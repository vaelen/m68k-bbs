// 68kBBS: a simple BBS for System 6/7 68k Macs.
// App entry: window/menu declarations, modem session flow, screen
// dispatch, and the shared output helpers. The feature areas live in
// the included modules (sysop.cla, boards.cla, editor.cla).

include "scanner.cla"
include "telnet.cla"
include "user.cla"
include "usersdb.cla"
include "boardsdb.cla"
include "networksdb.cla"
include "postsdb.cla"
include "termio.cla"
include "sysop.cla"
include "boards.cla"
include "maildb.cla"
include "areasdb.cla"
include "filesdb.cla"
include "mail.cla"
include "files.cla"
include "editor.cla"
include "loginlog.cla"
include "banned.cla"
include "config.cla"
include "wall.cla"
include "motd.cla"
include "games/basic.cla"
include "xmodem.cla"
include "zmodem.cla"
include "ftntoss.cla"
include "emsi.cla"
include "toolbox/osutils.cla"   // DateTimeRec / SecondsToDate (via --rtdir)

app BBS {
    name: "68kBBS"
    version: "0.2"
    author: "Andrew C. Young"
    about: "A simple BBS for classic Macs."
    id: "68BB"
}

window Main {
    title: "68kBBS Log"
    size: 480, 300
    resizable: min(300, 150)

    textview LogView { fill: both; scrollbar: both }
}

menu File {
    item Quit "Quit" key "Q"
}

menu Edit { standard edit }

menu FidoNet {
    item PollAll "Poll All Networks"
}

var modem: connection
var isConnected: bool = false

// Set when a hotkey was just echoed: the caller's cursor sits after
// the key, so the next caller-facing output starts a fresh line. The
// newline is part of the echo, not of the key delivery -- handlers get
// the bare key, and a screen with echo off (a BASIC program reading
// INKEY$) gets no newline at all.
var hotkeyPending: bool = false

func freshLine() {
    if not hotkeyPending { return }
    hotkeyPending = false
    if termCol > 0 { sendData(terminal.eol) }
}

// All caller-facing output funnels through here, so telnet IAC
// escaping has one chokepoint. Modem commands (+++/ATH) and telnet
// negotiation bytes bypass it via modem.send/telnetOut.
func sendData(s: string) {
    freshLine()
    trackOutput(s)
    telnetSend(modem, s)
}

// Raw negotiation bytes from telnet.cla -- never escaped.
func telnetOut(s: string) {
    modem.send(s)
}

// Modem commands for the FTN poll (emsi.cla): raw, never escaped.
func ftnModemSend(s: string) {
    modem.send(s)
}

// User 1's name for the EMSI IDENT field.
func ftnSysopName(): string {
    var rec: text = dbFind(usersDb, 1)
    if rec.length != userRecordSize { return "Sysop" }
    return dbExtractString(rec, uOffName)
}

// --- File transfers ----------------------------------------------------
// A transfer is the "xfer" screen: inputChar hands every raw byte to
// xferChar, the 30-tick timer calls xferTick, and disconnected() calls
// xferAbort. Engines answer through xferOut (below) and xferDone
// (files.cla). ponytail: the switch grows a case per engine (Kermit
// next) -- see docs/file-transfers.md.

var xferProto: char = 'X'
var xferPath: string

// Frames can be 1K+, so send in 255-byte slices; telnetSend keeps the
// IAC doubling, and there's no cursor tracking for binary.
func xferOut(t: text) {
    var i: int = 0
    var n: int = 0
    while i < t.length {
        n = t.length - i
        if n > 255 { n = 255 }
        telnetSend(modem, t[i, n])
        i = i + n
    }
}

// proto: 'X' XMODEM, '1' XMODEM-1K, 'Y' YMODEM (all xmodem.cla),
// 'Z' ZMODEM (zmodem.cla).
func xferStart(proto: char, path: string, name: string) {
    xferProto = proto
    xferPath = path
    user.screen = "xfer"
    telnetBinaryRequest()    // 8-bit clean both ways for a telnet caller
    switch proto {
    case 'X', '1', 'Y' { xmodemSendStart(path, name, proto) }
    case 'Z' { zmodemSendStart(path, name) }
    }
}

func xferStartReceive(proto: char, folder: string, name: string) {
    xferProto = proto
    xferPath = ""
    user.screen = "xfer"
    telnetBinaryRequest()
    switch proto {
    case 'X', '1', 'Y' { xmodemRecvStart(proto, folder, name) }
    case 'Z' { zmodemRecvStart(folder) }
    }
}

func xferChar(c: char) {
    switch xferProto {
    case 'X', '1', 'Y' { xmodemChar(c) }
    case 'Z' { zmodemChar(c) }
    }
}

func xferTick() {
    switch xferProto {
    case 'X', '1', 'Y' { xmodemTick() }
    case 'Z' { zmodemTick() }
    }
}

func xferAbort() {
    switch xferProto {
    case 'X', '1', 'Y' { xmodemAbort() }
    case 'Z' { zmodemAbort() }
    }
}

// Login/signup state between prompts (reset on connect).
var pendingId: int = 0      // account found at the login prompt
var pendingHash: int = 0    // first password entered during signup
var returning: bool = false // logged into an existing account: show the welcome-back banner
var sessionName: string(31) // who logged in this call ("" = nobody yet), for the login log
var sessionStart: int = 0
var sessionNew: bool = false
var previousSeen: int = 0   // that account's lastSeen before this login (Mac seconds can be
                            // negative as an int past 2^31, so no sentinel value -- hence the bool)
var postLogin: bool = false // just logged in or signed up: run the
                            // welcome -> wall -> MOTD chain once
var pauseNext: string(15)   // what the "pause" screen's keypress runs


const BS:  char = '\x08'
const DEL: char = '\x7F'

// Line-mode hooks for the editor (set per prompt by displayPrompt):
// a buffer that reaches lineLimit is handed to processInput as a
// "soft" line (inputSoft) before the next character starts a fresh
// one; 0 means no limit.
var lineLimit: int = 0
var inputSoft: bool = false

// The BBS echoes received characters back (classic remote-echo BBS
// behavior; telnet clients get local echo turned off by the connect
// probe). Fully off during the probe and logoff, so stray probe bytes
// and the modem's command chatter never bounce back onto the line.
func echoActive(): bool {
    if not terminal.echo { return false }
    if user.screen == "probe" or user.screen == "logoff" or user.screen == "xfer" { return false }
    if user.screen == "basic" { return false }    // INKEY$ keys: the program decides what shows
    return true
}

// Password entry: the Enter still echoes as a newline, the characters
// don't.
func echoHidden(): bool {
    switch user.screen {
    case "password", "newpass", "newpass2" { return true }
    case "edituserval" { return editField == 'P' }   // sysop password reset
    }
    return false
}

func echoChar(c: char) {
    var s: string(1)
    if not echoActive() or echoHidden() { return }
    if c < ' ' or c == DEL { return }   // control chars don't echo
    s = s + c
    sendData(s)
    // Hard-wrap at the margin so the terminal never sits in its
    // ambiguous "pending wrap" state, which no BS/CR sequence can
    // reliably step back from.
    // ponytail: assumes deferred wrap (VT100/xterm/modern clients); an
    // immediate-wrap terminal shows one blank line per margin hit.
    if termCol >= terminal.columns { sendData(terminal.eol) }
}

func echoBuffer() {
    var i: int = 0
    while i < user.buffer.length {
        echoChar(user.buffer[i])
        i = i + 1
    }
}

// Collect connected-caller input, one char at a time. Called by
// telnet.cla with every byte left after modem result-code filtering
// (scanner.cla) and telnet command processing. Line mode
// (terminal.linemode, set per screen by displayPrompt) buffers until
// CR (LF is dropped, so CRLF terminals work) and handles BS/DEL;
// otherwise each key acts at once: Enter arrives as "", any other key
// as itself (a length-1 string), echoed hotkey-style; the newline that
// follows the echo is deferred until the screen prints something
// (hotkeyPending/freshLine). Data arriving with no caller connected is
// dropped.
func inputChar(c: char) {
    var single: string(1)
    if not isConnected { return }
    if user.screen == "ftn" {
        emsiChar(c)
        return
    }
    if user.screen == "xfer" {
        xferChar(c)
        return
    }
    if c == '\x03' and basicActive {      // ^C breaks a BASIC program
        basicBreakKey()
        return
    }
    if not terminal.linemode {
        if c == LF or c == BS or c == DEL { return }
        if c >= '0' and c <= '9' and numberScreen(user.screen) != "" {
            // a digit on a numbered list opens its number prompt with
            // the digit already typed
            single = single + c
            hotkeyPending = echoActive()
            promptNumber(numberScreen(user.screen), single)
            return
        }
        if c != CR {
            single = single + c
            echoChar(c)
        }
        hotkeyPending = echoActive()
        processInput(single)
        return
    }
    if c == CR {
        // no newline echo when a hard wrap already left the cursor at
        // column 0
        if echoActive() and termCol > 0 { sendData(terminal.eol) }
        processInput(user.buffer)
        user.buffer = ""
        return
    }
    if c == LF { return }
    if c == BS or c == DEL {
        if user.buffer.length == 0 and user.screen == "editbody" {
            editJoinPrevious()
            return
        }
        if user.buffer.length > 0 {
            user.buffer = user.buffer[0, user.buffer.length - 1]
            if echoActive() and not echoHidden() {
                if termCol > 0 {
                    sendData("\x08 \x08")
                } else {
                    // the deleted char sits at the end of the previous
                    // row, which BS can't reach: redraw the input line
                    sendData(terminal.eol)
                    displayPrompt()
                    echoBuffer()
                }
            }
        }
        return
    }
    if lineLimit > 0 and user.buffer.length >= lineLimit {
        inputSoft = true       // row full: submit it, start the next
        processInput(user.buffer)
        inputSoft = false
        user.buffer = ""
    }
    if user.buffer.length >= 255 {
        sendData("\x07")      // line full: drop the char, ring the bell
        return
    }
    user.buffer = user.buffer + c
    echoChar(c)
}

// Two sends: `s + terminal.eol` as one expression would clamp at the
// 255-byte string cap when s is already full, silently dropping the
// line ending.
func sendLine(s: string) {
    sendData(s)
    sendData(terminal.eol)
}

// --- Table output ------------------------------------------------------
// Connection-facing senders over terminal.cla's table builders, shared
// by the sysop screens and the bulletin board reader.

func sendRule(l: BoxPiece, m: BoxPiece, r: BoxPiece, w: list of int) {
    freshLine()
    sendDrawing(modem, ruleLine(l, m, r, w))
    sendData(terminal.eol)
}

// Top of a boxed table: rule, centered title bar, joint rule.
func sendTableTitle(title: string, w: list of int) {
    var span: list of int
    var cells: list of string
    span.add(spanWidth(w))
    cells.add(center(title, span[0]))
    sendLine("")
    sendRule(TopLeft, TopCenter, TopRight, span)
    sendLine(rowLine(cells, span))
    sendRule(CenterLeft, TopCenter, CenterRight, w)
}

// Table title plus a header row and its rule.
func sendTableHeader(title: string, headers: list of string, w: list of int) {
    sendTableTitle(title, w)
    sendLine(rowLine(headers, w))
    sendRule(CenterLeft, Center, CenterRight, w)
}

// Bottom of a boxed table with a right-aligned footer bar: joint rule,
// footer row spanning the table, bottom rule.
func sendTableFooter(msg: string, w: list of int) {
    var span: list of int
    var cells: list of string
    span.add(spanWidth(w))
    cells.add(padLeft(msg, span[0]))
    sendRule(CenterLeft, BottomCenter, CenterRight, w)
    sendLine(rowLine(cells, span))
    sendRule(BottomLeft, BottomCenter, BottomRight, span)
}

// Decimal string of a non-negative int (no int-to-string builtin).
func intStr(n: int): string {
    var v: int = n
    var s: string = ""
    if v == 0 { return "0" }
    while v > 0 {
        s = char(int('0') + (v mod 10)) + s
        v = v / 10
    }
    return s
}

func pad2(n: int): string {
    if n < 10 { return "0" + intStr(n) }
    return intStr(n)
}

// "[yyyy-mm-dd HH:MM:SS] " from the Mac clock. Built up in pieces:
// the 68k backend caps string temps per statement.
func timestamp(): string {
    var rec: DateTimeRec
    var s: string
    SecondsToDate(now(), rec)
    s = "[" + intStr(rec.year) + "-" + pad2(rec.month)
    s = s + "-" + pad2(rec.day) + " " + pad2(rec.hour)
    s = s + ":" + pad2(rec.minute) + ":" + pad2(rec.second) + "] "
    return s
}

// Strip leading and trailing spaces.
func trimStr(s: string): string {
    var a: int = 0
    var b: int = s.length
    while a < b and s[a] == ' ' { a = a + 1 }
    while b > a and s[b - 1] == ' ' { b = b - 1 }
    return s[a, b - a]
}

func upperStr(s: string): string {
    var r: string = s
    var i: int = 0
    var c: char
    while i < r.length {
        c = r[i]
        if c >= 'a' and c <= 'z' { r[i] = char(int(c) - 32) }
        i = i + 1
    }
    return r
}

// --- Screens ----------------------------------------------------------
// Each screen has a menu (drawn on entry and by "?") and a prompt
// (redrawn after every input). gotoScreen is the one way to move
// between screens; processInput routes completed input to the current
// screen's handler.

func displayMenu() {
    switch user.screen {
    case "terminal"    { drawTerminalMenu() }
    case "main"        { drawMainMenu() }
    case "games"       { drawGamesMenu() }
    case "sysop"       { drawSysopMenu() }
    case "sysopboards" { drawSysopBoardsMenu() }
    case "sysopareas"  { drawSysopAreasMenu() }
    case "sysopusers"  { drawSysopUsersMenu() }
    case "sysopnets"   { drawSysopNetsMenu() }
    case "sysopbanned" { drawSysopBannedMenu() }
    case "sysopconfig" { drawSysopConfigMenu() }
    case "boards"      { drawBoardPicker() }
    case "areas"       { drawAreaPicker() }
    case "posts"       { drawPostsMenu() }
    case "postview"    { drawPostViewMenu() }
    case "files"       { drawFilesMenu() }
    case "fileview"    { drawFileViewMenu() }
    case "xferproto"   { drawXferProtoMenu() }
    case "upproto"     { drawUpProtoMenu() }
    case "mail"        { drawMailMenu() }
    case "mailview"    { drawMailViewMenu() }
    }
}

// The number prompt belonging to a numbered-list screen ("" if the
// screen has none). Its V key opens the prompt empty; a digit opens it
// pre-filled (see inputChar).
func numberScreen(list: string): string {
    switch list {
    case "boards" { return "boardnum" }
    case "areas"  { return "areanum" }
    case "posts"  { return "postnum" }
    case "files"  { return "filenum" }
    case "mail"   { return "mailnum" }
    case "games"  { return "gamenum" }
    }
    return ""
}

func promptNumber(screen: string, prefill: string) {
    user.screen = screen
    displayPrompt()          // line mode from here on
    user.buffer = prefill
    echoBuffer()
}

// Screens that take typed text (names, IDs, numbers, editor lines)
// buffer until Enter; every other prompt acts on the first key.
func lineScreen(s: string): bool {
    switch s {
    case "login", "password", "newname", "newpass", "newpass2", "newemail" { return true }
    case "banadd", "bandel" { return true }
    case "showuser", "showboard", "showarea" { return true }
    case "edituserid", "editboardid", "editareaid" { return true }
    case "edituserval", "editboardval", "editareaval", "useraccess" { return true }
    case "deluserid", "delboardid", "delareaid" { return true }
    case "boardnum", "areanum", "postnum", "filenum", "mailnum" { return true }
    case "mailto", "mailaddr", "editsubject", "editbody", "delpostnum", "delfilenum" { return true }
    case "newboardname", "newboarddesc", "newboardnet", "newboardtag" { return true }
    case "newareaname", "newareadesc", "newareafolder" { return true }
    case "upname", "updesc", "editfiledesc" { return true }
    case "shownet", "editnetid", "editnetval", "delnetid", "newnetname", "areafixreq" { return true }
    case "wallentry" { return true }
    case "basicline", "gamenum" { return true }
    }
    return false
}

func displayPrompt() {
    terminal.linemode = lineScreen(user.screen)
    lineLimit = 0
    switch user.screen {
    case "login"    { sendData("Username: ") }
    case "password" { sendData("Password: ") }
    case "newname"  { sendData("Choose a username: ") }
    case "newpass"  { sendData("Choose a password: ") }
    case "newpass2" { sendData("Retype password: ") }
    case "newemail" { sendData("Email (optional): ") }
    case "terminal"    { sendData("Terminal type [4]> ") }
    case "main"        { sendData("Main Menu> ") }
    case "games"       { sendData("Games> ") }
    case "sysop"       { sendData("Sysop Menu> ") }
    case "sysopboards" { sendData("Sysop:Boards> ") }
    case "sysopareas"  { sendData("Sysop:Areas> ") }
    case "sysopusers"  { sendData("Sysop:Users> ") }
    case "showuser"    { sendData("User ID or name: ") }
    case "showboard"   { sendData("Board ID: ") }
    case "showarea"    { sendData("Area ID: ") }
    case "edituserid"  { sendData("User ID or name: ") }
    case "editboardid" { sendData("Board ID: ") }
    case "editareaid"  { sendData("Area ID: ") }
    case "edituser", "editboard", "editarea" { sendData("Field letter, S)ave, Q)uit: ") }
    case "edituserval"  { editUserValuePrompt() }
    case "useraccess"   { sendData("Flag to toggle, ?)Redraw, Enter = done: ") }
    case "editboardval" { editBoardValuePrompt() }
    case "editareaval"  { editAreaValuePrompt() }
    case "deluserid"    { sendData("User ID or name: ") }
    case "delboardid"   { sendData("Board ID: ") }
    case "delareaid"    { sendData("Area ID: ") }
    case "deluserconfirm"  { sendData("Delete this user? (Y/N): ") }
    case "delboardconfirm" { sendData("Delete this board? (Y/N): ") }
    case "delareaconfirm"  { sendData("Delete this area? (Y/N): ") }
    case "boards" { sendData("Board ID> ") }
    case "areas" { sendData("Area ID> ") }
    case "boardnum" { sendData("Board ID: ") }
    case "areanum"  { sendData("Area ID: ") }
    case "postnum"  { sendData("Post number: ") }
    case "filenum"  { sendData("File number: ") }
    case "mailnum"  { sendData("Message number: ") }
    case "posts", "postview" { postsPrompt() }
    case "files", "fileview" { filesPrompt() }
    case "xferproto", "upproto" { sendData("Protocol: ") }
    case "upname" { sendData("Filename: ") }
    case "updesc" { sendData("Description: ") }
    case "editfiledesc" { sendData("Description [" + fileRec.description + "]: ") }
    case "mail", "mailview" { mailPrompt() }
    case "delmailconfirm" { sendData("Delete this message? (Y/N): ") }
    case "mailto" { sendData("To: ") }
    case "mailaddr" { sendData("Address (zone:net/node): ") }
    case "editsubject" { editSubjectPrompt() }
    case "editbody"    { editBodyPrompt() }
    case "delpostnum"     { sendData("Delete post #: ") }
    case "delpostconfirm" { sendData("Delete this post? (Y/N): ") }
    case "delfilenum"     { sendData("Delete file #: ") }
    case "delfileconfirm" { sendData("Delete this file? (Y/N): ") }
    case "newboardname" { sendData("Board name: ") }
    case "newboarddesc" { sendData("Description: ") }
    case "newboardnet"  { sendData("Network (ID or name, Enter = local): ") }
    case "newboardtag"  { sendData("Echo tag: ") }
    case "newareaname"   { sendData("Area name: ") }
    case "newareadesc"   { sendData("Description: ") }
    case "newareafolder" { sendData("Folder (Enter = app directory): ") }
    case "newareaaccess" { sendData("Access (A=all, S=sysop) [A]: ") }
    case "sysopnets"   { sendData("Sysop:Networks> ") }
    case "sysopbanned" { sendData("Sysop:Banned> ") }
    case "sysopconfig" { sendData("Sysop:Config> ") }
    case "banadd"      { sendData("Name to ban (Enter = cancel): ") }
    case "bandel"      { sendData("Name to remove (Enter = cancel): ") }
    case "netlist"     { }
    case "shownet", "editnetid", "delnetid" { sendData("Network ID or name: ") }
    case "shownetkeys" { sendData("P)oll  A)reaFix  Q)uit: ") }
    case "editnet"     { sendData("Field letter, S)ave, Q)uit: ") }
    case "editnetval"  { editNetValuePrompt() }
    case "delnetconfirm" { sendData("Delete this network? (Y/N): ") }
    case "newnetname"  { sendData("Network name: ") }
    case "areafixreq"  { sendData("AreaFix request (+TAG, -TAG, %LIST): ") }
    case "pause"   { sendData("Press any key to continue... ") }
    case "wallmore"  { sendData("Display More? (Y/[N]) ") }
    case "wallask"   { sendData("Sign the wall? (Y/[N]) ") }
    case "wallentry" { sendData("Your message (" + intStr(wallMessageMax) + " chars max): ") }
    case "gamenum"   { sendData("Game number: ") }
    case "basic", "basicline" { }     // the interpreter prints its own prompts
    }
}

func gotoScreen(s: string) {
    user.screen = s
    displayMenu()
    displayPrompt()
}

func drawTerminalMenu() {
    sendLine("")
    sendLine("Terminal Types:")
    sendLine("1. ASCII 80x24 No Color")
    sendLine("2. ASCII 80x24 With Color")
    sendLine("3. ANSI  80x24 No Color (DOS/Windows)")
    sendLine("4. ANSI  80x24 With Color (DOS/Windows)")
    sendLine("5. VT100 80x24 No Color (UNIX/Linux)")
    sendLine("6. VT100 80x24 With Color (UNIX/Linux)")
    sendLine("7. ASCII 40x24 No Color (APPLE II, etc)")
    sendLine("8. ASCII 40x24 With Color (APPLE II, etc)")
}

func drawMainMenu() {
    sendLine("")
    sendLine("B) Bulletin Boards")
    sendLine("F) File Areas")
    if unreadCount(user.id) > 0 {
        sendLine("M) Mail (" + intStr(unreadCount(user.id)) + " new)")
    } else {
        sendLine("M) Mail")
    }
    if hasPermission(Games) { sendLine("G) Games") }
    sendLine("")
    sendLine("D) Message of the Day")
    sendLine("W) Wall")
    sendLine("L) Recent Logins")
    if hasPermission(Sysop) {
        sendLine("S) Sysop Menu")
    }
    sendLine("T) Terminal Settings")
    sendLine("")
    sendLine("Q) Quit (Logoff)")
    sendLine("?) Display This Menu")
    sendLine("")
}

// The last 20 sessions from the login log, newest first. Narrow
// terminals drop the duration column.
func drawRecentLogins() {
    var recs: list of string
    var w: list of int
    var span: list of int
    var cells: list of string
    var i: int = 0
    w.add(1)
    cells.add("N")
    if terminal.columns >= minimumWideTerminalWidth {
        w.add(20)
        w.add(loginTimeWidth)
        w.add(loginDurWidth)
        cells.add("Login")
        cells.add("Time")
        cells.add("Duration")
    } else {
        w.add(10)
        w.add(loginTimeWidth)
        cells.add("Login")
        cells.add("Time")
    }
    loginLogRecent(20, recs)
    sendTableHeader("Recent Logins", cells, w)
    while i < recs.count {
        cells.clear()
        cells.add(loginField(recs[i], loginNewAt, 1))
        cells.add(loginField(recs[i], loginNameAt, w[1]))
        cells.add(loginField(recs[i], loginTimeAt, loginTimeWidth))
        if w.count == 4 { cells.add(loginField(recs[i], loginDurAt, loginDurWidth)) }
        sendLine(rowLine(cells, w))
        i = i + 1
    }
    if recs.count == 0 {
        span.add(spanWidth(w))
        cells.clear()
        cells.add(center("No logins yet.", span[0]))
        sendLine(rowLine(cells, span))
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

// Act on one completed input (a line, or a single key on hotkey
// screens -- "" for Enter) according to the screen the user is on.
func processInput(input: string) {
    switch user.screen {
    case "login"    { loginName(input) }
    case "password" { loginPassword(input) }
    case "newname"  { newName(input) }
    case "newpass"  { newPass(input) }
    case "newpass2" { newPass2(input) }
    case "newemail" { newEmail(input) }
    case "pause"   { pauseChoice(input) }
    case "wallmore"  { wallMoreChoice(input) }
    case "wallask"   { wallAskChoice(input) }
    case "wallentry" { wallEntryInput(input) }
    case "terminal"    { terminalChoice(input) }
    case "main"        { mainChoice(input) }
    case "games"       { gamesChoice(input) }
    case "gamenum"     { gameNumberInput(input) }
    case "basic", "basicline" { basicScreenInput(input) }
    case "sysop"       { sysopChoice(input) }
    case "sysopboards" { sysopBoardsChoice(input) }
    case "sysopareas"  { sysopAreasChoice(input) }
    case "sysopusers"  { sysopUsersChoice(input) }
    case "userlist"    { userListInput(input) }
    case "boardlist"   { boardListInput(input) }
    case "arealist"    { areaListInput(input) }
    case "showuser"    { showUserInput(input) }
    case "showboard"   { showBoardInput(input) }
    case "showarea"    { showAreaInput(input) }
    case "edituserid"   { editUserIdInput(input) }
    case "edituser"     { editUserChoice(input) }
    case "edituserval"  { editUserValue(input) }
    case "useraccess"   { accessToggleInput(input) }
    case "editboardid"  { editBoardIdInput(input) }
    case "editboard"    { editBoardChoice(input) }
    case "editboardval" { editBoardValue(input) }
    case "editareaid"   { editAreaIdInput(input) }
    case "editarea"     { editAreaChoice(input) }
    case "editareaval"  { editAreaValue(input) }
    case "deluserid"       { delUserIdInput(input) }
    case "deluserconfirm"  { delUserConfirm(input) }
    case "delboardid"      { delBoardIdInput(input) }
    case "delboardconfirm" { delBoardConfirm(input) }
    case "delareaid"       { delAreaIdInput(input) }
    case "delareaconfirm"  { delAreaConfirm(input) }
    case "boards" { boardPickerInput(input) }
    case "areas" { areaPickerInput(input) }
    case "boardnum" { boardNumInput(input) }
    case "areanum"  { areaNumInput(input) }
    case "postnum"  { postNumInput(input) }
    case "filenum"  { fileNumInput(input) }
    case "mailnum"  { mailNumInput(input) }
    case "posts"  { postsChoice(input) }
    case "postview" { postViewChoice(input) }
    case "files" { filesChoice(input) }
    case "fileview" { fileViewChoice(input) }
    case "xferproto" { xferProtoChoice(input) }
    case "upproto" { upProtoChoice(input) }
    case "upname" { upNameInput(input) }
    case "updesc" { upDescInput(input) }
    case "editfiledesc" { editFileDescInput(input) }
    case "mail" { mailChoice(input) }
    case "mailview" { mailViewChoice(input) }
    case "delmailconfirm" { delMailConfirm(input) }
    case "mailto" { mailToInput(input) }
    case "mailaddr" { mailAddrInput(input) }
    case "editsubject" { editSubjectInput(input) }
    case "editbody"    { editBodyInput(input) }
    case "delpostnum"     { delPostNumInput(input) }
    case "delpostconfirm" { delPostConfirm(input) }
    case "delfilenum"     { delFileNumInput(input) }
    case "delfileconfirm" { delFileConfirm(input) }
    case "newboardname" { newBoardName(input) }
    case "newboarddesc" { newBoardDesc(input) }
    case "newboardnet"  { newBoardNet(input) }
    case "newboardtag"  { newBoardTag(input) }
    case "newareaname"   { newAreaName(input) }
    case "newareadesc"   { newAreaDesc(input) }
    case "newareafolder" { newAreaFolder(input) }
    case "newareaaccess" { newAreaAccess(input) }
    case "sysopnets"   { sysopNetsChoice(input) }
    case "sysopbanned" { sysopBannedChoice(input) }
    case "sysopconfig" { sysopConfigChoice(input) }
    case "banadd"      { banAddInput(input) }
    case "bandel"      { banDelInput(input) }
    case "netlist"     { netListInput(input) }
    case "shownet"     { showNetInput(input) }
    case "shownetkeys" { showNetKeys(input) }
    case "editnetid"   { editNetIdInput(input) }
    case "editnet"     { editNetChoice(input) }
    case "editnetval"  { editNetValue(input) }
    case "delnetid"    { delNetIdInput(input) }
    case "delnetconfirm" { delNetConfirm(input) }
    case "newnetname"  { newNetName(input) }
    case "areafixreq"  { areafixReqInput(input) }
    case "logoff"   { }   // ignore trailing input (e.g. the modem's OK)
    case "probe"    { }   // discard stray bytes during the telnet probe
    }
}

// --- Login ------------------------------------------------------------
// Names are looked up case-insensitively (the Users database indexes
// them that way); NEW starts the signup flow.

func loginName(input: string) {
    if input == "" {
        displayPrompt()
    } else if upperStr(input) == "NEW" {
        gotoScreen("newname")
    } else if isBanned(input) {
        log("Banned name at login (" + input + "); hanging up.")
        user.screen = "logoff"
        hangupPhase = 1
    } else {
        pendingId = findUserId(input)
        if pendingId < 1 {
            sendLine("No such user. Type NEW to create an account.")
            displayPrompt()
        } else {
            user.screen = "password"
            displayPrompt()
        }
    }
}

func loginPassword(input: string) {
    if pendingId >= 1 and loadUser(pendingId) and hashPassword(input) == user.passwordHash {
        if hasPermission(Login) {
            loginOk()
        } else {
            log("Disabled account at login (" + user.name + "); hanging up.")
            sendLine("This account is disabled.")
            user.screen = "logoff"
            hangupPhase = 1
        }
    } else {
        sendLine("Invalid password.")
        pendingId = 0
        gotoScreen("login")
    }
}

func loginOk() {
    user.authenticated = true
    log("User logged in: " + user.name + " (#" + intStr(user.id) + ")")
    returning = true
    postLogin = true
    previousSeen = user.lastSeen
    user.lastSeen = now()
    saveUser()
    sessionName = user.name
    sessionStart = now()
    sessionNew = false
    gotoScreen("terminal")
}

// --- Signup -----------------------------------------------------------
// newname -> newpass -> newpass2 -> newemail -> account created and
// logged in. An empty username cancels back to login.

func newName(input: string) {
    if input == "" {
        sendLine("Signup cancelled.")
        gotoScreen("login")
    } else if input.length > 31 {
        sendLine("Names are limited to 31 characters.")
        displayPrompt()
    } else if isBanned(input) {
        sendLine("That username is not allowed.")
        displayPrompt()
    } else if upperStr(input) == "NEW" or findUserId(input) >= 1 {
        sendLine("That name is taken.")
        displayPrompt()
    } else {
        user.name = input
        user.screen = "newpass"
        displayPrompt()
    }
}

func newPass(input: string) {
    if input == "" {
        displayPrompt()
    } else {
        pendingHash = hashPassword(input)
        user.screen = "newpass2"
        displayPrompt()
    }
}

func newPass2(input: string) {
    if hashPassword(input) == pendingHash {
        user.passwordHash = pendingHash
        user.screen = "newemail"
        displayPrompt()
    } else {
        sendLine("Passwords do not match.")
        user.screen = "newpass"
        displayPrompt()
    }
}

func newEmail(input: string) {
    if input.length > 63 {
        sendLine("Email addresses are limited to 63 characters.")
        displayPrompt()
        return
    }
    user.email = input
    user.access = config.newUserAccess
    if userCount() == 0 { user.access = accessAllFlags }
    user.created = now()
    user.lastSeen = now()
    if createUser() < 1 {
        sendLine("Account creation failed; sorry.")
        gotoScreen("login")
        return
    }
    log("New user created: " + user.name + " (#" + intStr(user.id) + ")")
    sessionName = user.name
    sessionStart = now()
    sessionNew = true
    sendLine("")
    sendLine("Account created. Welcome, " + user.name + "!")
    if hasPermission(Sysop) {
        sendLine("You are the first user, so you have sysop access.")
    }
    user.authenticated = true
    postLogin = true
    gotoScreen("terminal")
}

func termTypeName(t: TerminalType): string {
    switch t {
    case ASCII { return "ASCII" }
    case ANSI  { return "ANSI" }
    case VT100 { return "VT100" }
    }
    return ""
}

func applyTerminal(t: TerminalType, cols: int, colorOn: bool) {
    var msg: string
    terminal.type = t
    setColumns(cols)
    setRows(24)
    terminal.color = colorOn
    // color implies escape-code support, whatever the type
    terminal.ansi = (t == ANSI or t == VT100 or colorOn)
    if t == VT100 { sendData(vt100SetupSeq) }
    msg = "User: " + user.name + ", Terminal: " + termTypeName(t)
    msg = msg + " " + intStr(cols) + "x" + intStr(terminal.rows)
    log(msg)
    if postLogin {
        // the once-per-login chain: welcome, wall, MOTD, counts
        postLogin = false
        sendLine("")
        if returning {
            sendLine("Welcome back, " + user.name + "!")
            if previousSeen != 0 {
                sendLine("Last on: " + dateTimeStr(previousSeen))
            }
        } else {
            sendLine("Welcome, " + user.name + "!")
        }
        returning = false
        showPause("wall")
        return
    }
    gotoScreen("main")
}

// --- Post-login chain --------------------------------------------------
// applyTerminal -> pause -> wall (wall.cla) -> MOTD -> pause
// -> new-message/pending-file counts -> main menu. "pause" swallows one
// key and runs pauseNext.

func showPause(next: string) {
    pauseNext = next
    user.screen = "pause"
    displayPrompt()
}

func pauseChoice(input: string) {
    switch pauseNext {
    case "wall" {
        wallFromMenu = false
        startWall()
    }
    case "counts" { postLoginCounts() }
    else          { gotoScreen("main") }
    }
}

// The MOTD wrapped to the caller's width, blank line above and below.
func showMotd() {
    var lines: list of string
    wrapText(motdText, terminal.columns, lines)
    sendLine("")
    for l in lines {
        sendLine(l)
    }
    sendLine("")
}

// After the wall: the MOTD and its pause, skipped when empty.
func postLoginMotd() {
    if motdText.length == 0 {
        postLoginCounts()
        return
    }
    showMotd()
    showPause("counts")
}

func postLoginCounts() {
    var pf: int = 0
    sendLine("")
    if unreadCount(user.id) > 0 {
        sendLine("You have " + intStr(unreadCount(user.id)) + " new message(s).")
    }
    if hasPermission(ApproveUploads) {
        pf = pendingFileCount()
        if pf > 0 {
            sendLine(intStr(pf) + " file(s) are awaiting approval.")
        }
    }
    gotoScreen("main")
}

// Invalid choice redraws the whole menu; empty input takes the default.
func terminalChoice(input: string) {
    switch input {
    case "1"     { applyTerminal(ASCII, 80, false) }
    case "2"     { applyTerminal(ASCII, 80, true) }
    case "3"     { applyTerminal(ANSI, 80, false) }
    case "4"     { applyTerminal(ANSI, 80, true) }
    case "", "5" { applyTerminal(VT100, 80, false) }
    case "6"     { applyTerminal(VT100, 80, true) }
    case "7"     { applyTerminal(ASCII, 40, false) }
    case "8"     { applyTerminal(ASCII, 40, true) }
    else         { gotoScreen("terminal") }
    }
}

// Invalid choice redraws only the prompt; "?" redraws the menu.
func mainChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "B" { gotoScreen("boards") }
    case "F" { gotoScreen("areas") }
    case "G" {
        if hasPermission(Games) { gotoScreen("games") } else { displayPrompt() }
    }
    case "W" {
        wallFromMenu = true
        startWall()
    }
    case "D" {
        if motdText.length == 0 {
            sendLine("No message of the day.")
        } else {
            showMotd()
        }
        showPause("main")
    }
    case "M" {
        mailPage = 1
        user.screen = "mail"
        drawInbox()
        displayPrompt()
    }
    case "S" {
        if hasPermission(Sysop) {
            gotoScreen("sysop")
        } else {
            displayPrompt()
        }
    }
    case "L" {
        drawRecentLogins()
        displayPrompt()
    }
    case "T" { gotoScreen("terminal") }   // applyTerminal re-inits and returns here
    case "Q" { logoff() }
    else     { displayPrompt() }
    }
}

// --- Logoff / hang-up -------------------------------------------------
// The bridge hangs up on "+++" then "ATH", each needing ~1s of line
// silence around it (Hayes guard time), so the sequence is paced by the
// once-a-second timer below.

var hangupPhase: int = 0
var telnetProbe: int = 0   // countdown to the end of the telnet probe

// The probe window is over: the telnet processor has already consumed
// any negotiation that came back (setting terminal.telnet), so keep
// intercepting only for telnet clients, drop whatever stray bytes the
// probe buffered, and show the login prompt.
func telnetProbeDone() {
    if not isConnected { return }
    telnetIntercept = terminal.telnet
    user.buffer = ""
    if terminal.telnet {
        log("Telnet client detected (type: " + terminal.reportedTerminalType + ").")
    }
    sendLine("")
    user.screen = "login"
    displayPrompt()
}

func logoff() {
    sendLine("")
    sendLine("Goodbye!")
    user.authenticated = false
    user.screen = "logoff"
    hangupPhase = 1
}

// Keeps a BASIC program moving between caller keystrokes (games/basic.cla).
every 2 ticks {
    if basicActive and (basicState == BRunning or basicState == BSleeping) { basicPump() }
}

every 30 ticks {
    if ftnPolling { emsiTick() }
    ftnSchedMinutes = ftnSchedMinutes + 1
    if ftnSchedMinutes >= 120 {      // once a minute: interval polls
        ftnSchedMinutes = 0
        ftnSchedule()
    }
    if user.screen == "xfer" { xferTick() }
    if telnetProbe > 0 {
        telnetProbe = telnetProbe - 1
        if telnetProbe == 0 { telnetProbeDone() }
    }
    if hangupPhase > 0 {
        hangupPhase = hangupPhase + 1
        if hangupPhase == 3 { modem.send("+++") }       // ~1s of silence first
        if hangupPhase == 5 {                            // ~1s after +++
            modem.send("ATH\x0D")
            hangupPhase = 0
        }
    }
}

// Called by scanner.cla's feedChar on a full "\r\nCONNECT <n>\r\n".
func connected() {
    isConnected = true
    user = new User          // fresh session: login screen
    terminal = new Terminal  // fresh session: 80x24 ASCII, no color
    telnetReset()
    telnetIntercept = true   // watch for negotiation during the probe
    hangupPhase = 0
    pendingId = 0
    pendingHash = 0
    returning = false
    postLogin = false
    sessionName = ""
    if ftnPolling {
        // our own outbound call: the mailer answered, not a caller
        telnetIntercept = false
        user.screen = "ftn"
        log("Mailer connected.")
        emsiConnected()
        return
    }
    log("Caller connected.")
    sendLine("Welcome to 68kBBS!")
    sendLine("Type NEW at the login prompt to create an account.")
    telnetProbeStart()
    sendLine("Checking for telnet support...")
    user.screen = "probe"
    telnetProbe = 2          // ~1s; telnetProbeDone shows the login prompt
}

// Called by scanner.cla's feedChar on a full "\r\nNO CARRIER\r\n".
func disconnected() {
    isConnected = false
    hangupPhase = 0
    telnetProbe = 0
    telnetIntercept = false
    if ftnPolling {
        emsiDisconnected()      // toss, commit, record, next queued poll
        return
    }
    if user.screen == "xfer" { xferAbort() }
    if basicActive {
        basicStop()
        basicActive = false
    }
    postsClose()
    if sessionName != "" {
        if not loginLogAppend(sessionNew, sessionName, sessionStart, now() - sessionStart) {
            log("Login log write failed: " + lastError.message)
        }
        sessionName = ""
    }
    log("Caller disconnected.")
    ftnNext()                   // a poll the sysop queued runs now
}

// Append text to the log window, dropping LF (0x0A) -- the Mac newline
// is CR, so CRLF/LF input would otherwise litter the view with boxes.
// ponytail: rebuilds the whole textview text per append; fine until the
// 32,000-byte TextEdit cap nears -- trim oldest lines then.
func appendLog(chunk: text) {
    var m: Main = Main.front
    var filtered: text
    var t: text
    var i: int = 0
    if m == nil { return }
    while i < chunk.length {
        if chunk[i] != '\x0A' { filtered.append(chunk[i]) }
        i = i + 1
    }
    t = m.LogView.text + filtered
    m.LogView.text = t
}

// Every log(...) call lands here (after reaching the diagnostic stream)
// and is appended to the log window.
on App.log(line: string) {
    appendLog(timestamp() + line + "\n")
}

on App.launch {
    open Main
    log("68kBBS starting up.")
    if bannedLoad() {
        log("Banned names loaded (" + intStr(bannedNames.count) + ").")
    } else {
        log("Banned names unavailable: " + lastError.message)
    }
    if configLoad() {
        log("Configuration loaded (new user access " + intStr(config.newUserAccess) + ").")
    } else {
        log("Configuration unavailable: " + lastError.message)
    }
    if motdLoad() {
        log("Message of the day loaded (" + intStr(motdText.length) + " bytes).")
    } else {
        log("Message of the day unavailable: " + lastError.message)
    }
    if usersOpen() {
        log("Users database open (" + intStr(userCount()) + " users).")
    } else {
        log("Users database unavailable: " + lastError.message)
    }
    if boardsOpen() {
        log("Boards database open (" + intStr(boardCount()) + " boards).")
    } else {
        log("Boards database unavailable: " + lastError.message)
    }
    if networksOpen() {
        log("Networks database open (" + intStr(networkCount()) + " networks).")
    } else {
        log("Networks database unavailable: " + lastError.message)
    }
    if mailOpen() {
        log("Mail database open (" + intStr(mailCount()) + " messages).")
    } else {
        log("Mail database unavailable: " + lastError.message)
    }
    if areasOpen() {
        log("Areas database open (" + intStr(areaCount()) + " file areas).")
    } else {
        log("Areas database unavailable: " + lastError.message)
    }
    if wallOpen() {
        log("Wall database open (" + intStr(wallCount()) + " messages).")
    } else {
        log("Wall database unavailable: " + lastError.message)
    }
    if not ftnEnsureFolders() {
        log("FTN folders unavailable: " + lastError.message)
    }
    modem.open(serial "modem:9600")
}

on modem.opened {
    log("Modem port open.")
}

on modem.received(data: text) {
    var i: int = 0
    while i < data.length {
        feedChar(data[i])
        i = i + 1
    }
}

on modem.failed(err: error) {
    log("Modem error: " + err.message)
}

extend File {
    on Quit.select {
        usersClose()
        boardsClose()
        networksClose()
        mailClose()
        areasClose()
        filesClose()
        wallClose()
        quit
    }
}

extend FidoNet {
    on PollAll.select {
        if isConnected {
            log("A caller is online; polls will run after the call.")
        }
        ftnPollAll()
    }
}

extend Main {
    on closed {              // closing the log window exits the app
        usersClose()
        boardsClose()
        networksClose()
        mailClose()
        areasClose()
        filesClose()
        wallClose()
        quit
    }
}
