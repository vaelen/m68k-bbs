// 68kBBS: a simple BBS for System 6/7 68k Macs.
// Current state: log window, File > Quit; modem port data mirrored
// into the log (read-only, nothing written back yet).

include "scanner.cla"
include "user.cla"
include "usersdb.cla"
include "termio.cla"
include "toolbox/osutils.cla"   // DateTimeRec / SecondsToDate (via --rtdir)

app BBS {
    name: "68kBBS"
    version: "0.1"
    author: "Andrew C. Young"
    about: "A simple BBS for classic Macs."
    id: "68BB"
}

window Main {
    title: "68kBBS Log"
    size: 480, 300
    resizable: min(300, 150)

    textview LogView { fill: both; scrollbar: both }
}

menu File {
    item Quit "Quit" key "Q"
}

menu Edit { standard edit }

var modem: connection
var isConnected: bool = false

// Login/signup state between prompts (reset on connect).
var pendingId: int = 0      // account found at the login prompt
var pendingHash: int = 0    // first password entered during signup
var listFromId: int = 1     // paging cursor for the user list


// Collect connected-caller input, one char at a time. Called by
// scanner.cla with every byte it releases as ordinary data (result-code
// bytes are filtered out). Line mode buffers until CR (LF is dropped,
// so CRLF terminals work); Character mode forwards each char
// immediately. Data arriving with no caller connected is dropped.
func dataChar(c: char) {
    var single: string(1)
    if not isConnected { return }
    if user.mode == Character {
        single = single + c
        processInput(single)
        return
    }
    if c == CR {
        processInput(user.buffer)
        user.buffer = ""
        return
    }
    if c == LF { return }
    user.buffer = user.buffer + c
}

func sendLine(s: string) {
    modem.send(s + terminal.eol)
}

// Decimal string of a non-negative int (no int-to-string builtin).
func intStr(n: int): string {
    var v: int = n
    var s: string = ""
    if v == 0 { return "0" }
    while v > 0 {
        s = char(int('0') + (v mod 10)) + s
        v = v / 10
    }
    return s
}

func pad2(n: int): string {
    if n < 10 { return "0" + intStr(n) }
    return intStr(n)
}

// "[yyyy-mm-dd HH:MM:SS] " from the Mac clock. Built up in pieces:
// the 68k backend caps string temps per statement.
func timestamp(): string {
    var rec: DateTimeRec
    var s: string
    SecondsToDate(now(), rec)
    s = "[" + intStr(rec.year) + "-" + pad2(rec.month)
    s = s + "-" + pad2(rec.day) + " " + pad2(rec.hour)
    s = s + ":" + pad2(rec.minute) + ":" + pad2(rec.second) + "] "
    return s
}

func upperStr(s: string): string {
    var r: string = s
    var i: int = 0
    var c: char
    while i < r.length {
        c = r[i]
        if c >= 'a' and c <= 'z' { r[i] = char(int(c) - 32) }
        i = i + 1
    }
    return r
}

// --- Screens ----------------------------------------------------------
// Each screen has a menu (drawn on entry and by "?") and a prompt
// (redrawn after every input). gotoScreen is the one way to move
// between screens; processInput routes completed input to the current
// screen's handler.

func displayMenu() {
    switch user.screen {
    case "terminal"    { drawTerminalMenu() }
    case "main"        { drawMainMenu() }
    case "sysop"       { drawSysopMenu() }
    case "sysopboards" { drawSysopBoardsMenu() }
    case "sysopusers"  { drawSysopUsersMenu() }
    }
}

func displayPrompt() {
    switch user.screen {
    case "login"    { modem.send("Username: ") }
    case "password" { modem.send("Password: ") }
    case "newname"  { modem.send("Choose a username: ") }
    case "newpass"  { modem.send("Choose a password: ") }
    case "newpass2" { modem.send("Retype password: ") }
    case "newemail" { modem.send("Email (optional): ") }
    case "terminal"    { modem.send("Terminal type [4]> ") }
    case "main"        { modem.send("Main Menu> ") }
    case "sysop"       { modem.send("Sysop Menu> ") }
    case "sysopboards" { modem.send("Sysop:Boards> ") }
    case "sysopusers"  { modem.send("Sysop:Users> ") }
    }
}

func gotoScreen(s: string) {
    user.screen = s
    displayMenu()
    displayPrompt()
}

func drawTerminalMenu() {
    sendLine("")
    sendLine("Terminal Types:")
    sendLine("1. ASCII 80x24 No Color")
    sendLine("2. ASCII 80x24 With Color")
    sendLine("3. ANSI  80x24 (DOS/Windows)")
    sendLine("4. VT100 80x24 (UNIX/Linux)")
    sendLine("5. ASCII 40x24 No Color (APPLE II, etc)")
}

func drawMainMenu() {
    sendLine("")
    sendLine("?) Display This Menu")
    if user.access == accessSysop {
        sendLine("S) Sysop Menu")
    }
    sendLine("Q) Quit (Logoff)")
    sendLine("")
}

func drawSysopMenu() {
    sendLine("")
    sendLine("Sysop Menu:")
    sendLine("B) Message Boards")
    sendLine("U) Users")
    sendLine("Q) Return to Main Menu")
    sendLine("")
}

func drawSysopBoardsMenu() {
    sendLine("")
    sendLine("Sysop - Message Boards:")
    sendLine("L) List Boards")
    sendLine("S) Show Board Details")
    sendLine("E) Edit Board")
    sendLine("N) New Board")
    sendLine("D) Delete Board")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

func drawSysopUsersMenu() {
    sendLine("")
    sendLine("Sysop - Users:")
    sendLine("L) List Users")
    sendLine("S) Show User Details")
    sendLine("E) Edit User")
    sendLine("D) Delete User")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

// Act on one completed input (a line, or a single char in Character
// mode) according to the screen the user is on.
func processInput(input: string) {
    switch user.screen {
    case "login"    { loginName(input) }
    case "password" { loginPassword(input) }
    case "newname"  { newName(input) }
    case "newpass"  { newPass(input) }
    case "newpass2" { newPass2(input) }
    case "newemail" { newEmail(input) }
    case "terminal"    { terminalChoice(input) }
    case "main"        { mainChoice(input) }
    case "sysop"       { sysopChoice(input) }
    case "sysopboards" { sysopBoardsChoice(input) }
    case "sysopusers"  { sysopUsersChoice(input) }
    case "userlist"    { userListInput(input) }
    case "logoff"   { }   // ignore trailing input (e.g. the modem's OK)
    }
}

// --- Login ------------------------------------------------------------
// Names are looked up case-insensitively (the Users database indexes
// them that way); NEW starts the signup flow.

func loginName(input: string) {
    if input == "" {
        displayPrompt()
    } else if upperStr(input) == "NEW" {
        gotoScreen("newname")
    } else {
        pendingId = findUserId(input)
        if pendingId < 1 {
            sendLine("No such user. Type NEW to create an account.")
            displayPrompt()
        } else {
            user.screen = "password"
            displayPrompt()
        }
    }
}

func loginPassword(input: string) {
    if pendingId >= 1 and loadUser(pendingId) and hashPassword(input) == user.passwordHash {
        loginOk()
    } else {
        sendLine("Invalid password.")
        pendingId = 0
        gotoScreen("login")
    }
}

func loginOk() {
    user.authenticated = true
    log("User logged in: " + user.name + " (#" + intStr(user.id) + ")")
    sendLine("")
    sendLine("Welcome back, " + user.name + "!")
    if user.lastSeen != 0 {
        sendLine("Last on: " + dateTimeStr(user.lastSeen))
    }
    user.lastSeen = now()
    saveUser()
    gotoScreen("terminal")
}

// --- Signup -----------------------------------------------------------
// newname -> newpass -> newpass2 -> newemail -> account created and
// logged in. An empty username cancels back to login.

func newName(input: string) {
    if input == "" {
        sendLine("Signup cancelled.")
        gotoScreen("login")
    } else if input.length > 31 {
        sendLine("Names are limited to 31 characters.")
        displayPrompt()
    } else if upperStr(input) == "NEW" or findUserId(input) >= 1 {
        sendLine("That name is taken.")
        displayPrompt()
    } else {
        user.name = input
        user.screen = "newpass"
        displayPrompt()
    }
}

func newPass(input: string) {
    if input == "" {
        displayPrompt()
    } else {
        pendingHash = hashPassword(input)
        user.screen = "newpass2"
        displayPrompt()
    }
}

func newPass2(input: string) {
    if hashPassword(input) == pendingHash {
        user.passwordHash = pendingHash
        user.screen = "newemail"
        displayPrompt()
    } else {
        sendLine("Passwords do not match.")
        user.screen = "newpass"
        displayPrompt()
    }
}

func newEmail(input: string) {
    if input.length > 63 {
        sendLine("Email addresses are limited to 63 characters.")
        displayPrompt()
        return
    }
    user.email = input
    user.access = accessUser
    if userCount() == 0 { user.access = accessSysop }
    user.created = now()
    user.lastSeen = now()
    if createUser() < 1 {
        sendLine("Account creation failed; sorry.")
        gotoScreen("login")
        return
    }
    log("New user created: " + user.name + " (#" + intStr(user.id) + ")")
    sendLine("")
    sendLine("Account created. Welcome, " + user.name + "!")
    if user.access == accessSysop {
        sendLine("You are the first user, so you have sysop access.")
    }
    user.authenticated = true
    gotoScreen("terminal")
}

func termTypeName(t: TerminalType): string {
    switch t {
    case ASCII { return "ASCII" }
    case ANSI  { return "ANSI" }
    case VT100 { return "VT100" }
    }
    return ""
}

func applyTerminal(t: TerminalType, cols: int, colorOn: bool) {
    var msg: string
    terminal.type = t
    terminal.columns = cols
    terminal.rows = 24
    terminal.color = colorOn
    if t == VT100 { modem.send(vt100SetupSeq) }
    msg = "User: " + user.name + ", Terminal: " + termTypeName(t)
    msg = msg + " " + intStr(terminal.columns) + "x" + intStr(terminal.rows)
    log(msg)
    gotoScreen("main")
}

// Invalid choice redraws the whole menu; empty input takes the default.
func terminalChoice(input: string) {
    switch input {
    case "1"     { applyTerminal(ASCII, 80, false) }
    case "2"     { applyTerminal(ASCII, 80, true) }
    case "3"     { applyTerminal(ANSI, 80, true) }
    case "", "4" { applyTerminal(VT100, 80, false) }
    case "5"     { applyTerminal(ASCII, 40, false) }
    else         { gotoScreen("terminal") }
    }
}

// Invalid choice redraws only the prompt; "?" redraws the menu.
func mainChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "S" {
        if user.access == accessSysop {
            gotoScreen("sysop")
        } else {
            displayPrompt()
        }
    }
    case "Q" { logoff() }
    else     { displayPrompt() }
    }
}

// --- Sysop menus ------------------------------------------------------
// All non-navigation options are stubs for now: echo the option name,
// then redraw the prompt.

func stubOption(name: string) {
    sendLine(name)
    displayMenu()
    displayPrompt()
}

func sysopChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "B" { gotoScreen("sysopboards") }
    case "U" { gotoScreen("sysopusers") }
    case "Q" { gotoScreen("main") }
    else     { displayPrompt() }
    }
}

func sysopBoardsChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { stubOption("List Boards") }
    case "S" { stubOption("Show Board Details") }
    case "E" { stubOption("Edit Board") }
    case "N" { stubOption("New Board") }
    case "D" { stubOption("Delete Board") }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

func sysopUsersChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { startUserList() }
    case "S" { stubOption("Show User Details") }
    case "E" { stubOption("Edit User") }
    case "D" { stubOption("Delete User") }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

// --- User list ---------------------------------------------------------
// A paged table of all accounts, read straight off the Users database
// records (the session's `user` global is never touched).

// Content widths: narrow (<80 columns) is ID/Username/Access (total 40
// with borders), wide adds Last On and Email (total 80).
func userListWidths(w: list of int) {
    w.clear()
    w.add(4)
    w.add(21)
    w.add(5)
    if terminal.columns < 80 { return }
    w.add(17)
    w.add(17)
}

func sendRule(l: BoxPiece, m: BoxPiece, r: BoxPiece, w: list of int) {
    sendDrawing(modem, ruleLine(l, m, r, w))
    modem.send(terminal.eol)
}

func startUserList() {
    user.screen = "userlist"
    listFromId = 1
    drawUserListPage()
}

// Enter (or anything but Q) shows the next page; Q returns to the menu.
func userListInput(input: string) {
    if upperStr(input) == "Q" {
        gotoScreen("sysopusers")
    } else {
        drawUserListPage()
    }
}

func drawUserListPage() {
    var w: list of int
    var span: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(usersDb)
    var pageRows: int = terminal.rows - 8
    var shown: int = 0
    var total: int = 0
    var i: int = 0
    var id: int = 0
    var rec: text
    var more: bool = false

    userListWidths(w)
    // A one-column span the full table width, for the title bar.
    while i < w.count {
        total = total + w[i]
        i = i + 1
    }
    span.add(total + 3 * (w.count - 1))

    sendLine("")
    sendRule(TopLeft, TopCenter, TopRight, span)
    cells.add(center("Users", span[0]))
    sendLine(rowLine(cells, span))
    sendRule(CenterLeft, TopCenter, CenterRight, w)
    cells.clear()
    cells.add("ID")
    cells.add("Username")
    cells.add("Acc")
    if terminal.columns >= 80 {
        cells.add("Last On")
        cells.add("Email")
    }
    sendLine(rowLine(cells, w))
    sendRule(CenterLeft, Center, CenterRight, w)

    id = listFromId
    while id < nextId and shown < pageRows {
        rec = dbFind(usersDb, id)
        if rec.length == userRecordSize {
            cells.clear()
            cells.add(intStr(id))
            cells.add(dbExtractString(rec, uOffName))
            if rec[uOffAccess] == accessSysop {
                cells.add("Sysop")
            } else {
                cells.add("User")
            }
            if terminal.columns >= 80 {
                if rec.intAt(uOffLastSeen) != 0 {
                    cells.add(dateTimeStr(rec.intAt(uOffLastSeen)))
                } else {
                    cells.add("Never")
                }
                cells.add(dbExtractString(rec, uOffEmail))
            }
            sendLine(rowLine(cells, w))
            shown = shown + 1
        }
        id = id + 1
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)

    // Anything left to show? (Skips trailing deleted records.)
    listFromId = id
    while id < nextId {
        rec = dbFind(usersDb, id)
        if rec.length == userRecordSize {
            more = true
            break
        }
        id = id + 1
    }
    if more {
        modem.send("[Enter] More  [Q] Menu > ")
    } else {
        user.screen = "sysopusers"
        displayPrompt()
    }
}

// --- Logoff / hang-up -------------------------------------------------
// The bridge hangs up on "+++" then "ATH", each needing ~1s of line
// silence around it (Hayes guard time), so the sequence is paced by the
// once-a-second timer below.

var hangupPhase: int = 0

func logoff() {
    sendLine("")
    sendLine("Goodbye!")
    user.authenticated = false
    user.screen = "logoff"
    hangupPhase = 1
}

every 30 ticks {
    if hangupPhase > 0 {
        hangupPhase = hangupPhase + 1
        if hangupPhase == 3 { modem.send("+++") }       // ~1s of silence first
        if hangupPhase == 5 {                            // ~1s after +++
            modem.send("ATH\x0D")
            hangupPhase = 0
        }
    }
}

// Called by scanner.cla's feedChar on a full "\r\nCONNECT <n>\r\n".
func connected() {
    isConnected = true
    user = new User          // fresh session: login screen, Line mode
    terminal = new Terminal  // fresh session: 80x24 ASCII, no color
    hangupPhase = 0
    pendingId = 0
    pendingHash = 0
    log("Caller connected.")
    sendLine("Welcome to 68kBBS!")
    sendLine("Type NEW at the login prompt to create an account.")
    displayPrompt()
}

// Called by scanner.cla's feedChar on a full "\r\nNO CARRIER\r\n".
func disconnected() {
    isConnected = false
    hangupPhase = 0
    log("Caller disconnected.")
}

// Append text to the log window, dropping LF (0x0A) -- the Mac newline
// is CR, so CRLF/LF input would otherwise litter the view with boxes.
// ponytail: rebuilds the whole textview text per append; fine until the
// 32,000-byte TextEdit cap nears -- trim oldest lines then.
func appendLog(chunk: text) {
    var m: Main = Main.front
    var filtered: text
    var t: text
    var i: int = 0
    if m == nil { return }
    while i < chunk.length {
        if chunk[i] != '\x0A' { filtered.append(chunk[i]) }
        i = i + 1
    }
    t = m.LogView.text + filtered
    m.LogView.text = t
}

// Every log(...) call lands here (after reaching the diagnostic stream)
// and is appended to the log window.
on App.log(line: string) {
    appendLog(timestamp() + line + "\n")
}

on App.launch {
    open Main
    log("68kBBS starting up.")
    if usersOpen() {
        log("Users database open (" + intStr(userCount()) + " users).")
    } else {
        log("Users database unavailable: " + lastError.message)
    }
    modem.open(serial "modem:9600")
}

on modem.opened {
    log("Modem port open.")
}

on modem.received(data: text) {
    var i: int = 0
    while i < data.length {
        feedChar(data[i])
        i = i + 1
    }
}

on modem.failed(err: error) {
    log("Modem error: " + err.message)
}

extend File {
    on Quit.select {
        usersClose()
        quit
    }
}

extend Main {
    on closed {              // closing the log window exits the app
        usersClose()
        quit
    }
}
