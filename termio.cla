// Connection-facing wrappers over terminal.cla's pure sequence
// builders. Split from terminal.cla so the host-lane tests (which
// cannot compile connection method calls) can include the pure part
// alone.

include "telnet.cla"   // pulls in terminal.cla; provides telnetSend

// No-ops unless the terminal reports color support.

func setColor(conn: connection, color: Color) {
    if not terminal.color { return }
    telnetSend(conn, colorSeq(color))
}

func clearColor(conn: connection) {
    if not terminal.color { return }
    telnetSend(conn, clearColorSeq)
}

func setBackground(conn: connection, color: Color) {
    if not terminal.color { return }
    telnetSend(conn, backgroundSeq(color))
}

func clearBackground(conn: connection) {
    if not terminal.color { return }
    telnetSend(conn, clearBackgroundSeq)
}

// Send a run of box-drawing characters (boxChar/hbar output) as one
// drawing-mode shift, so a whole rule line costs a single SO/SI pair
// on VT100. Translated like every other caller-facing string (PETSCII
// gets its own line graphics here).
func sendDrawing(conn: connection, s: string) {
    telnetSend(conn, translateOut(startDrawing() + s + stopDrawing()))
}
