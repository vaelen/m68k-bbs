// Modem-facing wrappers over terminal.cla's pure sequence builders.
// Split from terminal.cla so the host-lane tests (which cannot compile
// connection method calls) can include the pure part alone.
//
// These send on the global `modem` rather than taking a connection
// parameter: clarusc does not yet implement method calls on a
// connection held in a parameter ("receiver kind 13"), on either
// backend. Restore the (conn: connection, ...) signatures when it does.

include "terminal.cla"

// No-ops unless the terminal reports color support.

func setColor(color: Color) {
    if not terminal.color { return }
    modem.send(colorSeq(color))
}

func clearColor() {
    if not terminal.color { return }
    modem.send(clearColorSeq)
}

func setBackground(color: Color) {
    if not terminal.color { return }
    modem.send(backgroundSeq(color))
}

func clearBackground() {
    if not terminal.color { return }
    modem.send(clearBackgroundSeq)
}
