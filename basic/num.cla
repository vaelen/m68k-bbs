// Num: the BASIC interpreter's software floating point. Clarus has no
// float (int and 16.16 fixed only, and SANE is a Mac-only trap), so
// BASIC numbers are m * 2^e with a 32-bit signed mantissa m normalized
// so |m| is in [2^30, 2^31) -- zero is m = 0, e = 0. That is about 9
// significant digits, a little better than MS BASIC single precision;
// PRINT rounds to 7 digits like GW-BASIC so program output matches.
// Every routine here is pure Clarus and runs on both lanes. Errors are
// abort("Overflow") / abort("Division by zero") / abort("Illegal
// function call"), the BASIC error messages, caught by the
// interpreter's attempt block.

record Num {
    m: int
    e: int
}

const numMaxExp: int = 100      // 2^(100+31) ~ 2.7e39, a hair past MS BASIC's 3.4e38
const numMinExp: int = -160     // below ~1e-39: flush to zero

func numZero(): Num {
    var r: Num
    return r
}

func numIsZero(x: Num): bool { return x.m == 0 }

// Bring m into [2^30, 2^31) by magnitude, adjusting e.
func numNormalize(m: int, e: int): Num {
    var r: Num
    var mm: int = m
    var ee: int = e
    if mm == 0 { return r }
    while mm < 0x40000000 and mm > -0x40000000 {
        mm = mm << 1
        ee = ee - 1
    }
    if ee > numMaxExp { abort("Overflow") }
    if ee < numMinExp { return r }
    r.m = mm
    r.e = ee
    return r
}

func numFromInt(i: int): Num {
    if i == -2147483647 - 1 { return numNormalize(-0x40000000, 1) }
    return numNormalize(i, 0)
}

func numNeg(x: Num): Num {
    var r: Num = x
    r.m = -x.m
    return r
}

func numAbs(x: Num): Num {
    if x.m < 0 { return numNeg(x) }
    return x
}

// Sign-magnitude addition on halved mantissas (so the sum fits in 31
// bits); the smaller operand is shifted down by the exponent gap.
func numAdd(a: Num, b: Num): Num {
    var big: Num
    var small: Num
    var d: int
    var mb: int
    var ms: int
    if a.m == 0 { return b }
    if b.m == 0 { return a }
    if a.e >= b.e {
        big = a
        small = b
    } else {
        big = b
        small = a
    }
    d = big.e - small.e
    if d >= 32 { return big }
    mb = big.m
    ms = small.m
    if mb < 0 { mb = -((-mb) >> 1) } else { mb = mb >> 1 }
    if ms < 0 { ms = -(((-ms) >> 1) >> d) } else { ms = (ms >> 1) >> d }
    return numNormalize(mb + ms, big.e + 1)
}

func numSub(a: Num, b: Num): Num { return numAdd(a, numNeg(b)) }

// The 64-bit mantissa product via 16-bit halves, taken down to a
// normalized 31-bit mantissa with round-to-nearest. The product of two
// normalized mantissas is in [2^60, 2^62), so the result is P >> 30 or
// P >> 31 depending on the top bit.
func numMul(a: Num, b: Num): Num {
    var am: int
    var bm: int
    var ah: int
    var al: int
    var bh: int
    var bl: int
    var hi: int
    var mid1: int
    var mid2: int
    var lo: int
    var t: int
    var k: int
    var p: int
    var rem: int
    var neg: bool
    if a.m == 0 or b.m == 0 { return numZero() }
    neg = (a.m < 0) != (b.m < 0)
    am = a.m
    bm = b.m
    if am < 0 { am = -am }
    if bm < 0 { bm = -bm }
    ah = am >> 16
    al = am & 0xFFFF
    bh = bm >> 16
    bl = bm & 0xFFFF
    hi = ah * bh            // < 2^30
    mid1 = ah * bl          // < 2^31
    mid2 = al * bh          // < 2^31
    lo = al * bl            // < 2^32: may wrap negative, masks keep it right
    // P = hi*2^32 + (mid1+mid2)*2^16 + lo. Dropping 31 bits always
    // fits; if that leaves p below 2^30 (P < 2^61) drop 30 instead so
    // the rounding happens at the normalized precision.
    t = 31
    while true {
        k = t - 16
        p = (hi << (32 - t)) + (mid1 >> k) + (mid2 >> k) + ((lo >> t) & ((1 << (32 - t)) - 1))
        // the dropped bits, in units of 2^16
        rem = (mid1 & ((1 << k) - 1)) + (mid2 & ((1 << k) - 1)) + ((lo & ((1 << t) - 1)) >> 16)
        p = p + (rem >> k)
        if t == 30 or p >= 0x40000000 { break }
        t = 30
    }
    if (rem & ((1 << k) - 1)) >= (1 << (k - 1)) and p != 0x7FFFFFFF { p = p + 1 }
    if neg { p = -p }
    return numNormalize(p, a.e + b.e + t)
}

// Restoring long division on halved mantissas: 31 quotient bits of
// |a.m| / |b.m|, which lies in (0.5, 2).
func numDiv(a: Num, b: Num): Num {
    var rem: int
    var den: int
    var q: int = 0
    var i: int = 0
    var neg: bool
    if b.m == 0 { abort("Division by zero") }
    if a.m == 0 { return numZero() }
    neg = (a.m < 0) != (b.m < 0)
    rem = a.m
    den = b.m
    if rem < 0 { rem = -rem }
    if den < 0 { den = -den }
    rem = rem >> 1
    den = den >> 1
    while i < 31 {
        q = q << 1
        if rem >= den {
            rem = rem - den
            q = q | 1
        }
        rem = rem << 1
        i = i + 1
    }
    if rem >= den and q != 0x7FFFFFFF { q = q + 1 }   // round to nearest
    if neg { q = -q }
    return numNormalize(q, a.e - b.e - 30)
}

// -1, 0, 1. Exact: both operands are normalized, so for two positives
// the larger exponent wins and equal exponents compare mantissas.
func numCmp(a: Num, b: Num): int {
    var an: bool = a.m < 0
    var bn: bool = b.m < 0
    var r: int
    if a.m == 0 and b.m == 0 { return 0 }
    if a.m == 0 { if bn { return 1 } else { return -1 } }
    if b.m == 0 { if an { return -1 } else { return 1 } }
    if an != bn { if an { return -1 } else { return 1 } }
    // same sign: compare magnitudes
    if a.e != b.e {
        if a.e > b.e { r = 1 } else { r = -1 }
    } else if a.m == b.m {
        return 0
    } else if a.m > b.m {
        r = 1
    } else {
        r = -1
    }
    if an { r = -r }
    return r
}

// Truncate toward zero. Aborts "Overflow" outside the int range.
func numToInt(x: Num): int {
    var shift: int
    if x.m == 0 { return 0 }
    if x.e > 0 {
        if x.e == 1 and x.m == -0x40000000 { return -2147483647 - 1 }
        abort("Overflow")
    }
    if x.e == 0 { return x.m }
    shift = -x.e
    if shift > 31 { return 0 }
    if x.m < 0 { return -((-x.m) >> shift) }
    return x.m >> shift
}

func numIsInt(x: Num): bool {
    var shift: int
    var mag: int
    if x.m == 0 { return true }
    if x.e >= 0 { return true }
    shift = -x.e
    if shift > 31 { return false }
    mag = x.m
    if mag < 0 { mag = -mag }
    return (mag & ((1 << shift) - 1)) == 0
}

// Largest integer <= x (BASIC's INT).
func numFloor(x: Num): Num {
    var t: Num
    if numIsInt(x) { return x }
    t = numFromInt(numToInt(x))
    if x.m < 0 { return numSub(t, numFromInt(1)) }
    return t
}

func numIntPart(x: Num): int { return numToInt(numFloor(x)) }

// Nearest integer, halves away from zero.
func numRound(x: Num): Num {
    var half: Num
    var r: Num
    half.m = 0x40000000
    half.e = -31
    r = numFloor(numAdd(numAbs(x), half))
    if x.m < 0 { return numNeg(r) }
    return r
}

// --- Decimal conversion ------------------------------------------------

func numTen(): Num { return numFromInt(10) }

// 10^k by squaring; negative k divides.
func numPow10(k: int): Num {
    var r: Num = numFromInt(1)
    var b: Num = numTen()
    var kk: int = k
    if kk < 0 { return numDiv(numFromInt(1), numPow10(-kk)) }
    while kk > 0 {
        if (kk & 1) != 0 { r = numMul(r, b) }
        kk = kk >> 1
        if kk > 0 { b = numMul(b, b) }
    }
    return r
}

// x * 10^k, applied in chunks so a large |k| never builds an
// intermediate power that overflows on its own.
func numMulPow10(x: Num, k: int): Num {
    var r: Num = x
    var kk: int = k
    while kk > 30 {
        r = numMul(r, numPow10(30))
        kk = kk - 30
    }
    while kk < -30 {
        r = numDiv(r, numPow10(30))
        kk = kk + 30
    }
    // divide for negative k: 225 / 100 is exact where 225 * (1/100) is not
    if kk < 0 { return numDiv(r, numPow10(-kk)) }
    if kk > 0 { r = numMul(r, numPow10(kk)) }
    return r
}

// Index just past the text the last numParsePrefix/numParse consumed.
var numParseEnd: int = 0

func numDigit(c: char): int {
    if c >= '0' and c <= '9' { return int(c) - int('0') }
    return -1
}

// Parse the longest numeric prefix of s after leading blanks:
// [-+]digits[.digits][E[-+]digits], or &H/&O integers. Sets numParseEnd;
// nothing parsed gives zero with numParseEnd at the first non-blank.
func numParsePrefix(s: string): Num {
    var i: int = 0
    var acc: int = 0
    var dropped: int = 0
    var frac: int = 0
    var exp: int = 0
    var expNeg: bool = false
    var neg: bool = false
    var digits: int = 0
    var d: int
    var j: int
    var r: Num
    var c: char
    while i < s.length and (s[i] == ' ' or s[i] == '\x09') { i = i + 1 }
    numParseEnd = i
    if i + 1 < s.length and s[i] == '&' {
        c = s[i + 1]
        if c == 'H' or c == 'h' {
            j = i + 2
            while j < s.length {
                c = s[j]
                d = numDigit(c)
                if d < 0 and c >= 'A' and c <= 'F' { d = int(c) - int('A') + 10 }
                if d < 0 and c >= 'a' and c <= 'f' { d = int(c) - int('a') + 10 }
                if d < 0 { break }
                acc = (acc << 4) | d
                j = j + 1
            }
            numParseEnd = j
            return numFromInt(acc)
        }
        if c == 'O' or c == 'o' {
            j = i + 2
            while j < s.length {
                d = numDigit(s[j])
                if d < 0 or d > 7 { break }
                acc = (acc << 3) | d
                j = j + 1
            }
            numParseEnd = j
            return numFromInt(acc)
        }
    }
    if i < s.length and (s[i] == '-' or s[i] == '+') {
        neg = s[i] == '-'
        i = i + 1
    }
    while i < s.length {
        d = numDigit(s[i])
        if d < 0 { break }
        if acc < 100000000 { acc = acc * 10 + d } else { dropped = dropped + 1 }
        digits = digits + 1
        i = i + 1
    }
    if i < s.length and s[i] == '.' {
        i = i + 1
        while i < s.length {
            d = numDigit(s[i])
            if d < 0 { break }
            if acc < 100000000 {
                acc = acc * 10 + d
                frac = frac + 1
            }
            digits = digits + 1
            i = i + 1
        }
    }
    if digits == 0 { return r }
    if i < s.length and (s[i] == 'E' or s[i] == 'e' or s[i] == 'D' or s[i] == 'd') {
        j = i + 1
        if j < s.length and (s[j] == '-' or s[j] == '+') {
            expNeg = s[j] == '-'
            j = j + 1
        }
        if j < s.length and numDigit(s[j]) >= 0 {
            while j < s.length and numDigit(s[j]) >= 0 {
                if exp < 1000 { exp = exp * 10 + numDigit(s[j]) }
                j = j + 1
            }
            if expNeg { exp = -exp }
            i = j
        }
    }
    numParseEnd = i
    exp = exp - frac + dropped
    if acc == 0 { return r }
    if exp > 60 { abort("Overflow") }
    if exp < -60 { return r }
    r = numMulPow10(numFromInt(acc), exp)
    if neg { r = numNeg(r) }
    return r
}

// The whole string (blanks aside) must be a number: BASIC's numeric
// input conversion. Aborts "Type mismatch" otherwise.
func numParse(s: string): Num {
    var r: Num = numParsePrefix(s)
    var i: int = numParseEnd
    var start: int = 0
    while start < s.length and (s[start] == ' ' or s[start] == '\x09') { start = start + 1 }
    if i == start { abort("Type mismatch") }
    while i < s.length {
        if s[i] != ' ' and s[i] != '\x09' { abort("Type mismatch") }
        i = i + 1
    }
    return r
}

// GW-BASIC single-precision PRINT form: 7 significant digits, a
// leading space for non-negative values (or "-"), no point on integral
// values, no zero before the point, E notation at 1E+07 and below
// 1E-04. PRINT adds its own trailing space.
func numStr(x: Num): string {
    var ax: Num
    var y: Num
    var d: int
    var digits: int
    var ds: string
    var r: string
    var i: int
    var intDigits: int
    if x.m == 0 { return " 0" }
    ax = numAbs(x)
    // decimal exponent estimate from the binary one, then exact adjust
    d = (ax.e + 31) * 30103
    if d < 0 { d = -((-d + 99999) / 100000) } else { d = d / 100000 }
    while d < 38 and numCmp(ax, numPow10(d + 1)) >= 0 { d = d + 1 }
    while numCmp(ax, numPow10(d)) < 0 { d = d - 1 }
    // scale to a 7-digit integer and round
    y = numMulPow10(ax, 6 - d)
    digits = numToInt(numRound(y))
    if digits >= 10000000 {
        digits = 1000000
        d = d + 1
    }
    ds = string(digits)
    while ds.length > 1 and ds[ds.length - 1] == '0' { ds = ds[0, ds.length - 1] }
    if d >= 7 or d <= -5 {
        r = ds[0, 1]
        if ds.length > 1 { r = r + "." + ds[1, ds.length - 1] }
        r = r + "E"
        if d < 0 { r = r + "-" } else { r = r + "+" }
        i = d
        if i < 0 { i = -i }
        if i < 10 { r = r + "0" }
        r = r + string(i)
    } else if d >= 0 {
        intDigits = d + 1
        if ds.length <= intDigits {
            r = ds
            while r.length < intDigits { r = r + "0" }
        } else {
            r = ds[0, intDigits] + "." + ds[intDigits, ds.length - intDigits]
        }
    } else {
        r = "."
        i = -d - 1
        while i > 0 {
            r = r + "0"
            i = i - 1
        }
        r = r + ds
    }
    if x.m < 0 { return "-" + r }
    return " " + r
}

// --- Transcendental functions ------------------------------------------
// Series after range reduction; accurate to a few units in the 9th
// digit, well past the 7 PRINT shows.

var numConstsReady: bool = false
var numLn2V: Num
var numPiV: Num

func numConsts() {
    if numConstsReady { return }
    numLn2V = numParse("0.69314718056")
    numPiV = numParse("3.14159265359")
    numConstsReady = true
}

func numPi(): Num {
    numConsts()
    return numPiV
}

func numHalve(x: Num): Num {
    var r: Num = x
    if x.m == 0 { return x }
    r.e = x.e - 1
    if r.e < numMinExp { return numZero() }
    return r
}

func numSqrt(x: Num): Num {
    var y: Num
    var i: int = 0
    if x.m < 0 { abort("Illegal function call") }
    if x.m == 0 { return x }
    y = numNormalize(0x40000000, (x.e + 31) / 2 - 30)   // ~2^((e+31)/2)
    while i < 7 {
        y = numHalve(numAdd(y, numDiv(x, y)))
        i = i + 1
    }
    return y
}

func numExp(x: Num): Num {
    var k: int
    var r: Num
    var term: Num
    var sum: Num
    var i: int = 1
    numConsts()
    if x.m == 0 { return numFromInt(1) }
    if numCmp(x, numFromInt(91)) > 0 { abort("Overflow") }
    if numCmp(x, numFromInt(-110)) < 0 { return numZero() }
    k = numToInt(numRound(numDiv(x, numLn2V)))
    r = numSub(x, numMul(numFromInt(k), numLn2V))      // |r| <= ln2/2
    term = numFromInt(1)
    sum = numFromInt(1)
    while i < 16 {
        term = numDiv(numMul(term, r), numFromInt(i))
        sum = numAdd(sum, term)
        i = i + 1
    }
    return numNormalize(sum.m, sum.e + k)
}

func numLog(x: Num): Num {
    var m: Num
    var z: Num
    var z2: Num
    var term: Num
    var sum: Num
    var i: int = 3
    numConsts()
    if x.m <= 0 { abort("Illegal function call") }
    m.m = x.m
    m.e = -31                                           // [0.5, 1)
    z = numDiv(numSub(m, numFromInt(1)), numAdd(m, numFromInt(1)))   // [-1/3, 0)
    z2 = numMul(z, z)
    term = z
    sum = z
    while i < 27 {
        term = numMul(term, z2)
        sum = numAdd(sum, numDiv(term, numFromInt(i)))
        i = i + 2
    }
    return numAdd(numMul(sum, numFromInt(2)), numMul(numFromInt(x.e + 31), numLn2V))
}

// Reduce to [-pi/2, pi/2] then Taylor.
func numSin(x: Num): Num {
    var twoPi: Num
    var halfPi: Num
    var r: Num
    var r2: Num
    var term: Num
    var sum: Num
    var i: int = 3
    numConsts()
    if x.m == 0 { return x }
    twoPi = numMul(numPiV, numFromInt(2))
    halfPi = numHalve(numPiV)
    r = numSub(x, numMul(numFloor(numDiv(x, twoPi)), twoPi))   // [0, 2pi)
    if numCmp(r, numPiV) > 0 { r = numSub(r, twoPi) }         // [-pi, pi]
    if numCmp(r, halfPi) > 0 { r = numSub(numPiV, r) }
    if numCmp(r, numNeg(halfPi)) < 0 { r = numSub(numNeg(numPiV), r) }
    r2 = numMul(r, r)
    term = r
    sum = r
    while i < 19 {
        term = numNeg(numDiv(numMul(term, r2), numFromInt(i * (i - 1))))
        sum = numAdd(sum, term)
        i = i + 2
    }
    return sum
}

func numCos(x: Num): Num {
    numConsts()
    return numSin(numAdd(x, numHalve(numPiV)))
}

func numTan(x: Num): Num {
    return numDiv(numSin(x), numCos(x))
}

// atn on [0, 1] after 1/x and two half-angle reductions.
func numAtn(x: Num): Num {
    var neg: bool = x.m < 0
    var invert: bool = false
    var a: Num = numAbs(x)
    var one: Num = numFromInt(1)
    var a2: Num
    var term: Num
    var sum: Num
    var i: int = 3
    numConsts()
    if a.m == 0 { return a }
    if numCmp(a, one) > 0 {
        invert = true
        a = numDiv(one, a)
    }
    a = numDiv(a, numAdd(one, numSqrt(numAdd(one, numMul(a, a)))))
    a = numDiv(a, numAdd(one, numSqrt(numAdd(one, numMul(a, a)))))   // <= tan(pi/16) ~ .2
    a2 = numMul(a, a)
    term = a
    sum = a
    while i < 19 {
        term = numNeg(numMul(term, a2))
        sum = numAdd(sum, numDiv(term, numFromInt(i)))
        i = i + 2
    }
    sum = numMul(sum, numFromInt(4))
    if invert { sum = numSub(numHalve(numPiV), sum) }
    if neg { return numNeg(sum) }
    return sum
}

// a ^ b: integer exponents by squaring, otherwise exp(b * log a).
func numPow(a: Num, b: Num): Num {
    var r: Num = numFromInt(1)
    var base: Num = a
    var n: int
    if b.m == 0 { return r }
    if a.m == 0 {
        if b.m < 0 { abort("Division by zero") }
        return a
    }
    if numIsInt(b) and b.e < 0 {          // |b| < 2^30
        n = numToInt(b)
        if n < 0 { n = -n }
        while n > 0 {
            if (n & 1) != 0 { r = numMul(r, base) }
            n = n >> 1
            if n > 0 { base = numMul(base, base) }
        }
        if b.m < 0 { return numDiv(numFromInt(1), r) }
        return r
    }
    if a.m < 0 { abort("Illegal function call") }
    return numExp(numMul(b, numLog(a)))
}
