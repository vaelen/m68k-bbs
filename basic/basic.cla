// A GW-BASIC-flavored BASIC interpreter. Decoupled from the BBS: it
// talks to its host only through four hook functions the including
// program defines, and an API the host drives (docs/basic.md,
// basic/langref.md). Nothing here touches connections, terminals or
// the BBS.
//
// Hooks the including program must define:
//   basicOut(s: string)                       -- every byte of output;
//                                                "\n" (CR) ends lines
//   basicScreen(op: char, a: int, b: int)     -- 'C' CLS, 'L' LOCATE
//                                                row a col b (0 = keep),
//                                                'K' COLOR fg a bg b
//                                                (-1 = keep), 'B' BEEP
//   basicPath(name: string, write: bool): string
//                                             -- a bare BASIC file name
//                                                to a real path in the
//                                                host's sandbox; "" refuses;
//                                                name "" = the folder
//   basicEnv(name: string): string            -- ENVIRON$; "" if unknown
//
// API: basicNew, basicLoad, basicRun, basicPrompt, basicStep,
// basicLine, basicKey, basicStop, and the state basicState. The
// interpreter never blocks: INPUT parks it in BWaitLine and the host
// calls basicLine with the answer.
//
// Design: the source is kept per line; RUN tokenizes it into one flat
// token list (no AST -- MS BASIC itself interpreted by scanning
// tokens) and the program counter is a token index. Every error is an
// abort caught by basicStep.

include "num.cla"

// --- State ---------------------------------------------------------------

enum BasicState { BIdle, BRunning, BWaitLine, BWaitKey, BSleeping, BPrompt, BDone }

var basicState: BasicState = BIdle
var basicWidth: int = 80          // PRINT wraps here; WIDTH n changes it
var basicSleepInstant: bool = false   // tests: SLEEP returns at once
var basicFixedSeed: int = 0       // tests: RANDOMIZE uses this seed when nonzero

// --- Source store --------------------------------------------------------
// One text per line, keyed by line number, plus the numbers in order.

var srcLines: intmap of text
var srcNumbers: list of int

// Replace, insert, or (empty s) delete line n.
func srcSetText(n: int, t: text) {
    var i: int = 0
    var j: int
    if t.length == 0 {
        if not srcLines.has(n) { return }
        srcLines.remove(n)
        while i < srcNumbers.count {
            if srcNumbers[i] == n {
                srcNumbers.remove(i)
                return
            }
            i = i + 1
        }
        return
    }
    if not srcLines.has(n) {
        // keep srcNumbers sorted: append, then bubble down into place
        srcNumbers.add(n)
        j = srcNumbers.count - 1
        while j > 0 and srcNumbers[j - 1] > n {
            srcNumbers[j] = srcNumbers[j - 1]
            j = j - 1
        }
        srcNumbers[j] = n
    }
    srcLines[n] = t
}

func srcSet(n: int, s: string) {
    var t: text = s
    srcSetText(n, t)
}

func srcClear() {
    srcLines.clear()
    srcNumbers.clear()
}

func srcLineStr(n: int): string {
    var t: text = srcLines[n]
    if t.length > 255 { return t[0, 255] }
    return t[0, t.length]
}

// LIST a-b through basicOut, one source line per output line.
func srcListRange(a: int, b: int) {
    var i: int = 0
    var n: int
    var t: text
    var j: int
    while i < srcNumbers.count {
        n = srcNumbers[i]
        i = i + 1
        if n < a or n > b { continue }
        basicOut(string(n) + " ")
        t = srcLines[n]
        j = 0
        while j + 200 < t.length {
            basicOut(t[j, 200])
            j = j + 200
        }
        basicOut(t[j, t.length - j])
        basicOut("\n")
    }
}

// Replace the program from source text: CR, LF or CRLF line ends;
// numbered lines keep their numbers, unnumbered ones get previous + 1
// (10 for the first). A collision prints a message and fails.
func basicLoad(src: text): bool {
    var i: int = 0
    var start: int
    var line: text
    var n: int
    var last: int = 0
    var k: int
    var hasNumber: bool
    var c: char
    srcClear()
    while i <= src.length {
        start = i
        while i < src.length and src[i] != '\x0D' and src[i] != '\x0A' { i = i + 1 }
        line = src.textAt(start, i - start)
        // consume the line end (CRLF counts once)
        if i < src.length {
            if src[i] == '\x0D' and i + 1 < src.length and src[i + 1] == '\x0A' { i = i + 1 }
            i = i + 1
        } else {
            i = i + 1
        }
        k = 0
        while k < line.length and (line[k] == ' ' or line[k] == '\x09') { k = k + 1 }
        if k >= line.length { continue }
        hasNumber = false
        n = 0
        while k < line.length and line[k] >= '0' and line[k] <= '9' {
            n = n * 10 + int(line[k]) - int('0')
            hasNumber = true
            k = k + 1
        }
        if hasNumber {
            if k < line.length and line[k] == ' ' { k = k + 1 }
        } else {
            if last == 0 { n = 10 } else { n = last + 1 }
        }
        if srcLines.has(n) {
            basicOut("Duplicate line number " + string(n) + "\n")
            srcClear()
            return false
        }
        line = line.textAt(k, line.length - k)
        if hasNumber and line.length == 0 { continue }   // "10" alone deletes; nothing to delete
        srcSetText(n, line)
        last = n
    }
    return true
}

// --- Tokens --------------------------------------------------------------

enum TokKind { TLine, TNum, TStr, TId, TKw, TOp, TEnd }

record Tok {
    kind: TokKind
    ival: int        // line number / pool index / name id / keyword id / op code
    aux: int         // K_DATA: index into dataText
    num: Num         // TNum
}

// Two-character operators get codes above any char.
const O_LE: int = 256
const O_GE: int = 257
const O_NE: int = 258

