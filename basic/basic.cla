func keywordId(w: string): int {
    switch w {
    case "PRINT" { return K_PRINT }
    case "INPUT" { return K_INPUT }
    case "LET" { return K_LET }
    case "IF" { return K_IF }
    case "THEN" { return K_THEN }
    case "ELSE" { return K_ELSE }
    case "FOR" { return K_FOR }
    case "TO" { return K_TO }
    case "STEP" { return K_STEP }
    case "NEXT" { return K_NEXT }
    case "WHILE" { return K_WHILE }
    case "WEND" { return K_WEND }
    case "GOTO" { return K_GOTO }
    case "GOSUB" { return K_GOSUB }
    case "RETURN" { return K_RETURN }
    case "ON" { return K_ON }
    case "DIM" { return K_DIM }
    case "OPTION" { return K_OPTION }
    case "BASE" { return K_BASE }
    case "DEF" { return K_DEF }
    case "DEFINT" { return K_DEFINT }
    case "DEFSNG" { return K_DEFSNG }
    case "DEFDBL" { return K_DEFDBL }
    case "DEFSTR" { return K_DEFSTR }
    case "DATA" { return K_DATA }
    case "READ" { return K_READ }
    case "RESTORE" { return K_RESTORE }
    case "REM" { return K_REM }
    case "END" { return K_END }
    case "STOP" { return K_STOP }
    case "SWAP" { return K_SWAP }
    case "RANDOMIZE" { return K_RANDOMIZE }
    case "SLEEP" { return K_SLEEP }
    case "CLS" { return K_CLS }
    case "LOCATE" { return K_LOCATE }
    case "COLOR" { return K_COLOR }
    case "WIDTH" { return K_WIDTH }
    case "BEEP" { return K_BEEP }
    case "CLEAR" { return K_CLEAR }
    case "SYSTEM" { return K_SYSTEM }
    case "OPEN" { return K_OPEN }
    case "CLOSE" { return K_CLOSE }
    case "WRITE" { return K_WRITE }
    case "LINE" { return K_LINE }
    case "AS" { return K_AS }
    case "OUTPUT" { return K_OUTPUT }
    case "APPEND" { return K_APPEND }
    case "RUN" { return K_RUN }
    case "LIST" { return K_LIST }
    case "NEW" { return K_NEW }
    case "LOAD" { return K_LOAD }
    case "SAVE" { return K_SAVE }
    case "FILES" { return K_FILES }
    case "DELETE" { return K_DELETE }
    case "CONT" { return K_CONT }
    case "USING" { return K_USING }
    case "ERROR" { return K_ERROR }
    case "AND" { return K_AND }
    case "OR" { return K_OR }
    case "NOT" { return K_NOT }
    case "XOR" { return K_XOR }
    case "EQV" { return K_EQV }
    case "IMP" { return K_IMP }
    case "MOD" { return K_MOD }
    case "ABS" { return K_ABS }
    case "SGN" { return K_SGN }
    case "INT" { return K_INT }
    case "FIX" { return K_FIX }
    case "SQR" { return K_SQR }
    case "SIN" { return K_SIN }
    case "COS" { return K_COS }
    case "TAN" { return K_TAN }
    case "ATN" { return K_ATN }
    case "EXP" { return K_EXP }
    case "LOG" { return K_LOG }
    case "RND" { return K_RND }
    case "TIMER" { return K_TIMER }
    case "LEN" { return K_LEN }
    case "LEFT$" { return K_LEFTS }
    case "RIGHT$" { return K_RIGHTS }
    case "MID$" { return K_MIDS }
    case "INSTR" { return K_INSTR }
    case "STR$" { return K_STRS }
    case "VAL" { return K_VAL }
    case "CHR$" { return K_CHRS }
    case "ASC" { return K_ASC }
    case "SPACE$" { return K_SPACES }
    case "STRING$" { return K_STRINGS }
    case "UCASE$" { return K_UCASES }
    case "LCASE$" { return K_LCASES }
    case "LTRIM$" { return K_LTRIMS }
    case "RTRIM$" { return K_RTRIMS }
    case "HEX$" { return K_HEXS }
    case "OCT$" { return K_OCTS }
    case "INKEY$" { return K_INKEYS }
    case "POS" { return K_POS }
    case "CSRLIN" { return K_CSRLIN }
    case "ENVIRON$" { return K_ENVIRONS }
    case "EOF" { return K_EOF }
    case "FRE" { return K_FRE }
    case "TAB" { return K_TAB }
    case "SPC" { return K_SPC }
    case "CINT" { return K_CINT }
    case "CSNG" { return K_CSNG }
    case "CDBL" { return K_CDBL }
    case "SCREEN" { return K_SCREEN }
    case "PSET" { return K_PSET }
    case "PRESET" { return K_PRESET }
    case "CIRCLE" { return K_CIRCLE }
    case "PAINT" { return K_PAINT }
    case "DRAW" { return K_DRAW }
    case "GET" { return K_GET }
    case "PUT" { return K_PUT }
    case "PLAY" { return K_PLAY }
    case "SOUND" { return K_SOUND }
    case "LPRINT" { return K_LPRINT }
    case "LLIST" { return K_LLIST }
    case "PEEK" { return K_PEEK }
    case "POKE" { return K_POKE }
    case "INP" { return K_INP }
    case "OUT" { return K_OUT }
    case "CALL" { return K_CALL }
    case "USR" { return K_USR }
    case "FIELD" { return K_FIELD }
    case "LSET" { return K_LSET }
    case "RSET" { return K_RSET }
    case "CHAIN" { return K_CHAIN }
    case "COMMON" { return K_COMMON }
    case "RESUME" { return K_RESUME }
    case "ERR" { return K_ERR }
    case "ERL" { return K_ERL }
    case "VIEW" { return K_VIEW }
    case "WINDOW" { return K_WINDOW }
    case "PALETTE" { return K_PALETTE }
    case "KEY" { return K_KEY }
    case "SEG" { return K_SEG }
    case "WAIT" { return K_WAIT }
    case "VARPTR" { return K_VARPTR }
    }
    return 0
}

var prog: list of Tok             // the tokenized program
var lineIndex: intmap of int      // line number -> index of its TLine
var labels: map of int            // LABEL -> line number
var names: list of string         // interned variable names (with suffix)
var nameIds: map of int
var strPool: list of string       // string literals
var dataText: list of string      // raw text of every DATA statement
var dataLine: list of int         // ... and the line each is on

func internName(w: string): int {
    var id: int
    if nameIds.has(w) { return nameIds[w] }
    id = names.count
    names.add(w)
    nameIds[w] = id
    return id
}

func upperChar(c: char): char {
    if c >= 'a' and c <= 'z' { return char(int(c) - 32) }
    return c
}

func isLetter(c: char): bool {
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')
}

func isDigitChar(c: char): bool { return c >= '0' and c <= '9' }

// Scanner state for the line being tokenized.
var tkSrc: text
var tkPos: int = 0
var tkLine: int = 0
var tkOut: list of Tok
var tkLineStart: int = 0      // tkOut index of the current line's TLine

func tkEmit(kind: TokKind, ival: int) {
    var t: Tok
    t.kind = kind
    t.ival = ival
    tkOut.add(t)
}

func tkEmitNum(v: Num) {
    var t: Tok
    t.kind = TNum
    t.num = v
    tkOut.add(t)
}

// Glue keywords that crunched code runs into a number: 1TO9, GOTO10.
func splitsBeforeDigit(w: string): int {
    var k: int = keywordId(w)
    if k == K_TO or k == K_THEN or k == K_ELSE or k == K_GOTO or k == K_GOSUB or k == K_STEP { return k }
    return 0
}

func tkStatementEnd(): bool {
    var n: int = tkOut.count
    if n == 0 { return true }
    if tkOut[n - 1].kind == TLine { return true }
    if tkOut[n - 1].kind == TOp and tkOut[n - 1].ival == int(':') { return true }
    if tkOut[n - 1].kind == TKw and (tkOut[n - 1].ival == K_THEN or tkOut[n - 1].ival == K_ELSE) { return true }
    return false
}

// Raw text after DATA up to an unquoted ':' or the end of the line.
func tkScanData() {
    var start: int = tkPos
    var inQuote: bool = false
    var s: string
    while tkPos < tkSrc.length {
        if tkSrc[tkPos] == '"' { inQuote = not inQuote }
        if tkSrc[tkPos] == ':' and not inQuote { break }
        tkPos = tkPos + 1
    }
    while start < tkPos and tkSrc[start] == ' ' { start = start + 1 }
    if tkPos - start > 255 { s = tkSrc[start, 255] } else { s = tkSrc[start, tkPos - start] }
    tkOut[tkOut.count - 1].aux = dataText.count
    dataText.add(s)
    dataLine.add(tkLine)
}

func tkWord() {
    var start: int = tkPos
    var w: string
    var k: int
    var i: int
    var c: char
    var pre: string
    while tkPos < tkSrc.length and (isLetter(tkSrc[tkPos]) or isDigitChar(tkSrc[tkPos]) or tkSrc[tkPos] == '.') {
        tkPos = tkPos + 1
    }
    if tkPos < tkSrc.length {
        c = tkSrc[tkPos]
        if c == '$' or c == '%' or c == '!' or c == '#' or c == '&' { tkPos = tkPos + 1 }
    }
    i = start
    while i < tkPos {
        w = w + upperChar(tkSrc[i])
        i = i + 1
    }
    k = keywordId(w)
    if k == 0 {
        // a keyword glued to a following number: TO9, GOTO10
        i = 0
        while i < w.length and isLetter(w[i]) { i = i + 1 }
        if i < w.length and i > 0 and isDigitChar(w[i]) {
            pre = w[0, i]
            k = splitsBeforeDigit(pre)
            if k != 0 {
                tkPos = start + i
                tkEmit(TKw, k)
                return
            }
        }
        // a label: WORD: at the start of the line
        if tkOut.count == tkLineStart + 1 and tkPos < tkSrc.length and tkSrc[tkPos] == ':' and w[w.length - 1] != '$' {
            labels[w] = tkLine
            tkPos = tkPos + 1
            return
        }
        tkEmit(TId, internName(w))
        return
    }
    if k == K_REM {
        tkEmit(TKw, K_REM)
        tkPos = tkSrc.length
        return
    }
    tkEmit(TKw, k)
    if k == K_DATA { tkScanData() }
}

func tkString() {
    var s: string
    tkPos = tkPos + 1
    while tkPos < tkSrc.length and tkSrc[tkPos] != '"' {
        if s.length < 255 { s = s + tkSrc[tkPos] }
        tkPos = tkPos + 1
    }
    if tkPos < tkSrc.length { tkPos = tkPos + 1 }
    tkEmit(TStr, strPool.count)
    strPool.add(s)
}

func tkNumber() {
    var s: string
    var n: int = tkSrc.length - tkPos
    if n > 40 { n = 40 }
    s = tkSrc[tkPos, n]
    tkEmitNum(numParsePrefix(s))
    tkPos = tkPos + numParseEnd
}

func tokenizeText(t: text, lineNo: int, out: list of Tok) {
    var c: char
    var c2: char
    tkSrc = t
    tkPos = 0
    tkLine = lineNo
    tkOut = out
    tkLineStart = tkOut.count
    tkEmit(TLine, lineNo)
    while tkPos < tkSrc.length {
        c = tkSrc[tkPos]
        if c == ' ' or c == '\x09' {
            tkPos = tkPos + 1
        } else if isLetter(c) {
            tkWord()
        } else if isDigitChar(c) or (c == '.' and tkPos + 1 < tkSrc.length and isDigitChar(tkSrc[tkPos + 1])) {
            tkNumber()
        } else if c == '&' and tkPos + 1 < tkSrc.length and (upperChar(tkSrc[tkPos + 1]) == 'H' or upperChar(tkSrc[tkPos + 1]) == 'O') {
            tkNumber()
        } else if c == '"' {
            tkString()
        } else if c == '\'' {
            tkEmit(TKw, K_REM)
            tkPos = tkSrc.length
        } else if c == '?' {
            tkEmit(TKw, K_PRINT)
            tkPos = tkPos + 1
        } else {
            c2 = ' '
            if tkPos + 1 < tkSrc.length { c2 = tkSrc[tkPos + 1] }
            if (c == '<' and c2 == '=') or (c == '=' and c2 == '<') {
                tkEmit(TOp, O_LE)
                tkPos = tkPos + 2
            } else if (c == '>' and c2 == '=') or (c == '=' and c2 == '>') {
                tkEmit(TOp, O_GE)
                tkPos = tkPos + 2
            } else if (c == '<' and c2 == '>') or (c == '>' and c2 == '<') {
                tkEmit(TOp, O_NE)
                tkPos = tkPos + 2
            } else {
                tkEmit(TOp, int(c))
                tkPos = tkPos + 1
            }
        }
    }
    tkEmit(TEnd, 0)
}

func tokenizeLine(s: string, lineNo: int, out: list of Tok) {
    var t: text = s
    tokenizeText(t, lineNo, out)
}

// RUN: the whole source into prog, one TEnd at the end.
func tokenizeProgram() {
    var i: int = 0
    var n: int
    prog.clear()
    lineIndex.clear()
    labels.clear()
    names.clear()
    nameIds.clear()
    strPool.clear()
    dataText.clear()
    dataLine.clear()
    while i < srcNumbers.count {
        n = srcNumbers[i]
        lineIndex[n] = prog.count
        tokenizeText(srcLines[n], n, prog)
        prog.pop()                      // each line's own TEnd
        i = i + 1
    }
    tkOut = prog
    tkEmit(TEnd, 0)
}

// --- Values and variables ---------------------------------------------

record Val {
    isStr: bool
    n: Num
    s: string
}

func valNum(n: Num): Val {
    var v: Val
    v.n = n
    return v
}

func valStr(s: string): Val {
    var v: Val
    v.isStr = true
    v.s = s
    return v
}

func valInt(i: int): Val { return valNum(numFromInt(i)) }

func needNum(v: Val): Num {
    if v.isStr { abort("Type mismatch") }
    return v.n
}

func needStr(v: Val): string {
    if not v.isStr { abort("Type mismatch") }
    return v.s
}

// Nearest int with ties to even, as GW-BASIC's CINT converts arguments.
func numCint(n: Num): Num {
    var r: Num = numRound(n)
    var frac: Num = numSub(numAbs(n), numFloor(numAbs(n)))
    if numCmp(frac, numNormalize(0x40000000, -31)) == 0 and (numToInt(r) & 1) != 0 {
        if r.m < 0 { r = numAdd(r, numFromInt(1)) } else { r = numSub(r, numFromInt(1)) }
    }
    return r
}

func numAsInt(n: Num): int { return numToInt(numCint(n)) }

var nums: map of Num
var strs: map of string
var defTypes: char[26]        // implied suffix per initial letter; 0 = none

record ArrayInfo {
    lower: int          // OPTION BASE
    dims: int
    d0: int
    d1: int
    d2: int
    isStr: bool
    heap: int           // first slot in anums / astrs
}

var arrays: map of ArrayInfo
var anums: list of Num
var astrs: list of string
var optionBase: int = 0

func isStrKey(key: string): bool { return key[key.length - 1] == '$' }
func isIntKey(key: string): bool { return key[key.length - 1] == '%' }

// The variable key for a name id: the name with its suffix, or the
// DEFtype-implied suffix when it has none.
func varKey(id: int): string {
    var name: string = names[id]
    var last: char = name[name.length - 1]
    var d: char
    if last == '$' or last == '%' { return name }
    if last == '!' or last == '#' or last == '&' { return name }
    d = defTypes[int(name[0]) - int('A')]
    if d == '$' { return name + "$" }
    if d == '%' { return name + "%" }
    return name
}

// (assigned to locals first: the 68k backend can't return a map get)
func getNum(key: string): Num {
    var v: Num = nums.get(key, numZero())
    return v
}

func getStr(key: string): string {
    var v: string = strs.get(key, "")
    return v
}

func storeNum(key: string, v: Num) {
    var r: Num = v
    if isIntKey(key) {
        r = numCint(v)
        if numCmp(numAbs(r), numFromInt(32767)) > 0 { abort("Overflow") }
    }
    nums[key] = r
}

func storeVal(key: string, v: Val) {
    if isStrKey(key) {
        strs[key] = needStr(v)
    } else {
        storeNum(key, needNum(v))
    }
}

func clearVars() {
    var i: int = 0
    nums.clear()
    strs.clear()
    arrays.clear()
    anums.clear()
    astrs.clear()
    optionBase = 0
    while i < 26 {
        defTypes[i] = char(0)
        i = i + 1
    }
}

// --- Execution state --------------------------------------------------

var cur: list of Tok          // the list being executed: prog or immed
var pc: int = 0
var runLine: int = 0          // current line for error messages (0 = immediate)
var fromPrompt: bool = false  // RUN started from the Ok prompt: errors return there
var cursorCol: int = 0
var cursorRow: int = 1
var outBytes: int = 0         // output emitted during this basicStep
var contPc: int = -1
var sleepUntil: int = 0
var fileCol: int = 0          // column within the file for PRINT # zones

// --- Token access -----------------------------------------------------

func tok(): Tok {
    if pc >= cur.count { return cur[cur.count - 1] }
    return cur[pc]
}

func isOp(c: char): bool {
    var t: Tok = tok()
    return t.kind == TOp and t.ival == int(c)
}

func isOpCode(code: int): bool {
    var t: Tok = tok()
    return t.kind == TOp and t.ival == code
}

func isKw(k: int): bool {
    var t: Tok = tok()
    return t.kind == TKw and t.ival == k
}

func expectOp(c: char) {
    if not isOp(c) { abort("Syntax error") }
    pc = pc + 1
}

func skipOp(c: char): bool {
    if isOp(c) {
        pc = pc + 1
        return true
    }
    return false
}

func skipKw(k: int): bool {
    if isKw(k) {
        pc = pc + 1
        return true
    }
    return false
}

func atLineEnd(): bool {
    var t: Tok = tok()
    return t.kind == TLine or t.kind == TEnd
}

func atStmtEnd(): bool {
    var t: Tok = tok()
    if t.kind == TLine or t.kind == TEnd { return true }
    if t.kind == TOp and t.ival == int(':') { return true }
    if t.kind == TKw and t.ival == K_ELSE { return true }
    return false
}

func skipToLineEnd() {
    while not atLineEnd() { pc = pc + 1 }
}

func skipToStmtEnd() {
    while not atStmtEnd() { pc = pc + 1 }
}

// --- Output -----------------------------------------------------------

var printFile: int = 0        // PRINT #n in progress (0 = screen)

func emitRaw(s: string) {
    basicOut(s)
    outBytes = outBytes + s.length
}

func outNewline() {
    if printFile > 0 {
        fileWrite(printFile, "\n")
        fileCol = 0
        return
    }
    emitRaw("\n")
    cursorCol = 0
    cursorRow = cursorRow + 1
}

// Print an item, wrapping to a new line first when it would cross the
// width, and ending the line when it exactly fills it (GW-BASIC's own
// behavior).
func outStr(s: string) {
    if s.length == 0 { return }
    if printFile > 0 {
        fileWrite(printFile, s)
        fileCol = fileCol + s.length
        return
    }
    if cursorCol > 0 and cursorCol + s.length > basicWidth { outNewline() }
    emitRaw(s)
    cursorCol = cursorCol + s.length
    while cursorCol >= basicWidth {
        cursorCol = cursorCol - basicWidth
        cursorRow = cursorRow + 1
        if cursorCol == 0 { emitRaw("\n") }
    }
}

func spaces(n: int): string {
    var s: string
    var i: int = n
    if i > 255 { i = 255 }
    while i > 0 {
        s = s + " "
        i = i - 1
    }
    return s
}

func curCol(): int {
    if printFile > 0 { return fileCol }
    return cursorCol
}

// --- Expressions ------------------------------------------------------
// Recursive descent in MS BASIC precedence, lowest first:
// IMP EQV XOR OR AND NOT relational +- MOD \ */ unary- ^

func evalExpr(): Val {
    return evalImp()
}

func toLogic(v: Val): int { return numAsInt(needNum(v)) }

func evalImp(): Val {
    var left: Val = evalEqv()
    var a: int
    var b: int
    while isKw(K_IMP) {
        pc = pc + 1
        a = toLogic(left)
        b = toLogic(evalEqv())
        left = valInt((~a) | b)
    }
    return left
}

func evalEqv(): Val {
    var left: Val = evalXor()
    var a: int
    var b: int
    while isKw(K_EQV) {
        pc = pc + 1
        a = toLogic(left)
        b = toLogic(evalXor())
        left = valInt(~(a ^ b))
    }
    return left
}

func evalXor(): Val {
    var left: Val = evalOr()
    var a: int
    while isKw(K_XOR) {
        pc = pc + 1
        a = toLogic(left)
        left = valInt(a ^ toLogic(evalOr()))
    }
    return left
}

func evalOr(): Val {
    var left: Val = evalAnd()
    var a: int
    while isKw(K_OR) {
        pc = pc + 1
        a = toLogic(left)
        left = valInt(a | toLogic(evalAnd()))
    }
    return left
}

func evalAnd(): Val {
    var left: Val = evalNot()
    var a: int
    while isKw(K_AND) {
        pc = pc + 1
        a = toLogic(left)
        left = valInt(a & toLogic(evalNot()))
    }
    return left
}

func evalNot(): Val {
    if isKw(K_NOT) {
        pc = pc + 1
        return valInt(~toLogic(evalNot()))
    }
    return evalRel()
}

func boolVal(b: bool): Val {
    if b { return valInt(-1) }
    return valInt(0)
}

func evalRel(): Val {
    var left: Val = evalAdd()
    var right: Val
    var c: int
    var t: Tok
    while true {
        t = tok()
        if t.kind != TOp { break }
        if t.ival != int('=') and t.ival != int('<') and t.ival != int('>') and t.ival != O_LE and t.ival != O_GE and t.ival != O_NE { break }
        pc = pc + 1
        right = evalAdd()
        if left.isStr != right.isStr { abort("Type mismatch") }
        if left.isStr {
            if left.s < right.s { c = -1 } else if left.s > right.s { c = 1 } else { c = 0 }
        } else {
            c = numCmp(left.n, right.n)
        }
        if t.ival == int('=') {
            left = boolVal(c == 0)
        } else if t.ival == int('<') {
            left = boolVal(c < 0)
        } else if t.ival == int('>') {
            left = boolVal(c > 0)
        } else if t.ival == O_LE {
            left = boolVal(c <= 0)
        } else if t.ival == O_GE {
            left = boolVal(c >= 0)
        } else {
            left = boolVal(c != 0)
        }
    }
    return left
}

func evalAdd(): Val {
    var left: Val = evalMod()
    var right: Val
    var plus: bool
    while isOp('+') or isOp('-') {
        plus = isOp('+')
        pc = pc + 1
        right = evalMod()
        if left.isStr or right.isStr {
            if not plus or not left.isStr or not right.isStr { abort("Type mismatch") }
            if left.s.length + right.s.length > 255 { abort("String too long") }
            left = valStr(left.s + right.s)
        } else if plus {
            left = valNum(numAdd(left.n, right.n))
        } else {
            left = valNum(numSub(left.n, right.n))
        }
    }
    return left
}

func evalMod(): Val {
    var left: Val = evalIdiv()
    var a: int
    var b: int
    while isKw(K_MOD) {
        pc = pc + 1
        a = toLogic(left)
        b = toLogic(evalIdiv())
        if b == 0 { abort("Division by zero") }
        left = valInt(a mod b)
    }
    return left
}

func evalIdiv(): Val {
    var left: Val = evalMul()
    var a: int
    var b: int
    while isOp('\\') {
        pc = pc + 1
        a = toLogic(left)
        b = toLogic(evalMul())
        if b == 0 { abort("Division by zero") }
        left = valInt(a / b)
    }
    return left
}

func evalMul(): Val {
    var left: Val = evalNeg()
    var right: Num
    var mul: bool
    while isOp('*') or isOp('/') {
        mul = isOp('*')
        pc = pc + 1
        right = needNum(evalNeg())
        if mul {
            left = valNum(numMul(needNum(left), right))
        } else {
            left = valNum(numDiv(needNum(left), right))
        }
    }
    return left
}

func evalNeg(): Val {
    if isOp('-') {
        pc = pc + 1
        return valNum(numNeg(needNum(evalNeg())))
    }
    if isOp('+') {
        pc = pc + 1
        return evalNeg()
    }
    return evalPow()
}

func evalPow(): Val {
    var left: Val = evalPrimary()
    var right: Val
    while isOp('^') {
        pc = pc + 1
        if isOp('-') {
            pc = pc + 1
            right = valNum(numNeg(needNum(evalPrimary())))
        } else {
            right = evalPrimary()
        }
        left = valNum(numPow(needNum(left), needNum(right)))
    }
    return left
}

func evalNum(): Num { return needNum(evalExpr()) }
func evalStr(): string { return needStr(evalExpr()) }
func evalInt(): int { return numAsInt(evalNum()) }

// ( expr )
func parenNum(): Num {
    var n: Num
    expectOp('(')
    n = evalNum()
    expectOp(')')
    return n
}

func parenStr(): string {
    var s: string
    expectOp('(')
    s = evalStr()
    expectOp(')')
    return s
}

func parenInt(): int { return numAsInt(parenNum()) }

func strFromChar(c: char): string {
    var s: string(1)
    s = s + c
    return s
}

func evalPrimary(): Val {
    var t: Tok = tok()
    var v: Val
    var key: string
    var idx: int
    if t.kind == TNum {
        pc = pc + 1
        return valNum(t.num)
    }
    if t.kind == TStr {
        pc = pc + 1
        return valStr(strPool[t.ival])
    }
    if t.kind == TOp and t.ival == int('(') {
        pc = pc + 1
        v = evalExpr()
        expectOp(')')
        return v
    }
    if t.kind == TId {
        pc = pc + 1
        if names[t.ival].length > 2 and names[t.ival][0] == 'F' and names[t.ival][1] == 'N' {
            return callUserFn(t.ival)
        }
        key = varKey(t.ival)
        if isOp('(') {
            idx = arrayIndex(key)
            if isStrKey(key) { return valStr(astrs[idx]) }
            return valNum(anums[idx])
        }
        if isStrKey(key) { return valStr(getStr(key)) }
        return valNum(getNum(key))
    }
    if t.kind == TKw {
        pc = pc + 1
        return evalFunction(t.ival)
    }
    abort("Syntax error")
    return v
}

func evalFunction(k: int): Val {
    var s: string
    var s2: string
    var n: int
    var m: int
    var x: Num
    var v: Val
    switch k {
    case K_ABS { return valNum(numAbs(parenNum())) }
    case K_SGN {
        x = parenNum()
        return valInt(numCmp(x, numZero()))
    }
    case K_INT { return valNum(numFloor(parenNum())) }
    case K_FIX { return valNum(numFromInt(numToInt(parenNum()))) }
    case K_CINT {
        n = parenInt()
        if n > 32767 or n < -32768 { abort("Overflow") }
        return valInt(n)
    }
    case K_CSNG, K_CDBL { return valNum(parenNum()) }
    case K_SQR { return valNum(numSqrt(parenNum())) }
    case K_SIN { return valNum(numSin(parenNum())) }
    case K_COS { return valNum(numCos(parenNum())) }
    case K_TAN { return valNum(numTan(parenNum())) }
    case K_ATN { return valNum(numAtn(parenNum())) }
    case K_EXP { return valNum(numExp(parenNum())) }
    case K_LOG { return valNum(numLog(parenNum())) }
    case K_RND {
        if isOp('(') {
            x = parenNum()
            if x.m == 0 { return valNum(rndLast) }
            if x.m < 0 { rndSeed = numToInt(x) }
        }
        return valNum(rndNext())
    }
    case K_TIMER { return valNum(timerNow()) }
    case K_LEN { return valInt(parenStr().length) }
    case K_LEFTS {
        expectOp('(')
        s = evalStr()
        expectOp(',')
        n = evalInt()
        expectOp(')')
        if n < 0 { abort("Illegal function call") }
        if n > s.length { n = s.length }
        return valStr(s[0, n])
    }
    case K_RIGHTS {
        expectOp('(')
        s = evalStr()
        expectOp(',')
        n = evalInt()
        expectOp(')')
        if n < 0 { abort("Illegal function call") }
        if n > s.length { n = s.length }
        return valStr(s[s.length - n, n])
    }
    case K_MIDS {
        expectOp('(')
        s = evalStr()
        expectOp(',')
        n = evalInt()
        m = 255
        if skipOp(',') { m = evalInt() }
        expectOp(')')
        if n < 1 or m < 0 { abort("Illegal function call") }
        if n > s.length { return valStr("") }
        if m > s.length - n + 1 { m = s.length - n + 1 }
        return valStr(s[n - 1, m])
    }
    case K_INSTR {
        expectOp('(')
        v = evalExpr()
        n = 1
        if not v.isStr {
            n = numAsInt(v.n)
            expectOp(',')
            v = evalExpr()
        }
        s = needStr(v)
        expectOp(',')
        s2 = evalStr()
        expectOp(')')
        if n < 1 { abort("Illegal function call") }
        if n > s.length { return valInt(0) }
        if s2.length == 0 { return valInt(n) }
        m = s[n - 1, s.length - n + 1].indexOf(s2)
        if m < 0 { return valInt(0) }
        return valInt(m + n)
    }
    case K_STRS { return valStr(numStr(parenNum())) }
    case K_VAL { return valNum(numParsePrefix(parenStr())) }
    case K_CHRS {
        n = parenInt()
        if n < 0 or n > 255 { abort("Illegal function call") }
        return valStr(strFromChar(char(n)))
    }
    case K_ASC {
        s = parenStr()
        if s.length == 0 { abort("Illegal function call") }
        return valInt(int(s[0]))
    }
    case K_SPACES {
        n = parenInt()
        if n < 0 or n > 255 { abort("Illegal function call") }
        return valStr(spaces(n))
    }
    case K_STRINGS {
        expectOp('(')
        n = evalInt()
        expectOp(',')
        v = evalExpr()
        expectOp(')')
        if v.isStr {
            if v.s.length == 0 { abort("Illegal function call") }
            m = int(v.s[0])
        } else {
            m = numAsInt(v.n)
        }
        if n < 0 or n > 255 or m < 0 or m > 255 { abort("Illegal function call") }
        s = ""
        while n > 0 {
            s = s + char(m)
            n = n - 1
        }
        return valStr(s)
    }
    case K_UCASES {
        s = parenStr()
        n = 0
        while n < s.length {
            s[n] = upperChar(s[n])
            n = n + 1
        }
        return valStr(s)
    }
    case K_LCASES {
        s = parenStr()
        n = 0
        while n < s.length {
            if s[n] >= 'A' and s[n] <= 'Z' { s[n] = char(int(s[n]) + 32) }
            n = n + 1
        }
        return valStr(s)
    }
    case K_LTRIMS {
        s = parenStr()
        n = 0
        while n < s.length and s[n] == ' ' { n = n + 1 }
        return valStr(s[n, s.length - n])
    }
    case K_RTRIMS {
        s = parenStr()
        n = s.length
        while n > 0 and s[n - 1] == ' ' { n = n - 1 }
        return valStr(s[0, n])
    }
    case K_HEXS, K_OCTS {
        n = parenInt()
        if n < 0 { n = n & 0xFFFF }
        if k == K_HEXS { m = 16 } else { m = 8 }
        s = ""
        if n == 0 { s = "0" }
        while n > 0 {
            if (n mod m) < 10 { s = char(int('0') + (n mod m)) + s } else { s = char(int('A') + (n mod m) - 10) + s }
            n = n / m
        }
        return valStr(s)
    }
    case K_INKEYS { return valStr(inkeyRead()) }
    case K_POS {
        parenNum()
        return valInt(curCol() + 1)
    }
    case K_CSRLIN { return valInt(cursorRow) }
    case K_ENVIRONS { return valStr(basicEnv(parenStr())) }
    case K_EOF { return boolVal(fileEof(parenInt())) }
    case K_FRE {
        expectOp('(')
        evalExpr()
        expectOp(')')
        return valInt(65536)
    }
    }
    if k >= K_NOTSUP_FIRST { abort("Not supported") }
    abort("Syntax error")
    return v
}

// --- Arrays -----------------------------------------------------------

// Parse "(i[,j[,k]])" after an array name and return its heap slot,
// DIMing 10 per subscript on first use. (Subscripts travel as three
// ints: the 68k backend can't pass a fixed array by value.)
func arrayIndex(key: string): int {
    var s0: int = 0
    var s1: int = 0
    var s2: int = 0
    var n: int = 0
    var info: ArrayInfo
    expectOp('(')
    while true {
        if n >= 3 { abort("Subscript out of range") }
        if n == 0 { s0 = evalInt() } else if n == 1 { s1 = evalInt() } else { s2 = evalInt() }
        n = n + 1
        if not skipOp(',') { break }
    }
    expectOp(')')
    if not arrays.has(key) { dimArray(key, n, 10, 10, 10) }
    info = arrays[key]
    if info.dims != n { abort("Subscript out of range") }
    return arraySlot(info, s0, s1, s2)
}

func arraySlotDim(idx: int, sub: int, d: int, lower: int): int {
    if sub < lower or sub > d { abort("Subscript out of range") }
    return idx * (d - lower + 1) + (sub - lower)
}

func arraySlot(info: ArrayInfo, s0: int, s1: int, s2: int): int {
    var idx: int = arraySlotDim(0, s0, info.d0, info.lower)
    if info.dims > 1 { idx = arraySlotDim(idx, s1, info.d1, info.lower) }
    if info.dims > 2 { idx = arraySlotDim(idx, s2, info.d2, info.lower) }
    return info.heap + idx
}

func dimArray(key: string, dims: int, d0: int, d1: int, d2: int) {
    var info: ArrayInfo
    var count: int = 1
    if arrays.has(key) { abort("Duplicate definition") }
    info.lower = optionBase
    info.dims = dims
    info.d0 = d0
    info.d1 = d1
    info.d2 = d2
    info.isStr = isStrKey(key)
    if d0 < optionBase or (dims > 1 and d1 < optionBase) or (dims > 2 and d2 < optionBase) { abort("Subscript out of range") }
    count = d0 - optionBase + 1
    if dims > 1 { count = count * (d1 - optionBase + 1) }
    if dims > 2 { count = count * (d2 - optionBase + 1) }
    if info.isStr {
        info.heap = astrs.count
        while count > 0 {
            astrs.add("")
            count = count - 1
        }
    } else {
        info.heap = anums.count
        while count > 0 {
            anums.add(numZero())
            count = count - 1
        }
    }
    arrays[key] = info
}

// --- User functions, RND, TIMER ---------------------------------------

record FnInfo {
    param: int          // name id of the parameter
    pc: int             // token index of the expression
}

var fns: map of FnInfo

func callUserFn(id: int): Val {
    var name: string = names[id]
    var fn: FnInfo
    var pkey: string
    var arg: Val
    var savedNum: Num
    var savedStr: string
    var savedPc: int
    var savedCur: list of Tok
    var v: Val
    if not fns.has(name) { abort("Undefined user function") }
    fn = fns[name]
    if fn.param >= 0 {
        expectOp('(')
        arg = evalExpr()
        expectOp(')')
        pkey = varKey(fn.param)
        if isStrKey(pkey) {
            savedStr = getStr(pkey)
            strs[pkey] = needStr(arg)
        } else {
            savedNum = getNum(pkey)
            storeNum(pkey, needNum(arg))
        }
    }
    savedPc = pc
    savedCur = cur
    cur = prog
    pc = fn.pc
    v = evalExpr()
    cur = savedCur
    pc = savedPc
    if fn.param >= 0 {
        if isStrKey(pkey) { strs[pkey] = savedStr } else { nums[pkey] = savedNum }
    }
    if isStrKey(name) { needStr(v) } else { needNum(v) }
    return v
}

var rndSeed: int = 12345
var rndLast: Num

func rndNext(): Num {
    rndSeed = rndSeed * 1103515245 + 12345
    rndLast = numMul(numFromInt((rndSeed >> 8) & 0xFFFFFF), numNormalize(0x40000000, -54))   // / 2^24
    return rndLast
}

// Seconds since local midnight. now() is local-time seconds since 1904
// read as a signed int (negative today); 2^32 mod 86400 = 23296.
func timerNow(): Num {
    var t: int = ((now() mod 86400) + 23296 + 86400) mod 86400
    return numFromInt(t)
}

// --- Control flow -----------------------------------------------------

record ForFrame {
    key: string(41)
    limit: Num
    step: Num
    pc: int             // first token after the FOR statement
}

var forStack: list of ForFrame
var gosubStack: list of int
var whileStack: list of int

func clearStacks() {
    forStack.clear()
    gosubStack.clear()
    whileStack.clear()
}

// A line number or label at pc.
func lineTarget(): int {
    var t: Tok = tok()
    var n: int
    pc = pc + 1
    if t.kind == TNum { return numAsInt(t.num) }
    if t.kind == TId {
        n = labels.get(names[t.ival], -1)
        if n < 0 { abort("Undefined line number") }
        return n
    }
    abort("Syntax error")
    return 0
}

func jumpToLine(n: int) {
    var idx: int = lineIndex.get(n, -1)
    if idx < 0 { abort("Undefined line number") }
    cur = prog
    pc = idx
}

func stmtGoto() { jumpToLine(lineTarget()) }

func stmtGosub() {
    var n: int = lineTarget()
    gosubStack.add(pc)
    jumpToLine(n)
}

func stmtReturn() {
    if gosubStack.count == 0 { abort("RETURN without GOSUB") }
    pc = gosubStack.pop()
}

func stmtIf() {
    var c: Num = evalNum()
    var depth: int = 0
    var t: Tok
    if not skipKw(K_THEN) and not isKw(K_GOTO) { abort("Syntax error") }
    if c.m != 0 {
        if tok().kind == TNum { jumpToLine(lineTarget()) }
        return
    }
    // false: find our ELSE on this line, else fall to the next line
    while true {
        t = tok()
        if t.kind == TLine or t.kind == TEnd { return }
        if t.kind == TKw and t.ival == K_IF { depth = depth + 1 }
        if t.kind == TKw and t.ival == K_ELSE {
            if depth == 0 {
                pc = pc + 1
                if tok().kind == TNum { jumpToLine(lineTarget()) }
                return
            }
            depth = depth - 1
        }
        pc = pc + 1
    }
}

func forPast(v: Num, f: ForFrame): bool {
    if f.step.m < 0 { return numCmp(v, f.limit) < 0 }
    return numCmp(v, f.limit) > 0
}

func stmtFor() {
    var t: Tok = tok()
    var f: ForFrame
    var start: Num
    var depth: int = 0
    var i: int
    if t.kind != TId { abort("Syntax error") }
    pc = pc + 1
    f.key = varKey(t.ival)
    expectOp('=')
    start = evalNum()
    if not skipKw(K_TO) { abort("Syntax error") }
    f.limit = evalNum()
    f.step = numFromInt(1)
    if skipKw(K_STEP) { f.step = evalNum() }
    storeNum(f.key, start)
    // a FOR on a variable with an active loop replaces that loop
    i = forStack.count - 1
    while i >= 0 {
        if forStack[i].key == f.key {
            while forStack.count > i { forStack.pop() }
            break
        }
        i = i - 1
    }
    f.pc = pc
    forStack.add(f)
    if not forPast(start, f) { return }
    // zero-trip: skip to the matching NEXT
    while true {
        t = tok()
        if t.kind == TEnd { abort("FOR without NEXT") }
        if t.kind == TKw and t.ival == K_FOR { depth = depth + 1 }
        if t.kind == TKw and t.ival == K_NEXT {
            if depth == 0 {
                pc = pc + 1
                forStack.pop()
                if tok().kind == TId {
                    pc = pc + 1
                    if skipOp(',') { stmtNext() }   // NEXT I,J closes J too
                }
                return
            }
            depth = depth - 1
        }
        pc = pc + 1
    }
}

func stmtNext() {
    var t: Tok
    var key: string
    var f: ForFrame
    var v: Num
    while true {
        t = tok()
        key = ""
        if t.kind == TId {
            key = varKey(t.ival)
            pc = pc + 1
        }
        if key != "" {
            while forStack.count > 0 and forStack.last().key != key { forStack.pop() }
        }
        if forStack.count == 0 { abort("NEXT without FOR") }
        f = forStack.last()
        v = numAdd(getNum(f.key), f.step)
        storeNum(f.key, v)
        if not forPast(v, f) {
            pc = f.pc
            return
        }
        forStack.pop()
        if not skipOp(',') { return }
    }
}

func stmtWhile() {
    var c: Num
    var depth: int = 0
    var t: Tok
    whileStack.add(pc - 1)
    c = evalNum()
    if c.m != 0 { return }
    whileStack.pop()
    while true {
        t = tok()
        if t.kind == TEnd { abort("WHILE without WEND") }
        if t.kind == TKw and t.ival == K_WHILE { depth = depth + 1 }
        if t.kind == TKw and t.ival == K_WEND {
            if depth == 0 {
                pc = pc + 1
                return
            }
            depth = depth - 1
        }
        pc = pc + 1
    }
}

func stmtWend() {
    if whileStack.count == 0 { abort("WEND without WHILE") }
    pc = whileStack.pop()
}

func stmtOn() {
    var n: int = evalInt()
    var gosub: bool
    var targets: list of int
    if skipKw(K_GOTO) {
        gosub = false
    } else if skipKw(K_GOSUB) {
        gosub = true
    } else if isKw(K_ERROR) {
        abort("Not supported")
    } else {
        abort("Syntax error")
    }
    while true {
        targets.add(lineTarget())
        if not skipOp(',') { break }
    }
    if n < 1 or n > targets.count { return }
    if gosub { gosubStack.add(pc) }
    jumpToLine(targets[n - 1])
}

func stmtStop() {
    if cursorCol > 0 { outNewline() }
    if runLine > 0 { basicOut("Break in " + string(runLine) + "\n") } else { basicOut("Break\n") }
    contPc = pc
    endRun()
}

// --- Statements -------------------------------------------------------

// An assignment target at pc: a scalar or an array element.
var lvKey: string
var lvIdx: int = -1

func parseLValue() {
    var t: Tok = tok()
    if t.kind != TId { abort("Syntax error") }
    pc = pc + 1
    lvKey = varKey(t.ival)
    lvIdx = -1
    if isOp('(') { lvIdx = arrayIndex(lvKey) }
}

func assignLValue(key: string, idx: int, v: Val) {
    if idx < 0 {
        storeVal(key, v)
    } else if isStrKey(key) {
        astrs[idx] = needStr(v)
    } else {
        anums[idx] = needNum(v)
    }
}

func readLValue(key: string, idx: int): Val {
    if idx < 0 {
        if isStrKey(key) { return valStr(getStr(key)) }
        return valNum(getNum(key))
    }
    if isStrKey(key) { return valStr(astrs[idx]) }
    return valNum(anums[idx])
}

func stmtLet() {
    var key: string
    var idx: int
    var v: Val
    skipKw(K_LET)
    parseLValue()
    key = lvKey
    idx = lvIdx
    expectOp('=')
    v = evalExpr()
    assignLValue(key, idx, v)
}

func stmtDim() {
    var t: Tok
    var key: string
    var d0: int
    var d1: int
    var d2: int
    var n: int
    while true {
        t = tok()
        if t.kind != TId { abort("Syntax error") }
        pc = pc + 1
        key = varKey(t.ival)
        expectOp('(')
        n = 0
        d0 = 0
        d1 = 0
        d2 = 0
        while true {
            if n >= 3 { abort("Subscript out of range") }
            if n == 0 { d0 = evalInt() } else if n == 1 { d1 = evalInt() } else { d2 = evalInt() }
            n = n + 1
            if not skipOp(',') { break }
        }
        expectOp(')')
        dimArray(key, n, d0, d1, d2)
        if not skipOp(',') { break }
    }
}

func stmtOption() {
    var n: int
    if not skipKw(K_BASE) { abort("Syntax error") }
    n = evalInt()
    if n != 0 and n != 1 { abort("Syntax error") }
    if arrays.count > 0 { abort("Duplicate definition") }
    optionBase = n
}

func stmtDefFn() {
    var t: Tok = tok()
    var name: string
    var fn: FnInfo
    if t.kind != TId or names[t.ival].length < 3 or names[t.ival][0] != 'F' or names[t.ival][1] != 'N' { abort("Syntax error") }
    name = names[t.ival]
    pc = pc + 1
    fn.param = -1
    if skipOp('(') {
        t = tok()
        if t.kind != TId { abort("Syntax error") }
        fn.param = t.ival
        pc = pc + 1
        expectOp(')')
    }
    expectOp('=')
    fn.pc = pc
    fns[name] = fn
    skipToStmtEnd()
}

// DEFINT A-C, X: the implied suffix for names starting with those letters.
func stmtDefType(suffix: char) {
    var t: Tok
    var a: int
    var b: int
    var i: int
    while true {
        t = tok()
        if t.kind != TId or names[t.ival].length != 1 { abort("Syntax error") }
        a = int(names[t.ival][0]) - int('A')
        b = a
        pc = pc + 1
        if skipOp('-') {
            t = tok()
            if t.kind != TId or names[t.ival].length != 1 { abort("Syntax error") }
            b = int(names[t.ival][0]) - int('A')
            pc = pc + 1
        }
        i = a
        while i <= b {
            defTypes[i] = suffix
            i = i + 1
        }
        if not skipOp(',') { break }
    }
}

// DATA is read from the raw text the tokenizer saved per statement.
var dataIdx: int = 0
var dataPos: int = 0

func readDataItem(): string {
    var s: string
    var item: string
    while true {
        if dataIdx >= dataText.count { abort("Out of DATA") }
        s = dataText[dataIdx]
        while dataPos < s.length and s[dataPos] == ' ' { dataPos = dataPos + 1 }
        if dataPos >= s.length and s.length > 0 and s[s.length - 1] != ',' {
            dataIdx = dataIdx + 1
            dataPos = 0
            continue
        }
        break
    }
    if dataPos < s.length and s[dataPos] == '"' {
        dataPos = dataPos + 1
        while dataPos < s.length and s[dataPos] != '"' {
            item = item + s[dataPos]
            dataPos = dataPos + 1
        }
        if dataPos < s.length { dataPos = dataPos + 1 }
        while dataPos < s.length and s[dataPos] == ' ' { dataPos = dataPos + 1 }
    } else {
        while dataPos < s.length and s[dataPos] != ',' {
            item = item + s[dataPos]
            dataPos = dataPos + 1
        }
        while item.length > 0 and item[item.length - 1] == ' ' { item = item[0, item.length - 1] }
    }
    if dataPos < s.length and s[dataPos] == ',' {
        dataPos = dataPos + 1
    } else {
        dataIdx = dataIdx + 1
        dataPos = 0
    }
    return item
}

func stmtRead() {
    var key: string
    var idx: int
    var item: string
    var v: Val
    while true {
        parseLValue()
        key = lvKey
        idx = lvIdx
        item = readDataItem()
        if isStrKey(key) {
            v = valStr(item)
        } else if item == "" {
            v = valInt(0)
        } else {
            numParsePrefix(item)
            if numParseEnd != item.length { abort("Syntax error") }
            v = valNum(numParsePrefix(item))
        }
        assignLValue(key, idx, v)
        if not skipOp(',') { break }
    }
}

func stmtRestore() {
    var n: int
    var i: int = 0
    dataIdx = 0
    dataPos = 0
    if atStmtEnd() { return }
    n = lineTarget()
    while i < dataLine.count and dataLine[i] < n { i = i + 1 }
    dataIdx = i
}

func stmtSwap() {
    var k1: string
    var i1: int
    var v1: Val
    var v2: Val
    parseLValue()
    k1 = lvKey
    i1 = lvIdx
    expectOp(',')
    parseLValue()
    if isStrKey(k1) != isStrKey(lvKey) { abort("Type mismatch") }
    v1 = readLValue(k1, i1)
    v2 = readLValue(lvKey, lvIdx)
    assignLValue(k1, i1, v2)
    assignLValue(lvKey, lvIdx, v1)
}

func stmtRandomize() {
    if basicFixedSeed != 0 {
        rndSeed = basicFixedSeed
        if not atStmtEnd() { evalNum() }
        return
    }
    if atStmtEnd() {
        rndSeed = now()
    } else {
        rndSeed = numToInt(numFloor(evalNum()))
    }
}

// MID$(s$, n[, m]) = e$
func stmtMidAssign() {
    var key: string
    var idx: int
    var n: int
    var m: int = 255
    var e: string
    var s: string
    var count: int
    var i: int
    expectOp('(')
    parseLValue()
    key = lvKey
    idx = lvIdx
    if not isStrKey(key) { abort("Type mismatch") }
    expectOp(',')
    n = evalInt()
    if skipOp(',') { m = evalInt() }
    expectOp(')')
    expectOp('=')
    e = evalStr()
    s = needStr(readLValue(key, idx))
    if n < 1 or m < 0 { abort("Illegal function call") }
    if n > s.length { return }
    count = e.length
    if m < count { count = m }
    if s.length - n + 1 < count { count = s.length - n + 1 }
    i = 0
    while i < count {
        s[n - 1 + i] = e[i]
        i = i + 1
    }
    assignLValue(key, idx, valStr(s))
}

func stmtClear() {
    while not atStmtEnd() { pc = pc + 1 }    // CLEAR [,n[,m]] arguments are ignored
    clearVars()
    fns.clear()
    closeAllFiles()
}

func stmtPrint() {
    var lastSep: bool = false
    var v: Val
    var n: int
    var next: int
    if isOp('#') {
        pc = pc + 1
        n = evalInt()
        expectOp(',')
        printFile = fileForWrite(n)
    }
    while not atStmtEnd() {
        if isOp(';') {
            pc = pc + 1
            lastSep = true
        } else if isOp(',') {
            pc = pc + 1
            lastSep = true
            next = (curCol() / 14 + 1) * 14
            if next >= basicWidth { outNewline() } else { outStr(spaces(next - curCol())) }
        } else if isKw(K_TAB) {
            pc = pc + 1
            n = parenInt() - 1
            if n < 0 { n = 0 }
            if n < curCol() { outNewline() }
            outStr(spaces(n - curCol()))
            lastSep = false
        } else if isKw(K_SPC) {
            pc = pc + 1
            n = parenInt()
            if n > 0 { outStr(spaces(n)) }
            lastSep = false
        } else if isKw(K_USING) {
            printFile = 0
            abort("Not supported")
        } else {
            v = evalExpr()
            if v.isStr { outStr(v.s) } else { outStr(numStr(v.n) + " ") }
            lastSep = false
        }
    }
    if not lastSep { outNewline() }
    printFile = 0
}

func endRun() {
    closeAllFiles()
    if fromPrompt {
        basicPrompt()
    } else {
        basicState = BDone
    }
}

func stmtEnd() {
    contPc = -1
    endRun()
}

// One statement at pc.
func execStatement() {
    var t: Tok = tok()
    if t.kind == TLine {
        runLine = t.ival
        pc = pc + 1
        return
    }
    if t.kind == TEnd {
        if immediateRunning {
            immediateRunning = false
            endRun()
        } else {
            stmtEnd()
        }
        return
    }
    if t.kind == TOp and t.ival == int(':') {
        pc = pc + 1
        return
    }
    if t.kind == TId {
        stmtLet()
        return
    }
    if t.kind != TKw { abort("Syntax error") }
    pc = pc + 1
    switch t.ival {
    case K_PRINT { stmtPrint() }
    case K_LET {
        pc = pc - 1
        stmtLet()
    }
    case K_END { stmtEnd() }
    case K_REM { skipToLineEnd() }
    case K_ELSE { skipToLineEnd() }
    case K_GOTO { stmtGoto() }
    case K_GOSUB { stmtGosub() }
    case K_RETURN { stmtReturn() }
    case K_IF { stmtIf() }
    case K_FOR { stmtFor() }
    case K_NEXT { stmtNext() }
    case K_WHILE { stmtWhile() }
    case K_WEND { stmtWend() }
    case K_ON { stmtOn() }
    case K_STOP { stmtStop() }
    case K_DIM { stmtDim() }
    case K_OPTION { stmtOption() }
    case K_DEF { stmtDefFn() }
    case K_DEFINT { stmtDefType('%') }
    case K_DEFSNG, K_DEFDBL { stmtDefType('!') }
    case K_DEFSTR { stmtDefType('$') }
    case K_DATA { }
    case K_READ { stmtRead() }
    case K_RESTORE { stmtRestore() }
    case K_SWAP { stmtSwap() }
    case K_RANDOMIZE { stmtRandomize() }
    case K_MIDS { stmtMidAssign() }
    case K_CLEAR { stmtClear() }
    case K_INPUT { stmtInput() }
    case K_LINE { stmtLineInput() }
    case K_SLEEP { stmtSleep() }
    case K_CLS { stmtCls() }
    case K_LOCATE { stmtLocate() }
    case K_COLOR { stmtColor() }
    case K_WIDTH { stmtWidth() }
    case K_BEEP { stmtBeep() }
    case K_RUN { stmtRun() }
    case K_LIST { stmtList() }
    case K_NEW { stmtNew() }
    case K_DELETE { stmtDelete() }
    case K_LOAD { stmtLoad() }
    case K_SAVE { stmtSave() }
    case K_FILES { stmtFiles() }
    case K_CONT { stmtCont() }
    case K_SYSTEM { stmtSystem() }
    case K_OPEN { stmtOpen() }
    case K_CLOSE { stmtClose() }
    case K_WRITE { stmtWrite() }
    else {
        if t.ival >= K_NOTSUP_FIRST { abort("Not supported") }
        abort("Syntax error")
    }
    }
}

// --- Stepping and errors ----------------------------------------------

func reportError(msg: string) {
    if cursorCol > 0 { outNewline() }
    if runLine > 0 {
        basicOut(msg + " in " + string(runLine) + "\n")
    } else {
        basicOut(msg + "\n")
    }
    contPc = -1
    endRun()
}

// Run up to budget statements. Returns true while the host should keep
// calling (running, sleeping, or waiting for a key).
func basicStep(budget: int): bool {
    var n: int = 0
    outBytes = 0
    if basicState == BSleeping and now() >= sleepUntil { basicState = BRunning }
    if basicState != BRunning {
        return basicState == BSleeping or basicState == BWaitKey
    }
    attempt {
        while basicState == BRunning and n < budget and outBytes < 1024 {
            execStatement()
            n = n + 1
        }
    } aborted msg {
        reportError(msg)
    }
    return basicState == BRunning or basicState == BSleeping or basicState == BWaitKey
}

func basicRun() {
    fromPrompt = false
    startProgram(0)
}

func basicStop() {
    closeAllFiles()
    basicState = BDone
}

func basicPrompt() {
    basicOut("Ok\n")
    cursorCol = 0
    fromPrompt = true
    basicState = BPrompt
}

// --- Input ------------------------------------------------------------
// INPUT parks the interpreter in BWaitLine with the variable list's
// token range remembered; basicLine parses the answer into it.

var inputVarsPc: int = 0
var inputResumePc: int = 0
var inputPrompt: string
var inputQuestion: bool = false
var inputIsLine: bool = false
var inputKeepLine: bool = false
var keyQueue: text
var inkeyMisses: int = 0

func showInputPrompt() {
    outStr(inputPrompt)
    if inputQuestion { outStr("? ") }
}

func stmtInput() {
    var t: Tok
    if isOp('#') {
        stmtInputFile(false)
        return
    }
    inputKeepLine = skipOp(';')
    inputPrompt = ""
    inputQuestion = true
    t = tok()
    if t.kind == TStr {
        inputPrompt = strPool[t.ival]
        pc = pc + 1
        if skipOp(',') {
            inputQuestion = false
        } else {
            expectOp(';')
        }
    }
    showInputPrompt()
    inputVarsPc = pc
    skipToStmtEnd()
    inputResumePc = pc
    inputIsLine = false
    basicState = BWaitLine
}

// LINE INPUT [;]["prompt";] var$   (after the LINE keyword)
func stmtLineInput() {
    var t: Tok
    if not skipKw(K_INPUT) { abort("Not supported") }     // graphics LINE
    if isOp('#') {
        stmtInputFile(true)
        return
    }
    inputKeepLine = skipOp(';')
    inputPrompt = ""
    inputQuestion = false
    t = tok()
    if t.kind == TStr {
        inputPrompt = strPool[t.ival]
        pc = pc + 1
        expectOp(';')
    }
    showInputPrompt()
    inputVarsPc = pc
    skipToStmtEnd()
    inputResumePc = pc
    inputIsLine = true
    basicState = BWaitLine
}

// Comma-separated items, quotes honored, blanks trimmed.
func splitInputItems(s: string, items: list of string) {
    var i: int = 0
    var item: string
    items.clear()
    while true {
        item = ""
        while i < s.length and s[i] == ' ' { i = i + 1 }
        if i < s.length and s[i] == '"' {
            i = i + 1
            while i < s.length and s[i] != '"' {
                item = item + s[i]
                i = i + 1
            }
            if i < s.length { i = i + 1 }
            while i < s.length and s[i] == ' ' { i = i + 1 }
        } else {
            while i < s.length and s[i] != ',' {
                item = item + s[i]
                i = i + 1
            }
            while item.length > 0 and item[item.length - 1] == ' ' { item = item[0, item.length - 1] }
        }
        items.add(item)
        if i < s.length and s[i] == ',' {
            i = i + 1
        } else {
            return
        }
    }
}

// The caller's answer to INPUT. Returns false when it must be redone.
func inputAnswer(s: string): bool {
    var items: list of string
    var n: int = 0
    var pass: int = 0
    var key: string
    var idx: int
    var v: Val
    if inputIsLine {
        pc = inputVarsPc
        parseLValue()
        assignLValue(lvKey, lvIdx, valStr(s))
        return true
    }
    splitInputItems(s, items)
    // pass 0 checks the count and the numeric items; pass 1 assigns
    while pass < 2 {
        pc = inputVarsPc
        n = 0
        while true {
            parseLValue()
            key = lvKey
            idx = lvIdx
            if n >= items.count { return false }
            if isStrKey(key) {
                v = valStr(items[n])
            } else if items[n] == "" {
                v = valInt(0)
            } else {
                v = valNum(numParsePrefix(items[n]))
                if numParseEnd != items[n].length { return false }
            }
            if pass == 1 { assignLValue(key, idx, v) }
            n = n + 1
            if not skipOp(',') { break }
        }
        if n != items.count { return false }
        pass = pass + 1
    }
    return true
}

// A completed line from the host: the answer to INPUT, or a line typed
// at the Ok prompt.
func basicLine(s: string) {
    var ok: bool
    if basicState == BPrompt {
        immediateLine(s)
        return
    }
    if basicState != BWaitLine { return }
    if inputKeepLine {
        cursorCol = cursorCol + s.length
    } else {
        cursorCol = 0
        cursorRow = cursorRow + 1
    }
    attempt {
        ok = inputAnswer(s)
        if ok {
            pc = inputResumePc
            basicState = BRunning
        } else {
            basicOut("?Redo from start\n")
            cursorCol = 0
            showInputPrompt()
        }
    } aborted msg {
        reportError(msg)
    }
}

// One raw key from the host, for INKEY$; wakes SLEEP and a stalled
// INKEY$ poll.
func basicKey(c: char) {
    keyQueue.append(c)
    inkeyMisses = 0
    if basicState == BWaitKey or basicState == BSleeping { basicState = BRunning }
}

// INKEY$: the next queued key or "". A program polling with nothing
// queued would spin forever, so after 200 empty polls the interpreter
// parks in BWaitKey until a key arrives.
func inkeyRead(): string {
    var s: string
    if keyQueue.length > 0 {
        s = keyQueue[0, 1]
        keyQueue = keyQueue.textAt(1, keyQueue.length - 1)
        inkeyMisses = 0
        return s
    }
    inkeyMisses = inkeyMisses + 1
    if inkeyMisses >= 200 {
        inkeyMisses = 0
        basicState = BWaitKey
    }
    return ""
}

// SLEEP [seconds]: no argument (or 0) waits for a key; otherwise for
// the seconds or a key, whichever first.
func stmtSleep() {
    var n: int = 0
    if not atStmtEnd() { n = evalInt() }
    if n <= 0 {
        basicState = BWaitKey
        return
    }
    if basicSleepInstant { return }
    sleepUntil = now() + n
    basicState = BSleeping
}

// --- Screen -----------------------------------------------------------

func stmtCls() {
    basicScreen('C', 0, 0)
    cursorCol = 0
    cursorRow = 1
}

// LOCATE [row][,[col][,anything more]]
func stmtLocate() {
    var row: int = 0
    var col: int = 0
    if not atStmtEnd() and not isOp(',') { row = evalInt() }
    if skipOp(',') {
        if not atStmtEnd() and not isOp(',') { col = evalInt() }
        skipToStmtEnd()
    }
    if row < 0 or col < 0 { abort("Illegal function call") }
    if row > 0 { cursorRow = row }
    if col > 0 { cursorCol = col - 1 }
    basicScreen('L', row, col)
}

// COLOR [fg][,[bg][,border]]
func stmtColor() {
    var fg: int = -1
    var bg: int = -1
    if not atStmtEnd() and not isOp(',') { fg = evalInt() }
    if skipOp(',') {
        if not atStmtEnd() and not isOp(',') { bg = evalInt() }
        skipToStmtEnd()
    }
    if fg > 31 or bg > 15 { abort("Illegal function call") }
    basicScreen('K', fg, bg)
}

// WIDTH n sets the line width; WIDTH LPRINT / WIDTH #n forms are ignored.
func stmtWidth() {
    var n: int
    if isOp('#') or isKw(K_LPRINT) {
        skipToStmtEnd()
        return
    }
    n = evalInt()
    if n < 20 or n > 255 { abort("Illegal function call") }
    basicWidth = n
    skipToStmtEnd()
}

func stmtBeep() { basicScreen('B', 0, 0) }

// --- Immediate mode ---------------------------------------------------

var immed: list of Tok
var immediateRunning: bool = false   // executing immed (its end keeps CONT alive)

// A line typed at the Ok prompt: a numbered line edits the program,
// anything else runs now.
func immediateLine(s: string) {
    var i: int = 0
    var n: int = 0
    var t: text
    var hasNumber: bool = false
    cursorCol = 0
    while i < s.length and s[i] == ' ' { i = i + 1 }
    if i >= s.length { return }
    while i < s.length and s[i] >= '0' and s[i] <= '9' {
        n = n * 10 + int(s[i]) - int('0')
        hasNumber = true
        i = i + 1
    }
    if hasNumber {
        if i < s.length and s[i] == ' ' { i = i + 1 }
        srcSet(n, s[i, s.length - i])
        return
    }
    immed.clear()
    t = s
    tokenizeText(t, 0, immed)
    cur = immed
    pc = 0
    runLine = 0
    immediateRunning = true
    basicState = BRunning
}

// Start the program from its first line, or from line n.
func startProgram(line: int) {
    tokenizeProgram()
    clearVars()
    clearStacks()
    fns.clear()
    closeAllFiles()
    cur = prog
    pc = 0
    if line > 0 { jumpToLine(line) }
    runLine = 0
    immediateRunning = false
    contPc = -1
    dataIdx = 0
    dataPos = 0
    keyQueue = ""
    inkeyMisses = 0
    basicState = BRunning
}

func withExtension(name: string): string {
    if name.indexOf('.') < 0 { return name + ".BAS" }
    return name
}

func programLoadFile(name: string) {
    var p: string = basicPath(withExtension(name), false)
    var t: text
    if p == "" { abort("Bad file name") }
    if not file.readText(p, t) { abort("File not found") }
    clearVars()
    clearStacks()
    fns.clear()
    closeAllFiles()
    contPc = -1
    if not basicLoad(t) { abort("Syntax error") }
}

func programSaveFile(name: string) {
    var p: string = basicPath(withExtension(name), true)
    var t: text
    var i: int = 0
    var n: int
    if p == "" { abort("Bad file name") }
    while i < srcNumbers.count {
        n = srcNumbers[i]
        t.append(string(n) + " ")
        t.append(srcLines[n])
        t.append("\n")
        i = i + 1
    }
    if not file.writeText(p, t, "TEXT", "ttxt") { abort("Device I/O error") }
}

// RUN | RUN line | RUN "file"
func stmtRun() {
    var t: Tok = tok()
    if t.kind == TStr {
        pc = pc + 1
        programLoadFile(strPool[t.ival])
        startProgram(0)
        return
    }
    if t.kind == TNum {
        pc = pc + 1
        startProgram(numAsInt(t.num))
        return
    }
    startProgram(0)
}

// LIST [a][-[b]]
func stmtList() {
    var a: int = 0
    var b: int = 65529
    var t: Tok = tok()
    if t.kind == TNum {
        a = numAsInt(t.num)
        b = a
        pc = pc + 1
    }
    if skipOp('-') {
        b = 65529
        t = tok()
        if t.kind == TNum {
            b = numAsInt(t.num)
            pc = pc + 1
        }
    }
    srcListRange(a, b)
}

func stmtNew() {
    srcClear()
    prog.clear()
    clearVars()
    clearStacks()
    fns.clear()
    closeAllFiles()
    contPc = -1
}

// DELETE a[-b]
func stmtDelete() {
    var a: int
    var b: int
    var i: int
    var doomed: list of int
    var t: Tok = tok()
    if t.kind != TNum { abort("Syntax error") }
    a = numAsInt(t.num)
    b = a
    pc = pc + 1
    if skipOp('-') {
        t = tok()
        if t.kind != TNum { abort("Syntax error") }
        b = numAsInt(t.num)
        pc = pc + 1
    }
    i = 0
    while i < srcNumbers.count {
        if srcNumbers[i] >= a and srcNumbers[i] <= b { doomed.add(srcNumbers[i]) }
        i = i + 1
    }
    for n in doomed { srcSet(n, "") }
    contPc = -1
}

func stmtLoad() {
    var t: Tok = tok()
    if t.kind != TStr { abort("Syntax error") }
    pc = pc + 1
    programLoadFile(strPool[t.ival])
}

func stmtSave() {
    var t: Tok = tok()
    if t.kind != TStr { abort("Syntax error") }
    pc = pc + 1
    programSaveFile(strPool[t.ival])
}

// FILES: the sandbox folder's names, four per row.
func stmtFiles() {
    var folder: string = basicPath("", false)
    var found: list of string
    var name: string
    var i: int = 0
    if not file.list(folder, found) { abort("Path not found") }
    for name in found {
        outStr(name)
        i = i + 1
        if i mod 4 == 0 {
            outNewline()
        } else if name.length < 18 {
            outStr(spaces(18 - name.length))
        }
    }
    if i mod 4 != 0 { outNewline() }
}

func stmtCont() {
    if contPc < 0 { abort("Can't continue") }
    cur = prog
    pc = contPc
    contPc = -1
    immediateRunning = false
}

func stmtSystem() { basicStop() }

// --- Data files -------------------------------------------------------
// Sequential files 1-3. Each open file is a whole text: read on open
// for INPUT/APPEND, written on close for OUTPUT/APPEND.
// ponytail: whole-file buffering; stream it if someone writes a log.

record BasFile {
    isOpen: bool
    mode: char          // 'I', 'O', 'A'
    path: string
    data: text
    pos: int
}

var files: BasFile[4]

func fileCheck(n: int) {
    if n < 1 or n > 3 or not files[n].isOpen { abort("Bad file number") }
}

func fileForWrite(n: int): int {
    fileCheck(n)
    if files[n].mode == 'I' { abort("Bad file mode") }
    return n
}

func fileWrite(n: int, s: string) { files[n].data.append(s) }

func fileEof(n: int): bool {
    fileCheck(n)
    return files[n].pos >= files[n].data.length
}

func fileClose(n: int) {
    var empty: text
    if not files[n].isOpen { return }
    if files[n].mode != 'I' {
        if not file.writeText(files[n].path, files[n].data, "TEXT", "ttxt") { abort("Device I/O error") }
    }
    files[n].isOpen = false
    files[n].data = empty
}

func closeAllFiles() {
    var n: int = 1
    while n <= 3 {
        fileClose(n)
        n = n + 1
    }
}

// OPEN "name" FOR INPUT|OUTPUT|APPEND AS [#]n  |  OPEN "I"|"O"|"A", [#]n, "name"
func stmtOpen() {
    var s: string = evalStr()
    var name: string
    var mode: char
    var n: int
    var p: string
    var t: text
    if skipKw(K_FOR) {
        name = s
        if skipKw(K_INPUT) {
            mode = 'I'
        } else if skipKw(K_OUTPUT) {
            mode = 'O'
        } else if skipKw(K_APPEND) {
            mode = 'A'
        } else {
            abort("Syntax error")
        }
        if not skipKw(K_AS) { abort("Syntax error") }
        skipOp('#')
        n = evalInt()
    } else {
        if s.length == 0 { abort("Bad file mode") }
        mode = upperChar(s[0])
        if mode != 'I' and mode != 'O' and mode != 'A' { abort("Bad file mode") }
        expectOp(',')
        skipOp('#')
        n = evalInt()
        expectOp(',')
        name = evalStr()
    }
    if n < 1 or n > 3 { abort("Bad file number") }
    if files[n].isOpen { abort("File already open") }
    p = basicPath(name, mode != 'I')
    if p == "" { abort("Bad file name") }
    if mode == 'I' {
        if not file.readText(p, t) { abort("File not found") }
    } else if mode == 'A' {
        file.readText(p, t)
    }
    files[n].isOpen = true
    files[n].mode = mode
    files[n].path = p
    files[n].data = t
    if mode == 'I' { files[n].pos = 0 } else { files[n].pos = t.length }
    fileCol = 0
}

// CLOSE [[#]n[,[#]m]...]; no list closes everything.
func stmtClose() {
    var n: int
    if atStmtEnd() {
        closeAllFiles()
        return
    }
    while true {
        skipOp('#')
        n = evalInt()
        if n < 1 or n > 3 { abort("Bad file number") }
        fileClose(n)
        if not skipOp(',') { break }
    }
}

// WRITE [#n,] items: strings quoted, numbers bare, commas between.
func stmtWrite() {
    var first: bool = true
    var v: Val
    var s: string
    var n: int
    if isOp('#') {
        pc = pc + 1
        n = evalInt()
        expectOp(',')
        printFile = fileForWrite(n)
    }
    while not atStmtEnd() {
        if not first { outStr(",") }
        first = false
        v = evalExpr()
        if v.isStr {
            outStr("\"" + v.s + "\"")
        } else {
            s = numStr(v.n)
            if s[0] == ' ' { s = s[1, s.length - 1] }
            outStr(s)
        }
        skipOp(',')
        skipOp(';')
    }
    outNewline()
    printFile = 0
}

func fileAtEnd(n: int): bool { return files[n].pos >= files[n].data.length }

// The next comma- or line-delimited item of an input file.
func fileReadItem(n: int): string {
    var item: string
    var c: char
    fileCheck(n)
    if files[n].mode != 'I' { abort("Bad file mode") }
    while not fileAtEnd(n) {
        c = files[n].data[files[n].pos]
        if c != ' ' and c != '\x0D' and c != '\x0A' { break }
        files[n].pos = files[n].pos + 1
    }
    if fileAtEnd(n) { abort("Input past end") }
    if files[n].data[files[n].pos] == '"' {
        files[n].pos = files[n].pos + 1
        while not fileAtEnd(n) and files[n].data[files[n].pos] != '"' {
            if item.length < 255 { item = item + files[n].data[files[n].pos] }
            files[n].pos = files[n].pos + 1
        }
        if not fileAtEnd(n) { files[n].pos = files[n].pos + 1 }
    } else {
        while not fileAtEnd(n) {
            c = files[n].data[files[n].pos]
            if c == ',' or c == '\x0D' or c == '\x0A' { break }
            if item.length < 255 { item = item + c }
            files[n].pos = files[n].pos + 1
        }
        while item.length > 0 and item[item.length - 1] == ' ' { item = item[0, item.length - 1] }
    }
    // consume the delimiter: a comma, or the line end (so EOF turns true
    // right after the last item, as in GW-BASIC)
    while not fileAtEnd(n) and files[n].data[files[n].pos] == ' ' { files[n].pos = files[n].pos + 1 }
    if not fileAtEnd(n) and files[n].data[files[n].pos] == ',' {
        files[n].pos = files[n].pos + 1
    } else {
        if not fileAtEnd(n) and files[n].data[files[n].pos] == '\x0D' { files[n].pos = files[n].pos + 1 }
        if not fileAtEnd(n) and files[n].data[files[n].pos] == '\x0A' { files[n].pos = files[n].pos + 1 }
    }
    return item
}

// The rest of the current line of an input file.
func fileReadLine(n: int): string {
    var item: string
    var c: char
    fileCheck(n)
    if files[n].mode != 'I' { abort("Bad file mode") }
    if fileAtEnd(n) { abort("Input past end") }
    while not fileAtEnd(n) {
        c = files[n].data[files[n].pos]
        if c == '\x0D' or c == '\x0A' { break }
        if item.length < 255 { item = item + c }
        files[n].pos = files[n].pos + 1
    }
    if not fileAtEnd(n) and files[n].data[files[n].pos] == '\x0D' { files[n].pos = files[n].pos + 1 }
    if not fileAtEnd(n) and files[n].data[files[n].pos] == '\x0A' { files[n].pos = files[n].pos + 1 }
    return item
}

// INPUT #n, vars  /  LINE INPUT #n, var$   (pc at the '#')
func stmtInputFile(lineMode: bool) {
    var n: int
    var key: string
    var idx: int
    var item: string
    var v: Val
    expectOp('#')
    n = evalInt()
    expectOp(',')
    while true {
        parseLValue()
        key = lvKey
        idx = lvIdx
        if lineMode { item = fileReadLine(n) } else { item = fileReadItem(n) }
        if isStrKey(key) {
            v = valStr(item)
        } else {
            v = valNum(numParsePrefix(item))
        }
        assignLValue(key, idx, v)
        if lineMode or not skipOp(',') { break }
    }
}

// --- Lifecycle -----------------------------------------------------------

func basicNew() {
    srcClear()
    prog.clear()
    clearVars()
    clearStacks()
    fns.clear()
    closeAllFiles()
    cursorCol = 0
    cursorRow = 1
    fromPrompt = false
    basicState = BIdle
}
