func keywordId(w: string): int {
    switch w {
    case "PRINT" { return K_PRINT }
    case "INPUT" { return K_INPUT }
    case "LET" { return K_LET }
    case "IF" { return K_IF }
    case "THEN" { return K_THEN }
    case "ELSE" { return K_ELSE }
    case "FOR" { return K_FOR }
    case "TO" { return K_TO }
    case "STEP" { return K_STEP }
    case "NEXT" { return K_NEXT }
    case "WHILE" { return K_WHILE }
    case "WEND" { return K_WEND }
    case "GOTO" { return K_GOTO }
    case "GOSUB" { return K_GOSUB }
    case "RETURN" { return K_RETURN }
    case "ON" { return K_ON }
    case "DIM" { return K_DIM }
    case "OPTION" { return K_OPTION }
    case "BASE" { return K_BASE }
    case "DEF" { return K_DEF }
    case "DEFINT" { return K_DEFINT }
    case "DEFSNG" { return K_DEFSNG }
    case "DEFDBL" { return K_DEFDBL }
    case "DEFSTR" { return K_DEFSTR }
    case "DATA" { return K_DATA }
    case "READ" { return K_READ }
    case "RESTORE" { return K_RESTORE }
    case "REM" { return K_REM }
    case "END" { return K_END }
    case "STOP" { return K_STOP }
    case "SWAP" { return K_SWAP }
    case "RANDOMIZE" { return K_RANDOMIZE }
    case "SLEEP" { return K_SLEEP }
    case "CLS" { return K_CLS }
    case "LOCATE" { return K_LOCATE }
    case "COLOR" { return K_COLOR }
    case "WIDTH" { return K_WIDTH }
    case "BEEP" { return K_BEEP }
    case "CLEAR" { return K_CLEAR }
    case "SYSTEM" { return K_SYSTEM }
    case "OPEN" { return K_OPEN }
    case "CLOSE" { return K_CLOSE }
    case "WRITE" { return K_WRITE }
    case "LINE" { return K_LINE }
    case "AS" { return K_AS }
    case "OUTPUT" { return K_OUTPUT }
    case "APPEND" { return K_APPEND }
    case "RUN" { return K_RUN }
    case "LIST" { return K_LIST }
    case "NEW" { return K_NEW }
    case "LOAD" { return K_LOAD }
    case "SAVE" { return K_SAVE }
    case "FILES" { return K_FILES }
    case "DELETE" { return K_DELETE }
    case "CONT" { return K_CONT }
    case "USING" { return K_USING }
    case "ERROR" { return K_ERROR }
    case "AND" { return K_AND }
    case "OR" { return K_OR }
    case "NOT" { return K_NOT }
    case "XOR" { return K_XOR }
    case "EQV" { return K_EQV }
    case "IMP" { return K_IMP }
    case "MOD" { return K_MOD }
    case "ABS" { return K_ABS }
    case "SGN" { return K_SGN }
    case "INT" { return K_INT }
    case "FIX" { return K_FIX }
    case "SQR" { return K_SQR }
    case "SIN" { return K_SIN }
    case "COS" { return K_COS }
    case "TAN" { return K_TAN }
    case "ATN" { return K_ATN }
    case "EXP" { return K_EXP }
    case "LOG" { return K_LOG }
    case "RND" { return K_RND }
    case "TIMER" { return K_TIMER }
    case "LEN" { return K_LEN }
    case "LEFT$" { return K_LEFTS }
    case "RIGHT$" { return K_RIGHTS }
    case "MID$" { return K_MIDS }
    case "INSTR" { return K_INSTR }
    case "STR$" { return K_STRS }
    case "VAL" { return K_VAL }
    case "CHR$" { return K_CHRS }
    case "ASC" { return K_ASC }
    case "SPACE$" { return K_SPACES }
    case "STRING$" { return K_STRINGS }
    case "UCASE$" { return K_UCASES }
    case "LCASE$" { return K_LCASES }
    case "LTRIM$" { return K_LTRIMS }
    case "RTRIM$" { return K_RTRIMS }
    case "HEX$" { return K_HEXS }
    case "OCT$" { return K_OCTS }
    case "INKEY$" { return K_INKEYS }
    case "POS" { return K_POS }
    case "CSRLIN" { return K_CSRLIN }
    case "ENVIRON$" { return K_ENVIRONS }
    case "EOF" { return K_EOF }
    case "FRE" { return K_FRE }
    case "TAB" { return K_TAB }
    case "SPC" { return K_SPC }
    case "CINT" { return K_CINT }
    case "CSNG" { return K_CSNG }
    case "CDBL" { return K_CDBL }
    case "SCREEN" { return K_SCREEN }
    case "PSET" { return K_PSET }
    case "PRESET" { return K_PRESET }
    case "CIRCLE" { return K_CIRCLE }
    case "PAINT" { return K_PAINT }
    case "DRAW" { return K_DRAW }
    case "GET" { return K_GET }
    case "PUT" { return K_PUT }
    case "PLAY" { return K_PLAY }
    case "SOUND" { return K_SOUND }
    case "LPRINT" { return K_LPRINT }
    case "LLIST" { return K_LLIST }
    case "PEEK" { return K_PEEK }
    case "POKE" { return K_POKE }
    case "INP" { return K_INP }
    case "OUT" { return K_OUT }
    case "CALL" { return K_CALL }
    case "USR" { return K_USR }
    case "FIELD" { return K_FIELD }
    case "LSET" { return K_LSET }
    case "RSET" { return K_RSET }
    case "CHAIN" { return K_CHAIN }
    case "COMMON" { return K_COMMON }
    case "RESUME" { return K_RESUME }
    case "ERR" { return K_ERR }
    case "ERL" { return K_ERL }
    case "VIEW" { return K_VIEW }
    case "WINDOW" { return K_WINDOW }
    case "PALETTE" { return K_PALETTE }
    case "KEY" { return K_KEY }
    case "SEG" { return K_SEG }
    case "WAIT" { return K_WAIT }
    case "VARPTR" { return K_VARPTR }
    }
    return 0
}

var prog: list of Tok             // the tokenized program
var lineIndex: intmap of int      // line number -> index of its TLine
var labels: map of int            // LABEL -> line number
var names: list of string         // interned variable names (with suffix)
var nameIds: map of int
var strPool: list of string       // string literals
var dataText: list of string      // raw text of every DATA statement
var dataLine: list of int         // ... and the line each is on

func internName(w: string): int {
    var id: int
    if nameIds.has(w) { return nameIds[w] }
    id = names.count
    names.add(w)
    nameIds[w] = id
    return id
}

func upperChar(c: char): char {
    if c >= 'a' and c <= 'z' { return char(int(c) - 32) }
    return c
}

func isLetter(c: char): bool {
    return (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')
}

func isDigitChar(c: char): bool { return c >= '0' and c <= '9' }

// Scanner state for the line being tokenized.
var tkSrc: text
var tkPos: int = 0
var tkLine: int = 0
var tkOut: list of Tok

func tkEmit(kind: TokKind, ival: int) {
    var t: Tok
    t.kind = kind
    t.ival = ival
    tkOut.add(t)
}

func tkEmitNum(v: Num) {
    var t: Tok
    t.kind = TNum
    t.num = v
    tkOut.add(t)
}

// Glue keywords that crunched code runs into a number: 1TO9, GOTO10.
func splitsBeforeDigit(w: string): int {
    var k: int = keywordId(w)
    if k == K_TO or k == K_THEN or k == K_ELSE or k == K_GOTO or k == K_GOSUB or k == K_STEP { return k }
    return 0
}

func tkStatementEnd(): bool {
    var n: int = tkOut.count
    if n == 0 { return true }
    if tkOut[n - 1].kind == TLine { return true }
    if tkOut[n - 1].kind == TOp and tkOut[n - 1].ival == int(':') { return true }
    if tkOut[n - 1].kind == TKw and (tkOut[n - 1].ival == K_THEN or tkOut[n - 1].ival == K_ELSE) { return true }
    return false
}

// Raw text after DATA up to an unquoted ':' or the end of the line.
func tkScanData() {
    var start: int = tkPos
    var inQuote: bool = false
    var s: string
    while tkPos < tkSrc.length {
        if tkSrc[tkPos] == '"' { inQuote = not inQuote }
        if tkSrc[tkPos] == ':' and not inQuote { break }
        tkPos = tkPos + 1
    }
    while start < tkPos and tkSrc[start] == ' ' { start = start + 1 }
    if tkPos - start > 255 { s = tkSrc[start, 255] } else { s = tkSrc[start, tkPos - start] }
    tkOut[tkOut.count - 1].aux = dataText.count
    dataText.add(s)
    dataLine.add(tkLine)
}

func tkWord() {
    var start: int = tkPos
    var w: string
    var k: int
    var i: int
    var c: char
    var pre: string
    while tkPos < tkSrc.length and (isLetter(tkSrc[tkPos]) or isDigitChar(tkSrc[tkPos]) or tkSrc[tkPos] == '.') {
        tkPos = tkPos + 1
    }
    if tkPos < tkSrc.length {
        c = tkSrc[tkPos]
        if c == '$' or c == '%' or c == '!' or c == '#' or c == '&' { tkPos = tkPos + 1 }
    }
    i = start
    while i < tkPos {
        w = w + upperChar(tkSrc[i])
        i = i + 1
    }
    k = keywordId(w)
    if k == 0 {
        // a keyword glued to a following number: TO9, GOTO10
        i = 0
        while i < w.length and isLetter(w[i]) { i = i + 1 }
        if i < w.length and i > 0 and isDigitChar(w[i]) {
            pre = w[0, i]
            k = splitsBeforeDigit(pre)
            if k != 0 {
                tkPos = start + i
                tkEmit(TKw, k)
                return
            }
        }
        // a label: WORD: at the start of the line
        if tkOut.count == 1 and tkPos < tkSrc.length and tkSrc[tkPos] == ':' and w[w.length - 1] != '$' {
            labels[w] = tkLine
            tkPos = tkPos + 1
            return
        }
        tkEmit(TId, internName(w))
        return
    }
    if k == K_REM {
        tkEmit(TKw, K_REM)
        tkPos = tkSrc.length
        return
    }
    tkEmit(TKw, k)
    if k == K_DATA { tkScanData() }
}

func tkString() {
    var s: string
    tkPos = tkPos + 1
    while tkPos < tkSrc.length and tkSrc[tkPos] != '"' {
        if s.length < 255 { s = s + tkSrc[tkPos] }
        tkPos = tkPos + 1
    }
    if tkPos < tkSrc.length { tkPos = tkPos + 1 }
    tkEmit(TStr, strPool.count)
    strPool.add(s)
}

func tkNumber() {
    var s: string
    var n: int = tkSrc.length - tkPos
    if n > 40 { n = 40 }
    s = tkSrc[tkPos, n]
    tkEmitNum(numParsePrefix(s))
    tkPos = tkPos + numParseEnd
}

func tokenizeText(t: text, lineNo: int, out: list of Tok) {
    var c: char
    var c2: char
    tkSrc = t
    tkPos = 0
    tkLine = lineNo
    tkOut = out
    tkEmit(TLine, lineNo)
    while tkPos < tkSrc.length {
        c = tkSrc[tkPos]
        if c == ' ' or c == '\x09' {
            tkPos = tkPos + 1
        } else if isLetter(c) {
            tkWord()
        } else if isDigitChar(c) or (c == '.' and tkPos + 1 < tkSrc.length and isDigitChar(tkSrc[tkPos + 1])) {
            tkNumber()
        } else if c == '&' and tkPos + 1 < tkSrc.length and (upperChar(tkSrc[tkPos + 1]) == 'H' or upperChar(tkSrc[tkPos + 1]) == 'O') {
            tkNumber()
        } else if c == '"' {
            tkString()
        } else if c == '\'' {
            tkEmit(TKw, K_REM)
            tkPos = tkSrc.length
        } else if c == '?' {
            tkEmit(TKw, K_PRINT)
            tkPos = tkPos + 1
        } else {
            c2 = ' '
            if tkPos + 1 < tkSrc.length { c2 = tkSrc[tkPos + 1] }
            if (c == '<' and c2 == '=') or (c == '=' and c2 == '<') {
                tkEmit(TOp, O_LE)
                tkPos = tkPos + 2
            } else if (c == '>' and c2 == '=') or (c == '=' and c2 == '>') {
                tkEmit(TOp, O_GE)
                tkPos = tkPos + 2
            } else if (c == '<' and c2 == '>') or (c == '>' and c2 == '<') {
                tkEmit(TOp, O_NE)
                tkPos = tkPos + 2
            } else {
                tkEmit(TOp, int(c))
                tkPos = tkPos + 1
            }
        }
    }
    tkEmit(TEnd, 0)
}

func tokenizeLine(s: string, lineNo: int, out: list of Tok) {
    var t: text = s
    tokenizeText(t, lineNo, out)
}

// RUN: the whole source into prog, one TEnd at the end.
func tokenizeProgram() {
    var i: int = 0
    var n: int
    prog.clear()
    lineIndex.clear()
    labels.clear()
    names.clear()
    nameIds.clear()
    strPool.clear()
    dataText.clear()
    dataLine.clear()
    while i < srcNumbers.count {
        n = srcNumbers[i]
        lineIndex[n] = prog.count
        tokenizeText(srcLines[n], n, prog)
        prog.pop()                      // each line's own TEnd
        i = i + 1
    }
    tkOut = prog
    tkEmit(TEnd, 0)
}

// --- Lifecycle -----------------------------------------------------------

func basicNew() {
    srcClear()
    prog.clear()
    basicState = BIdle
}
