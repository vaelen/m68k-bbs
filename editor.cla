// Post editor: a classic BBS line editor for new posts and replies
// (WWIV style). Text is typed at numbered prompts, one display row
// each (terminal width minus the prompt): typing past the end of a
// row starts the next row with no newline in the text, Enter ends a
// row with one, and backspacing past the start of a row goes back to
// the end of the previous row (removing its newline if it had one).
// A line starting with '/' is a command (/S save, /A abort, /L list,
// /D n, /E n, /I n, /R n, /?). Each stored row carries its own CR
// when it was ended with Enter, so the body is just the rows joined
// end to end; the viewer re-wraps it to each reader's width.

var editLines: list of string
var editSubject: string(63)
var editThread: int = 0
var editPending: char = ' '     // 'E'/'I': next line replaces/inserts;
                                // 'R': awaiting /R's Original text,
                                // 'T': awaiting its Replacement
var editPendingLine: int = 0
var editPendingHard: bool = false   // /E target row ended with Enter
var editOriginal: string
var editTarget: char = 'P'      // 'P' board post, 'M' private mail,
                                // 'F' file long description (files.cla)

// ponytail: 100 lines max; raise if real posts ever hit it.
const editMaxLines: int = 100

// A closed one-row banner (title only, no open frame below it).
func sendEditorBanner(title: string) {
    var w: list of int
    var cells: list of string
    postViewWidths(w)
    cells.add(center(title, w[0]))
    sendLine("")
    sendRule(TopLeft, TopCenter, TopRight, w)
    sendLine(rowLine(cells, w))
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func startNewPost() {
    editTarget = 'P'
    editThread = 0
    editSubject = ""
    editLines.clear()
    editPending = ' '
    sendEditorBanner("New Post - " + board.name)
    user.screen = "editsubject"
    displayPrompt()
}

// Reply to the currently viewed post: subject defaults to Re: <orig>,
// thread is the original's thread (its own id if it's the starter).
func startReply() {
    var sub: string = post.subject
    editTarget = 'P'
    if post.threadId == 0 {
        editThread = post.id
    } else {
        editThread = post.threadId
    }
    if sub.length < 4 or sub[0, 4] != "Re: " {
        if sub.length > 59 { sub = sub[0, 59] }
        sub = "Re: " + sub
    }
    editSubject = sub
    editLines.clear()
    editPending = ' '
    sendEditorBanner("Reply - " + board.name)
    user.screen = "editsubject"
    displayPrompt()
}

func editSubjectPrompt() {
    if editSubject == "" {
        sendData("Subject: ")
    } else {
        sendData("Subject [" + editSubject + "]: ")
    }
}

// Empty input takes the default (replies) or aborts (new posts, which
// have none); /A always aborts.
func editSubjectInput(input: string) {
    if upperStr(input) == "/A" or (input == "" and editSubject == "") {
        abortEditor()
        return
    }
    if input != "" {
        if input.length > 63 {
            sendLine("Subjects are limited to 63 characters.")
            displayPrompt()
            return
        }
        editSubject = input
    }
    sendLine("Enter your message, one line at a time.")
    sendLine("/S saves, /A aborts, /? lists commands.")
    user.screen = "editbody"
    displayPrompt()
}

func abortEditor() {
    if editTarget == 'F' {
        fileDescAbort()
        return
    }
    if editTarget == 'M' {
        sendLine("Message aborted.")
        backToInbox()
        return
    }
    sendLine("Post aborted.")
    backToPosts()
}

func backToPosts() {
    user.screen = "posts"
    drawPostList()
    displayPrompt()
}

// Numbered line prompt; a pending /E or /I prompts with its target,
// and /R's two steps prompt for the text to change.
func editBodyPrompt() {
    var n: int = editLines.count + 1
    if editPending == 'R' {
        sendData("Original: ")
        return
    }
    if editPending == 'T' {
        sendData("Replacement: ")
        return
    }
    if editPending != ' ' { n = editPendingLine }
    sendData(padLeft(intStr(n), 3) + ": ")
    lineLimit = terminal.columns - 5   // one display row per numbered line
}

// Pre-load the editor rows from an existing body: each CR ends a hard
// row (kept with its newline, the storage format above); a line longer
// than the display keeps splitting into soft rows, the same shape
// typing it would have produced.
func seedEditorBody(body: text) {
    var i: int = 0
    var line: string = ""
    var limit: int = terminal.columns - 5
    var c: char
    editLines.clear()
    if limit < 1 { limit = 1 }
    while i < body.length {
        c = body[i]
        i = i + 1
        if c == '\x0A' { continue }
        if c == '\x0D' {
            editLines.add(line + "\n")
            line = ""
        } else {
            line = line + c
            if line.length >= limit {
                editLines.add(line)      // soft row: continues on the next
                line = ""
            }
        }
    }
    if line != "" { editLines.add(line + "\n") }
}

// Row i's text without its trailing CR, and whether it had one.
func rowText(i: int): string {
    var row: string = editLines[i]
    if rowHard(i) { return row[0, row.length - 1] }
    return row
}

func rowHard(i: int): bool {
    var row: string = editLines[i]
    return row.length > 0 and row[row.length - 1] == '\n'
}

// Backspace at the start of a row: pop the previous row back into the
// input buffer (dropping its newline, if any) and redisplay it, the
// same way a rubout across a wrapped row redraws. The first row has
// nothing before it, and /E, /I and /R prompts stay put.
func editJoinPrevious() {
    if editPending != ' ' or editLines.count == 0 { return }
    user.buffer = rowText(editLines.count - 1)
    editLines.remove(editLines.count - 1)
    sendData(terminal.eol)
    displayPrompt()
    echoBuffer()
}

func editorHelp() {
    sendLine("/S save    /A abort    /L list")
    sendLine("/D n  delete line n")
    sendLine("/E n  replace line n")
    sendLine("/I n  insert before line n")
    sendLine("/R n  replace text in line n")
}

// Prefix and line sent separately: a full 255-byte line would clamp
// off the tail if concatenated with its number.
func listEditLines() {
    var i: int = 0
    while i < editLines.count {
        sendData(padLeft(intStr(i + 1), 3) + ": ")
        sendLine(rowText(i))
        i = i + 1
    }
}

func editorCommand(input: string) {
    var letter: char = ' '
    var n: int = 0
    if input.length >= 2 { letter = upperStr(input)[1] }
    if input.length > 2 {
        n = parseIntStr(trimStr(input[2, input.length - 2]))
    }
    switch letter {
    case 'S' { saveEditor() }
    case 'A' { abortEditor() }
    case 'L' {
        listEditLines()
        displayPrompt()
    }
    case 'D' {
        if n >= 1 and n <= editLines.count {
            editLines.remove(n - 1)
        } else {
            sendLine("No such line.")
        }
        displayPrompt()
    }
    case 'E' {
        if n >= 1 and n <= editLines.count {
            sendData(intStr(n) + " was: ")
            sendLine(rowText(n - 1))
            editPending = 'E'
            editPendingLine = n
            editPendingHard = rowHard(n - 1)
        } else {
            sendLine("No such line.")
        }
        displayPrompt()
    }
    case 'I' {
        if n >= 1 and n <= editLines.count {
            editPending = 'I'
            editPendingLine = n
            editPendingHard = true   // an inserted line is a full line
        } else {
            sendLine("No such line.")
        }
        displayPrompt()
    }
    case 'R' {
        if n >= 1 and n <= editLines.count {
            editPending = 'R'
            editPendingLine = n
        } else {
            sendLine("No such line.")
        }
        displayPrompt()
    }
    case '?' {
        editorHelp()
        displayPrompt()
    }
    else {
        sendLine("Unknown command. /? for help.")
        displayPrompt()
    }
    }
}

// Swap `repl` in for the first occurrence of editOriginal in the /R
// target line, then echo the result.
func applyReplace(repl: string) {
    var line: string = editLines[editPendingLine - 1]
    var i: int = line.indexOf(editOriginal)
    var tail: string
    var tmp: list of string
    var j: int = 0
    editPending = ' '
    if i < 0 {
        sendLine("Not found.")
        displayPrompt()
        return
    }
    if line.length - editOriginal.length + repl.length > 255 {
        sendLine("Line too long.")
        displayPrompt()
        return
    }
    tail = line[i + editOriginal.length, line.length - i - editOriginal.length]
    line = line[0, i] + repl + tail
    tmp = editLines.clone()
    editLines.clear()
    while j < tmp.count {
        if j == editPendingLine - 1 {
            editLines.add(line)
        } else {
            editLines.add(tmp[j])
        }
        j = j + 1
    }
    sendData(padLeft(intStr(editPendingLine), 3) + ": ")
    sendLine(line)
    displayPrompt()
}

func editBodyInput(input: string) {
    var tmp: list of string
    var row: string
    var i: int = 0
    // /R's sub-prompts take their input literally (a body line may
    // well contain slashes); empty Original cancels.
    if editPending == 'R' {
        if input == "" {
            editPending = ' '
            sendLine("Nothing to replace.")
        } else {
            editOriginal = input
            editPending = 'T'
        }
        displayPrompt()
        return
    }
    if editPending == 'T' {
        applyReplace(input)
        return
    }
    if not inputSoft and input.length >= 1 and input[0] == '/' {
        editorCommand(input)
        return
    }
    // A row ended with Enter keeps its newline; a row that simply
    // filled up (inputSoft) continues on the next one.
    row = input
    if not inputSoft {
        // a completed line gets its newline; /E keeps the replaced
        // row's status (editPendingHard, which /I sets)
        if editPending == ' ' or editPendingHard { row = row + "\n" }
    }
    if editPending != ' ' {
        // replace ('E') or insert-before ('I') via rebuild -- lists
        // have no assign-at or insert-at.
        tmp = editLines.clone()
        editLines.clear()
        while i < tmp.count {
            if i == editPendingLine - 1 {
                editLines.add(row)
                if editPending == 'I' { editLines.add(tmp[i]) }
            } else {
                editLines.add(tmp[i])
            }
            i = i + 1
        }
        if inputSoft {
            // the overflow continues as an insert before the next row
            editPending = 'I'
            editPendingLine = editPendingLine + 1
        } else {
            editPending = ' '
        }
        displayPrompt()
        return
    }
    if editLines.count >= editMaxLines {
        sendLine("Message full -- /S to save or /A to abort.")
        displayPrompt()
        return
    }
    editLines.add(row)
    displayPrompt()
}

func saveEditor() {
    var body: text
    var i: int = 0
    while i < editLines.count {
        body = body + editLines[i]   // rows carry their own newlines
        i = i + 1
    }
    if editTarget == 'F' {
        fileDescSave(body)
        return
    }
    if editTarget == 'M' {
        if sendMail(user.name, user.id, mailToName, mailToId, editSubject, body) >= 1 {
            sendLine("Message sent.")
        } else {
            sendLine("Send failed: " + lastError.message)
        }
        backToInbox()
        return
    }
    if addPost(user.name, editThread, editSubject, body) >= 1 {
        sendLine("Post saved.")
        postPage = 1
    } else {
        sendLine("Save failed: " + lastError.message)
    }
    backToPosts()
}
