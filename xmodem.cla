// XMODEM / XMODEM-1K / YMODEM sender, driven one byte / one tick at a
// time so the runtime's receive pump is never starved. Pure: talks to
// the world only through readAt on its own handle and two callbacks
// the including program defines:
//   xferOut(t: text)     -- bytes for the caller (bbs.cla: telnetSend)
//   xferDone(ok: bool)   -- transfer over; the engine is idle already
// bbs.cla feeds xmodemChar from inputChar on the "xfer" screen and
// xmodemTick from the 30-tick timer (one tick = half a second).
//
// Modes (xmMode): 'X' XMODEM, 128-byte blocks, CRC if the receiver
// starts with C, checksum on NAK. '1' XMODEM-1K: 1024-byte STX blocks
// while at least 1K remains, 128-byte SOH blocks for the tail. 'Y'
// YMODEM: 1K/CRC plus block 0 (name NUL size NUL) before the data
// and an empty block 0 after the EOT to end the one-file batch.
// Design: docs/file-transfers.md.

const xmSOH: char = '\x01'
const xmSTX: char = '\x02'
const xmEOT: char = '\x04'
const xmACK: char = '\x06'
const xmNAK: char = '\x15'
const xmCAN: char = '\x18'
const xmSUB: char = '\x1A'
const xmNUL: char = '\x00'

const xmStartTicks: int = 120   // 60 s for the receiver's first C/NAK
const xmAckTicks: int = 20      // 10 s per ACK
const xmMaxErrors: int = 10

enum XmState {
    xmIdle
    xmWaitStart        // receiver's first C / NAK
    xmWaitHeaderAck    // YMODEM: block 0 sent
    xmWaitDataStart    // YMODEM: block 0 ACKed, waiting for C
    xmWaitAck          // data block sent
    xmWaitEotAck       // EOT sent
    xmWaitBatchStart   // YMODEM: EOT ACKed, waiting for C
    xmWaitEndAck       // YMODEM: empty block 0 sent
}

var xmFile: filehandle
var xmMode: char = 'X'
var xmName: string(63)         // for YMODEM's block 0
var xmSize: int = 0
var xmPos: int = 0             // next file byte to send
var xmBlock: int = 1           // next block number, wraps mod 256
var xmCrc: bool = false
var xmState: XmState = xmIdle
var xmTimer: int = 0           // ticks in the current state
var xmErrors: int = 0
var xmCanCount: int = 0
var xmLast: text               // last frame, resent verbatim
var xmLastData: int = 0        // file bytes carried by xmLast

// CRC-16/XMODEM: poly 0x1021, init 0, no reflection, no final XOR.
// ponytail: bitwise loop (8 steps per byte); swap for text.crc16x
// when the runtime grows it (docs/language-gaps.md #8).
func crcXmodem(t: text): int {
    var crc: int = 0
    var i: int = 0
    var b: int = 0
    while i < t.length {
        crc = crc ^ (int(t[i]) << 8)
        b = 0
        while b < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            b = b + 1
        }
        i = i + 1
    }
    return crc
}

func xmodemSendStart(path: string, name: string, mode: char) {
    xmFile = file.open(path)
    if xmFile == nil {
        log("XMODEM: cannot open " + path + ": " + lastError.message)
        xferDone(false)
        return
    }
    xmMode = mode
    xmName = name
    xmSize = xmFile.size()
    xmPos = 0
    xmBlock = 1
    xmCrc = false
    xmTimer = 0
    xmErrors = 0
    xmCanCount = 0
    xmState = xmWaitStart
}

func xmodemChar(c: char) {
    if xmState == xmIdle { return }
    if c == xmCAN {
        xmCanCount = xmCanCount + 1
        if xmCanCount >= 2 {
            log("XMODEM: cancelled by the caller.")
            xmFinish(false)
        }
        return
    }
    xmCanCount = 0
    switch xmState {
    case xmWaitStart {
        if c == 'C' {
            xmCrc = true
        } else if c == xmNAK and xmMode != 'Y' {
            xmCrc = false
        } else {
            return
        }
        if xmMode == 'Y' {
            xmSendHeader(xmName, string(xmSize))
            xmState = xmWaitHeaderAck
            xmTimer = 0
        } else {
            xmNext()
        }
    }
    case xmWaitHeaderAck {
        if c == xmACK {
            xmState = xmWaitDataStart
            xmTimer = 0
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitDataStart {
        if c == 'C' { xmNext() }
    }
    case xmWaitAck {
        if c == xmACK {
            xmPos = xmPos + xmLastData
            xmBlock = (xmBlock + 1) mod 256
            xmNext()
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitEotAck {
        if c == xmACK {
            if xmMode == 'Y' {
                xmState = xmWaitBatchStart
                xmTimer = 0
            } else {
                xmFinish(true)
            }
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitBatchStart {
        if c == 'C' {
            xmSendHeader("", "")
            xmState = xmWaitEndAck
            xmTimer = 0
        }
    }
    case xmWaitEndAck {
        if c == xmACK {
            xmFinish(true)
        } else if c == xmNAK {
            xmRetry()
        }
    }
    }
}

func xmodemTick() {
    if xmState == xmIdle { return }
    xmTimer = xmTimer + 1
    if xmState == xmWaitStart {
        if xmTimer >= xmStartTicks {
            log("XMODEM: no receiver started.")
            xmCancel()
        }
        return
    }
    if xmTimer >= xmAckTicks { xmRetry() }
}

// The line is gone: release the file, tell nobody.
func xmodemAbort() {
    if xmState == xmIdle { return }
    xmFile.close()
    xmFile = nil
    xmState = xmIdle
}

// --- internals ---------------------------------------------------------

func xmNext() {
    if xmPos >= xmSize {
        xmSendEot()
    } else {
        xmSendBlock()
    }
}

// Frame the payload as block xmBlock: SOH/STX, number, complement,
// data, then CRC-16 or the 8-bit sum. Sets xmLast.
func xmFrame(data: text) {
    var i: int = 0
    var sum: int = 0
    var crc: int = 0
    xmLast = ""
    if data.length == 1024 {
        xmLast.append(xmSTX)
    } else {
        xmLast.append(xmSOH)
    }
    xmLast.append(char(xmBlock))
    xmLast.append(char(255 - xmBlock))
    while i < data.length {
        xmLast.append(data[i])
        sum = sum + int(data[i])
        i = i + 1
    }
    if xmCrc {
        crc = crcXmodem(data)
        xmLast.append(char(crc >> 8))
        xmLast.append(char(crc))
    } else {
        xmLast.append(char(sum))
    }
}

func xmSendBlock() {
    var buf: text
    var want: int = 128
    if xmMode != 'X' and xmSize - xmPos >= 1024 { want = 1024 }
    if not xmFile.readAt(xmPos, want, buf) {
        log("XMODEM: read failed: " + lastError.message)
        xmCancel()
        return
    }
    xmLastData = buf.length
    while buf.length < want { buf.append(xmSUB) }
    xmFrame(buf)
    xferOut(xmLast)
    xmState = xmWaitAck
    xmTimer = 0
}

// YMODEM block 0: "name NUL size NUL", NUL-padded to 128 bytes, CRC.
// An empty name is the end-of-batch block. The caller sets the state.
func xmSendHeader(name: string, size: string) {
    var buf: text
    buf.append(name)
    buf.append(xmNUL)
    if name != "" {
        buf.append(size)
        buf.append(xmNUL)
    }
    while buf.length < 128 { buf.append(xmNUL) }
    xmBlock = 0
    xmFrame(buf)
    xmBlock = 1
    xferOut(xmLast)
}

func xmOutStr(s: string) {
    var t: text
    t = s
    xferOut(t)
}

func xmSendEot() {
    xmOutStr("\x04")
    xmState = xmWaitEotAck
    xmTimer = 0
}

// NAK or timeout: resend the current frame, up to the error ceiling.
// The two YMODEM waits for a C have nothing to resend; they just wait.
func xmRetry() {
    xmErrors = xmErrors + 1
    if xmErrors >= xmMaxErrors {
        log("XMODEM: too many errors.")
        xmCancel()
        return
    }
    xmTimer = 0
    switch xmState {
    case xmWaitEotAck { xmOutStr("\x04") }
    case xmWaitDataStart, xmWaitBatchStart { }
    else { xferOut(xmLast) }
    }
}

// Our side gives up: tell the receiver, then finish.
func xmCancel() {
    xmOutStr("\x18\x18\x18")
    xmFinish(false)
}

func xmFinish(ok: bool) {
    xmFile.close()
    xmFile = nil
    xmState = xmIdle
    xferDone(ok)
}
