// XMODEM / XMODEM-1K / YMODEM sender and receiver, driven one byte /
// one tick at a time so the runtime's receive pump is never starved.
// Pure: talks to the world only through its own filehandle and the
// callbacks the including program defines:
//   xferOut(t: text)                 -- bytes for the caller (telnetSend)
//   xferDone(ok: bool)               -- transfer over; the engine is idle
//   xferReceived(name, bytes)        -- an uploaded file is on disk
//   xferAcceptName(name): bool       -- may a YMODEM-supplied name be used?
// bbs.cla feeds xmodemChar from inputChar on the "xfer" screen and
// xmodemTick from the 30-tick timer (one tick = half a second).
//
// Modes (xmMode): 'X' XMODEM, 128-byte blocks, CRC if the receiver
// starts with C, checksum on NAK. '1' XMODEM-1K: 1024-byte STX blocks
// while at least 1K remains, 128-byte SOH blocks for the tail. 'Y'
// YMODEM: 1K/CRC plus block 0 (name NUL size NUL) before the data
// and an empty block 0 after the EOT to end the one-file batch.
// Design: docs/file-transfers.md.

const xmSOH: char = '\x01'
const xmSTX: char = '\x02'
const xmEOT: char = '\x04'
const xmACK: char = '\x06'
const xmNAK: char = '\x15'
const xmCAN: char = '\x18'
const xmSUB: char = '\x1A'
const xmNUL: char = '\x00'

const xmStartTicks: int = 120   // 60 s for the receiver's first C/NAK
const xmAckTicks: int = 20      // 10 s per ACK
const xmMaxErrors: int = 10

enum XmState {
    xmIdle
    xmWaitStart        // receiver's first C / NAK
    xmWaitHeaderAck    // YMODEM: block 0 sent
    xmWaitDataStart    // YMODEM: block 0 ACKed, waiting for C
    xmWaitAck          // data block sent
    xmWaitEotAck       // EOT sent
    xmWaitBatchStart   // YMODEM: EOT ACKed, waiting for C
    xmWaitEndAck       // YMODEM: empty block 0 sent
}

var xmFile: filehandle
var xmMode: char = 'X'
var xmName: string(63)         // for YMODEM's block 0
var xmSize: int = 0
var xmPos: int = 0             // next file byte to send
var xmBlock: int = 1           // next block number, wraps mod 256
var xmCrc: bool = false
var xmState: XmState = xmIdle
var xmTimer: int = 0           // ticks in the current state
var xmErrors: int = 0
var xmCanCount: int = 0
var xmLast: text               // last frame, resent verbatim
var xmLastData: int = 0        // file bytes carried by xmLast

// CRC-16/XMODEM: poly 0x1021, init 0, no reflection, no final XOR.
// ponytail: bitwise loop (8 steps per byte); swap for text.crc16x
// when the runtime grows it (docs/language-gaps.md #8).
func crcXmodem(t: text): int {
    var crc: int = 0
    var i: int = 0
    var b: int = 0
    while i < t.length {
        crc = crc ^ (int(t[i]) << 8)
        b = 0
        while b < 8 {
            if (crc & 0x8000) != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            b = b + 1
        }
        i = i + 1
    }
    return crc
}

func xmodemSendStart(path: string, name: string, mode: char) {
    xmFile = file.open(path)
    if xmFile == nil {
        log("XMODEM: cannot open " + path + ": " + lastError.message)
        xferDone(false)
        return
    }
    xmMode = mode
    xmName = name
    xmSize = xmFile.size()
    xmPos = 0
    xmBlock = 1
    xmCrc = false
    xmTimer = 0
    xmErrors = 0
    xmCanCount = 0
    xmState = xmWaitStart
}

func xmodemChar(c: char) {
    if rvState != rvIdle {
        xmodemRecvChar(c)
        return
    }
    if xmState == xmIdle { return }
    if c == xmCAN {
        xmCanCount = xmCanCount + 1
        if xmCanCount >= 2 {
            log("XMODEM: cancelled by the caller.")
            xmFinish(false)
        }
        return
    }
    xmCanCount = 0
    switch xmState {
    case xmWaitStart {
        if c == 'C' {
            xmCrc = true
        } else if c == xmNAK and xmMode != 'Y' {
            xmCrc = false
        } else {
            return
        }
        if xmMode == 'Y' {
            xmSendHeader(xmName, string(xmSize))
            xmState = xmWaitHeaderAck
            xmTimer = 0
        } else {
            xmNext()
        }
    }
    case xmWaitHeaderAck {
        if c == xmACK {
            xmState = xmWaitDataStart
            xmTimer = 0
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitDataStart {
        if c == 'C' { xmNext() }
    }
    case xmWaitAck {
        if c == xmACK {
            xmPos = xmPos + xmLastData
            xmBlock = (xmBlock + 1) mod 256
            xmNext()
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitEotAck {
        if c == xmACK {
            if xmMode == 'Y' {
                xmState = xmWaitBatchStart
                xmTimer = 0
            } else {
                xmFinish(true)
            }
        } else if c == xmNAK {
            xmRetry()
        }
    }
    case xmWaitBatchStart {
        if c == 'C' {
            xmSendHeader("", "")
            xmState = xmWaitEndAck
            xmTimer = 0
        }
    }
    case xmWaitEndAck {
        if c == xmACK {
            xmFinish(true)
        } else if c == xmNAK {
            xmRetry()
        }
    }
    }
}

func xmodemTick() {
    if rvState != rvIdle {
        xmodemRecvTick()
        return
    }
    if xmState == xmIdle { return }
    xmTimer = xmTimer + 1
    if xmState == xmWaitStart {
        if xmTimer >= xmStartTicks {
            log("XMODEM: no receiver started.")
            xmCancel()
        }
        return
    }
    if xmTimer >= xmAckTicks { xmRetry() }
}

// The line is gone: release the file, tell nobody.
func xmodemAbort() {
    if rvState != rvIdle {
        xmodemRecvAbort()
        return
    }
    if xmState == xmIdle { return }
    xmFile.close()
    xmFile = nil
    xmState = xmIdle
}

// --- internals ---------------------------------------------------------

func xmNext() {
    if xmPos >= xmSize {
        xmSendEot()
    } else {
        xmSendBlock()
    }
}

// Frame the payload as block xmBlock: SOH/STX, number, complement,
// data, then CRC-16 or the 8-bit sum. Sets xmLast.
func xmFrame(data: text) {
    var i: int = 0
    var sum: int = 0
    var crc: int = 0
    xmLast = ""
    if data.length == 1024 {
        xmLast.append(xmSTX)
    } else {
        xmLast.append(xmSOH)
    }
    xmLast.append(char(xmBlock))
    xmLast.append(char(255 - xmBlock))
    while i < data.length {
        xmLast.append(data[i])
        sum = sum + int(data[i])
        i = i + 1
    }
    if xmCrc {
        crc = crcXmodem(data)
        xmLast.append(char(crc >> 8))
        xmLast.append(char(crc))
    } else {
        xmLast.append(char(sum))
    }
}

func xmSendBlock() {
    var buf: text
    var want: int = 128
    if xmMode != 'X' and xmSize - xmPos >= 1024 { want = 1024 }
    if not xmFile.readAt(xmPos, want, buf) {
        log("XMODEM: read failed: " + lastError.message)
        xmCancel()
        return
    }
    xmLastData = buf.length
    while buf.length < want { buf.append(xmSUB) }
    xmFrame(buf)
    xferOut(xmLast)
    xmState = xmWaitAck
    xmTimer = 0
}

// YMODEM block 0: "name NUL size NUL", NUL-padded to 128 bytes, CRC.
// An empty name is the end-of-batch block. The caller sets the state.
func xmSendHeader(name: string, size: string) {
    var buf: text
    buf.append(name)
    buf.append(xmNUL)
    if name != "" {
        buf.append(size)
        buf.append(xmNUL)
    }
    while buf.length < 128 { buf.append(xmNUL) }
    xmBlock = 0
    xmFrame(buf)
    xmBlock = 1
    xferOut(xmLast)
}

func xmOutStr(s: string) {
    var t: text
    t = s
    xferOut(t)
}

func xmSendEot() {
    xmOutStr("\x04")
    xmState = xmWaitEotAck
    xmTimer = 0
}

// NAK or timeout: resend the current frame, up to the error ceiling.
// The two YMODEM waits for a C have nothing to resend; they just wait.
func xmRetry() {
    xmErrors = xmErrors + 1
    if xmErrors >= xmMaxErrors {
        log("XMODEM: too many errors.")
        xmCancel()
        return
    }
    xmTimer = 0
    switch xmState {
    case xmWaitEotAck { xmOutStr("\x04") }
    case xmWaitDataStart, xmWaitBatchStart { }
    else { xferOut(xmLast) }
    }
}

// Our side gives up: tell the receiver, then finish.
func xmCancel() {
    xmOutStr("\x18\x18\x18")
    xmFinish(false)
}

func xmFinish(ok: bool) {
    xmFile.close()
    xmFile = nil
    xmState = xmIdle
    xferDone(ok)
}

// --- Receive side --------------------------------------------------------
// The same three modes, receiving: prod the sender with C (CRC) -- or,
// for XMODEM/1K after four unanswered Cs, NAK (checksum) -- assemble
// each frame byte by byte, write good blocks with writeAt, ACK them,
// NAK bad ones after the line goes quiet, ACK the EOT. YMODEM: block 0
// names the file (and may give its size, used to trim the padding);
// an empty block 0 ends the batch. Each finished file is reported via
// xferReceived(name, bytes); names off the wire are vetted through
// xferAcceptName(name) first.

enum RvState {
    rvIdle
    rvWaitFrame    // between frames: SOH/STX/EOT/CAN
    rvNum          // block number
    rvInv          // its complement
    rvData         // payload bytes
    rvCheck        // CRC (2) or checksum (1)
    rvPurge        // bad frame: discard until the line is quiet, then NAK
}

const rvProdTicks: int = 6        // a C/NAK every 3 s while waiting to start
const rvCrcTries: int = 4         // Cs before falling back to checksum (X/1)

var rvState: RvState = rvIdle
var rvMode: char = 'X'
var rvFolder: string
var rvName: string(63)
var rvFile: filehandle
var rvHaveFile: bool = false
var rvWritten: int = 0
var rvExpectSize: int = 0        // YMODEM block 0 size; 0 = unknown
var rvBlock: int = 1             // next expected block number
var rvExpectHeader: bool = false // YMODEM: the next frame is a block 0
var rvProd: bool = false         // send C/NAK on the tick until a frame arrives
var rvProds: int = 0
var rvCrc: bool = true
var rvNeed: int = 0
var rvNumByte: int = 0
var rvInvByte: int = 0
var rvBuf: text
var rvCheckVal: int = 0
var rvCheckGot: int = 0
var rvTimer: int = 0
var rvErrors: int = 0
var rvCanCount: int = 0

func xmodemRecvStart(mode: char, folder: string, name: string) {
    rvMode = mode
    rvFolder = folder
    rvName = name
    rvHaveFile = false
    rvWritten = 0
    rvExpectSize = 0
    rvBlock = 1
    rvExpectHeader = (mode == 'Y')
    rvCrc = true
    rvErrors = 0
    rvCanCount = 0
    rvState = rvWaitFrame
    if mode != 'Y' {
        if not rvOpen(name) { return }
    }
    rvStartProd()
}

// Start prodding the sender: one C now, more on the tick.
func rvStartProd() {
    rvProd = true
    rvProds = 1
    rvTimer = 0
    xmOutStr("C")
}

func rvPath(name: string): string {
    if rvFolder.length == 0 { return name }
    return rvFolder + ":" + name
}

func rvOpen(name: string): bool {
    rvFile = file.create(rvPath(name), "BINA", "68BB")
    if rvFile == nil {
        log("Upload: cannot create " + rvPath(name) + ": " + lastError.message)
        rvFinish(false)
        return false
    }
    rvName = name
    rvHaveFile = true
    rvWritten = 0
    rvBlock = 1
    return true
}

func xmodemRecvChar(c: char) {
    switch rvState {
    case rvWaitFrame {
        if c == xmCAN {
            rvCanCount = rvCanCount + 1
            if rvCanCount >= 2 {
                log("Upload: cancelled by the caller.")
                rvFinish(false)
            }
            return
        }
        rvCanCount = 0
        if c == xmSOH or c == xmSTX {
            if c == xmSOH { rvNeed = 128 } else { rvNeed = 1024 }
            rvBuf = ""
            rvProd = false
            rvState = rvNum
            rvTimer = 0
        } else if c == xmEOT {
            xmOutStr("\x06")
            if rvHaveFile { rvFileDone() }
            if rvMode == 'Y' {
                rvExpectHeader = true
                rvStartProd()
            } else {
                rvFinish(true)
            }
        }
    }
    case rvNum {
        rvNumByte = int(c)
        rvState = rvInv
        rvTimer = 0
    }
    case rvInv {
        rvInvByte = int(c)
        rvState = rvData
        rvTimer = 0
    }
    case rvData {
        rvBuf.append(c)
        rvTimer = 0
        if rvBuf.length == rvNeed {
            rvCheckVal = 0
            rvCheckGot = 0
            rvState = rvCheck
        }
    }
    case rvCheck {
        rvCheckVal = rvCheckVal * 256 + int(c)
        rvCheckGot = rvCheckGot + 1
        rvTimer = 0
        if (rvCrc and rvCheckGot == 2) or (not rvCrc and rvCheckGot == 1) {
            rvFrameDone()
        }
    }
    case rvPurge {
        rvTimer = 0     // still noisy; keep waiting for quiet
    }
    }
}

func xmodemRecvTick() {
    if rvState == rvIdle { return }
    rvTimer = rvTimer + 1
    switch rvState {
    case rvWaitFrame {
        if rvProd {
            if rvTimer >= xmStartTicks {
                log("Upload: no sender started.")
                rvCancel()
            } else if rvTimer mod rvProdTicks == 0 {
                rvProds = rvProds + 1
                if rvMode != 'Y' and rvProds > rvCrcTries {
                    rvCrc = false           // ponytail: a late CRC frame
                    xmOutStr("\x15")        // then fails its check; the
                } else {                    // error ceiling ends that loop
                    xmOutStr("C")
                }
            }
        } else if rvTimer >= xmAckTicks {
            rvError()                       // sender stalled between frames
        }
    }
    case rvPurge {
        if rvTimer >= 2 {                   // 1 s of quiet
            xmOutStr("\x15")
            rvState = rvWaitFrame
            rvTimer = 0
        }
    }
    else {
        if rvTimer >= 2 { rvError() }       // stalled inside a frame
    }
    }
}

func xmodemRecvAbort() {
    if rvState == rvIdle { return }
    if rvHaveFile { rvFile.close() }
    rvFile = nil
    rvHaveFile = false
    rvState = rvIdle
}

// A complete frame is in rvNumByte/rvInvByte/rvBuf/rvCheckVal.
func rvFrameDone() {
    var i: int = 0
    var sum: int = 0
    var want: int = 0
    if rvNumByte + rvInvByte != 255 {
        rvError()
        return
    }
    if rvCrc {
        want = crcXmodem(rvBuf)
    } else {
        while i < rvBuf.length {
            sum = sum + int(rvBuf[i])
            i = i + 1
        }
        want = sum & 0xFF
    }
    if want != rvCheckVal {
        rvError()
        return
    }
    if rvExpectHeader {
        if rvNumByte != 0 {
            rvError()
            return
        }
        rvHeaderDone()
        return
    }
    if rvNumByte == rvBlock {
        if not rvFile.writeAt(rvWritten, rvBuf) {
            log("Upload: write failed: " + lastError.message)
            rvCancel()
            return
        }
        rvWritten = rvWritten + rvBuf.length
        rvBlock = (rvBlock + 1) mod 256
        rvErrors = 0
    } else if rvNumByte != (rvBlock + 255) mod 256 {
        log("Upload: block " + string(rvNumByte) + " out of sequence.")
        rvCancel()
        return
    }
    // a repeat of the previous block (our ACK was lost): just ACK again
    xmOutStr("\x06")
    rvState = rvWaitFrame
    rvTimer = 0
}

// YMODEM block 0: "name NUL size [mtime mode ...] NUL". A path is
// reduced to its last segment. Empty name = end of batch.
func rvHeaderDone() {
    var i: int = 0
    var name: string(63)
    var size: int = 0
    var c: char
    while i < rvBuf.length and rvBuf[i] != xmNUL {
        c = rvBuf[i]
        if c == '/' or c == '\\' {
            name = ""
        } else if name.length < 63 {
            name = name + c
        }
        i = i + 1
    }
    if name == "" {
        xmOutStr("\x06")
        rvFinish(true)
        return
    }
    i = i + 1
    while i < rvBuf.length and rvBuf[i] >= '0' and rvBuf[i] <= '9' {
        size = size * 10 + (int(rvBuf[i]) - 48)
        i = i + 1
    }
    if not xferAcceptName(name) {
        log("Upload: name refused: " + name)
        rvCancel()
        return
    }
    if not rvOpen(name) { return }
    rvExpectSize = size
    rvExpectHeader = false
    xmOutStr("\x06")
    rvState = rvWaitFrame
    rvStartProd()             // C: send the data
}

// EOT for the current file: trim YMODEM padding, report it.
func rvFileDone() {
    rvFile.flush()
    if rvExpectSize > 0 and rvExpectSize < rvWritten {
        rvFile.setSize(rvExpectSize)
        rvWritten = rvExpectSize
    }
    rvFile.close()
    rvFile = nil
    rvHaveFile = false
    xferReceived(rvName, rvWritten)
}

func rvError() {
    rvErrors = rvErrors + 1
    if rvErrors >= xmMaxErrors {
        log("Upload: too many errors.")
        rvCancel()
        return
    }
    rvState = rvPurge
    rvTimer = 0
}

func rvCancel() {
    xmOutStr("\x18\x18\x18")
    rvFinish(false)
}

func rvFinish(ok: bool) {
    if rvHaveFile { rvFile.close() }
    rvFile = nil
    rvHaveFile = false
    rvState = rvIdle
    xferDone(ok)
}
