// The Wall database: short, timestamped shoutouts from callers,
// shown newest first after login and from the main menu.
//
// On-disk record ("Wall" database, 160 bytes, record ID = entry ID):
//   0    name, 32-byte Pascal field
//   32   created (i32, Mac-epoch seconds)
//   36   message, 121-byte Pascal field (<= wallMessageMax chars)
//   157+ slack
//
// No indexes: IDs are monotonic, so descending ID is descending time.

include "vdb.cla"

const wallRecordSize: int = 160
const wallMessageMax: int = 120

const wallOffName: int = 0
const wallOffCreated: int = 32
const wallOffMessage: int = 36

var wallDb: Database
var wallUsed: int = 0    // TickCount of the last wallHandle()

// The entry last loaded by loadWallEntry.
var wallName: string(31)
var wallCreated: int = 0
var wallMessage: string(120)

// Open the Wall database, creating it on first run. Callers use
// wallHandle(): the database is held only while in use (vDB's on-demand
// rule -- every open file is an FCB, docs/vdb-clarus.md).
func wallOpen(): bool {
    wallDb = dbOpen("Wall", "68BB")
    if not dbIsOpen(wallDb) { wallDb = dbCreate("Wall", wallRecordSize, "68BB") }
    wallUsed = TickCount()
    return dbIsOpen(wallDb)
}

func wallClose() {
    if dbIsOpen(wallDb) { dbClose(wallDb) }
    wallDb = new Database
}

// The open database, opened if need be (a closed handle on failure).
func wallHandle(): Database {
    if not dbIsOpen(wallDb) { wallOpen() }
    wallUsed = TickCount()
    return wallDb
}

// Close it once unused for dbIdleTicks (the 30-tick timer calls this).
func wallIdleClose() {
    if dbIsOpen(wallDb) and TickCount() - wallUsed > dbIdleTicks { wallClose() }
}

func wallCount(): int {
    return dbRecordCount(wallHandle())
}

// Add an entry stamped now(); name and message are truncated to their
// fields. Returns the new ID, or -1 (lastError).
func addWallEntry(name: string, msg: string): int {
    var t: text
    var n: string = name
    var m: string = msg
    if n.length > 31 { n = n[0, 31] }
    if m.length > wallMessageMax { m = m[0, wallMessageMax] }
    t.append(char(n.length))
    t.append(n)
    while t.length < wallOffCreated {
        t.append(char(0))
    }
    btAppendInt(t, now())
    t.append(char(m.length))
    t.append(m)
    return dbAdd(wallHandle(), t)
}

// Load entry `id` into wallName/wallCreated/wallMessage.
func loadWallEntry(id: int): bool {
    var rec: text = dbFind(wallHandle(), id)
    if rec.length != wallRecordSize { return false }
    wallName = dbExtractString(rec, wallOffName)
    wallCreated = rec.intAt(wallOffCreated)
    wallMessage = rec.stringAt(wallOffMessage)   // dbExtractString caps at 63
    return true
}

// The newest n entry IDs, newest first.
func recentWallIds(n: int, ids: list of int) {
    var cur: text
    var rec: text
    var id: int
    ids.clear()
    if not dbScanStart(wallHandle(), cur, dbNextRecordId(wallHandle()) - 1, true) { return }
    id = dbScanNext(wallHandle(), cur, rec)
    while id != 0 and ids.count < n {
        ids.add(id)
        if ids.count < n {
            id = dbScanNext(wallHandle(), cur, rec)
        } else {
            id = 0
        }
    }
}
