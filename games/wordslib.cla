// Daily Word: the pure parts -- scoring, the day number, word-file
// lookup, the sparse stats file and leaderboard ranking, and the
// per-letter rendering. games/words.cla has the screens.
// docs/daily-word.md.

include "../terminal.cla"

// The five marks for `guess` against `answer` (both five lowercase
// letters): G right spot, Y elsewhere in the word, . not in it. Exact
// matches claim their letters first, so a duplicate in the guess is
// only yellow while unmatched copies remain in the answer.
func wordScore(guess: string, answer: string): string {
    var marks: string = "....."
    var counts: int[26]
    var i: int = 0
    var k: int
    while i < 5 {
        if guess[i] == answer[i] {
            marks[i] = 'G'
        } else {
            k = int(answer[i]) - int('a')
            counts[k] = counts[k] + 1
        }
        i = i + 1
    }
    i = 0
    while i < 5 {
        if marks[i] != 'G' {
            k = int(guess[i]) - int('a')
            if counts[k] > 0 {
                marks[i] = 'Y'
                counts[k] = counts[k] - 1
            }
        }
        i = i + 1
    }
    return marks
}

func wordsLower(s: string): string {
    var r: string = s
    var i: int = 0
    while i < r.length {
        if r[i] >= 'A' and r[i] <= 'Z' { r[i] = char(int(r[i]) + 32) }
        i = i + 1
    }
    return r
}

func wordsUpper(s: string): string {
    var r: string = s
    var i: int = 0
    while i < r.length {
        if r[i] >= 'a' and r[i] <= 'z' { r[i] = char(int(r[i]) - 32) }
        i = i + 1
    }
    return r
}

// Exactly five lowercase letters.
func wordsIsWord(s: string): bool {
    var i: int = 0
    if s.length != 5 { return false }
    while i < 5 {
        if s[i] < 'a' or s[i] > 'z' { return false }
        i = i + 1
    }
    return true
}

// Days since 1970-01-01 for a proleptic Gregorian date (Hinnant's
// days_from_civil; y >= 1). Pure arithmetic on small ints, so it runs
// the same on both lanes and never meets now()'s negative seconds.
func civilDays(y: int, m: int, d: int): int {
    var yy: int = y
    var mp: int
    var era: int
    var yoe: int
    var doy: int
    var doe: int
    if m <= 2 { yy = y - 1 }
    era = yy / 400
    yoe = yy - era * 400
    if m > 2 {
        mp = m - 3
    } else {
        mp = m + 9
    }
    doy = (153 * mp + 2) / 5 + d - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// The `n` digits of `s` at `at` as a number, or -1.
func wordsDigits(s: string, at: int, n: int): int {
    var v: int = 0
    var i: int = 0
    if at + n > s.length { return -1 }
    while i < n {
        if s[at + i] < '0' or s[at + i] > '9' { return -1 }
        v = v * 10 + (int(s[at + i]) - int('0'))
        i = i + 1
    }
    return v
}

// "yyyy-mm-dd" (Config.txt's wordsDayOne) as civilDays, or -1.
func wordsIsoDays(s: string): int {
    var y: int
    var m: int
    var d: int
    if s.length != 10 or s[4] != '-' or s[7] != '-' { return -1 }
    y = wordsDigits(s, 0, 4)
    m = wordsDigits(s, 5, 2)
    d = wordsDigits(s, 8, 2)
    if y < 1 or m < 1 or m > 12 or d < 1 or d > 31 { return -1 }
    return civilDays(y, m, d)
}

// dateTimeStr's "mm-dd-yy HH:MM:SS" (local time) as civilDays, or -1.
func wordsStampDays(stamp: string): int {
    var m: int = wordsDigits(stamp, 0, 2)
    var d: int = wordsDigits(stamp, 3, 2)
    var y: int = wordsDigits(stamp, 6, 2)
    if m < 1 or m > 12 or d < 1 or d > 31 or y < 0 { return -1 }
    return civilDays(2000 + y, m, d)
}

// --- Word files --------------------------------------------------------
// Fixed 6-byte lines (five lowercase letters + CR), so line n is at
// byte 6 * n and nothing is ever loaded whole.

const wordsFolder: string = ":Words"
const wordsListFile: string = ":Words:Words.txt"      // every allowed guess, sorted
const wordsAnswerFile: string = ":Words:Answers.txt"  // one answer per day, shuffled
const wordsLineSize: int = 6

// Lines in an open word file, or 0 when it is empty or mangled.
func wordsCountOpen(f: filehandle): int {
    var n: int = f.size()
    if n == 0 or n mod wordsLineSize != 0 { return 0 }
    return n / wordsLineSize
}

func wordsFileCount(path: string): int {
    var f: filehandle = file.open(path)
    var n: int
    if f == nil { return 0 }
    n = wordsCountOpen(f)
    f.close()
    return n
}

// Line i without its CR, or "" on a read error.
func wordsLineAt(f: filehandle, i: int): string {
    var t: text
    if not f.readAt(i * wordsLineSize, 5, t) { return "" }
    if t.length != 5 { return "" }
    return t[0, 5]
}

// Binary search: ~13 six-byte reads for the full list.
func wordsFind(path: string, w: string): bool {
    var f: filehandle = file.open(path)
    var lo: int = 0
    var hi: int
    var mid: int
    var s: string
    if f == nil { return false }
    hi = wordsCountOpen(f) - 1
    while lo <= hi {
        mid = (lo + hi) / 2
        s = wordsLineAt(f, mid)
        if s == w {
            f.close()
            return true
        }
        if s < w {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    f.close()
    return false
}

// Puzzle `day` (1-based) is line (day - 1) mod count.
func wordsAnswerFor(path: string, day: int): string {
    var f: filehandle = file.open(path)
    var n: int
    var w: string = ""
    if f == nil { return "" }
    n = wordsCountOpen(f)
    if n > 0 { w = wordsLineAt(f, (day - 1) mod n) }
    f.close()
    return w
}

// --- Stats file --------------------------------------------------------
// Sparse: one 64-byte big-endian record per player (not per account),
// each starting with its user ID, in first-played order. Found by a
// linear scan; the offset is then kept so every update is one write.
// Only whole records count (size / 64), so a torn append is ignored
// and overwritten by the next one. docs/daily-word.md "Stats file".

const wordsRecSize: int = 64
const wordsChunk: int = 4096          // whole records per read
const wordsMaxGuesses: int = 6

const wordsNone: int = 0
const wordsPlaying: int = 1
const wordsWon: int = 2
const wordsLost: int = 3

const wOffUser: int = 0       // i32
const wOffDay: int = 4        // u16: the puzzle this game is for, 0 = none
const wOffState: int = 6      // byte: wordsNone..wordsLost
const wOffUsed: int = 7       // byte: guesses made
const wOffGuesses: int = 8    // 6 x 5 letters
const wOffFinished: int = 38  // i32: now() at the win or loss
const wOffPlayed: int = 42    // u16
const wOffWins: int = 44      // u16
const wOffStreak: int = 46    // u16: stored; read through wordsLiveStreak
const wOffBest: int = 48      // u16
const wOffLastWin: int = 50   // u16: day of the last win, 0 = never
const wOffDist: int = 52      // 6 x u16: wins in 1..6 guesses

var wordsRec: text            // the caller's record

func wordsBlank(userId: int): text {
    var t: text
    var i: int = 0
    while i < wordsRecSize {
        t.append("\x00")
        i = i + 1
    }
    t.setIntAt(wOffUser, userId)
    return t
}

// Load `userId`'s record into wordsRec: its byte offset, or -1 with
// wordsRec a blank record for them.
func wordsLoad(path: string, userId: int): int {
    var f: filehandle = file.open(path)
    var buf: text
    var pos: int = 0
    var end: int
    var i: int
    wordsRec = wordsBlank(userId)
    if f == nil { return -1 }
    end = (f.size() / wordsRecSize) * wordsRecSize
    while pos < end {
        if not f.readAt(pos, wordsChunk, buf) { break }
        i = 0
        while i + wordsRecSize <= buf.length and pos + i < end {
            if buf.intAt(i + wOffUser) == userId {
                wordsRec.clear()
                wordsRec.append(buf[i, wordsRecSize])
                f.close()
                return pos + i
            }
            i = i + wordsRecSize
        }
        pos = pos + wordsChunk
    }
    f.close()
    return -1
}

// Write wordsRec at `at`, or append it (over any torn tail) when
// at < 0. The offset written, or -1.
func wordsSave(path: string, at: int): int {
    var f: filehandle = file.open(path)
    var pos: int = at
    var ok: bool
    if f == nil { f = file.create(path, "BINA", "68BB") }
    if f == nil { return -1 }
    if pos < 0 { pos = (f.size() / wordsRecSize) * wordsRecSize }
    ok = f.writeAt(pos, wordsRec)
    if ok { ok = f.flush() }
    f.close()
    if not ok { return -1 }
    return pos
}

// Start a fresh game for `day` unless wordsRec already holds it.
func wordsBeginDay(day: int) {
    var i: int = 0
    if wordsRec.wordAt(wOffDay) == day { return }
    wordsRec.setWordAt(wOffDay, day)
    wordsRec[wOffState] = char(wordsPlaying)
    wordsRec[wOffUsed] = char(0)
    while i < wordsMaxGuesses * 5 {
        wordsRec[wOffGuesses + i] = char(0)
        i = i + 1
    }
}

func wordsGuessAt(n: int): string {
    return wordsRec[wOffGuesses + 5 * n, 5]
}

// Record `guess` against `answer`; a win or the sixth miss finishes
// the game and updates the totals. `at` is now().
func wordsAddGuess(guess: string, answer: string, at: int) {
    var used: int = int(wordsRec[wOffUsed])
    var day: int = wordsRec.wordAt(wOffDay)
    var streak: int = 1
    var i: int = 0
    while i < 5 {
        wordsRec[wOffGuesses + 5 * used + i] = guess[i]
        i = i + 1
    }
    used = used + 1
    wordsRec[wOffUsed] = char(used)
    if guess == answer {
        wordsRec[wOffState] = char(wordsWon)
        if wordsRec.wordAt(wOffLastWin) == day - 1 { streak = wordsRec.wordAt(wOffStreak) + 1 }
        wordsRec.setWordAt(wOffStreak, streak)
        if streak > wordsRec.wordAt(wOffBest) { wordsRec.setWordAt(wOffBest, streak) }
        wordsRec.setWordAt(wOffWins, wordsRec.wordAt(wOffWins) + 1)
        wordsRec.setWordAt(wOffLastWin, day)
        wordsRec.setWordAt(wOffDist + 2 * (used - 1), wordsRec.wordAt(wOffDist + 2 * (used - 1)) + 1)
    } else {
        if used < wordsMaxGuesses { return }
        wordsRec[wOffState] = char(wordsLost)
        wordsRec.setWordAt(wOffStreak, 0)
    }
    wordsRec.setWordAt(wOffPlayed, wordsRec.wordAt(wOffPlayed) + 1)
    wordsRec.setIntAt(wOffFinished, at)
}

// A stored streak only counts while the last win was today or
// yesterday: a skipped day breaks it without rewriting the record.
func wordsLiveStreak(streak: int, lastWin: int, today: int): int {
    if lastWin > 0 and lastWin >= today - 1 { return streak }
    return 0
}

// --- Leaderboards ------------------------------------------------------
// One pass over the stats file keeps the top 10 of each board by
// insertion and counts who ranks above the caller.

const wordsTopN: int = 10

record WordsRow {
    userId: int
    used: int
    finishedAt: int
    streak: int           // live
    best: int
    played: int
    wins: int
    solvedToday: bool
}

var wordsMyTodayRank: int     // 1-based; 0 = not on the board
var wordsMyStreakRank: int

func wordsRowFrom(buf: text, i: int, today: int): WordsRow {
    var r: WordsRow
    r.userId = buf.intAt(i + wOffUser)
    r.used = int(buf[i + wOffUsed])
    r.finishedAt = buf.intAt(i + wOffFinished)
    r.streak = wordsLiveStreak(buf.wordAt(i + wOffStreak), buf.wordAt(i + wOffLastWin), today)
    r.best = buf.wordAt(i + wOffBest)
    r.played = buf.wordAt(i + wOffPlayed)
    r.wins = buf.wordAt(i + wOffWins)
    r.solvedToday = buf.wordAt(i + wOffDay) == today and int(buf[i + wOffState]) == wordsWon
    return r
}

// Today: fewer guesses, then the earlier finish (same-day now()
// values order correctly). Streaks: live streak, best, then wins.
func wordsBetter(a: WordsRow, b: WordsRow, byStreak: bool): bool {
    if byStreak {
        if a.streak != b.streak { return a.streak > b.streak }
        if a.best != b.best { return a.best > b.best }
        return a.wins > b.wins
    }
    if a.used != b.used { return a.used < b.used }
    return a.finishedAt < b.finishedAt
}

func wordsInsert(top: list of WordsRow, r: WordsRow, byStreak: bool) {
    var i: int = top.count
    top.add(r)
    while i > 0 and wordsBetter(r, top[i - 1], byStreak) {
        top[i] = top[i - 1]
        i = i - 1
    }
    top[i] = r
    if top.count > wordsTopN { top.pop() }
}

func wordsOnStreakBoard(r: WordsRow): bool {
    return r.streak > 0 or r.best > 0
}

// ponytail: ranks count records of deleted accounts (the draw skips
// their names); filter with userNameById in the scan if that shows.
func wordsBoards(path: string, today: int, me: WordsRow, todayTop: list of WordsRow, streakTop: list of WordsRow) {
    var f: filehandle = file.open(path)
    var buf: text
    var pos: int = 0
    var end: int
    var i: int
    var r: WordsRow
    todayTop.clear()
    streakTop.clear()
    wordsMyTodayRank = 0
    wordsMyStreakRank = 0
    if me.solvedToday { wordsMyTodayRank = 1 }
    if wordsOnStreakBoard(me) { wordsMyStreakRank = 1 }
    if f == nil { return }
    end = (f.size() / wordsRecSize) * wordsRecSize
    while pos < end {
        if not f.readAt(pos, wordsChunk, buf) { break }
        i = 0
        while i + wordsRecSize <= buf.length and pos + i < end {
            r = wordsRowFrom(buf, i, today)
            if r.solvedToday {
                wordsInsert(todayTop, r, false)
                if wordsMyTodayRank > 0 and r.userId != me.userId and wordsBetter(r, me, false) {
                    wordsMyTodayRank = wordsMyTodayRank + 1
                }
            }
            if wordsOnStreakBoard(r) {
                wordsInsert(streakTop, r, true)
                if wordsMyStreakRank > 0 and r.userId != me.userId and wordsBetter(r, me, true) {
                    wordsMyStreakRank = wordsMyStreakRank + 1
                }
            }
            i = i + wordsRecSize
        }
        pos = pos + wordsChunk
    }
    f.close()
}

// --- Rendering ---------------------------------------------------------
// Color terminals color each letter; the rest get a marker row under
// the guess (wordsMarkText). The helpers return "" when a terminal
// lacks the feature, so one path serves every type.

// One letter in its mark's colors (m: G, Y or .).
func wordsPaint(c: char, m: char): string {
    var l: string = string(c)
    if not terminal.color { return l }
    if terminal.type == PETSCII {
        switch m {
        case 'G' { return reverseVideo(true) + fg(Green) + l + reverseVideo(false) + fgOff() }
        case 'Y' { return reverseVideo(true) + fg(Yellow) + l + reverseVideo(false) + fgOff() }
        }
        return fg(BrightBlack) + l + fgOff()
    }
    switch m {
    case 'G' { return bg(Green) + fg(Black) + l + bgOff() + fgOff() }
    case 'Y' { return bg(Yellow) + fg(Black) + l + bgOff() + fgOff() }
    }
    return fg(BrightBlack) + l + fgOff()
}

// "  ^ ? . . ^", aligned under a "  C R A N E" guess row.
func wordsMarkText(marks: string): string {
    var s: string = " "
    var i: int = 0
    while i < marks.length {
        switch marks[i] {
        case 'G' { s = s + " ^" }
        case 'Y' { s = s + " ?" }
        else     { s = s + " ." }
        }
        i = i + 1
    }
    return s
}

func wordsStateRank(c: char): int {
    switch c {
    case '.' { return 1 }
    case 'Y' { return 2 }
    case 'G' { return 3 }
    }
    return 0
}

// The best mark seen for each of a..z over wordsRec's guesses:
// ' ' untried, '.' not in the word, 'Y', 'G'.
func wordsLetterStates(answer: string): string {
    var states: string = ""
    var n: int = 0
    var i: int
    var k: int
    var g: string
    var marks: string
    while n < 26 {
        states = states + " "
        n = n + 1
    }
    n = 0
    while n < int(wordsRec[wOffUsed]) {
        g = wordsGuessAt(n)
        marks = wordScore(g, answer)
        i = 0
        while i < 5 {
            k = int(g[i]) - int('a')
            if wordsStateRank(marks[i]) > wordsStateRank(states[k]) { states[k] = marks[i] }
            i = i + 1
        }
        n = n + 1
    }
    return states
}

// One display cell per letter lo..hi-1: "." when ruled out, else
// the capital, painted when it is in the word.
func wordsAlphabetCells(states: string, lo: int, hi: int, out: list of string) {
    var k: int = lo
    var c: char
    out.clear()
    while k < hi {
        c = char(int('A') + k)
        switch states[k] {
        case ' ' { out.add(string(c)) }
        case '.' { out.add(".") }
        else     { out.add(wordsPaint(c, states[k])) }
        }
        k = k + 1
    }
}
