// Daily Word: the pure parts -- scoring, the day number, word-file
// lookup, the sparse stats file and leaderboard ranking, and the
// per-letter rendering. games/words.cla has the screens.
// docs/daily-word.md.

include "../terminal.cla"

// The five marks for `guess` against `answer` (both five lowercase
// letters): G right spot, Y elsewhere in the word, . not in it. Exact
// matches claim their letters first, so a duplicate in the guess is
// only yellow while unmatched copies remain in the answer.
func wordScore(guess: string, answer: string): string {
    var marks: string = "....."
    var counts: int[26]
    var i: int = 0
    var k: int
    while i < 5 {
        if guess[i] == answer[i] {
            marks[i] = 'G'
        } else {
            k = int(answer[i]) - int('a')
            counts[k] = counts[k] + 1
        }
        i = i + 1
    }
    i = 0
    while i < 5 {
        if marks[i] != 'G' {
            k = int(guess[i]) - int('a')
            if counts[k] > 0 {
                marks[i] = 'Y'
                counts[k] = counts[k] - 1
            }
        }
        i = i + 1
    }
    return marks
}

func wordsLower(s: string): string {
    var r: string = s
    var i: int = 0
    while i < r.length {
        if r[i] >= 'A' and r[i] <= 'Z' { r[i] = char(int(r[i]) + 32) }
        i = i + 1
    }
    return r
}

func wordsUpper(s: string): string {
    var r: string = s
    var i: int = 0
    while i < r.length {
        if r[i] >= 'a' and r[i] <= 'z' { r[i] = char(int(r[i]) - 32) }
        i = i + 1
    }
    return r
}

// Exactly five lowercase letters.
func wordsIsWord(s: string): bool {
    var i: int = 0
    if s.length != 5 { return false }
    while i < 5 {
        if s[i] < 'a' or s[i] > 'z' { return false }
        i = i + 1
    }
    return true
}

// Days since 1970-01-01 for a proleptic Gregorian date (Hinnant's
// days_from_civil; y >= 1). Pure arithmetic on small ints, so it runs
// the same on both lanes and never meets now()'s negative seconds.
func civilDays(y: int, m: int, d: int): int {
    var yy: int = y
    var mp: int
    var era: int
    var yoe: int
    var doy: int
    var doe: int
    if m <= 2 { yy = y - 1 }
    era = yy / 400
    yoe = yy - era * 400
    if m > 2 {
        mp = m - 3
    } else {
        mp = m + 9
    }
    doy = (153 * mp + 2) / 5 + d - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// The `n` digits of `s` at `at` as a number, or -1.
func wordsDigits(s: string, at: int, n: int): int {
    var v: int = 0
    var i: int = 0
    if at + n > s.length { return -1 }
    while i < n {
        if s[at + i] < '0' or s[at + i] > '9' { return -1 }
        v = v * 10 + (int(s[at + i]) - int('0'))
        i = i + 1
    }
    return v
}

// "yyyy-mm-dd" (Config.txt's wordsDayOne) as civilDays, or -1.
func wordsIsoDays(s: string): int {
    var y: int
    var m: int
    var d: int
    if s.length != 10 or s[4] != '-' or s[7] != '-' { return -1 }
    y = wordsDigits(s, 0, 4)
    m = wordsDigits(s, 5, 2)
    d = wordsDigits(s, 8, 2)
    if y < 1 or m < 1 or m > 12 or d < 1 or d > 31 { return -1 }
    return civilDays(y, m, d)
}

// dateTimeStr's "mm-dd-yy HH:MM:SS" (local time) as civilDays, or -1.
func wordsStampDays(stamp: string): int {
    var m: int = wordsDigits(stamp, 0, 2)
    var d: int = wordsDigits(stamp, 3, 2)
    var y: int = wordsDigits(stamp, 6, 2)
    if m < 1 or m > 12 or d < 1 or d > 31 or y < 0 { return -1 }
    return civilDays(2000 + y, m, d)
}
