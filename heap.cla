// Compactor for the append-only body heaps (BRD<nn>.MSG, Mail.MSG,
// ARE<nn>.MSG): each record in the owning vDB database points at its
// bytes with an (offset, length) pair at fixed field positions, bodies
// are exact-fit with no framing, and deletes orphan their bytes.
//
// Fresh-file rewrite with deterministic offsets: walk records in ID
// order appending each live body to <name>.NEW; a body's new offset is
// the running total of the live bodies before it, so it can be
// recomputed from the headers alone. Then .MSG -> .OLD, .NEW -> .MSG,
// rewrite every header's offset, delete .OLD. Every crash point is
// recoverable at the next open (heapRecover):
//   .NEW only            crashed mid-rewrite       delete .NEW
//   .OLD + .NEW, no .MSG crashed between renames   finish the swap, then
//   .OLD + .MSG          crashed fixing offsets    fix offsets, delete .OLD
// Both are idempotent. docs/maintenance.md.
//
// The offset fix writes the field in place (dbSetFieldIntAt: no
// journal, no index work -- the offset fields are unindexed). That is
// safe because .OLD stays on disk until the fix is flushed: a crash
// part-way leaves .OLD, and the next open redoes the whole fix.
//
// Maintenance runs it as a job of one-record units (heapBegin, then
// heapUnit until it stops returning hsMore) in three passes over the
// primary index (ID order, no deleted-ID gaps), each reading only the
// offset/length fields (dbFieldIntAt -- a dbFind costs ~130 ms on the
// 68k):
//   hjCheck  sum the live lengths; too little waste ends the job here
//   hjCopy   append each live body to .NEW, then swap the files
//   hjFix    rewrite each offset, flush, delete .OLD
// The scan cursor (hjCur) lives in a global across events, which the
// scan API normally forbids: it is safe only because nothing writes
// the database's index while a job runs -- maintenance refuses callers
// and holds off polls and tosses, and the job itself writes only .NEW
// and record data pages. One job at a time.
//
// `path` may include folders (":Boards:BRD01.MSG"); renames pass
// heapLeaf, since file.rename takes a leaf name. The owner closes its own heap handle before heapBegin
// and reopens after the job ends.

include "vdb.cla"

const hsDone: int = 0       // job finished (hjPacked says whether it rewrote)
const hsMore: int = 1       // call heapUnit again
const hsFailed: int = 2

const hjCheck: int = 1
const hjCopy: int = 2
const hjFix: int = 3

// A heap is rewritten only when at least 1/heapWasteDivisor of it is
// orphaned bytes, so daily expiry doesn't rewrite a big heap nightly.
const heapWasteDivisor: int = 4
var heapForce: bool = false     // pack any waste at all (scripts/boardtool.cla)

var hjPath: string
var hjOff: int
var hjLen: int
var hjSrc: filehandle
var hjDst: filehandle
var hjStage: int = 0
var hjCur: text             // primary-index scan cursor, kept across units
var hjCurOk: bool = false   // false: the scan is exhausted
var hjSize: int             // the old heap's size
var hjLive: int             // check: live bytes so far
var hjRunning: int          // fix: new offset of the next body
var hjTotal: int            // records in the database (progress)
var hjDone: int             // records visited in this pass (progress)
var hjPacked: bool = false  // the finished job rewrote the heap

func heapNewPath(path: string): string {
    return path[0, path.length - 4] + ".NEW"
}

func heapOldPath(path: string): string {
    return path[0, path.length - 4] + ".OLD"
}

// The file name after the last ':' -- file.rename's new name.
func heapLeaf(path: string): string {
    var i: int = path.length
    while i > 0 {
        if path[i - 1] == ':' { return path[i, path.length - i] }
        i = i - 1
    }
    return path
}

// Rewrite every live record's offset to the running total of the live
// bodies before it, in one call (crash recovery at open). Idempotent.
func heapFixOffsets(db: Database, offField: int, lenField: int): bool {
    var cur: text
    var f: filehandle = db.data
    var running: int = 0
    var page: int
    var len: int
    if btScanStart(db.index, cur, 1, false) {
        while btScanNext(db.index, cur) {
            page = btScanValue(cur)
            len = dbFieldIntAt(db, page, lenField)
            if len > 0 {
                if dbFieldIntAt(db, page, offField) != running {
                    if not dbSetFieldIntAt(db, page, offField, running) { return false }
                }
                running = running + len
            }
        }
    }
    return f.flush()
}

func heapCloseFiles() {
    var s: filehandle = hjSrc
    var d: filehandle = hjDst
    if s != nil { s.close() }
    if d != nil { d.close() }
    hjSrc = nil
    hjDst = nil
}

// Start a pass: the cursor at the first record.
func heapPass(db: Database, stage: int) {
    hjStage = stage
    hjDone = 0
    hjCurOk = btScanStart(db.index, hjCur, 1, false)
}

// The next record's first page, or 0 once the pass is over.
func heapNextPage(db: Database): int {
    if hjCurOk { hjCurOk = btScanNext(db.index, hjCur) }
    if not hjCurOk { return 0 }
    hjDone = hjDone + 1
    return btScanValue(hjCur)
}

// Begin a job on `path`; step it with heapUnit.
func heapBegin(db: Database, path: string, offField: int, lenField: int): bool {
    heapCloseFiles()
    hjPacked = false
    if not dbIsOpen(db) { return false }
    hjSrc = file.open(path)
    if hjSrc == nil { return false }
    hjPath = path
    hjOff = offField
    hjLen = lenField
    hjSize = hjSrc.size()
    hjLive = 0
    hjRunning = 0
    hjTotal = dbRecordCount(db)
    heapPass(db, hjCheck)
    return true
}

func heapFail(): int {
    heapCloseFiles()
    hjStage = 0
    return hsFailed
}

// Check pass over: pack only when enough of the heap is orphaned.
func heapCheckDone(db: Database): int {
    if hjLive == hjSize or (not heapForce and (hjSize - hjLive) * heapWasteDivisor < hjSize) {
        heapCloseFiles()
        hjStage = 0
        return hsDone
    }
    if file.exists(heapNewPath(hjPath)) { file.delete(heapNewPath(hjPath)) }
    hjDst = file.create(heapNewPath(hjPath), "TEXT", "68BB")
    if hjDst == nil { return heapFail() }
    heapPass(db, hjCopy)
    return hsMore
}

// Copy pass over: flush .NEW and swap it in.
func heapCopyDone(db: Database): int {
    var dst: filehandle = hjDst
    if not dst.flush() {
        heapCloseFiles()
        file.delete(heapNewPath(hjPath))        // the old heap is untouched
        return heapFail()
    }
    heapCloseFiles()
    if not file.rename(hjPath, heapLeaf(heapOldPath(hjPath))) {
        file.delete(heapNewPath(hjPath))
        return heapFail()
    }
    if not file.rename(heapNewPath(hjPath), heapLeaf(hjPath)) { return heapFail() }   // heapRecover finishes it
    heapPass(db, hjFix)
    return hsMore
}

// Fix pass over: flush the offsets, then .OLD can go.
func heapFixDone(db: Database): int {
    var f: filehandle = db.data
    if not f.flush() { return heapFail() }                      // .OLD stays: redone at open
    if not file.delete(heapOldPath(hjPath)) { return heapFail() }
    hjStage = 0
    hjPacked = true
    return hsDone
}

// One record of the job. On hsFailed the files are left in a state
// heapRecover handles, so the owner just closes and reopens.
func heapUnit(db: Database): int {
    var page: int = heapNextPage(db)
    var len: int
    var body: text
    var src: filehandle = hjSrc
    var dst: filehandle = hjDst
    switch hjStage {
    case hjCheck {
        if page == 0 { return heapCheckDone(db) }
        hjLive = hjLive + dbFieldIntAt(db, page, hjLen)
    }
    case hjCopy {
        if page == 0 { return heapCopyDone(db) }
        len = dbFieldIntAt(db, page, hjLen)
        if len > 0 {
            if not src.readAt(dbFieldIntAt(db, page, hjOff), len, body) or body.length != len or not dst.append(body) {
                heapCloseFiles()
                file.delete(heapNewPath(hjPath))    // the old heap is untouched
                return heapFail()
            }
        }
    }
    case hjFix {
        if page == 0 { return heapFixDone(db) }
        len = dbFieldIntAt(db, page, hjLen)
        if len > 0 {
            if dbFieldIntAt(db, page, hjOff) != hjRunning {
                if not dbSetFieldIntAt(db, page, hjOff, hjRunning) { return heapFail() }
            }
            hjRunning = hjRunning + len
        }
    }
    else { return hsFailed }
    }
    return hsMore
}

// Job progress, 0-100: the check pass on its own, then the rewrite as
// 50% copy + 50% offset fix.
func heapPercent(): int {
    var t: int = hjTotal
    if t < 1 { t = 1 }
    switch hjStage {
    case hjCheck { return hjDone * 100 / t }
    case hjCopy { return hjDone * 50 / t }
    case hjFix { return 50 + hjDone * 50 / t }
    else { return 100 }
    }
}

// Called by the owner right after dbOpen (which has replayed the vDB
// journal) and before it opens its heap handle.
func heapRecover(db: Database, path: string, offField: int, lenField: int): bool {
    var newP: string = heapNewPath(path)
    var oldP: string = heapOldPath(path)
    if file.exists(oldP) {
        if not file.exists(path) {
            if not file.rename(newP, heapLeaf(path)) { return false }
        }
        if not heapFixOffsets(db, offField, lenField) { return false }
        return file.delete(oldP)
    }
    if file.exists(newP) { return file.delete(newP) }
    return true
}
