// Modem result-code scanner/filter: a char-at-a-time state machine that
// finds "\r\nCONNECT <digits>\r\n", "\r\nNO CARRIER\r\n" and
// "\r\nRING\r\n" in the received stream. State lives in globals, so a result code split
// across received() chunks still matches.
//
// The scanner is also the data path: every byte that is not part of a
// matched result code is released to `dataChar(c)`. Bytes that might be
// a result-code body (from the 'C'/'N'/'R' after a CRLF onward) are held in
// `pending`; a completed match discards them, a mismatch replays them
// to dataChar as ordinary data. The CRLF lead-in is held too, but only
// until the end of the received chunk (`scanEndChunk`), so a caller's
// Enter is never delayed while a modem's result code, which arrives in
// one burst, never leaks its CR to the screen as an Enter (the screen's
// reply would then go to a modem in command mode).
//
// The including program must define `connected()`, `disconnected()`,
// `ring()` and `dataChar(c: char)`, and call `scanEndChunk()` after
// feeding each received chunk. Note: in Clarus source, \n is CR (13); LF
// is \x0A.

const CR: char = '\x0D'
const LF: char = '\x0A'

const connectLit:   string = "CONNECT "
const noCarrierLit: string = "NO CARRIER\x0D\x0A"
const ringLit:      string = "RING\x0D\x0A"

const sIdle:    int = 0    // scanning for CR
const sCr:      int = 1    // seen CR, want LF
const sLead:    int = 2    // seen CRLF, want 'C', 'N' or 'R'
const sConn:    int = 3    // matching "CONNECT " (connectLit[matchIdx])
const sDig1:    int = 4    // want first baud digit
const sDigMore: int = 5    // more digits, or CR to end
const sConnEnd: int = 6    // seen CR after digits, want LF
const sNoCarr:  int = 7    // matching "NO CARRIER\r\n" (noCarrierLit[matchIdx])
const sRing:    int = 8    // matching "RING\r\n" (ringLit[matchIdx])

var matchState: int = 0
var matchIdx: int = 0
var pending: string(31)

// Replay held bytes as ordinary data (straight to dataChar -- they must
// not re-enter the scanner).
func flushPending() {
    var i: int = 0
    while i < pending.length {
        dataChar(pending[i])
        i = i + 1
    }
    pending = ""
}

// A candidate failed at byte c: release the held bytes, release c, and
// restart -- c itself may begin a new CRLF lead-in.
func scanMismatch(c: char) {
    flushPending()
    if c == CR {
        pending = "\x0D"
        matchState = sCr
    } else {
        dataChar(c)
        matchState = sIdle
    }
}

// End of a received chunk: release a held CRLF lead-in. A result-code
// body already under way stays held across chunks.
// ponytail: a code split right after its CRLF still leaks that CR; buffer
// with a short timeout if a modem turns out to do that.
func scanEndChunk() {
    if matchState == sCr or matchState == sLead { flushPending() }
}

func feedChar(c: char) {
    switch matchState {
    case sIdle {
        if c == CR {
            pending = "\x0D"
            matchState = sCr
        } else {
            dataChar(c)
        }
    }
    case sCr {
        if c == LF {
            pending = pending + c
            matchState = sLead
        } else {
            scanMismatch(c)       // another CR starts a new lead-in
        }
    }
    case sLead {
        if c == 'C' {
            matchState = sConn
            matchIdx = 1
            pending = pending + c
        } else if c == 'N' {
            matchState = sNoCarr
            matchIdx = 1
            pending = pending + c
        } else if c == 'R' {
            matchState = sRing
            matchIdx = 1
            pending = pending + c
        } else {
            scanMismatch(c)
        }
    }
    case sConn {
        if c == connectLit[matchIdx] {
            pending = pending + c
            matchIdx = matchIdx + 1
            if matchIdx == connectLit.length { matchState = sDig1 }
        } else {
            scanMismatch(c)
        }
    }
    case sDig1 {
        if c >= '0' and c <= '9' {
            pending = pending + c
            matchState = sDigMore
        } else {
            scanMismatch(c)
        }
    }
    case sDigMore {
        if pending.length >= 30 {         // absurdly long "baud": not a code
            scanMismatch(c)
        } else if c == CR {
            pending = pending + c
            matchState = sConnEnd
        } else if c >= '0' and c <= '9' {
            pending = pending + c
        } else {
            scanMismatch(c)
        }
    }
    case sConnEnd {
        if c == LF {
            pending = ""
            matchState = sLead   // this CRLF can lead the next result code
            connected()
        } else {
            scanMismatch(c)
        }
    }
    case sNoCarr {
        if c == noCarrierLit[matchIdx] {
            pending = pending + c
            matchIdx = matchIdx + 1
            if matchIdx == noCarrierLit.length {
                pending = ""
                matchState = sLead
                disconnected()
            }
        } else {
            scanMismatch(c)
        }
    }
    case sRing {
        if c == ringLit[matchIdx] {
            pending = pending + c
            matchIdx = matchIdx + 1
            if matchIdx == ringLit.length {
                pending = ""
                matchState = sLead
                ring()
            }
        } else {
            scanMismatch(c)
        }
    }
    }
}
