// Login log: one fixed-width, tab-delimited text line per completed
// session, appended when the caller disconnects. Every record is
// exactly loginRecSize bytes, so the newest N are one positioned read
// from the tail while the file stays readable in any text editor:
//
//   new(1) TAB name(31) TAB "mm-dd-yy HH:MM:SS"(17) TAB duration(12)
//     TAB terminal(10) CR
//
// `new` is '*' for a session that created its account, else ' '.
// Logs from before 2026-10-24 hold 65-byte records with no terminal
// field, and new ones are appended after them, so the reader walks
// back from the end: a record whose byte 12 before its CR is a TAB is
// new (that byte falls inside an old record's space-padded duration).

include "terminal.cla"   // pad

const loginLogName: string = "Logins.txt"
const loginRecSize: int = 76
const loginOldRecSize: int = 65
const loginNameWidth: int = 31
const loginTimeWidth: int = 17
const loginDurWidth: int = 12
const loginTermWidth: int = 10

// Field offsets within a record.
const loginNewAt:  int = 0
const loginNameAt: int = 2
const loginTimeAt: int = 34
const loginDurAt:  int = 52
const loginTermAt: int = 65

func loginRecord(isNew: bool, name: string, at: int, secs: int, term: string): string {
    var rec: string = " "
    if isNew { rec = "*" }
    rec = rec + "\x09" + pad(name, loginNameWidth)
    rec = rec + "\x09" + pad(dateTimeStr(at), loginTimeWidth)
    rec = rec + "\x09" + pad(durationStr(secs), loginDurWidth)
    rec = rec + "\x09" + pad(term, loginTermWidth) + "\n"
    return rec
}

// Append one session. Opens and closes the file each time: writes are
// rare, and holding no handle keeps the file safe to read from the
// Finder.
func loginLogAppend(isNew: bool, name: string, at: int, secs: int, term: string): bool {
    var f: filehandle = file.open(loginLogName)
    var ok: bool
    if f == nil {
        f = file.create(loginLogName, "TEXT", "ttxt")
        if f == nil { return false }
    }
    ok = f.writeAt(f.size(), loginRecord(isNew, name, at, secs, term))
    if ok { ok = f.flush() }
    f.close()
    return ok
}

// The newest `max` records, newest first, as record strings (field
// offsets above); an old record comes back with a blank terminal. A
// missing file is an empty log.
func loginLogRecent(max: int, out: list of string) {
    var f: filehandle = file.open(loginLogName)
    var size: int
    var take: int
    var data: text
    var p: int
    out.clear()
    if f == nil { return }
    size = f.size()
    take = max * loginRecSize
    if take > size { take = size }
    if take > 0 and f.readAt(size - take, take, data) {
        p = data.length              // end of the record being read
        while out.count < max and p >= loginOldRecSize {
            if p >= loginRecSize and data[p - 12] == '\x09' {
                out.add(data[p - loginRecSize, loginRecSize])
                p = p - loginRecSize
            } else {
                out.add(data[p - loginOldRecSize, loginOldRecSize - 1] + "\x09" + pad("", loginTermWidth) + "\n")
                p = p - loginOldRecSize
            }
        }
    }
    f.close()
}

// One padded field of a record (see the offsets above).
func loginField(rec: string, at: int, width: int): string {
    return rec[at, width]
}

// --- Recent callers ----------------------------------------------------
// The Mac window's Callers table: the newest recentKeep sessions, newest
// first, held in memory (70 bytes each) and seeded from the log at
// launch. Only logged-in sessions reach the log, so bots that never get
// past the login prompt never show up here.

record RecentCaller {
    name: string(31)
    when: string(11)     // "mm-dd HH:MM"
    term: string(10)
    time: string(12)     // durationStr
}

const recentKeep: int = 50
var recentCallers: list of RecentCaller

// A record string's field, trailing pad spaces dropped.
func loginTrim(rec: string, at: int, width: int): string {
    var n: int = width
    while n > 0 and rec[at + n - 1] == ' ' { n = n - 1 }
    return rec[at, n]
}

// Add one session (a loginRecord string), at the front for a new call
// or at the back while seeding; the oldest beyond recentKeep drop off.
func recentPut(rec: string, front: bool) {
    var c: RecentCaller
    var t: string = rec[loginTimeAt, loginTimeWidth]
    c.name = loginTrim(rec, loginNameAt, loginNameWidth)
    c.when = t[0, 5] + " " + t[9, 5]
    c.term = loginTrim(rec, loginTermAt, loginTermWidth)
    c.time = loginTrim(rec, loginDurAt, loginDurWidth)
    if front {
        recentCallers.unshift(c)
    } else {
        recentCallers.add(c)
    }
    while recentCallers.count > recentKeep { recentCallers.pop() }
}

func recentSeed() {
    var recs: list of string
    var i: int = 0
    recentCallers.clear()
    recentCallers.reserve(recentKeep + 1)
    loginLogRecent(recentKeep, recs)
    while i < recs.count {
        recentPut(recs[i], false)
        i = i + 1
    }
}
