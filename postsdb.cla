// Posts for one message board: fixed-size header records in a vDB
// database plus an append-only body heap, the classic message-base
// split (Hudson/Squish/JAM). A board's files are BRD<nn>.DAT/.IDX/
// .I00/.I01/.JNL (headers, board IDs 1-99) and BRD<nn>.MSG (bodies).
//
// On-disk header record (160 bytes, vDB record ID = post ID):
//   0    sender, 64-byte Pascal field (a name, not a user ID, so
//        echomail senders need not be local users)
//   64   created (i32, Mac-epoch seconds)
//   68   thread ID (i32, indexed): 0 for a thread starter; the
//        starter's post ID on replies
//   72   subject, 64-byte Pascal field
//   136  body offset in the .MSG heap (i32)
//   140  body length (i32; 0 = no body)
//   144  msgidCrc (u32, indexed): crc32 of the FTN MSGID; 0 = none
//   148  origin address (4 x u16; zeros for a local post)
//   156  flags (u16; bit 0 = inbound from the network)
//   158+ reserved
//
// Bodies are exact-fit and never journaled: addPost appends + flushes
// the body BEFORE the journaled header add, so a crash can only leave
// orphaned heap bytes, never a header pointing at missing text.
// Deleted posts orphan their body bytes until postsCompact (heap.cla)
// reclaims them.

include "vdb.cla"
include "ftnaddr.cla"
include "heap.cla"
include "boardsdb.cla"

const postRecordSize: int = 160
const pOffSender: int = 0
const pOffCreated: int = 64
const pOffThread: int = 68
const pOffSubject: int = 72
const pOffBodyOff: int = 136
const pOffBodyLen: int = 140
const pOffMsgId: int = 144
const pOffOrigin: int = 148
const pOffFlags: int = 156

const postFlagInbound: int = 1

record Post {
    id: int
    sender: string(63)
    created: int
    threadId: int
    subject: string(63)
    msgidCrc: int
    origin: FtnAddress
    flags: int
}

var postsDb: Database
var postsBody: filehandle
var post: Post      // last loaded post header
var postsBoardId: int = 0   // the open board, 0 = none (a caller or a toss may switch it)

func postsName(boardId: int): string {
    return "BRD" + char(int('0') + boardId / 10) + char(int('0') + boardId mod 10)
}

// Open board `boardId`'s posts (closing any board already open),
// creating its files on first use.
func postsOpen(boardId: int): bool {
    var name: string
    postsClose()
    if boardId < 1 or boardId > 99 { return false }
    name = postsName(boardId)
    postsDb = dbOpen(name, "68BB")
    if not dbIsOpen(postsDb) {
        postsDb = dbCreate(name, postRecordSize, "68BB")
        if not dbIsOpen(postsDb) { return false }
        if not dbAddIndex(postsDb, "Thread", itID, pOffThread) {
            postsClose()
            return false
        }
        if not dbAddIndex(postsDb, "MsgId", itID, pOffMsgId) {
            postsClose()
            return false
        }
    }
    if not heapRecover(postsDb, name + ".MSG", pOffBodyOff, pOffBodyLen) {
        postsClose()
        return false
    }
    postsBody = file.open(name + ".MSG")
    if postsBody == nil {
        postsBody = file.create(name + ".MSG", "TEXT", "68BB")
    }
    if postsBody == nil {
        postsClose()
        return false
    }
    postsBoardId = boardId
    return true
}

func postsClose() {
    var b: filehandle = postsBody
    if dbIsOpen(postsDb) { dbClose(postsDb) }
    postsDb = new Database
    if b != nil { b.close() }
    postsBody = nil
    postsBoardId = 0
}

func postCount(): int {
    return dbRecordCount(postsDb)
}

// For enumerating posts: loop loadPost over 1 .. postsNextId()-1.
func postsNextId(): int {
    return dbNextRecordId(postsDb)
}

func packPost(sender: string, created: int, threadId: int, subject: string, bodyOff: int, bodyLen: int, msgidCrc: int, origin: FtnAddress, flags: int): text {
    var t: text
    var s: string = sender
    var sub: string = subject
    if s.length > 63 { s = s[0, 63] }
    if sub.length > 63 { sub = sub[0, 63] }
    t.append(char(s.length))
    t.append(s)
    while t.length < pOffCreated {
        t.append(char(0))
    }
    btAppendInt(t, created)
    btAppendInt(t, threadId)
    t.append(char(sub.length))
    t.append(sub)
    while t.length < pOffBodyOff {
        t.append(char(0))
    }
    btAppendInt(t, bodyOff)
    btAppendInt(t, bodyLen)
    btAppendInt(t, msgidCrc)
    packAddress(t, origin)
    btAppendWord(t, flags)
    return t
}

// Add a local post; threadId is 0 for a new thread, or the thread
// starter's post ID for a reply. Returns the new post ID, or -1.
func addPost(sender: string, threadId: int, subject: string, body: text): int {
    var none: FtnAddress
    return addPostFtn(sender, 0, threadId, subject, body, 0, none, 0)
}

// The full form: created 0 = now; msgidCrc/origin/flags from the
// packet (toss) or a generated MSGID (local posts on a networked board).
func addPostFtn(sender: string, created: int, threadId: int, subject: string, body: text, msgidCrc: int, origin: FtnAddress, flags: int): int {
    var b: filehandle = postsBody
    var off: int
    var when: int = created
    var id: int
    if not dbIsOpen(postsDb) or b == nil { return -1 }
    if when == 0 { when = now() }
    off = b.size()
    if off < 0 { return -1 }
    if body.length > 0 {
        // body first, then the journaled header (see file comment)
        if not b.append(body) { return -1 }
        if not b.flush() { return -1 }
    }
    id = dbAdd(postsDb, packPost(sender, when, threadId, subject, off, body.length, msgidCrc, origin, flags))
    if id > 0 { boardTouch(postsBoardId, when) }   // no-op when Boards isn't open
    return id
}

// Load post `id`'s header into the global `post`.
func loadPost(id: int): bool {
    var rec: text = dbFind(postsDb, id)
    if rec.length != postRecordSize { return false }
    post.id = id
    post.sender = dbExtractString(rec, pOffSender)
    post.created = rec.intAt(pOffCreated)
    post.threadId = rec.intAt(pOffThread)
    post.subject = dbExtractString(rec, pOffSubject)
    post.msgidCrc = rec.intAt(pOffMsgId)
    post.origin = addressAt(rec, pOffOrigin)
    post.flags = rec.wordAt(pOffFlags)
    return true
}

// The post carrying MSGID CRC `crc` in the open board; -1 if none (or
// crc is 0, which marks "no MSGID" and is never looked up).
func findPostByMsgId(crc: int): int {
    if crc == 0 { return -1 }
    return dbFindByInt(postsDb, "MsgId", crc)
}

// Fetch post `id`'s body from the heap; empty if the post has none
// (or doesn't exist).
func postBody(id: int): text {
    var none: text
    var out: text
    var rec: text = dbFind(postsDb, id)
    var b: filehandle = postsBody
    if rec.length != postRecordSize or b == nil { return none }
    if rec.intAt(pOffBodyLen) == 0 { return none }
    if not b.readAt(rec.intAt(pOffBodyOff), rec.intAt(pOffBodyLen), out) { return none }
    if out.length != rec.intAt(pOffBodyLen) { return none }
    return out
}

// All post IDs in a thread: the starter first, then replies in
// posting order. Empty if `root` doesn't exist.
func threadPosts(root: int, ids: list of int) {
    var more: list of int
    var i: int = 0
    ids.clear()
    if dbFind(postsDb, root).length != postRecordSize { return }
    ids.add(root)
    dbFindAllByInt(postsDb, "Thread", root, more)
    while i < more.count {
        ids.add(more[i])
        i = i + 1
    }
}

// Delete every post created before `cutoff` (Mac-epoch seconds; the
// caller computes now() - keepDays * 86400). Walks the dense ID range
// with one header read per post; each delete is journaled. Bodies stay
// in the heap until heapCompact (heap.cla) reclaims them. Returns the
// count, or -1 if the board can't be opened; leaves the board open.
func expirePosts(boardId: int, cutoff: int): int {
    var id: int = 1
    var last: int
    var n: int = 0
    var rec: text
    if not postsOpen(boardId) { return -1 }
    last = postsNextId()
    while id < last {
        rec = dbFind(postsDb, id)
        if rec.length == postRecordSize and rec.intAt(pOffCreated) < cutoff {
            if dbDelete(postsDb, id) { n = n + 1 }
        }
        id = id + 1
    }
    return n
}

// Maintenance: compact the headers (dbCompact: slide, truncate, rebuild
// indexes) and then the body heap. Leaves the board open.
func postsCompact(boardId: int): bool {
    var b: filehandle
    var name: string = postsName(boardId)
    if not postsOpen(boardId) { return false }
    postsDb = dbCompact(postsDb)
    if not dbIsOpen(postsDb) {
        postsClose()
        return false
    }
    b = postsBody
    b.close()
    postsBody = nil
    if not heapCompact(postsDb, name + ".MSG", pOffBodyOff, pOffBodyLen) { return false }
    postsBody = file.open(name + ".MSG")
    return postsBody != nil
}
