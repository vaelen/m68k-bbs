// The Guestbook database: short, timestamped shoutouts from callers,
// shown newest first after login and from the main menu.
//
// On-disk record ("Guestbook" database, 160 bytes, record ID = entry ID):
//   0    name, 32-byte Pascal field
//   32   created (i32, Mac-epoch seconds)
//   36   message, 121-byte Pascal field (<= gbMessageMax chars)
//   157+ slack
//
// No indexes: IDs are monotonic, so descending ID is descending time.

include "vdb.cla"

const gbRecordSize: int = 160
const gbMessageMax: int = 120

const gbOffName: int = 0
const gbOffCreated: int = 32
const gbOffMessage: int = 36

var guestbookDb: Database

// The entry last loaded by loadGuestbookEntry.
var gbName: string(31)
var gbCreated: int = 0
var gbMessage: string(120)

// Open the Guestbook database, creating it on first run.
func guestbookOpen(): bool {
    guestbookDb = dbOpen("Guestbook", "68BB")
    if dbIsOpen(guestbookDb) { return true }
    guestbookDb = dbCreate("Guestbook", gbRecordSize, "68BB")
    return dbIsOpen(guestbookDb)
}

func guestbookClose() {
    if dbIsOpen(guestbookDb) { dbClose(guestbookDb) }
    guestbookDb = new Database
}

func guestbookCount(): int {
    return dbRecordCount(guestbookDb)
}

// Add an entry stamped now(); name and message are truncated to their
// fields. Returns the new ID, or -1 (lastError).
func addGuestbookEntry(name: string, msg: string): int {
    var t: text
    var n: string = name
    var m: string = msg
    if n.length > 31 { n = n[0, 31] }
    if m.length > gbMessageMax { m = m[0, gbMessageMax] }
    t.append(char(n.length))
    t.append(n)
    while t.length < gbOffCreated {
        t.append(char(0))
    }
    btAppendInt(t, now())
    t.append(char(m.length))
    t.append(m)
    return dbAdd(guestbookDb, t)
}

// Load entry `id` into gbName/gbCreated/gbMessage.
func loadGuestbookEntry(id: int): bool {
    var rec: text = dbFind(guestbookDb, id)
    if rec.length != gbRecordSize { return false }
    gbName = dbExtractString(rec, gbOffName)
    gbCreated = rec.intAt(gbOffCreated)
    gbMessage = rec.stringAt(gbOffMessage)   // dbExtractString caps at 63
    return true
}

// The newest n entry IDs, newest first: probe down from the last
// assigned ID (deleted IDs miss), the walk drawPostList uses.
func recentGuestbookIds(n: int, ids: list of int) {
    var id: int = dbNextRecordId(guestbookDb) - 1
    var rec: text
    ids.clear()
    while id >= 1 and ids.count < n {
        rec = dbFind(guestbookDb, id)
        if rec.length == gbRecordSize { ids.add(id) }
        id = id - 1
    }
}
