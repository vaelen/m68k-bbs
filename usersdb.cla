// The Users database: vDB-backed account storage for the BBS.
// Include after user.cla (this module reads/writes the global `user`).
//
// On-disk record ("Users" database, 160 bytes, vDB record ID = user ID):
//   0    username, 64-byte Pascal field (indexed, case-insensitive)
//   64   password hash (i32, djb2 -- hashPassword in user.cla)
//   68   email, 64-byte Pascal field
//   132  access level (1 byte: 'U' user, 'S' sysop)
//   133  created (i32, Mac-epoch seconds)
//   137  last seen (i32, Mac-epoch seconds)
//   141+ reserved for future fields (record_size 160 leaves slack)

include "vdb.cla"

const userRecordSize: int = 160

// accessUser / accessSysop live in user.cla, next to the `access`
// field they describe.

const uOffName: int = 0
const uOffHash: int = 64
const uOffEmail: int = 68
const uOffAccess: int = 132
const uOffCreated: int = 133
const uOffLastSeen: int = 137

var usersDb: Database

// Open the Users database, creating it (with its username index) on
// first run. False + lastError if neither works.
func usersOpen(): bool {
    usersDb = dbOpen("Users", "68BB")
    if dbIsOpen(usersDb) { return true }
    usersDb = dbCreate("Users", userRecordSize, "68BB")
    if not dbIsOpen(usersDb) { return false }
    return dbAddIndex(usersDb, "Username", itString, uOffName)
}

func usersClose() {
    if dbIsOpen(usersDb) { dbClose(usersDb) }
    usersDb = new Database
}

func userCount(): int {
    return dbRecordCount(usersDb)
}

// The user ID owning `name` (case-insensitive), or -1.
func findUserId(name: string): int {
    return dbFindByString(usersDb, "Username", name)
}

// Serialize user fields into a record image (dbAdd/dbUpdate zero-pad
// it to record_size). name/email are assumed to fit their fields
// (callers pass string(31)/string(63) values vs 64-byte fields).
func packUserFields(name: string, hash: int, email: string, access: char, created: int, lastSeen: int): text {
    var t: text
    t.append(char(name.length))
    t.append(name)
    while t.length < uOffHash {
        t.append(char(0))
    }
    btAppendInt(t, hash)
    t.append(char(email.length))
    t.append(email)
    while t.length < uOffAccess {
        t.append(char(0))
    }
    t.append(access)
    btAppendInt(t, created)
    btAppendInt(t, lastSeen)
    return t
}

// Serialize the session user.
func packUser(): text {
    return packUserFields(user.name, user.passwordHash, user.email, user.access, user.created, user.lastSeen)
}

// Write arbitrary field values to user record `id` (the session user
// is untouched). dbUpdate keeps the username index current on rename.
func updateUserFields(id: int, name: string, hash: int, email: string, access: char, created: int, lastSeen: int): bool {
    if id < 1 { return false }
    return dbUpdate(usersDb, id, packUserFields(name, hash, email, access, created, lastSeen))
}

// Load record `id` into the session user. Session-only fields
// (screen, mode, buffer, authenticated) are left untouched.
func loadUser(id: int): bool {
    var rec: text = dbFind(usersDb, id)
    if rec.length != userRecordSize { return false }
    user.id = id
    user.name = dbExtractString(rec, uOffName)
    user.passwordHash = rec.intAt(uOffHash)
    user.email = dbExtractString(rec, uOffEmail)
    user.access = rec[uOffAccess]
    user.created = rec.intAt(uOffCreated)
    user.lastSeen = rec.intAt(uOffLastSeen)
    return true
}

// Store the session user as a new account. Returns the new user ID
// (also set on user.id), or -1.
func createUser(): int {
    var id: int = dbAdd(usersDb, packUser())
    if id > 0 { user.id = id }
    return id
}

// Write the session user back to its record.
func saveUser(): bool {
    if user.id < 1 { return false }
    return dbUpdate(usersDb, user.id, packUser())
}
