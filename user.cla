// Session state for the connected caller.

// The app version: bbs.cla's app block and the FTN tearline/PID/EMSI
// carry it. Lives here so module tests reach it without bbs.cla.
const bbsVersion: string = "0.4"

record User {
    name:          string(31)
    authenticated: bool
    passwordHash:  int
    screen:        string(31) = "login"
    buffer:        string(255)        // line-mode input so far
    id:            int                // vDB record ID; 0 = not stored
    email:         string(63)
    access:        int                // Access flag bits (below)
    created:       int                // Mac-epoch seconds
    lastSeen:      int                // Mac-epoch seconds
}

var user: User

// Access flags: `access` is a bit set, one bit per Access member
// (the member's value is its bit number). Each gate checks its own
// bit; Sysop implies nothing else, so the first account is created
// with every bit and everyone after with accessDefault.
enum Access {
    Login          "Login"
    SendMail       "Send Mail"
    PostBoards     "Post to Boards"
    UploadFiles    "Upload Files"
    ApproveUploads "Approve Uploads"
    PostWall       "Post on Wall"
    Games          "Access Games"
    Sysop          "Sysop"
    BasicRepl      "BASIC Prompt"
}
const accessFlagCount: int = 9
const accessDefault:  int = 367        // all but ApproveUploads and Sysop
const accessAllFlags: int = 511        // bits 0-8

func getBit(v: int, n: int): bool { return (v & (1 << n)) != 0 }
func setBit(v: int, n: int): int { return v | (1 << n) }
func clearBit(v: int, n: int): int { return v & ~(1 << n) }

func accessHas(v: int, f: Access): bool { return getBit(v, int(f)) }
func hasPermission(f: Access): bool { return accessHas(user.access, f) }
func setPermission(f: Access, grant: bool) {
    if grant { user.access = setBit(user.access, int(f)) } else { user.access = clearBit(user.access, int(f)) }
}

func accessLabel(f: Access): string {
    switch f {
    case Login          { return "Login" }
    case SendMail       { return "Send Mail" }
    case PostBoards     { return "Post to Boards" }
    case UploadFiles    { return "Upload Files" }
    case ApproveUploads { return "Approve Uploads" }
    case PostWall       { return "Post on Wall" }
    case Games          { return "Access Games" }
    case Sysop          { return "Sysop" }
    case BasicRepl      { return "BASIC Prompt" }
    }
    return ""
}

// The file-area access byte (areasdb.cla): accessAll = visible to
// everyone, accessSysop = staff only.
const accessAll:   char = '\x00'
const accessSysop: char = 'S'

// djb2 hash of a password, masked positive -- the same per-byte step
// the runtime's text.hashStep uses.
// ponytail: not cryptographic; fine for a hobby BBS on a 68k. If real
// secrecy ever matters, store salted hashes with a proper KDF instead.
func hashPassword(p: string): int {
    var h: int = 5381
    var i: int = 0
    while i < p.length {
        h = ((h << 5) + h + int(p[i])) & 0x7FFFFFFF
        i = i + 1
    }
    return h
}
