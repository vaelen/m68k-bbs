// CLI self-check for the Boards database module (boardsdb.cla).
// Run by scripts/test.sh from a scratch directory.
// Exits 0 on pass, 1 on the first failure.

include "../boardsdb.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    var id1: int
    var id2: int

    expect(boardsOpen(), "boards db created on first open")
    expect(boardCount() == 0, "no boards yet")
    expect(not loadBoard(1), "missing board fails to load")

    id1 = createBoard("General", "General discussion", "", 0)
    id2 = createBoard("fsxNet Ads", "Adverts", "FSX_ADS", 1)
    expect(id1 == 1 and id2 == 2, "board IDs assigned in order")
    expect(boardCount() == 2, "count tracks creation")
    expect(boardsNextId() == 3, "next ID exposed for enumeration")

    expect(loadBoard(id1), "load first board")
    expect(board.id == id1, "board id set")
    expect(board.name == "General", "name roundtrip")
    expect(board.description == "General discussion", "description roundtrip")
    expect(board.tag == "" and board.networkId == 0, "local board has no tag/network")
    expect(not boardNetworked(), "local board is not networked")

    expect(loadBoard(id2) and board.tag == "FSX_ADS" and board.networkId == 1, "tag/network roundtrip")
    expect(boardNetworked(), "tagged board on a network is networked")
    expect(board.lastExported == 0 and board.flags == 0, "marks start at zero")
    board.lastExported = 17
    board.flags = boardFlagSubscribed
    expect(saveBoard(), "save marks")
    expect(loadBoard(id2) and board.lastExported == 17 and board.flags == boardFlagSubscribed, "marks roundtrip")
    expect(board.keepDays == 0, "expiry defaults to never")
    board.keepDays = 90
    expect(saveBoard(), "save expiry")
    expect(loadBoard(id2) and board.keepDays == 90, "expiry roundtrip")
    expect(loadBoard(id1) and board.keepDays == 0, "other board untouched")
    expect(dbFind(boardsDb, id2).intAt(bOffKeepDays) == 90, "expiry stored at offset 202")
    expect(board.lastPost == 0, "lastPost starts at zero")
    boardTouch(id2, 0 - 123456789)
    expect(board.lastPost == 0, "touching another board leaves the loaded one")
    expect(loadBoard(id2) and board.lastPost == 0 - 123456789, "lastPost roundtrip")
    expect(dbFind(boardsDb, id2).intAt(bOffLastPost) == 0 - 123456789, "lastPost stored at offset 206")
    boardTouch(id2, 42)
    expect(board.lastPost == 42, "touching the loaded board updates it in place")
    expect(loadBoard(id2) and board.keepDays == 90 and board.name == "fsxNet Ads", "touch keeps the other fields")
    boardTouch(99, 1)
    expect(loadBoard(id2) and board.lastPost == 42, "touching a missing board is a no-op")
    expect(dbFind(boardsDb, id2).length == 256, "record is 256 bytes")

    boardsClose()
    expect(boardsOpen(), "existing db reopens")
    expect(boardCount() == 2, "count survives reopen")
    expect(loadBoard(id2) and board.name == "fsxNet Ads", "boards survive reopen")
    boardsClose()

    if failures > 0 {
        log("boardsdb-test: FAILED")
        quit 1
    }
    log("boardsdb-test: all passed")
    quit
}
