// CLI self-check for the modem result-code scanner. Run on the host:
//   ~/repos/clarus/scripts/clarus-run.sh tests/scanner-test.cla
// Exits 0 on pass, 1 on the first failure.

include "../scanner.cla"

var failures: int = 0
var isConnected: bool = false

// Stubs for the callbacks scanner.cla requires (the app's versions also
// talk to the modem).
func connected() { isConnected = true }
func disconnected() { isConnected = false }

func feedString(s: string) {
    var i: int = 0
    while i < s.length {
        feedChar(s[i])
        i = i + 1
    }
}

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    // 1. CONNECT split across three chunks
    feedString("\x0D\x0ACONN")
    feedString("ECT 96")
    expect(not isConnected, "no fire before final CRLF")
    feedString("00\x0D\x0A")
    expect(isConnected, "CONNECT split across chunks")

    // 2. NO CARRIER split across chunks
    feedString("some session data\x0D\x0ANO CAR")
    expect(isConnected, "still connected mid-match")
    feedString("RIER\x0D\x0A")
    expect(not isConnected, "NO CARRIER split across chunks")

    // 3. CONNECT with no digits must not fire
    feedString("\x0D\x0ACONNECT\x0D\x0A")
    expect(not isConnected, "CONNECT without digits ignored")

    // 4. mid-line result text must not fire (no leading CRLF)
    feedString("say NO CARRIER out loud\x0D\x0A")
    feedString("CONNECT 1200\x0D\x0A")   // leading CRLF came from prev line
    expect(isConnected, "trailing CRLF of one line leads the next")

    // 5. back-to-back: CONNECT's closing CRLF leads NO CARRIER
    feedString("\x0D\x0ANO CARRIER\x0D\x0ACONNECT 2400\x0D\x0A")
    expect(isConnected, "NO CARRIER then CONNECT chained")
    feedString("NO CARRIER\x0D\x0A")
    expect(not isConnected, "chained NO CARRIER")

    // 6. false start then real match
    feedString("\x0D\x0ACONNE\x0D\x0ACONNECT 300\x0D\x0A")
    expect(isConnected, "partial CONNECT then real one")

    if failures > 0 {
        log("scanner-test: FAILED")
        quit 1
    }
    log("scanner-test: all passed")
    quit
}
