// CLI self-check for the per-board posts module (postsdb.cla):
// header records in vDB, bodies in the append-only .MSG heap.
// Run by scripts/test.sh from a scratch directory.
// Exits 0 on pass, 1 on the first failure.

include "../postsdb.cla"

var failures: int = 0
var ids: list of int

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func heapSize(): int {
    var b: filehandle = postsBody
    return b.size()
}

on App.startCLI(args: list of string) {
    var id1: int
    var id2: int
    var id3: int
    var r: text
    var body1: text
    var body2: text
    var a: FtnAddress
    var p4: int
    var legacy: Database

    body1 = "Hello, world!"
    body2 = "This is a longer reply body, packed right after the first."

    expect(not postsOpen(0), "board ID 0 rejected")
    expect(boardsOpen() and createBoard("General", "", "", 0) == 1, "a board to stamp")
    expect(postsOpen(1), "board 1 posts db created")
    expect(postCount() == 0, "no posts yet")
    expect(heapSize() == 0, "body heap starts empty")

    // a thread starter and a reply
    id1 = addPost("andrew", 0, "First post!", body1)
    expect(loadPost(id1) and loadBoard(1) and board.lastPost == post.created and post.created != 0, "adding a post stamps the board's lastPost")
    expect(id1 == 1, "thread starter added")
    id2 = addPost("alice", id1, "Re: First post!", body2)
    expect(id2 == 2, "reply added")
    expect(heapSize() == body1.length + body2.length, "bodies packed exactly")

    expect(loadPost(id1), "load starter header")
    expect(post.sender == "andrew", "sender roundtrip")
    expect(post.threadId == 0, "starter thread ID is 0")
    expect(post.subject == "First post!", "subject roundtrip")
    expect(post.created != 0, "created timestamp set")
    r = postBody(id1)
    expect(r == body1, "starter body roundtrip")
    r = postBody(id2)
    expect(r == body2, "reply body read from its heap offset")

    // a bodyless post and a second reply
    id3 = addPost("bob", id1, "Re: First post!", postBody(99))
    expect(id3 == 3, "bodyless post added")
    expect(postBody(id3).length == 0, "no body comes back empty")
    expect(heapSize() == body1.length + body2.length, "empty body wrote nothing")

    // thread listing: starter first, replies in posting order
    threadPosts(id1, ids)
    expect(ids.count == 3, "thread has three posts")
    expect(ids[0] == id1 and ids[1] == id2 and ids[2] == id3, "thread order is starter then replies")
    threadPosts(99, ids)
    expect(ids.count == 0, "missing thread is empty")

    // boards are isolated from each other
    expect(postsOpen(2), "board 2 posts db created")
    expect(postCount() == 0, "board 2 is empty")
    expect(addPost("carol", 0, "Other board", postBody(99)) == 1, "board 2 gets its own ID space")

    // persistence: reopen board 1, headers and heap offsets intact
    expect(postsOpen(1), "board 1 reopens")
    expect(postCount() == 3, "post count survives reopen")
    expect(postsNextId() == 4, "next ID survives reopen")
    r = postBody(id2)
    expect(r == body2, "heap offsets still valid after reopen")
    threadPosts(id1, ids)
    expect(ids.count == 3, "thread index survives reopen")

    // FTN fields: crc/origin/flags roundtrip, the MsgId index, explicit dates
    a = parseAddress("21:1/242")
    expect(addPostFtn("Rixter", 0, 0, "Rick's BBS", body1, 12345, a, postFlagInbound) == 4, "FTN post added")
    expect(loadPost(4) and post.msgidCrc == 12345 and post.flags == postFlagInbound, "crc/flags roundtrip")
    expect(addressStr(post.origin) == "21:1/242", "origin roundtrip")
    expect(loadPost(id1) and post.msgidCrc == 0 and addressIsZero(post.origin) and post.flags == 0, "local post has zero FTN fields")
    expect(findPostByMsgId(12345) == 4, "MsgId index finds the post")
    expect(findPostByMsgId(99999) < 0, "unknown crc")
    expect(findPostByMsgId(0) < 0, "crc 0 is never looked up")
    expect(addPostFtn("x", 0 - 1000000, 0, "dated", body1, 0, a, 0) == 5, "explicit created accepted")
    expect(loadPost(5) and post.created == 0 - 1000000, "created stored as given")

    // expiry: cutoff boundaries, and a reply outliving its starter
    // (timestamps are Mac-epoch ints, ~ -440M in 2026, so cutoffs are relative to now())
    expect(addPostFtn("old", now() - 3000000, 0, "starter", body1, 0, a, 0) == 6, "old starter, 35 days ago")
    expect(addPostFtn("old", now() - 2000000, 6, "reply", body2, 0, a, 0) == 7, "newer reply to it, 23 days ago")
    expect(expirePosts(1, now() - 2500000) == 1, "only post 6 is older than the 29-day cutoff")
    expect(loadPost(5) and not loadPost(6), "post 5 kept, post 6 gone")
    expect(loadPost(7) and post.threadId == 6, "reply survives its starter")
    expect(postBody(7) == body2, "surviving body still reads")
    expect(loadPost(id1) and loadPost(4), "recent posts untouched")
    expect(expirePosts(1, now() - 2500000) == 0, "second pass finds nothing")
    expect(expirePosts(0, 0) == -1, "bad board")

    // date-ordered walks: echomail arrives out of date order, and two
    // posts can share a second (a multi-value Created key)
    expect(postsOpen(3), "board 3 posts db created")
    id1 = addPostFtn("w", now() - 100, 0, "newest", body1, 0, a, 0)
    id2 = addPostFtn("x", now() - 300, 0, "oldest a", body1, 0, a, 0)
    id3 = addPostFtn("y", now() - 200, 0, "middle", body1, 0, a, 0)
    p4 = addPostFtn("z", now() - 300, 0, "oldest b", body1, 0, a, 0)
    expect(id1 == 1 and id2 == 2 and id3 == 3 and p4 == 4, "four dated posts")
    expect(postsByCreatedStart(true), "descending walk starts")
    expect(postsByCreatedNext() == id1, "newest date first, not newest ID")
    expect(postsByCreatedNext() == id3, "then the middle date")
    expect(postsByCreatedNext() == p4, "same-second posts reversed when descending")
    expect(postsByCreatedNext() == id2, "both same-second posts surface")
    expect(postsByCreatedNext() == 0, "walk exhausts")
    postsByCreatedEnd()
    expect(expirePosts(3, now() - 150) == 3, "expiry by date, not ID")
    expect(loadPost(id1) and not loadPost(id2) and not loadPost(id3) and not loadPost(p4), "only the newest survives")
    postsClose()

    // Created-index migration: a board written before the index existed
    legacy = dbCreate("BRD09", postRecordSize, "68BB")
    expect(dbIsOpen(legacy), "legacy board db created")
    expect(dbAddIndex(legacy, "Thread", itID, pOffThread) and dbAddIndex(legacy, "MsgId", itID, pOffMsgId), "legacy board has only two indexes")
    expect(dbAdd(legacy, packPost("old-timer", now() - 400, 0, "pre-index", 0, 0, 0, a, 0)) == 1, "legacy record added")
    dbClose(legacy)
    expect(postsOpen(9), "legacy board opens")
    expect(dbHasIndex(postsDb, "Created"), "postsOpen adds the missing Created index")
    expect(postsByCreatedStart(false) and postsByCreatedNext() == 1, "migrated index finds the record")
    postsByCreatedEnd()
    postsClose()

    if failures > 0 {
        log("postsdb-test: FAILED")
        quit 1
    }
    log("postsdb-test: all passed")
    quit
}
