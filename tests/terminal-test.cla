// CLI self-check for terminal.cla's escape-sequence builders. Run on
// the host:
//   ~/repos/clarus/scripts/clarus-run.sh tests/terminal-test.cla
// Exits 0 on pass, 1 on the first failure.

include "../terminal.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    var i: int = 0
    var digit: char
    var want: string
    var w: list of int
    var cells: list of string
    var lines: list of string

    // All 16 foreground sequences: values 0-7 are "\x1B[22;3Xm",
    // 8-15 are the same X with bold ("\x1B[1;3Xm").
    for i in 0 to 15 {
        digit = char(int('0') + (i mod 8))
        if i < 8 {
            want = "\x1B[22;3" + digit + "m"
        } else {
            want = "\x1B[1;3" + digit + "m"
        }
        expect(colorSeq(Color(i)) == want, "colorSeq " + digit)
    }

    // All 16 background sequences: bright falls back to basic, so both
    // halves map to "\x1B[4Xm".
    for i in 0 to 15 {
        digit = char(int('0') + (i mod 8))
        want = "\x1B[4" + digit + "m"
        expect(backgroundSeq(Color(i)) == want, "backgroundSeq " + digit)
    }

    // Spot-check the enum order actually matches ANSI color numbering.
    expect(colorSeq(Black)      == "\x1B[22;30m", "Black is 30")
    expect(colorSeq(Yellow)     == "\x1B[22;33m", "Yellow is 33")
    expect(colorSeq(BrightCyan) == "\x1B[1;36m",  "BrightCyan is bold 36")
    expect(backgroundSeq(BrightRed) == backgroundSeq(Red), "bright bg falls back")

    expect(clearColorSeq      == "\x1B[22;39m", "clearColorSeq")
    expect(clearBackgroundSeq == "\x1B[49m",    "clearBackgroundSeq")

    // --- Terminal-aware builders: "" unless the terminal supports them
    terminal.color = false
    terminal.ansi = false
    expect(fg(Red) == "" and bg(Blue) == "" and fgOff() == "" and bgOff() == "", "no color: color builders empty")
    expect(clearScreen() == "" and bold(true) == "" and underline(true) == "", "no ansi: attribute builders empty")
    expect(blink(true) == "" and reverseVideo(true) == "" and attrsOff() == "", "no ansi: more builders empty")
    expect(moveTo(5, 10) == "", "no ansi: moveTo empty")
    terminal.ansi = true
    expect(fg(Red) == "", "ansi without color: fg still empty")
    expect(clearScreen() == "\x1B[2J\x1B[H", "clearScreen")
    expect(bold(true) == "\x1B[1m" and bold(false) == "\x1B[22m", "bold on/off")
    expect(underline(true) == "\x1B[4m" and underline(false) == "\x1B[24m", "underline on/off")
    expect(blink(true) == "\x1B[5m" and blink(false) == "\x1B[25m", "blink on/off")
    expect(reverseVideo(true) == "\x1B[7m" and reverseVideo(false) == "\x1B[27m", "reverse on/off")
    expect(attrsOff() == "\x1B[0m", "attrsOff")
    expect(moveTo(5, 10) == "\x1B[5;10H", "moveTo")
    terminal.color = true
    expect(fg(Red) == colorSeq(Red) and bg(Blue) == backgroundSeq(Blue), "color: fg/bg")
    expect(fgOff() == clearColorSeq and bgOff() == clearBackgroundSeq, "color: fgOff/bgOff")
    terminal.color = false
    terminal.ansi = false

    // --- PETSCII: control bytes behind ESC, own colors, no backgrounds
    terminal.type = PETSCII
    terminal.color = true
    expect(fg(Red) == "\x1B\x1C" and fg(BrightWhite) == "\x1B\x05", "petscii fg")
    expect(bg(Red) == "" and bgOff() == "", "petscii: no backgrounds")
    expect(fgOff() == "\x1B\x9A", "petscii fgOff is light blue")
    expect(clearScreen() == "\x1B\x93", "petscii clear")
    expect(bold(true) == "" and underline(true) == "" and blink(true) == "", "petscii: no bold/underline/blink")
    expect(reverseVideo(true) == "\x1B\x12" and reverseVideo(false) == "\x1B\x92", "petscii reverse")
    expect(attrsOff() == "\x1B\x92\x1B\x9A", "petscii attrsOff")
    expect(moveTo(3, 2) == "\x1B\x13\x1B\x11\x1B\x11\x1B\x1D", "petscii moveTo")
    expect(moveTo(1, 1) == "\x1B\x13", "petscii moveTo home")
    // text: case swap, box drawing to C= graphics, other high bytes '?',
    // ESC passes the next byte through, BS becomes DELETE
    expect(translateOut("Hi 9") == "\xC8I 9", "petscii case swap")
    expect(translateOut("\xDA\xC4\xBF\xB3\xC0\xD9") == "\xB0\xC0\xAE\xDD\xAD\xBD", "petscii box")
    expect(translateOut("\xC9\xCD\xBB") == "\xB0\xC0\xAE", "petscii double-line box")
    expect(translateOut("\x82\xE1") == "??", "petscii unknown high bytes")
    expect(translateOut("a_b|c\\") == "A\xA4B\xDDC?", "petscii punctuation")
    expect(translateOut("\x1B\x9Ex\x08") == "\x9EX\x14", "petscii ESC passthrough, BS")
    expect(translateOut("\x0D\x07") == "\x0D\x07", "petscii controls untouched")
    expect(petsciiIn('A') == 'a' and petsciiIn('\xC1') == 'A' and petsciiIn('\x14') == '\x08', "petscii input")
    expect(petsciiIn('1') == '1' and petsciiIn('\x0D') == '\x0D', "petscii input passthrough")
    w.clear()
    w.add(1)
    w.add(1)
    expect(ruleLine(TopLeft, TopCenter, TopRight, w) == "\xDA\xC4\xC4\xC4\xC2\xC4\xC4\xC4\xBF", "petscii rule is cp437 pre-wire")
    w.clear()
    terminal.color = false
    terminal.type = ASCII
    expect(translateOut("a\xC4b\xFF") == "a?b?", "ascii: high bytes are ?")
    expect(translateOut("\x1B[1m") == "\x1B[1m", "ascii: escapes untouched")
    terminal.type = ANSI
    expect(translateOut("a\xC4\x1B") == "a\xC4\x1B", "ansi: untouched")
    terminal.type = ASCII

    // --- Box drawing ----------------------------------------------------

    // Default eol is CRLF.
    expect(terminal.eol == "\x0D\x0A", "default eol is CRLF")
    expect(terminal.echo, "echo defaults on")
    expect(not terminal.linemode, "line mode defaults off")

    // output column tracking
    trackOutput("Username: ")
    expect(termCol == 10, "prompt advances column")
    trackOutput("ab\x08 \x08")
    expect(termCol == 11, "rubout nets one column back")
    trackOutput("\x1B[22;31mX\x1B)0\x07\x0E\x0A")
    expect(termCol == 12, "escape sequences and control bytes don't move")
    trackOutput("\x0D\x0Anew")
    expect(termCol == 3, "CR returns to column 0")

    // ASCII (the default type): corners and crossings are all '+'.
    expect(boxChar(TopLeft)    == '+', "ascii TopLeft")
    expect(boxChar(Center)     == '+', "ascii Center")
    expect(boxChar(Horizontal) == '-', "ascii Horizontal")
    expect(boxChar(Vertical)   == '|', "ascii Vertical")
    expect(hbar(3) == "---", "ascii hbar")
    expect(hbar(0) == "",    "hbar 0 is empty")
    expect(vbar() == "|",    "ascii vbar")
    expect(startDrawing() == "", "ascii startDrawing empty")
    expect(stopDrawing()  == "", "ascii stopDrawing empty")

    // ANSI: the cp437 line-drawing set.
    terminal.type = ANSI
    expect(boxChar(TopLeft)      == '\xDA', "ansi TopLeft")
    expect(boxChar(TopCenter)    == '\xC2', "ansi TopCenter")
    expect(boxChar(TopRight)     == '\xBF', "ansi TopRight")
    expect(boxChar(CenterLeft)   == '\xC3', "ansi CenterLeft")
    expect(boxChar(Center)       == '\xC5', "ansi Center")
    expect(boxChar(CenterRight)  == '\xB4', "ansi CenterRight")
    expect(boxChar(BottomLeft)   == '\xC0', "ansi BottomLeft")
    expect(boxChar(BottomCenter) == '\xC1', "ansi BottomCenter")
    expect(boxChar(BottomRight)  == '\xD9', "ansi BottomRight")
    expect(boxChar(Horizontal)   == '\xC4', "ansi Horizontal")
    expect(boxChar(Vertical)     == '\xB3', "ansi Vertical")
    expect(hbar(2) == "\xC4\xC4", "ansi hbar")
    expect(vbar() == "\xB3",      "ansi vbar")
    expect(startDrawing() == "", "ansi startDrawing empty")

    // VT100: DEC Special Graphics letters, shifted in/out with SO/SI.
    terminal.type = VT100
    expect(boxChar(TopLeft)      == 'l', "vt100 TopLeft")
    expect(boxChar(TopCenter)    == 'w', "vt100 TopCenter")
    expect(boxChar(TopRight)     == 'k', "vt100 TopRight")
    expect(boxChar(CenterLeft)   == 't', "vt100 CenterLeft")
    expect(boxChar(Center)       == 'n', "vt100 Center")
    expect(boxChar(CenterRight)  == 'u', "vt100 CenterRight")
    expect(boxChar(BottomLeft)   == 'm', "vt100 BottomLeft")
    expect(boxChar(BottomCenter) == 'v', "vt100 BottomCenter")
    expect(boxChar(BottomRight)  == 'j', "vt100 BottomRight")
    expect(boxChar(Horizontal)   == 'q', "vt100 Horizontal")
    expect(boxChar(Vertical)     == 'x', "vt100 Vertical")
    expect(hbar(3) == "qqq",         "vt100 hbar is bare")
    expect(vbar() == "\x0Ex\x0F",    "vt100 vbar wraps itself")
    expect(startDrawing() == "\x0E", "vt100 startDrawing is SO")
    expect(stopDrawing()  == "\x0F", "vt100 stopDrawing is SI")
    expect(vt100SetupSeq == "\x1B)0", "vt100 setup designates G1")
    terminal.type = ASCII

    // --- pad / center ---------------------------------------------------

    expect(pad("Foo", 6)    == "Foo   ", "pad right-fills")
    expect(pad("Foobar", 3) == "Foo",    "pad truncates")
    expect(pad("Foo", 3)    == "Foo",    "pad exact fit")
    expect(pad("", 2)       == "  ",     "pad empty string")
    expect(pad("Foo", 0)    == "",       "pad width 0")
    expect(padLeft("Page 1 of 2", 15) == "    Page 1 of 2", "padLeft left-fills")
    expect(padLeft("Foobar", 3) == "Foo", "padLeft truncates")
    expect(padLeft("Foo", 3)    == "Foo", "padLeft exact fit")
    expect(padLeft("", 2)       == "  ",  "padLeft empty string")
    expect(center("Table Title", 23) == "      Table Title      ", "center even")
    expect(center("Hi", 5)  == " Hi  ",  "center odd remainder goes right")
    expect(center("Foobar", 3) == "Foo", "center truncates")
    expect(center("", 2)    == "  ",     "center empty string")

    // --- ruleLine / rowLine ---------------------------------------------

    // ASCII, two columns of content widths 6 and 12 (the example table).
    w.add(6)
    w.add(12)
    cells.add("Foo")
    cells.add("Bar")
    expect(ruleLine(TopLeft, TopCenter, TopRight, w) == "+--------+--------------+",
           "ascii top rule")
    expect(ruleLine(CenterLeft, Center, CenterRight, w) == "+--------+--------------+",
           "ascii mid rule")
    expect(rowLine(cells, w) == "| Foo    | Bar          |", "ascii row")

    // A one-element widths list spans the table (title bar).
    w.clear()
    w.add(21)
    expect(ruleLine(BottomLeft, BottomCenter, BottomRight, w) ==
           "+-----------------------+", "ascii single-span rule")

    // ANSI uses the cp437 pieces.
    terminal.type = ANSI
    w.clear()
    w.add(1)
    w.add(1)
    expect(ruleLine(CenterLeft, Center, CenterRight, w) ==
           "\xC3\xC4\xC4\xC4\xC5\xC4\xC4\xC4\xB4", "ansi mid rule")
    cells.clear()
    cells.add("a")
    cells.add("b")
    expect(rowLine(cells, w) == "\xB3 a \xB3 b \xB3", "ansi row")

    // spanWidth: the one-column content width that renders the same
    // total width as the given columns ([1,1] table is 9 wide).
    expect(spanWidth(w) == 5, "spanWidth of two columns")

    // wrapText: word-wrap a body to a width, honoring CR breaks.
    wrapText("The quick brown fox jumps", 10, lines)
    expect(lines.count == 3, "wrap: 3 lines")
    expect(lines.count == 3 and lines[0] == "The quick" and lines[1] == "brown fox" and lines[2] == "jumps",
           "wrap: on word boundaries")
    wrapText("12345 678", 5, lines)
    expect(lines.count == 2 and lines[0] == "12345" and lines[1] == "678", "wrap: exact-fit word")
    wrapText("abcdefghijxyz", 5, lines)
    expect(lines.count == 3 and lines[0] == "abcde" and lines[1] == "fghij" and lines[2] == "xyz",
           "wrap: hard-break long word")
    wrapText("one\x0D\x0Dtwo", 20, lines)
    expect(lines.count == 3 and lines[0] == "one" and lines[1] == "" and lines[2] == "two",
           "wrap: CR breaks and blank line kept")
    wrapText("a\x0D\x0Ab", 20, lines)
    expect(lines.count == 2 and lines[0] == "a" and lines[1] == "b", "wrap: LF ignored (CRLF)")
    wrapText("", 20, lines)
    expect(lines.count == 0, "wrap: empty body")

    // VT100: rules are bare DEC letters (caller wraps via sendDrawing);
    // rows carry SO/SI around each bar.
    terminal.type = VT100
    expect(ruleLine(TopLeft, TopCenter, TopRight, w) == "lqqqwqqqk", "vt100 rule")
    expect(rowLine(cells, w) == "\x0Ex\x0F a \x0Ex\x0F b \x0Ex\x0F", "vt100 row")
    terminal.type = ASCII

    if failures > 0 {
        log("terminal-test: FAILED")
        quit 1
    }
    log("terminal-test: all passed")
    quit
}
