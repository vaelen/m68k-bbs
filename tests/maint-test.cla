// CLI self-check for maint.cla: the window rule, then a scheduled run
// and a manual compaction stepped by hand over seeded databases. Run by scripts/test.sh from
// a scratch directory. Exits 0 on pass, 1 on the first failure.

include "../maint.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func windowTests() {
    var t: int = now()
    var rec: DateTimeRec
    var start: int
    var h: int
    SecondsToDate(t, rec)
    h = rec.hour
    start = maintWindowStart(h)
    expect(start <= t and t - start < 3600, "this hour's window opened within the hour")
    start = maintWindowStart((h + 1) mod 24)
    expect(start <= t and t - start >= 23 * 3600 and t - start < 24 * 3600, "next hour's window is yesterday's")
    expect(maintDueAt(0, start), "never run is due")
    expect(maintDueAt(start - 1, start), "run before the window is due")
    expect(not maintDueAt(start, start), "run at the window start is not due")
    expect(not maintDueAt(t, start), "run just now is not due")
}

func seed() {
    var none: FtnAddress
    var i: int = 0
    expect(usersOpen() and boardsOpen() and networksOpen() and mailOpen() and areasOpen() and wallOpen(), "databases open")
    user.name = "sysop"
    user.access = accessAllFlags
    expect(createUser() == 1, "sysop")
    expect(createBoard("Keep", "never expires", "", 0) == 1, "board 1")
    expect(createBoard("Expire", "30 days", "", 0) == 2, "board 2")
    expect(loadBoard(2), "load board 2")
    board.keepDays = 30
    expect(saveBoard(), "board 2 keeps 30 days")
    expect(postsOpen(1) and addPostFtn("a", now() - 300000000, 0, "ancient but kept", "b", 0, none, 0) > 0, "old post on board 1")
    expect(postsOpen(2), "board 2")
        while i < 30 {
        expect(addPostFtn("a", now() - 40 * 86400, 0, "40 days old", "old body", 0, none, 0) == i + 1, "old post on board 2")
        i = i + 1
    }
    expect(addPost("a", 0, "fresh", "fresh body") == i + 1, "fresh post on board 2")
    postsClose()
    expect(createArea("Files", "d", "", accessAll) == 1, "area 1")
    expect(filesOpen(1) and addFile("x.txt", "u", "s", 1, 0, "desc") == 1, "a file entry")
    filesClose()
}

func run(): int {
    var steps: int = 0
    while maintaining and steps < 5000 {
        maintTick()
        steps = steps + 1
    }
    return steps
}

func runTests() {
    var steps: int = 0
    var deleting: int = 0
    var reported: bool = false
    var orphaned: int
    var usersStamp: int
    rejectCallers = false
    expect(maintStart(), "run starts")
    expect(maintaining and not compacting and rejectCallers, "run in progress closes the BBS")
    expect(not maintStart() and not compactStart(), "a second start is refused")
    // unit by unit (maintTick runs these until 5 ticks pass or one logs)
    while maintaining and steps < 5000 {
        if maintStep == msDelete { deleting = deleting + 1 }
        if maintStep == msDelete and maintDoomedAt == 10 and not reported {
            // a minute's worth of ticks: the progress line goes out and resets
            maintProgStart = TickCount() - maintProgressTicks
            maintYield = false
            maintProgress()
            reported = maintYield and maintProgCount == 0
        }
        maintUnit()
        steps = steps + 1
    }
    expect(reported, "progress line logged and counters reset")
    expect(not maintaining, "run finished")
    expect(not rejectCallers, "manual flag restored")
    expect(deleting == (30 + maintDeleteBatch - 1) / maintDeleteBatch + 1, "one batch per unit (plus the unit that moves on)")
    expect(postsOpen(2) and postCount() == 1 and not loadPost(1) and loadPost(31), "40-day-old posts expired, fresh one kept")
    postsClose()
    expect(file.info(":Boards:BRD02.MSG").size == 10, "board 2 heap compacted to the fresh body")
    expect(not file.exists(":Boards:BRD02.OLD") and not file.exists(":Boards:BRD02.NEW"), "no scratch files left")
    expect(postsOpen(2) and postBody(31) == "fresh body", "fresh body reads back")
    postsClose()
    expect(postsOpen(1) and postCount() == 1, "board with keepDays 0 untouched")
    postsClose()
    expect(dbLastCompacted(usersDb) != 0 and dbLastCompacted(boardsDb) == 0 and dbLastCompacted(mailDb) == 0, "no database compacted, only the Users marker stamped")
    expect(not maintDueNow(), "not due right after a run")

    // manual compaction: every database file, no heaps
    expect(postsOpen(1) and addPost("a", 0, "doomed", "orphan bytes") == 2 and dbDelete(postsDb, 2), "leave an orphan on board 1")
    postsClose()
    orphaned = file.info(":Boards:BRD01.MSG").size
    usersStamp = dbLastCompacted(usersDb)
    expect(compactStart(), "compaction starts")
    expect(maintaining and compacting and rejectCallers, "compaction closes the BBS")
    expect(not maintStart(), "maintenance refused during compaction")
    steps = run()
    expect(not maintaining and not compacting and not rejectCallers, "compaction finished")
    expect(dbLastCompacted(boardsDb) != 0 and dbLastCompacted(mailDb) != 0 and dbLastCompacted(wallDb) != 0, "fixed databases compacted")
    expect(postsOpen(1) and dbLastCompacted(postsDb) != 0 and postCount() == 1, "board headers compacted")
    postsClose()
    expect(file.info(":Boards:BRD01.MSG").size == orphaned, "compaction leaves heaps alone")
    expect(dbLastCompacted(usersDb) != 0 and mailCount() == 0, "Users compacted, mail still open")
}

on App.startCLI(args: list of string) {
    windowTests()
    seed()
    runTests()
    if failures > 0 {
        log("maint-test: FAILED")
        quit 1
    }
    log("maint-test: all passed")
    quit
}
