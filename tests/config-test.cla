// CLI self-check for config.cla: defaults, the written-out file,
// parsing, and range checks. Run by scripts/test.sh from a scratch
// directory. Exits 0 on pass, 1 on the first failure.

include "../user.cla"
include "../config.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func writeConfig(body: string): bool {
    var f: filehandle = file.create(configFileName, "TEXT", "ttxt")
    var ok: bool
    if f == nil { return false }
    ok = f.writeAt(0, body)
    f.close()
    return ok
}

on App.startCLI(args: list of string) {
    expect(configLoad(), "missing file: load writes defaults")
    expect(file.exists(configFileName), "Config.txt written out")
    expect(config.newUserAccess == accessDefault, "default access")
    expect(config.maintenanceHour == 4, "default maintenance hour is 4")

    expect(writeConfig("# test\nnewUserAccess=5\nmaintenanceHour = 6\n"), "write a config")
    expect(configLoad(), "load it")
    expect(config.newUserAccess == 5 and config.maintenanceHour == 6, "both keys parsed, spaces trimmed")

    expect(writeConfig("maintenanceHour=25\n"), "write an out-of-range hour")
    expect(configLoad() and config.maintenanceHour == 4, "hour above 23 keeps the default")
    expect(writeConfig("maintenanceHour=x\n"), "write a non-numeric hour")
    expect(configLoad() and config.maintenanceHour == 4, "non-numeric hour keeps the default")

    config.maintenanceHour = 23
    expect(configSave() and configLoad() and config.maintenanceHour == 23, "save/load roundtrip")

    if failures > 0 {
        log("config-test: FAILED")
        quit 1
    }
    log("config-test: all passed")
    quit
}
