// CLI self-check for the Guestbook database module (guestbookdb.cla).
// Run by scripts/test.sh from a scratch directory (the Guestbook.*
// files land there). Exits 0 on pass, 1 on the first failure.

include "../guestbookdb.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    var ids: list of int
    var long: string = ""

    expect(guestbookOpen(), "guestbook db created on first open")
    expect(guestbookCount() == 0, "no entries yet")
    recentGuestbookIds(20, ids)
    expect(ids.count == 0, "no recent ids")

    expect(addGuestbookEntry("Alice", "hello") == 1, "first entry gets ID 1")
    expect(addGuestbookEntry("Bob", "hi Alice") == 2, "second entry gets ID 2")
    while long.length < 130 {
        long = long + "x"
    }
    expect(addGuestbookEntry("Carol", long) == 3, "third entry gets ID 3")
    expect(guestbookCount() == 3, "three entries")

    expect(loadGuestbookEntry(1), "load entry 1")
    expect(gbName == "Alice" and gbMessage == "hello" and gbCreated != 0, "entry 1 fields")
    expect(loadGuestbookEntry(3) and gbName == "Carol", "load entry 3")
    expect(gbMessage.length == gbMessageMax, "message capped at 120")
    expect(not loadGuestbookEntry(4), "unknown id missing")

    expect(dbDelete(guestbookDb, 2), "delete entry 2")
    expect(not loadGuestbookEntry(2), "deleted entry missing")
    recentGuestbookIds(20, ids)
    expect(ids.count == 2 and ids[0] == 3 and ids[1] == 1, "newest first, deleted skipped")
    recentGuestbookIds(1, ids)
    expect(ids.count == 1 and ids[0] == 3, "n limits the list")

    guestbookClose()
    expect(guestbookOpen() and guestbookCount() == 2, "reopen keeps entries")
    guestbookClose()

    if failures > 0 {
        log("guestbookdb-test: FAILED")
        quit 1
    }
    log("guestbookdb-test: all passed")
    quit
}
