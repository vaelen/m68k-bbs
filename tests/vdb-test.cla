// CLI self-check for the vDB database module (vdb.cla, v2 format).
// Run by scripts/test.sh from a scratch directory; the database files
// created here land there and are cleaned up with it.
// Exits 0 on pass, 1 on the first failure.

include "../vdb.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func dataSize(db: Database): int {
    var f: filehandle = db.data
    return f.size()
}

// A recognizable multi-page payload: byte i is (i mod 251) + 1.
func patternData(n: int): text {
    var t: text
    var i: int = 0
    while i < n {
        t.append(char(i mod 251 + 1))
        i = i + 1
    }
    return t
}

// A user record for the index tests: 64-byte Pascal name at offset 0,
// i32 age at offset 64 (record_size 96 leaves slack).
func mkUser(name: string, age: int): text {
    var t: text
    t.append(char(name.length))
    t.append(name)
    while t.length < 64 {
        t.append(char(0))
    }
    btAppendInt(t, age)
    return t
}

on App.startCLI(args: list of string) {
    var db: Database
    var r: text
    var e: text
    var f: filehandle
    var id1: int
    var id2: int
    var id3: int
    var size: int

    // 1. create: header + free list on disk, no records
    db = dbCreate("VDBT", 32, "68BB")
    expect(dbIsOpen(db), "create opens a database")
    expect(dataSize(db) == 1024, "fresh .DAT is header + free list")
    expect(dbRecordCount(db) == 0, "fresh database is empty")

    // 2. add and find single-page records
    id1 = dbAdd(db, "alice")
    id2 = dbAdd(db, "bob")
    expect(id1 == 1 and id2 == 2, "record IDs assigned in order")
    expect(dbRecordCount(db) == 2, "record count tracks adds")
    r = dbFind(db, id1)
    expect(r.length == 32, "find returns record_size bytes")
    expect(r[0, 5] == "alice" and int(r[5]) == 0, "record data zero-padded")
    r = dbFind(db, id2)
    expect(r[0, 3] == "bob", "second record found")
    r = dbFind(db, 99)
    expect(r.length == 0, "missing ID returns empty")

    // 3. update in place
    expect(dbUpdate(db, id1, "carol"), "update succeeds")
    r = dbFind(db, id1)
    expect(r[0, 5] == "carol", "update visible")
    expect(not dbUpdate(db, 99, "nope"), "update of missing ID fails")

    // 4. delete, and page reuse on the next add
    size = dataSize(db)
    expect(dbDelete(db, id1), "delete succeeds")
    expect(dbFind(db, id1).length == 0, "deleted record gone")
    expect(dbRecordCount(db) == 1, "count tracks delete")
    expect(not dbDelete(db, id1), "second delete fails")
    id3 = dbAdd(db, "dave")
    expect(id3 == 3, "IDs never reused")
    expect(dataSize(db) == size, "freed page reused, file did not grow")
    r = dbFind(db, id3)
    expect(r[0, 4] == "dave", "record in reused page found")

    // 5. persistence across close/reopen
    dbClose(db)
    db = dbOpen("VDBT", "68BB")
    expect(dbIsOpen(db), "reopen succeeds")
    expect(dbRecordCount(db) == 2, "count survives reopen")
    r = dbFind(db, id2)
    expect(r[0, 3] == "bob", "records survive reopen")
    dbClose(db)

    // 6. bad opens fail cleanly
    db = dbOpen("VDBT-missing", "68BB")
    expect(not dbIsOpen(db), "open of missing database fails")
    f = file.create("BAD.DAT", "TEXT", "68BB")
    f.writeAt(0, "not a database at all, sorry")
    f.close()
    db = dbOpen("BAD", "68BB")
    expect(not dbIsOpen(db), "open rejects a non-vdb file")

    // 7. multi-page records (600 bytes -> 2 pages each)
    db = dbCreate("VDBT2", 600, "68BB")
    id1 = dbAdd(db, patternData(600))
    expect(id1 == 1, "multi-page add succeeds")
    r = dbFind(db, id1)
    expect(r.length == 600, "multi-page find returns full record")
    expect(int(r[0]) == 1 and int(r[505]) == 4 and int(r[506]) == 5 and int(r[599]) == 98,
        "bytes correct across the page boundary")
    size = dataSize(db)
    expect(dbDelete(db, id1), "multi-page delete succeeds")
    id2 = dbAdd(db, patternData(600))
    expect(dataSize(db) == size, "freed 2-page run reused")
    r = dbFind(db, id2)
    expect(r.length == 600 and int(r[599]) == 98, "record in reused run intact")
    dbClose(db)

    // 8. crash recovery: hand-craft a pending journal, then reopen.
    //    The journal holds a valid update for record 1 and a second,
    //    corrupted entry that must be skipped.
    db = dbCreate("VDBT3", 16, "68BB")
    id1 = dbAdd(db, "aaaa")
    dbClose(db)
    e = dbJournalEntry(joUpdate, 2, id1, psActive, "bbbb", 0)
    f = file.open("VDBT3.JNL")
    f.append(e)
    e = dbJournalEntry(joUpdate, 2, id1, psActive, "cccc", 0)
    e.setIntAt(100, 12345)      // corrupt after checksum was computed
    f.append(e)
    f.close()
    f = file.open("VDBT3.DAT")
    f.writeAt(22, "\x01")       // journal_pending = true
    f.close()
    db = dbOpen("VDBT3", "68BB")
    expect(dbIsOpen(db), "open with pending journal succeeds")
    r = dbFind(db, id1)
    expect(r[0, 4] == "bbbb", "valid journal entry replayed")
    expect(r[0, 4] != "cccc", "corrupted journal entry skipped")
    f = db.journal
    expect(f.size() == 0, "journal truncated after replay")
    id2 = dbAdd(db, "dddd")
    r = dbFind(db, id2)
    expect(r[0, 4] == "dddd", "database usable after recovery")
    dbClose(db)

    // 9. secondary indexes
    db = dbCreate("VDBT4", 96, "68BB")
    id1 = dbAdd(db, mkUser("alice", 30))
    id2 = dbAdd(db, mkUser("Bob", 42))
    expect(dbAddIndex(db, "Username", itString, 0), "string index built over existing records")
    expect(dbAddIndex(db, "Age", itID, 64), "int index added")
    expect(not dbAddIndex(db, "Username", itString, 0), "duplicate index name rejected")
    expect(not dbAddIndex(db, "Oops", itString, 40), "field past record end rejected")
    expect(dbFindByString(db, "Username", "alice") == id1, "find by string field")
    expect(dbFindByString(db, "Username", "ALICE") == id1, "string lookup case-insensitive")
    expect(dbFindByString(db, "Username", "bob") == id2, "mixed-case stored name found")
    expect(dbFindByString(db, "Username", "carol") == -1, "missing name not found")
    expect(dbFindByInt(db, "Age", 42) == id2, "find by int field")
    expect(dbFindByInt(db, "Age", 99) == -1, "missing int value not found")
    expect(dbFindByInt(db, "Username", 1) == -1, "type mismatch rejected")
    id3 = dbAdd(db, mkUser("carol", 25))
    expect(dbFindByString(db, "Username", "carol") == id3, "indexes maintained on add")
    expect(dbUpdate(db, id3, mkUser("carla", 26)), "update of indexed record")
    expect(dbFindByString(db, "Username", "carla") == id3, "new name indexed after update")
    expect(dbFindByString(db, "Username", "carol") == -1, "old name unindexed after update")
    expect(dbFindByInt(db, "Age", 26) == id3, "int index re-keyed by update")
    expect(dbDelete(db, id2), "delete of indexed record")
    expect(dbFindByString(db, "Username", "bob") == -1, "deleted name unindexed")
    expect(dbFindByInt(db, "Age", 42) == -1, "deleted int value unindexed")
    dbClose(db)
    db = dbOpen("VDBT4", "68BB")
    expect(dbFindByString(db, "Username", "alice") == id1, "index metadata survives reopen")
    dbClose(db)

    // 10. recovery rebuilds secondaries: journal an update renaming
    //     alice -> zelda (her record is page 2), crash, reopen
    e = dbJournalEntry(joUpdate, 2, id1, psActive, mkUser("zelda", 30), 0)
    f = file.open("VDBT4.JNL")
    f.append(e)
    f.close()
    f = file.open("VDBT4.DAT")
    f.writeAt(22, "\x01")       // journal_pending = true
    f.close()
    db = dbOpen("VDBT4", "68BB")
    expect(dbIsOpen(db), "reopen with pending journal succeeds")
    expect(dbFindByString(db, "Username", "zelda") == id1, "secondary rebuilt to journaled state")
    expect(dbFindByString(db, "Username", "alice") == -1, "stale index entry gone after rebuild")
    expect(dbFindByInt(db, "Age", 30) == id1, "int index also rebuilt")
    dbClose(db)

    // 11. compaction: five records, two holes, then squeeze
    db = dbCreate("VDBT5", 32, "68BB")
    id1 = dbAdd(db, "aaaa")
    dbAdd(db, "bbbb")
    id3 = dbAdd(db, "cccc")
    dbAdd(db, "dddd")
    expect(dbAdd(db, "eeee") == 5, "five records added")
    expect(dbDelete(db, 2) and dbDelete(db, 4), "two holes punched")
    expect(dataSize(db) == 3584, "file still holds seven pages")
    db = dbCompact(db)
    expect(dbIsOpen(db), "compact succeeds")
    expect(dataSize(db) == 2560, "file truncated to header + three records")
    r = dbFind(db, id1)
    expect(r[0, 4] == "aaaa", "unmoved record intact")
    r = dbFind(db, id3)
    expect(r[0, 4] == "cccc", "moved record intact")
    r = dbFind(db, 5)
    expect(r[0, 4] == "eeee", "last record intact")
    expect(dbFind(db, 2).length == 0 and dbFind(db, 4).length == 0, "deleted records still gone")
    expect(dbRecordCount(db) == 3, "record count recounted")
    db = dbCompact(db)
    expect(dbIsOpen(db), "no-op compact succeeds")
    expect(dataSize(db) == 2560, "no-op compact changes nothing")
    expect(dbAdd(db, "ffff") == 6, "IDs still never reused after compact")
    expect(dataSize(db) == 3072, "new record appended, free list truly empty")
    dbClose(db)
    f = file.open("VDBT5.DAT")
    f.readAt(0, 512, r)
    f.close()
    expect(r.intAt(18) != 0, "last_compacted stamped")

    // 12. compaction rebuilds the indexes (VDBT4: zelda p2, hole p3,
    //     carla p4 after tests 9-10)
    db = dbOpen("VDBT4", "68BB")
    expect(dataSize(db) == 2560, "VDBT4 has one hole before compaction")
    db = dbCompact(db)
    expect(dbIsOpen(db), "indexed db compacts")
    expect(dataSize(db) == 2048, "hole squeezed out")
    expect(dbFindByString(db, "Username", "zelda") == 1, "unmoved record still indexed")
    expect(dbFindByString(db, "Username", "carla") == 3, "moved record re-indexed")
    expect(dbFindByInt(db, "Age", 26) == 3, "int index survives compaction")
    dbClose(db)

    // 13. duplicate-copy healing: fake a crash mid-compaction by
    //     copying record 1's page over a free page, then recover
    db = dbCreate("VDBT6", 16, "68BB")
    id1 = dbAdd(db, "aaaa")
    id2 = dbAdd(db, "bbbb")
    expect(dbDelete(db, id2), "second record deleted")
    dbClose(db)
    f = file.open("VDBT6.DAT")
    f.readAt(1024, 512, r)       // page 2: record 1
    f.writeAt(1536, r)           // page 3: now a duplicate active copy
    f.writeAt(22, "\x01")        // journal_pending = true
    f.close()
    db = dbOpen("VDBT6", "68BB")
    expect(dbIsOpen(db), "recovery with duplicate copy succeeds")
    r = dbFind(db, id1)
    expect(r[0, 4] == "aaaa", "record readable after dedup")
    expect(dbAdd(db, "cccc") == 3, "new record added after heal")
    expect(dataSize(db) == 2048, "healed duplicate page was reused")
    r = dbFind(db, 3)
    expect(r[0, 4] == "cccc", "new record landed on the healed page")
    dbClose(db)

    if failures > 0 {
        log("vdb-test: FAILED")
        quit 1
    }
    log("vdb-test: all passed")
    quit
}
