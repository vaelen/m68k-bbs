// CLI self-check for the XMODEM sender. Run on the host via
// scripts/test.sh. Exits 0 on pass, 1 on the first failure.

include "../xmodem.cla"

var failures: int = 0
var sent: text          // everything the engine handed to xferOut
var doneCalls: int = 0
var doneOk: bool = false

func xferOut(t: text) { sent.append(t) }
func xferDone(ok: bool) {
    doneCalls = doneCalls + 1
    doneOk = ok
}

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func reset() {
    sent = ""
    doneCalls = 0
    doneOk = false
    recvCalls = 0
}

var recvName: string
var recvBytes: int = 0
var recvCalls: int = 0
var acceptNames: bool = true

func xferReceived(name: string, bytes: int) {
    recvCalls = recvCalls + 1
    recvName = name
    recvBytes = bytes
}
func xferAcceptName(name: string): bool { return acceptNames }

// Feed a CRC frame for block blk carrying data (128 or 1024 bytes).
func feedFrame(blk: int, data: text) {
    var i: int = 0
    var crc: int = crcXmodem(data)
    if data.length == 1024 { xmodemChar('\x02') } else { xmodemChar('\x01') }
    xmodemChar(char(blk))
    xmodemChar(char(255 - blk))
    while i < data.length {
        xmodemChar(data[i])
        i = i + 1
    }
    xmodemChar(char(crc >> 8))
    xmodemChar(char(crc))
}

func fillText(n: int, seed: int): text {
    var t: text
    var i: int = 0
    while i < n {
        t.append(char((i * 7 + seed) mod 256))
        i = i + 1
    }
    return t
}

func readAll(path: string): text {
    var f: filehandle = file.open(path)
    var t: text
    if f == nil { return t }
    f.readAt(0, f.size(), t)
    f.close()
    return t
}


// A file of n bytes: byte i = (i * 7) mod 256, so blocks are distinct.
func makeFile(path: string, n: int) {
    var f: filehandle = file.create(path, "TEXT", "ttxt")
    var body: text
    var i: int = 0
    while i < n {
        body.append(char((i * 7) mod 256))
        i = i + 1
    }
    f.writeAt(0, body)
    f.close()
}

// Does sent[at ..] hold a well-formed CRC-mode frame for block blk
// covering file bytes [pos, pos+128) of a makeFile file of n bytes?
func expectBlock(at: int, blk: int, pos: int, n: int, name: string) {
    var i: int = 0
    var ok: bool = true
    var data: text
    var crc: int = 0
    if sent.length < at + 133 {
        expect(false, name + ": frame too short")
        return
    }
    ok = ok and sent[at] == '\x01'
    ok = ok and sent[at + 1] == char(blk)
    ok = ok and sent[at + 2] == char(255 - blk)
    while i < 128 {
        if pos + i < n {
            ok = ok and sent[at + 3 + i] == char(((pos + i) * 7) mod 256)
        } else {
            ok = ok and sent[at + 3 + i] == '\x1A'
        }
        data.append(sent[at + 3 + i])
        i = i + 1
    }
    crc = crcXmodem(data)
    ok = ok and sent[at + 131] == char(crc >> 8)
    ok = ok and sent[at + 132] == char(crc)
    expect(ok, name)
}

// Like expectBlock for a CRC frame carrying `size` data bytes (1024 STX
// or 128 SOH).
func expectBig(at: int, blk: int, pos: int, n: int, size: int, name: string) {
    var i: int = 0
    var ok: bool = true
    var data: text
    var crc: int = 0
    if sent.length < at + size + 5 {
        expect(false, name + ": frame too short")
        return
    }
    if size == 1024 {
        ok = ok and sent[at] == '\x02'
    } else {
        ok = ok and sent[at] == '\x01'
    }
    ok = ok and sent[at + 1] == char(blk)
    ok = ok and sent[at + 2] == char(255 - blk)
    while i < size {
        if pos + i < n {
            ok = ok and sent[at + 3 + i] == char(((pos + i) * 7) mod 256)
        } else {
            ok = ok and sent[at + 3 + i] == '\x1A'
        }
        data.append(sent[at + 3 + i])
        i = i + 1
    }
    crc = crcXmodem(data)
    ok = ok and sent[at + 3 + size] == char(crc >> 8)
    ok = ok and sent[at + 4 + size] == char(crc)
    expect(ok, name)
}

on App.startCLI(args: list of string) {
    var check: text
    var got: text
    var i: int = 0
    var sum: int = 0

    // 1. CRC-16/XMODEM check value
    check = "123456789"
    expect(crcXmodem(check) == 0x31C3, "crcXmodem check value 0x31C3")

    // 2. CRC start: 300-byte file -> blocks 1..3, last padded, EOT
    makeFile("xm300.bin", 300)
    reset()
    xmodemSendStart("xm300.bin", "xm300.bin", 'X')
    expect(sent.length == 0, "nothing sent before the receiver starts")
    xmodemChar('C')
    expect(sent.length == 133, "C: block 1 sent, 133 bytes")
    expectBlock(0, 1, 0, 300, "block 1 framing and CRC")
    xmodemChar('\x06')                       // ACK
    expectBlock(133, 2, 128, 300, "ACK -> block 2")
    xmodemChar('\x15')                       // NAK
    expect(sent.length == 399, "NAK -> resend")
    i = 0
    while i < 133 {
        if sent[133 + i] != sent[266 + i] { i = 1000 }
        i = i + 1
    }
    expect(i == 133, "resend is byte-identical")
    xmodemChar('\x06')
    expectBlock(399, 3, 256, 300, "block 3 padded with SUB")
    xmodemChar('\x06')
    expect(sent.length == 533 and sent[532] == '\x04', "last ACK -> EOT")
    expect(doneCalls == 0, "not done until EOT is ACKed")
    xmodemChar('\x15')
    expect(sent.length == 534 and sent[533] == '\x04', "NAK after EOT -> EOT again")
    xmodemChar('\x06')
    expect(doneCalls == 1 and doneOk, "ACK after EOT -> xferDone(true)")
    expect(xmState == xmIdle, "idle after completion")

    // 3. Checksum start (NAK): 132-byte frame with 8-bit sum
    reset()
    xmodemSendStart("xm300.bin", "xm300.bin", 'X')
    xmodemChar('\x15')
    expect(sent.length == 132, "NAK start: checksum frame is 132 bytes")
    sum = 0
    i = 0
    while i < 128 {
        sum = sum + int(sent[3 + i])
        i = i + 1
    }
    expect(sent[131] == char(sum), "checksum byte")
    xmodemAbort()
    expect(doneCalls == 0 and xmState == xmIdle, "abort: silent, idle")

    // 4. Block number wraps 255 -> 0 (256 blocks = 32768 bytes + 1)
    makeFile("xmwrap.bin", 32769)
    reset()
    xmodemSendStart("xmwrap.bin", "xmwrap.bin", 'X')
    xmodemChar('C')
    i = 0
    while i < 255 {
        xmodemChar('\x06')
        i = i + 1
    }
    // block 256 (number 0) starts at 255 * 133
    expect(sent[255 * 133 + 1] == '\x00' and sent[255 * 133 + 2] == '\xFF', "block number wraps to 0")
    xmodemChar('\x06')
    expect(sent[256 * 133 + 1] == '\x01', "then 1 again")
    xmodemAbort()

    // 5. Peer cancel: CAN CAN -> done(false), nothing sent back
    reset()
    xmodemSendStart("xm300.bin", "xm300.bin", 'X')
    xmodemChar('C')
    xmodemChar('\x18')
    expect(doneCalls == 0, "single CAN ignored")
    xmodemChar('\x06')                       // any other byte resets the count
    xmodemChar('\x18')
    expect(doneCalls == 0, "CAN after a non-CAN ignored")
    xmodemChar('\x18')
    expect(doneCalls == 1 and not doneOk, "CAN CAN -> xferDone(false)")
    expect(sent.length == 266, "nothing sent after peer cancel")

    // 6. Timeouts: 20 ticks -> resend; 10 errors -> CAN CAN CAN + done(false)
    reset()
    xmodemSendStart("xm300.bin", "xm300.bin", 'X')
    xmodemChar('C')
    i = 0
    while i < 19 {
        xmodemTick()
        i = i + 1
    }
    expect(sent.length == 133, "19 ticks: no resend yet")
    xmodemTick()
    expect(sent.length == 266, "20 ticks: resend")
    i = 0
    while i < 9 * 20 {
        xmodemTick()
        i = i + 1
    }
    expect(doneCalls == 1 and not doneOk, "10 errors -> xferDone(false)")
    expect(sent.length == 133 * 10 + 3, "CAN CAN CAN sent after the last error")
    expect(sent[sent.length - 1] == '\x18', "last byte is CAN")

    // 7. No receiver: 120 ticks at start -> done(false)
    reset()
    xmodemSendStart("xm300.bin", "xm300.bin", 'X')
    i = 0
    while i < 119 {
        xmodemTick()
        i = i + 1
    }
    expect(doneCalls == 0, "119 ticks waiting: still waiting")
    xmodemTick()
    expect(doneCalls == 1 and not doneOk, "120 ticks waiting: xferDone(false)")

    // 8. Zero-length file: EOT on C
    makeFile("xm0.bin", 0)
    reset()
    xmodemSendStart("xm0.bin", "xm0.bin", 'X')
    xmodemChar('C')
    expect(sent == "\x04", "empty file: EOT immediately")
    xmodemChar('\x06')
    expect(doneCalls == 1 and doneOk, "empty file completes")

    // 10. XMODEM-1K: 1100-byte file -> one STX block (1029 bytes), then a
    //     128-byte SOH tail; checksum start still honoured
    makeFile("xm1100.bin", 1100)
    reset()
    xmodemSendStart("xm1100.bin", "xm1100.bin", '1')
    xmodemChar('C')
    expect(sent.length == 1029, "1K: STX frame is 1029 bytes")
    expectBig(0, 1, 0, 1100, 1024, "1K: block 1 framing and CRC")
    xmodemChar('\x06')
    expect(sent.length == 1029 + 133, "1K: tail is a 128-byte SOH block")
    expectBig(1029, 2, 1024, 1100, 128, "1K: tail framing, padded")
    xmodemChar('\x06')
    expect(sent[sent.length - 1] == '\x04', "1K: EOT after the tail")
    xmodemChar('\x06')
    expect(doneCalls == 1 and doneOk, "1K: complete")
    reset()
    xmodemSendStart("xm1100.bin", "xm1100.bin", '1')
    xmodemChar('\x15')
    expect(sent.length == 1028 and sent[0] == '\x02', "1K: NAK start -> STX block with checksum")
    xmodemAbort()

    // 11. YMODEM: header block, C to start data, EOT, C, end block
    reset()
    xmodemSendStart("xm1100.bin", "xm1100.bin", 'Y')
    xmodemChar('\x15')
    expect(sent.length == 0, "YMODEM: NAK start ignored (CRC only)")
    xmodemChar('C')
    expect(sent.length == 133, "YMODEM: block 0 is a 128-byte SOH frame")
    expect(sent[1] == '\x00' and sent[2] == '\xFF', "YMODEM: block number 0")
    expect(sent[3, 16] == "xm1100.bin\x001100\x00", "YMODEM: name NUL size NUL")
    expect(sent[19] == '\x00' and sent[130] == '\x00', "YMODEM: NUL padded")
    check = ""
    i = 0
    while i < 128 {
        check.append(sent[3 + i])
        i = i + 1
    }
    expect(sent[131] == char(crcXmodem(check) >> 8) and sent[132] == char(crcXmodem(check)), "YMODEM: block 0 CRC")
    xmodemChar('\x06')
    expect(sent.length == 133, "YMODEM: ACK of block 0 sends nothing yet")
    xmodemChar('C')
    expect(sent.length == 133 + 1029, "YMODEM: C starts the 1K data")
    expectBig(133, 1, 0, 1100, 1024, "YMODEM: data block 1")
    xmodemChar('\x06')
    xmodemChar('\x06')
    expect(sent[sent.length - 1] == '\x04', "YMODEM: EOT")
    xmodemChar('\x06')
    expect(doneCalls == 0, "YMODEM: not done after EOT ACK")
    xmodemChar('C')
    i = sent.length - 133
    expect(sent[i] == '\x01' and sent[i + 1] == '\x00' and sent[i + 2] == '\xFF' and sent[i + 3] == '\x00', "YMODEM: empty block 0 ends the batch")
    xmodemChar('\x06')
    expect(doneCalls == 1 and doneOk, "YMODEM: complete")

    // 9. Missing file: done(false) at start
    reset()
    xmodemSendStart("no-such-file.bin", "x", 'X')
    expect(doneCalls == 1 and not doneOk, "missing file -> xferDone(false)")

    // 12. XMODEM receive: C first, two blocks, duplicate, bad CRC -> quiet -> NAK, EOT
    reset()
    xmodemRecvStart('X', "", "up.bin")
    expect(sent == "C", "recv: C sent at start")
    check = fillText(128, 1)
    feedFrame(1, check)
    expect(sent == "C\x06", "recv: good block 1 ACKed")
    feedFrame(1, check)
    expect(sent == "C\x06\x06", "recv: repeated block ACKed, not stored")
    check = fillText(128, 2)
    xmodemChar('\x01')
    xmodemChar('\x02')
    xmodemChar('\xFD')
    i = 0
    while i < 128 {
        xmodemChar(check[i])
        i = i + 1
    }
    xmodemChar('\x00')
    xmodemChar('\x00')                        // wrong CRC
    expect(sent.length == 3, "recv: bad frame: nothing sent yet")
    xmodemChar('z')                           // line still noisy
    xmodemTick()
    expect(sent.length == 3, "recv: purge waits for quiet")
    xmodemTick()
    expect(sent == "C\x06\x06\x15", "recv: NAK after 1 s of quiet")
    feedFrame(2, check)
    expect(sent == "C\x06\x06\x15\x06", "recv: block 2 ACKed")
    xmodemChar('\x04')
    expect(sent == "C\x06\x06\x15\x06\x06", "recv: EOT ACKed")
    expect(doneCalls == 1 and doneOk, "recv: done ok")
    expect(recvCalls == 1 and recvName == "up.bin" and recvBytes == 256, "recv: xferReceived(up.bin, 256)")
    check = fillText(128, 1)
    expect(readAll("up.bin")[0, 128] == check[0, 128], "recv: block 1 on disk")
    check = fillText(128, 2)
    expect(readAll("up.bin")[128, 128] == check[0, 128], "recv: block 2 on disk")

    // 13. Prodding: C every 6 ticks, NAK after 4 Cs (checksum), give up at 120
    reset()
    xmodemRecvStart('1', "", "up2.bin")
    i = 0
    while i < 23 {
        xmodemTick()
        i = i + 1
    }
    expect(sent == "CCCC", "recv: four Cs by tick 23")
    xmodemTick()
    expect(sent == "CCCC\x15", "recv: NAK fallback at tick 24")
    check = fillText(1024, 3)
    xmodemChar('\x02')
    xmodemChar('\x01')
    xmodemChar('\xFE')
    i = 0
    sum = 0
    while i < 1024 {
        xmodemChar(check[i])
        sum = sum + int(check[i])
        i = i + 1
    }
    xmodemChar(char(sum))
    expect(sent == "CCCC\x15\x06", "recv: 1K checksum block ACKed")
    xmodemChar('\x04')
    expect(recvBytes == 1024 and doneOk, "recv: 1K file complete")
    reset()
    xmodemRecvStart('X', "", "up3.bin")
    i = 0
    while i < 120 {
        xmodemTick()
        i = i + 1
    }
    expect(doneCalls == 1 and not doneOk, "recv: gives up after 120 ticks")
    expect(sent[sent.length - 1] == '\x18', "recv: cancels the sender")

    // 14. YMODEM receive: block 0 names the file, size trims padding, batch end
    reset()
    xmodemRecvStart('Y', "", "")
    expect(sent == "C", "yrecv: C at start")
    check = "dir/photo.bin\x00300 12345 100644\x00"
    while check.length < 128 { check.append('\x00') }
    feedFrame(0, check)
    expect(sent == "C\x06C", "yrecv: block 0 ACKed then C for data")
    check = fillText(128, 4)
    feedFrame(1, check)
    feedFrame(2, check)
    feedFrame(3, check)
    xmodemChar('\x04')
    expect(recvCalls == 1 and recvName == "photo.bin" and recvBytes == 300, "yrecv: basename, size trimmed to 300")
    got = readAll("photo.bin")
    expect(got.length == 300, "yrecv: file is 300 bytes")
    expect(doneCalls == 0, "yrecv: batch continues after EOT")
    expect(sent[sent.length - 1] == 'C', "yrecv: C for the next block 0")
    check = ""
    while check.length < 128 { check.append('\x00') }
    feedFrame(0, check)
    expect(doneCalls == 1 and doneOk, "yrecv: empty block 0 ends the batch")

    // 15. YMODEM: refused name -> CAN CAN CAN, done(false)
    reset()
    acceptNames = false
    xmodemRecvStart('Y', "", "")
    check = "bad:name\x00"
    while check.length < 128 { check.append('\x00') }
    feedFrame(0, check)
    expect(doneCalls == 1 and not doneOk and sent[sent.length - 1] == '\x18', "yrecv: refused name cancels")
    acceptNames = true

    // 16. Peer cancel while waiting between frames
    reset()
    xmodemRecvStart('X', "", "up4.bin")
    xmodemChar('\x18')
    xmodemChar('\x18')
    expect(doneCalls == 1 and not doneOk, "recv: CAN CAN -> done(false)")

    if failures > 0 {
        log(string(failures) + " failure(s)")
        quit 1
    }
    log("all xmodem tests passed")
    quit
}
