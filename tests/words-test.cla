// CLI self-check for Daily Word's pure logic (games/wordslib.cla).
// Run by scripts/test.sh from a scratch directory.
// Exits 0 on pass, 1 on the first failure.

include "../games/wordslib.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func testScoring() {
    expect(wordScore("abbey", "abbey") == "GGGGG", "all right")
    expect(wordScore("crane", "abbey") == "..Y.Y", "letters elsewhere")
    expect(wordScore("babes", "abbey") == "YYGG.", "duplicates: both b's used")
    expect(wordScore("bbbbb", "abbey") == ".GG..", "duplicates: extra copies are gray")
    expect(wordScore("lever", "eerie") == ".G.YY", "green claims its letter first")
    expect(wordScore("fghij", "abbey") == ".....", "nothing")
}

func testShape() {
    expect(wordsLower("CrAnE") == "crane", "lower")
    expect(wordsUpper("crane") == "CRANE", "upper")
    expect(wordsIsWord("crane"), "five letters")
    expect(not wordsIsWord("cran"), "four letters")
    expect(not wordsIsWord("cranes"), "six letters")
    expect(not wordsIsWord("cr4ne"), "a digit")
    expect(not wordsIsWord("CRANE"), "capitals are lowered by the caller first")
}

func testDays() {
    expect(civilDays(1970, 1, 1) == 0, "epoch")
    expect(civilDays(2000, 3, 1) == 11017, "2000-03-01")
    expect(civilDays(2026, 10, 1) - civilDays(2026, 9, 30) == 1, "month boundary")
    expect(civilDays(2027, 1, 1) - civilDays(2026, 12, 31) == 1, "year boundary")
    expect(civilDays(2028, 3, 1) - civilDays(2028, 2, 28) == 2, "leap year has Feb 29")
    expect(civilDays(2100, 3, 1) - civilDays(2100, 2, 28) == 1, "2100 is not a leap year")
    expect(wordsIsoDays("2026-10-01") == civilDays(2026, 10, 1), "iso date")
    expect(wordsIsoDays("2026/10/01") == -1, "wrong separators")
    expect(wordsIsoDays("2026-13-01") == -1, "month 13")
    expect(wordsIsoDays("2026-10-1") == -1, "short")
    expect(wordsIsoDays("") == -1, "empty")
    expect(wordsStampDays("10-01-26 00:00:05") == civilDays(2026, 10, 1), "dateTimeStr form")
    expect(wordsStampDays("10-29-26 23:59:59") - wordsIsoDays("2026-10-01") + 1 == 29, "puzzle number")
    expect(wordsStampDays("garbage") == -1, "bad stamp")
}

func writeFile(path: string, body: string): bool {
    var f: filehandle = file.create(path, "TEXT", "ttxt")
    var ok: bool
    if f == nil { return false }
    ok = f.writeAt(0, body)
    f.close()
    return ok
}

func testFiles() {
    expect(writeFile("list.txt", "abbey\x0Dcrane\x0Dlever\x0Dmoose\x0Dzebra\x0D"), "write a sorted list")
    expect(wordsFileCount("list.txt") == 5, "five lines")
    expect(wordsFind("list.txt", "abbey"), "first word")
    expect(wordsFind("list.txt", "lever"), "middle word")
    expect(wordsFind("list.txt", "zebra"), "last word")
    expect(not wordsFind("list.txt", "aaaaa"), "before the first")
    expect(not wordsFind("list.txt", "llama"), "between words")
    expect(not wordsFind("list.txt", "zzzzz"), "after the last")
    expect(wordsAnswerFor("list.txt", 1) == "abbey", "day 1 is line 0")
    expect(wordsAnswerFor("list.txt", 5) == "zebra", "day 5 is line 4")
    expect(wordsAnswerFor("list.txt", 6) == "abbey", "the cycle wraps")
    expect(writeFile("bad.txt", "abbey\x0Dcran\x0D"), "write a mangled list")
    expect(wordsFileCount("bad.txt") == 0, "size not a multiple of 6 counts as unusable")
    expect(not wordsFind("bad.txt", "abbey"), "no lookups in a mangled list")
    expect(wordsAnswerFor("bad.txt", 1) == "", "no answer from a mangled list")
    expect(wordsFileCount("missing.txt") == 0, "missing file")
}

func testRecord() {
    var at1: int
    var at2: int
    var f: filehandle
    var junk: text

    // a stranger has no record: blank, offset -1, and opening never writes
    expect(wordsLoad("stats.dat", 7) == -1, "no file, no record")
    expect(wordsRec.length == wordsRecSize and wordsRec.intAt(wOffUser) == 7, "blank record for the caller")
    expect(not file.exists("stats.dat"), "loading never creates the file")

    // day 1: miss, then win in 2
    wordsBeginDay(1)
    expect(int(wordsRec[wOffState]) == wordsPlaying, "a fresh game is playing")
    wordsAddGuess("crane", "abbey", 100)
    expect(int(wordsRec[wOffState]) == wordsPlaying and int(wordsRec[wOffUsed]) == 1, "a miss keeps playing")
    at1 = wordsSave("stats.dat", -1)
    expect(at1 == 0, "first player appended at 0")
    wordsAddGuess("abbey", "abbey", 200)
    expect(wordsSave("stats.dat", at1) == at1, "re-save in place")
    f = file.open("stats.dat")
    expect(f.size() == wordsRecSize, "re-saving never grows the file")
    f.close()
    expect(int(wordsRec[wOffState]) == wordsWon, "won")
    expect(wordsGuessAt(0) == "crane" and wordsGuessAt(1) == "abbey", "guesses kept")
    expect(wordsRec.wordAt(wOffPlayed) == 1 and wordsRec.wordAt(wOffWins) == 1, "totals")
    expect(wordsRec.wordAt(wOffStreak) == 1 and wordsRec.wordAt(wOffBest) == 1, "first streak")
    expect(wordsRec.wordAt(wOffDist + 2) == 1, "won in 2 counted")
    expect(wordsRec.intAt(wOffFinished) == 200, "finish time")

    // a second player appends after the first; both load back
    wordsLoad("stats.dat", 9)
    wordsBeginDay(1)
    wordsAddGuess("crane", "abbey", 300)
    at2 = wordsSave("stats.dat", -1)
    expect(at2 == wordsRecSize, "second player appended")
    expect(wordsLoad("stats.dat", 7) == 0 and wordsGuessAt(1) == "abbey", "first player found")
    expect(wordsLoad("stats.dat", 9) == wordsRecSize, "second player found")

    // day 2 continues the streak; day 4 (skipped 3) restarts it
    wordsLoad("stats.dat", 7)
    wordsBeginDay(2)
    expect(int(wordsRec[wOffUsed]) == 0 and wordsGuessAt(0) == "\x00\x00\x00\x00\x00", "new day clears guesses")
    wordsAddGuess("abbey", "abbey", 400)
    expect(wordsRec.wordAt(wOffStreak) == 2 and wordsRec.wordAt(wOffBest) == 2, "streak continues")
    expect(wordsLiveStreak(2, 2, 3) == 2, "live the day after")
    expect(wordsLiveStreak(2, 2, 4) == 0, "broken after a skipped day")
    wordsBeginDay(4)
    wordsAddGuess("abbey", "abbey", 500)
    expect(wordsRec.wordAt(wOffStreak) == 1 and wordsRec.wordAt(wOffBest) == 2, "streak restarts, best kept")
    wordsBeginDay(4)
    expect(int(wordsRec[wOffState]) == wordsWon, "same day: the finished game stays finished")

    // six misses lose and zero the streak
    wordsBeginDay(5)
    wordsAddGuess("crane", "abbey", 1)
    wordsAddGuess("crane", "abbey", 2)
    wordsAddGuess("crane", "abbey", 3)
    wordsAddGuess("crane", "abbey", 4)
    wordsAddGuess("crane", "abbey", 5)
    expect(int(wordsRec[wOffState]) == wordsPlaying, "five misses still playing")
    wordsAddGuess("crane", "abbey", 6)
    expect(int(wordsRec[wOffState]) == wordsLost, "sixth miss loses")
    expect(wordsRec.wordAt(wOffStreak) == 0 and wordsRec.wordAt(wOffPlayed) == 4, "loss: streak 0, played counts it")

    // a torn append: the partial tail is ignored and then overwritten
    f = file.open("stats.dat")
    junk.append("0123456789")
    expect(f.writeAt(f.size(), junk), "simulate a torn append")
    f.close()
    expect(wordsLoad("stats.dat", 11) == -1, "the tail is not a record")
    wordsBeginDay(1)
    expect(wordsSave("stats.dat", -1) == 2 * wordsRecSize, "append lands on the tail")
    f = file.open("stats.dat")
    expect(f.size() == 3 * wordsRecSize, "tail overwritten, file whole again")
    f.close()
    expect(wordsLoad("stats.dat", 11) == 2 * wordsRecSize, "third player found")
}

on App.startCLI(args: list of string) {
    testScoring()
    testShape()
    testDays()
    testFiles()
    testRecord()
    if failures > 0 {
        log("words-test: FAILED")
        quit 1
    }
    log("words-test: all passed")
    quit
}
