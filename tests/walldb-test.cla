// CLI self-check for the Wall database module (walldb.cla).
// Run by scripts/test.sh from a scratch directory (the Wall.*
// files land there). Exits 0 on pass, 1 on the first failure.

include "../walldb.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    var ids: list of int
    var long: string = ""

    expect(wallOpen(), "wall db created on first open")
    expect(wallCount() == 0, "no entries yet")
    recentWallIds(20, ids)
    expect(ids.count == 0, "no recent ids")

    expect(addWallEntry("Alice", "hello") == 1, "first entry gets ID 1")
    expect(addWallEntry("Bob", "hi Alice") == 2, "second entry gets ID 2")
    while long.length < 130 {
        long = long + "x"
    }
    expect(addWallEntry("Carol", long) == 3, "third entry gets ID 3")
    expect(wallCount() == 3, "three entries")

    expect(loadWallEntry(1), "load entry 1")
    expect(wallName == "Alice" and wallMessage == "hello" and wallCreated != 0, "entry 1 fields")
    expect(loadWallEntry(3) and wallName == "Carol", "load entry 3")
    expect(wallMessage.length == wallMessageMax, "message capped at 120")
    expect(not loadWallEntry(4), "unknown id missing")

    expect(dbDelete(wallDb, 2), "delete entry 2")
    expect(not loadWallEntry(2), "deleted entry missing")
    recentWallIds(20, ids)
    expect(ids.count == 2 and ids[0] == 3 and ids[1] == 1, "newest first, deleted skipped")
    recentWallIds(1, ids)
    expect(ids.count == 1 and ids[0] == 3, "n limits the list")

    wallClose()
    expect(wallOpen() and wallCount() == 2, "reopen keeps entries")
    wallClose()

    if failures > 0 {
        log("walldb-test: FAILED")
        quit 1
    }
    log("walldb-test: all passed")
    quit
}
