// CLI self-check for btree.cla, focused on overflow pages: one key
// holding far more values than fit a leaf entry. Run by scripts/test.sh
// from a scratch directory. Exits 0 on pass, 1 on the first failure.

include "../btree.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func countValues(f: filehandle, key: int): int {
    var v: list of int
    if not btFind(f, key, v) { return 0 - 1 }
    return v.count
}

func hasValue(f: filehandle, key: int, value: int): bool {
    var v: list of int
    var i: int = 0
    if not btFind(f, key, v) { return false }
    while i < v.count {
        if v[i] == value { return true }
        i = i + 1
    }
    return false
}

// Randomized inserts and value deletes against a model (parallel lists
// of key/value pairs): every key's values must match in order, and a
// scan must visit keys ascending. Covers the three-slice leaf rebuilds
// in btInsert/btRemove -- middle, first and last entries, splits, and
// keys spilling into overflow pages (key 7 gets far more than 32).
func fuzzTests() {
    var f: filehandle = btCreate("BTF.IDX", "VDBi", "68BB")
    var mk: list of int
    var mv: list of int
    var got: list of int
    var want: list of int
    var cur: text
    var seed: int = 12345
    var step: int = 0
    var key: int
    var i: int
    var j: int
    var ok: bool = true
    var prev: int
    var nextValue: int = 1
    while step < 4000 and ok {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        key = (seed / 65536) mod 60
        if (seed / 7) mod 3 == 0 { key = 7 }
        if mv.count > 0 and (seed / 131) mod 4 == 0 {
            // delete a random existing pair
            i = (seed / 4096) mod mv.count
            if not btDeleteValue(f, mk[i], mv[i]) { ok = false }
            mk.remove(i)
            mv.remove(i)
        } else {
            if not btInsert(f, key, nextValue) { ok = false }
            mk.add(key)
            mv.add(nextValue)
            nextValue = nextValue + 1
        }
        step = step + 1
    }
    expect(ok, "fuzz: every insert and delete succeeded")
    key = 0
    while key < 60 and ok {
        want.clear()
        i = 0
        while i < mk.count {
            if mk[i] == key { want.add(mv[i]) }
            i = i + 1
        }
        got.clear()
        if not btFind(f, key, got) { got.clear() }
        if got.count != want.count { ok = false }
        j = 0
        while ok and j < got.count {
            if got[j] != want[j] { ok = false }
            j = j + 1
        }
        if not ok { log("fuzz mismatch at key " + string(key) + ": " + string(got.count) + " vs " + string(want.count)) }
        key = key + 1
    }
    expect(ok, "fuzz: every key's values match the model, in order")
    ok = true
    prev = 0 - 1
    if btScanStart(f, cur, 0 - 1, false) {
        while btScanNext(f, cur) {
            if btScanKey(cur) <= prev { ok = false }
            prev = btScanKey(cur)
        }
    }
    expect(ok, "fuzz: scan visits keys ascending")
    f.close()
}

on App.startCLI(args: list of string) {
    var f: filehandle
    var v: list of int
    var i: int
    var ordered: bool
    var cur: text
    var f2: filehandle
    var hit: bool
    var sv: list of int
    var keys: int

    f = btCreate("BT.IDX", "VDBi", "68BB")
    expect(f != nil, "btree created")

    // 500 values under one key -- far past the ~123 that fit a leaf entry
    i = 1
    while i <= 500 {
        if not btInsert(f, 0, i) {
            expect(false, "insert value " + string(i) + " under key 0")
            i = 501
        }
        i = i + 1
    }
    expect(countValues(f, 0) == 500, "all 500 values under key 0 found")
    expect(hasValue(f, 0, 1) and hasValue(f, 0, 250) and hasValue(f, 0, 500), "first, middle, last present")

    // order preserved (inline block then chain, both ascending)
    btFind(f, 0, v)
    ordered = true
    i = 1
    while i < v.count {
        if v[i] <= v[i - 1] { ordered = false }
        i = i + 1
    }
    expect(ordered, "values come back in insertion order")

    // other keys still work alongside the big one
    expect(btInsert(f, 5, 42) and btInsert(f, 5, 43), "small key inserts")
    expect(countValues(f, 5) == 2, "small key has two values")
    expect(countValues(f, 0) == 500, "big key unaffected by small-key inserts")
    expect(countValues(f, 9) == 0 - 1, "absent key returns not found")

    // delete a value that lives in the overflow chain
    expect(btDeleteValue(f, 0, 300), "delete an overflow value")
    expect(countValues(f, 0) == 499, "one fewer after overflow delete")
    expect(not hasValue(f, 0, 300), "deleted value gone")
    expect(hasValue(f, 0, 299) and hasValue(f, 0, 301), "neighbours kept")

    // delete an inline value (one of the first few)
    expect(btDeleteValue(f, 0, 2), "delete an inline value")
    expect(countValues(f, 0) == 498 and not hasValue(f, 0, 2), "inline delete took")

    // btScanValues reads the cursor's snapshot: same answer as btFind,
    // for an inline key (5) and one spilling into overflow pages (0)
    hit = true
    keys = 0
    if btScanStart(f, cur, -2147483647 - 1, false) {
        while btScanNext(f, cur) {
            keys = keys + 1
            if not btScanValues(f, cur, sv) or not btFind(f, btScanKey(cur), v) or sv.count != v.count {
                hit = false
            } else {
                i = 0
                while i < v.count {
                    if sv[i] != v[i] { hit = false }
                    i = i + 1
                }
            }
        }
    }
    expect(keys == 2 and hit, "btScanValues matches btFind, inline and overflow")

    // persistence across reopen
    f.close()
    f = btOpen("BT.IDX")
    expect(f != nil, "reopened")
    expect(countValues(f, 0) == 498, "overflow values survive reopen")
    expect(hasValue(f, 0, 500) and not hasValue(f, 0, 300), "chain intact after reopen")

    // whole-key delete drops everything
    expect(btDelete(f, 0), "delete the whole big key")
    expect(countValues(f, 0) == 0 - 1, "big key gone")
    expect(countValues(f, 5) == 2, "small key survives the big delete")
    f.close()

    // --- scan cursor -------------------------------------------------
    f2 = btCreate("BTS.IDX", "VDBi", "68BB")
    expect(f2 != nil, "scan tree created")
    // 2500 keys (value = key * 7): ~70 leaves, two internal levels
    i = 1
    while i <= 2500 {
        if not btInsert(f2, i, i * 7) {
            expect(false, "scan insert " + string(i))
            i = 2501
        }
        i = i + 1
    }

    expect(btScanStart(f2, cur, 1, false), "ascending scan starts")
    i = 0
    ordered = true
    while btScanNext(f2, cur) {
        i = i + 1
        if btScanKey(cur) != i or btScanValue(cur) != i * 7 { ordered = false }
    }
    expect(i == 2500 and ordered, "ascending scan: all keys, in order")
    expect(not btScanNext(f2, cur), "exhausted scan stays done")

    expect(btScanStart(f2, cur, 2500, true), "descending scan starts")
    i = 2500
    ordered = true
    while btScanNext(f2, cur) {
        if btScanKey(cur) != i or btScanValue(cur) != i * 7 { ordered = false }
        i = i - 1
    }
    expect(i == 0 and ordered, "descending scan: all keys, in order")

    // seeded mid-range
    expect(btScanStart(f2, cur, 1200, false) and btScanNext(f2, cur), "asc seek 1200")
    expect(btScanKey(cur) == 1200, "asc seek lands on 1200")
    expect(btScanStart(f2, cur, 1200, true) and btScanNext(f2, cur), "desc seek 1200")
    expect(btScanKey(cur) == 1200, "desc seek lands on 1200")

    // holes: delete 900..1100 (empties several consecutive leaves)
    i = 900
    while i <= 1100 {
        btDeleteValue(f2, i, i * 7)
        i = i + 1
    }
    expect(btScanStart(f2, cur, 1000, false) and btScanNext(f2, cur), "asc seek into hole")
    expect(btScanKey(cur) == 1101, "asc scan skips the hole forward")
    expect(btScanStart(f2, cur, 1000, true) and btScanNext(f2, cur), "desc seek into hole")
    expect(btScanKey(cur) == 899, "desc scan skips the hole backward")
    // crossing the emptied leaves mid-run
    btScanStart(f2, cur, 890, false)
    i = 0
    hit = true
    while i < 15 and btScanNext(f2, cur) {
        i = i + 1
        if i <= 10 {
            if btScanKey(cur) != 889 + i { hit = false }
        } else {
            if btScanKey(cur) != 1090 + i { hit = false }
        }
    }
    expect(i == 15 and hit, "ascending run crosses emptied leaves")
    btScanStart(f2, cur, 1110, true)
    i = 0
    hit = true
    while i < 15 and btScanNext(f2, cur) {
        i = i + 1
        if i <= 10 {
            if btScanKey(cur) != 1111 - i { hit = false }
        } else {
            if btScanKey(cur) != 910 - i { hit = false }
        }
    }
    expect(i == 15 and hit, "descending run crosses emptied leaves")

    // ends of the range
    expect(btScanStart(f2, cur, 3000, true) and btScanNext(f2, cur) and btScanKey(cur) == 2500, "desc from past the top lands on max")
    expect(not (btScanStart(f2, cur, 3000, false) and btScanNext(f2, cur)), "asc from past the top is empty")
    expect(not (btScanStart(f2, cur, 0, true) and btScanNext(f2, cur)), "desc from below the bottom is empty")
    f2.close()

    // empty tree
    f2 = btCreate("BTE.IDX", "VDBi", "68BB")
    expect(not (btScanStart(f2, cur, 1, false) and btScanNext(f2, cur)), "empty tree asc scan is empty")
    expect(not (btScanStart(f2, cur, 1, true) and btScanNext(f2, cur)), "empty tree desc scan is empty")
    f2.close()

    fuzzTests()

    if failures > 0 {
        log("btree-test: FAILED")
        quit 1
    }
    log("btree-test: all passed")
    quit
}
