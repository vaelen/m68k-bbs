// CLI self-check for btree.cla, focused on overflow pages: one key
// holding far more values than fit a leaf entry. Run by scripts/test.sh
// from a scratch directory. Exits 0 on pass, 1 on the first failure.

include "../btree.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func countValues(f: filehandle, key: int): int {
    var v: list of int
    if not btFind(f, key, v) { return 0 - 1 }
    return v.count
}

func hasValue(f: filehandle, key: int, value: int): bool {
    var v: list of int
    var i: int = 0
    if not btFind(f, key, v) { return false }
    while i < v.count {
        if v[i] == value { return true }
        i = i + 1
    }
    return false
}

on App.startCLI(args: list of string) {
    var f: filehandle
    var v: list of int
    var i: int
    var ordered: bool

    f = btCreate("BT.IDX", "VDBi", "68BB")
    expect(f != nil, "btree created")

    // 500 values under one key -- far past the ~123 that fit a leaf entry
    i = 1
    while i <= 500 {
        if not btInsert(f, 0, i) {
            expect(false, "insert value " + string(i) + " under key 0")
            i = 501
        }
        i = i + 1
    }
    expect(countValues(f, 0) == 500, "all 500 values under key 0 found")
    expect(hasValue(f, 0, 1) and hasValue(f, 0, 250) and hasValue(f, 0, 500), "first, middle, last present")

    // order preserved (inline block then chain, both ascending)
    btFind(f, 0, v)
    ordered = true
    i = 1
    while i < v.count {
        if v[i] <= v[i - 1] { ordered = false }
        i = i + 1
    }
    expect(ordered, "values come back in insertion order")

    // other keys still work alongside the big one
    expect(btInsert(f, 5, 42) and btInsert(f, 5, 43), "small key inserts")
    expect(countValues(f, 5) == 2, "small key has two values")
    expect(countValues(f, 0) == 500, "big key unaffected by small-key inserts")
    expect(countValues(f, 9) == 0 - 1, "absent key returns not found")

    // delete a value that lives in the overflow chain
    expect(btDeleteValue(f, 0, 300), "delete an overflow value")
    expect(countValues(f, 0) == 499, "one fewer after overflow delete")
    expect(not hasValue(f, 0, 300), "deleted value gone")
    expect(hasValue(f, 0, 299) and hasValue(f, 0, 301), "neighbours kept")

    // delete an inline value (one of the first few)
    expect(btDeleteValue(f, 0, 2), "delete an inline value")
    expect(countValues(f, 0) == 498 and not hasValue(f, 0, 2), "inline delete took")

    // persistence across reopen
    f.close()
    f = btOpen("BT.IDX")
    expect(f != nil, "reopened")
    expect(countValues(f, 0) == 498, "overflow values survive reopen")
    expect(hasValue(f, 0, 500) and not hasValue(f, 0, 300), "chain intact after reopen")

    // whole-key delete drops everything
    expect(btDelete(f, 0), "delete the whole big key")
    expect(countValues(f, 0) == 0 - 1, "big key gone")
    expect(countValues(f, 5) == 2, "small key survives the big delete")
    f.close()

    if failures > 0 {
        log("btree-test: FAILED")
        quit 1
    }
    log("btree-test: all passed")
    quit
}
