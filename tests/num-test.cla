// CLI self-check for basic/num.cla, the BASIC interpreter's software
// float. Run on the host via scripts/test.sh. Exits 1 on any failure.

include "../basic/num.cla"

var failures: int = 0

func expect(cond: bool, name: string) {
    if cond {
        log("PASS " + name)
    } else {
        log("FAIL " + name)
        failures = failures + 1
    }
}

func n(i: int): Num { return numFromInt(i) }
func eqInt(x: Num, i: int): bool { return numCmp(x, numFromInt(i)) == 0 }

func expectStr(got: string, want: string, name: string) {
    if got == want {
        log("PASS " + name)
    } else {
        log("FAIL " + name + " got [" + got + "] want [" + want + "]")
        failures = failures + 1
    }
}

on App.startCLI(args: list of string) {
    var a: Num
    var b: Num
    var big: Num

    // --- arithmetic ---
    expect(eqInt(numAdd(n(2), n(3)), 5), "2+3")
    expect(eqInt(numSub(n(2), n(3)), -1), "2-3")
    expect(eqInt(numSub(n(7), n(7)), 0), "7-7 exactly zero")
    expect(numIsZero(numSub(n(7), n(7))), "7-7 isZero")
    expect(eqInt(numMul(n(-7), n(6)), -42), "-7*6")
    expect(eqInt(numDiv(n(84), n(2)), 42), "84/2")
    expect(numToInt(numDiv(n(1), n(3))) == 0, "int(1/3)")
    expect(eqInt(numFloor(numDiv(n(-1), n(3))), -1), "floor(-1/3)")
    a = numDiv(n(1), n(3))
    b = numMul(a, n(3))
    expect(numCmp(numAbs(numSub(b, n(1))), numDiv(n(1), n(1000000))) < 0, "1/3*3 within 1e-6")
    expect(numCmp(n(1), n(2)) < 0 and numCmp(n(2), n(1)) > 0 and numCmp(n(5), n(5)) == 0, "cmp")
    expect(numCmp(n(-1), n(1)) < 0 and numCmp(n(-2), n(-1)) < 0, "cmp negative")
    expect(numCmp(n(0), n(-1)) > 0 and numCmp(n(0), n(1)) < 0, "cmp zero")
    expect(numIsInt(n(7)) and not numIsInt(numDiv(n(7), n(2))), "isInt")
    expect(numToInt(numRound(numDiv(n(7), n(2)))) == 4, "round 3.5")
    expect(numToInt(numRound(numDiv(n(-7), n(2)))) == -4, "round -3.5")
    expect(numToInt(numRound(numDiv(n(5), n(2)))) == 3, "round 2.5")
    expect(eqInt(numMul(numMul(n(1000), n(1000)), n(1000)), 1000000000), "1e9 exact")
    big = numMul(n(46341), n(46341))
    expect(numCmp(big, n(2147483647)) > 0, "46341^2 exceeds int")
    expect(numToInt(numMul(n(1600), n(1000))) == 1600000, "1.6M")
    expect(numToInt(n(-2147483647 - 1)) == -2147483647 - 1, "min int round trip")
    expect(numToInt(numFloor(numDiv(n(7), n(2)))) == 3, "floor 3.5")
    expect(numToInt(numFloor(numDiv(n(-7), n(2)))) == -4, "floor -3.5")
    expect(numToInt(numDiv(n(-7), n(2))) == -3, "trunc -3.5")
    expect(numIntPart(numDiv(n(-1), n(2))) == -1, "intPart -.5")
    expect(numToInt(numMul(numDiv(n(1), n(1000)), n(1000000))) == 1000, "small times big")
    a = numDiv(n(1), n(1000))
    b = n(0)
    expect(numCmp(a, b) > 0, "0.001 > 0")

    // --- format ---
    expectStr(numStr(n(1)), " 1", "str 1")
    expectStr(numStr(n(-1)), "-1", "str -1")
    expectStr(numStr(n(0)), " 0", "str 0")
    expectStr(numStr(numDiv(n(1), n(2))), " .5", "str .5")
    expectStr(numStr(numDiv(n(1), n(3))), " .3333333", "str 1/3")
    expectStr(numStr(numDiv(n(-1), n(3))), "-.3333333", "str -1/3")
    expectStr(numStr(numDiv(n(2), n(3))), " .6666667", "str 2/3")
    expectStr(numStr(n(10000000)), " 1E+07", "str 1e7")
    expectStr(numStr(n(123456789)), " 1.234568E+08", "str 123456789")
    expectStr(numStr(n(1234567)), " 1234567", "str 1234567")
    expectStr(numStr(n(-1234567)), "-1234567", "str -1234567")
    expectStr(numStr(numDiv(n(1), n(10000))), " .0001", "str .0001")
    expectStr(numStr(numDiv(n(1), n(100000))), " 1E-05", "str 1e-5")
    expectStr(numStr(numDiv(n(1), n(10000000))), " 1E-07", "str 1e-7")
    expectStr(numStr(numDiv(n(3), n(2))), " 1.5", "str 1.5")
    expectStr(numStr(numDiv(n(1234567), n(100))), " 12345.67", "str 12345.67")
    expectStr(numStr(numMul(n(1600), n(1000))), " 1600000", "str 1.6M")
    expectStr(numStr(numMul(n(100000), n(100000))), " 1E+10", "str 1e10")
    expectStr(numStr(numDiv(n(1), n(7))), " .1428571", "str 1/7")
    expectStr(numStr(numMul(n(46341), n(46341))), " 2.147488E+09", "str 46341^2")
    expectStr(numStr(numDiv(n(999999949), n(100))), " 9999999", "str rounds up to 7 digits")
    expectStr(numStr(numDiv(n(99999995), n(10))), " 1E+07", "str rounding carry")
    // --- parse ---
    expectStr(numStr(numParse("1.5E3")), " 1500", "parse 1.5E3")
    expectStr(numStr(numParse(".5")), " .5", "parse .5")
    expectStr(numStr(numParse("-3")), "-3", "parse -3")
    expectStr(numStr(numParse("&HFF")), " 255", "parse &HFF")
    expectStr(numStr(numParse("&O17")), " 15", "parse &O17")
    expectStr(numStr(numParse("7.98")), " 7.98", "parse 7.98")
    expectStr(numStr(numParse("1.01")), " 1.01", "parse 1.01")
    expectStr(numStr(numParse(".98")), " .98", "parse .98")
    expectStr(numStr(numParse("3000")), " 3000", "parse 3000")
    expectStr(numStr(numParse("2E-2")), " .02", "parse 2E-2")
    expectStr(numStr(numParse("1D2")), " 100", "parse 1D2")
    expectStr(numStr(numParse("123456789012")), " 1.234568E+11", "parse long")
    expectStr(numStr(numParsePrefix("12abc")), " 12", "prefix 12abc")
    expectStr(numStr(numParsePrefix("abc")), " 0", "prefix abc")
    expectStr(numStr(numParsePrefix(" -2.5x")), "-2.5", "prefix -2.5x")
    expectStr(numStr(numParse("  .98  ")), " .98", "parse padded")
    expectStr(numStr(numParse("1e38")), " 1E+38", "parse 1e38")
    numParsePrefix("12abc")
    expect(numParseEnd == 2, "parseEnd 12abc")

    if failures > 0 { quit 1 }
    log("num-test: all passed")
}
