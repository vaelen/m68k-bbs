func editNetChoice(input: string) {
    switch upperStr(input) {
    case "N", "D", "A", "U", "W", "P", "X", "R", "T", "Z", "I", "E" {
        editField = upperStr(input)[0]
        user.screen = "editnetval"
        displayPrompt()
    }
    case "S" {
        if saveNetwork() {
            sendLine("Saved.")
        } else {
            sendLine("Save failed: " + lastError.message)
        }
        gotoScreen("sysopnets")
    }
    case "Q" { gotoScreen("sysopnets") }
    case "?" {
        drawEditNetCard()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

func editNetValuePrompt() {
    switch editField {
    case 'N' { sendData("Name [" + network.name + "]: ") }
    case 'D' { sendData("Domain [" + network.domain + "]: ") }
    case 'A' { sendData("Our address [" + addressStr(network.addr) + "]: ") }
    case 'U' { sendData("Uplink address [" + addressStr(network.uplink) + "]: ") }
    case 'W' { sendData("Session password (- = none) [" + network.sessionPw + "]: ") }
    case 'P' { sendData("Packet password (- = none) [" + network.packetPw + "]: ") }
    case 'X' { sendData("AreaFix password (- = none) [" + network.areafixPw + "]: ") }
    case 'R' { sendData("AreaFix robot [" + network.areafixName + "]: ") }
    case 'T' { sendData("Dial string [" + network.dial + "]: ") }
    case 'Z' { sendData("UTC offset in minutes, e.g. -300 or 540 [" + intStr(network.utcOffset) + "]: ") }
    case 'I' { sendData("Poll interval in minutes, 0 = manual [" + intStr(network.pollInterval) + "]: ") }
    case 'E' { sendData("Enabled (Y/N) [" + onOff(networkEnabled()) + "]: ") }
    }
}

// A signed number: digits with an optional leading minus; the
// smallest int when malformed (so callers can range-check).
func signedVal(s: string): int {
    var v: int
    if s.length > 1 and s[0] == '-' {
        v = digitsVal(s[1, s.length - 1])
        if v < 0 { return 0 - 1000000 }
        return 0 - v
    }
    v = digitsVal(s)
    if v < 0 { return 0 - 1000000 }
    return v
}

// Enter keeps the current value; "-" clears a password.
func editNetValue(input: string) {
    var ok: bool = true
    var a: FtnAddress
    var v: int
    if input != "" {
        switch editField {
        case 'N' { if input.length > 31 { ok = false } else { network.name = input } }
        case 'D' { if input.length > 31 { ok = false } else { network.domain = input } }
        case 'A', 'U' {
            a = parseAddress(trimStr(input))
            if addressIsZero(a) {
                sendLine("Enter an address like 21:1/141.")
                ok = false
            } else if editField == 'A' {
                network.addr = a
            } else {
                network.uplink = a
            }
        }
        case 'W' { if input == "-" { network.sessionPw = "" } else if input.length > 15 { ok = false } else { network.sessionPw = input } }
        case 'P' { if input == "-" { network.packetPw = "" } else if input.length > 7 { ok = false } else { network.packetPw = input } }
        case 'X' { if input == "-" { network.areafixPw = "" } else if input.length > 15 { ok = false } else { network.areafixPw = input } }
        case 'R' { if input.length > 31 { ok = false } else { network.areafixName = input } }
        case 'T' { if input.length > 31 { ok = false } else { network.dial = input } }
        case 'Z' {
            v = signedVal(input)
            if v < 0 - 720 or v > 840 {
                sendLine("Minutes between -720 and 840.")
                ok = false
            } else {
                network.utcOffset = v
            }
        }
        case 'I' {
            v = digitsVal(input)
            if v < 0 or v > 65535 { ok = false } else { network.pollInterval = v }
        }
        case 'E' {
            switch upperStr(input) {
            case "Y" { network.flags = network.flags | netFlagEnabled }
            case "N" { network.flags = network.flags & (~netFlagEnabled) }
            else { ok = false }
            }
        }
        }
    }
    if not ok {
        if editField != 'A' and editField != 'U' and editField != 'Z' { sendLine("Invalid value.") }
        displayPrompt()
        return
    }
    user.screen = "editnet"
    drawEditNetCard()
    displayPrompt()
}

func startDeleteNet() {
    user.screen = "delnetid"
    displayPrompt()
}

func delNetIdInput(input: string) {
    var id: int = netFromInput(input)
    if id == 0 {
        gotoScreen("sysopnets")
        return
    }
    if id < 0 {
        sendLine("No such network.")
        displayPrompt()
        return
    }
    drawNetDetails()
    user.screen = "delnetconfirm"
    displayPrompt()
}

// ponytail: boards still pointing at a deleted network keep their
// networkId; they simply never match a network at scan time.
func delNetConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(networksDb, network.id) {
            sendLine("Network deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
    } else {
        sendLine("Cancelled.")
    }
    gotoScreen("sysopnets")
}

// New network: a name, then the edit card for everything else.
func newNetName(input: string) {
    var n: Network
    var id: int
    if input == "" {
        sendLine("Cancelled.")
        gotoScreen("sysopnets")
        return
    }
    if input.length > 31 {
        sendLine("Names are limited to 31 characters.")
        displayPrompt()
        return
    }
    n.name = input
    n.areafixName = "AreaFix"
    id = createNetwork(n)
    if id < 1 {
        sendLine("Create failed: " + lastError.message)
        gotoScreen("sysopnets")
        return
    }
    loadNetwork(id)
    sendLine("Network " + intStr(id) + " created (disabled until E) is set).")
    user.screen = "editnet"
    drawEditNetCard()
    displayPrompt()
}
