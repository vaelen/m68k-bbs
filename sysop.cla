// Sysop screens: the sysop menu tree, the paged user/board lists, and
// the detail cards. Included by bbs.cla, which owns the screen
// dispatch (displayMenu/displayPrompt/processInput) and the shared
// session helpers (sendLine, gotoScreen, intStr, upperStr, modem).

var listFromId: int = 1     // paging cursor for the record lists

// Edit-in-progress state: the record being edited (buffered -- nothing
// is written until S)ave) and the field a value is being entered for.
var editId: int = 0
var editField: char = ' '
var editName: string(31)
var editEmail: string(63)
var editAccess: char = 'U'
var editHash: int = 0
var editCreated: int = 0
var editLastSeen: int = 0

// --- Menus -------------------------------------------------------------

func drawSysopMenu() {
    sendLine("")
    sendLine("Sysop Menu:")
    sendLine("B) Message Boards")
    sendLine("F) File Areas")
    sendLine("M) Message of the Day")
    sendLine("N) Networks")
    sendLine("U) Users")
    sendLine("X) Banned Names")
    sendLine("Q) Return to Main Menu")
    sendLine("")
}

func drawSysopBoardsMenu() {
    sendLine("")
    sendLine("Sysop - Message Boards:")
    sendLine("L) List Boards")
    sendLine("S) Show Board Details")
    sendLine("E) Edit Board")
    sendLine("N) New Board")
    sendLine("D) Delete Board")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

func drawSysopUsersMenu() {
    sendLine("")
    sendLine("Sysop - Users:")
    sendLine("L) List Users")
    sendLine("S) Show User Details")
    sendLine("E) Edit User")
    sendLine("D) Delete User")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

// M) Message of the Day: the line editor over the current text;
// /S writes MOTD.txt (editor.cla's 'D' target), /A discards.
func startMotdEditor() {
    editTarget = 'D'
    editPending = ' '
    seedEditorBody(motdText)
    sendEditorBanner("Message of the Day")
    sendLine("Enter the message, one line at a time.")
    sendLine("/S saves, /A aborts, /? lists commands.")
    if editLines.count > 0 { listEditLines() }
    user.screen = "editbody"
    displayPrompt()
}

// Not-yet-implemented options: echo the option name, then redraw.
func stubOption(name: string) {
    sendLine(name)
    displayMenu()
    displayPrompt()
}

func sysopChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "B" { gotoScreen("sysopboards") }
    case "F" { gotoScreen("sysopareas") }
    case "M" { startMotdEditor() }
    case "N" { gotoScreen("sysopnets") }
    case "U" { gotoScreen("sysopusers") }
    case "X" { gotoScreen("sysopbanned") }
    case "Q" { gotoScreen("main") }
    else     { displayPrompt() }
    }
}

func sysopBoardsChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { startBoardList() }
    case "S" { startShowBoard() }
    case "E" { startEditBoard() }
    case "N" { startNewBoard() }
    case "D" { startDeleteBoard() }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

func sysopUsersChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { startUserList() }
    case "S" { startShowUser() }
    case "E" { startEditUser() }
    case "D" { startDeleteUser() }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

// --- Banned names -------------------------------------------------------
// The list itself is the menu: names flow across the terminal width,
// then A)dd / D)elete prompt for one name each and save at once.

func drawSysopBannedMenu() {
    var line: string
    sendLine("")
    sendLine("Sysop - Banned Names (" + intStr(bannedNames.count) + "):")
    for n in bannedNames {
        if line.length + n.length + 2 > terminal.columns {
            sendLine(line)
            line = ""
        }
        line = line + n + "  "
    }
    if line != "" { sendLine(line) }
    sendLine("")
    sendLine("A) Add Name")
    sendLine("D) Delete Name")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

func sysopBannedChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "A" {
        user.screen = "banadd"
        displayPrompt()
    }
    case "D" {
        user.screen = "bandel"
        displayPrompt()
    }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

func banAddInput(input: string) {
    var name: string = trimStr(input)
    if name == "" {
        sendLine("Cancelled.")
    } else if name.length > 31 {
        sendLine("Names are limited to 31 characters.")
        displayPrompt()
        return
    } else if isBanned(name) {
        sendLine("Already banned.")
    } else if bannedAdd(name) {
        sendLine("Banned: " + name)
    } else {
        sendLine("Save failed: " + lastError.message)
    }
    gotoScreen("sysopbanned")
}

func banDelInput(input: string) {
    var name: string = trimStr(input)
    if name == "" {
        sendLine("Cancelled.")
    } else if not isBanned(name) {
        sendLine("Not on the list.")
    } else if bannedRemove(name) {
        sendLine("Removed: " + name)
    } else {
        sendLine("Save failed: " + lastError.message)
    }
    gotoScreen("sysopbanned")
}

// --- Shared helpers ----------------------------------------------------

// Decimal string to int; 0 unless the whole string is digits (record
// ids start at 1, so 0 doubles as "not a number").
func parseIntStr(s: string): int {
    var n: int = 0
    var i: int = 0
    if s.length == 0 { return 0 }
    while i < s.length {
        if s[i] < '0' or s[i] > '9' { return 0 }
        n = n * 10 + (int(s[i]) - int('0'))
        i = i + 1
    }
    return n
}

// A board's network as shown to the sysop. Loads the network (the
// global `network` is display scratch here).
func networkLabel(id: int): string {
    if id == 0 { return "local" }
    if loadNetwork(id) { return network.name }
    return "#" + intStr(id) + " (missing)"
}

// Resolve an ID or name typed at a network prompt: 0 for empty/"-"
// (local), the ID when it exists, else -1.
func resolveNetwork(input: string): int {
    var id: int = parseIntStr(input)
    if input == "" or input == "-" { return 0 }
    if id > 0 {
        if loadNetwork(id) { return id }
        return -1
    }
    id = findNetworkByName(input)
    if id > 0 { return id }
    return -1
}

func accessName(a: char): string {
    if a == accessSysop { return "Sysop" }
    return "User"
}

// --- Paged tables ------------------------------------------------------
// Shared machinery for full-screen record lists (users, boards): a
// boxed table drawn a page at a time, records read straight off the
// database (the session's `user` global is never touched). `listFromId`
// is the paging cursor; each list has its own draw/input/start funcs.
// The table senders themselves (sendRule, sendTableTitle,
// sendTableHeader) live in bbs.cla -- boards.cla uses them too.

// First id in [fromId, nextId) whose record is live, or nextId.
func nextLiveId(db: Database, fromId: int, nextId: int, size: int): int {
    var rec: text
    var id: int = fromId
    while id < nextId {
        rec = dbFind(db, id)
        if rec.length == size { return id }
        id = id + 1
    }
    return nextId
}

// Close a page: bottom rule, then the more-prompt (staying on the list
// screen) or, when no live records remain, back to `menuScreen`.
func finishListPage(db: Database, nextId: int, size: int, menuScreen: string, w: list of int) {
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
    if nextLiveId(db, listFromId, nextId, size) < nextId {
        sendData("[Enter] More  [Q] Menu > ")
    } else {
        user.screen = menuScreen
        displayPrompt()
    }
}

// --- User list ---------------------------------------------------------

// Content widths: narrow is ID/Username/Access (total 39
// with borders), wide adds Last On and Email (total 79).
func userListWidths(w: list of int) {
    w.clear()
    w.add(4)
    w.add(20)
    w.add(5)
    if terminal.columns < minimumWideTerminalWidth { return }
    w.add(17)
    w.add(17)
}

func startUserList() {
    user.screen = "userlist"
    listFromId = 1
    drawUserListPage()
}

// Enter (or anything but Q) shows the next page; Q returns to the menu.
func userListInput(input: string) {
    if upperStr(input) == "Q" {
        gotoScreen("sysopusers")
    } else {
        drawUserListPage()
    }
}

func drawUserListPage() {
    var w: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(usersDb)
    var pageRows: int = terminal.rows - 8
    var shown: int = 0
    var id: int = 0
    var rec: text

    userListWidths(w)
    cells.add("ID")
    cells.add("Username")
    cells.add("Acc")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Last On")
        cells.add("Email")
    }
    sendTableHeader("Users", cells, w)

    id = listFromId
    while id < nextId and shown < pageRows {
        rec = dbFind(usersDb, id)
        if rec.length == userRecordSize {
            cells.clear()
            cells.add(intStr(id))
            cells.add(dbExtractString(rec, uOffName))
            cells.add(accessName(rec[uOffAccess]))
            if terminal.columns >= minimumWideTerminalWidth {
                if rec.intAt(uOffLastSeen) != 0 {
                    cells.add(dateTimeStr(rec.intAt(uOffLastSeen)))
                } else {
                    cells.add("Never")
                }
                cells.add(dbExtractString(rec, uOffEmail))
            }
            sendLine(rowLine(cells, w))
            shown = shown + 1
        }
        id = id + 1
    }
    listFromId = id
    finishListPage(usersDb, nextId, userRecordSize, "sysopusers", w)
}

// --- Board list --------------------------------------------------------

// Content widths: narrow is ID/Name (total 39), wide is
// ID/Name/Description/Network (total 79).
func boardListWidths(w: list of int) {
    w.clear()
    w.add(4)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(28)
        return
    }
    w.add(20)
    w.add(33)
    w.add(9)
}

func startBoardList() {
    user.screen = "boardlist"
    listFromId = 1
    drawBoardListPage()
}

func boardListInput(input: string) {
    if upperStr(input) == "Q" {
        gotoScreen("sysopboards")
    } else {
        drawBoardListPage()
    }
}

func drawBoardListPage() {
    var w: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(boardsDb)
    var pageRows: int = terminal.rows - 8
    var shown: int = 0
    var id: int = 0
    var rec: text

    boardListWidths(w)
    cells.add("ID")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Description")
        cells.add("Network")
    }
    sendTableHeader("Message Boards", cells, w)

    id = listFromId
    while id < nextId and shown < pageRows {
        rec = dbFind(boardsDb, id)
        if rec.length == boardRecordSize {
            boardRowCells(id, rec, cells)
            sendLine(rowLine(cells, w))
            shown = shown + 1
        }
        id = id + 1
    }
    listFromId = id
    finishListPage(boardsDb, nextId, boardRecordSize, "sysopboards", w)
}

// --- Detail cards ------------------------------------------------------
// Two-column label/value tables. Label width fits "Description"; the
// value column fills out 40 or 80 total.

func detailWidths(w: list of int) {
    w.clear()
    w.add(11)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(21)
        return
    }
    w.add(61)
}

func sendDetailRow(label: string, value: string, w: list of int) {
    var cells: list of string
    cells.add(label)
    cells.add(value)
    sendLine(rowLine(cells, w))
}

func startShowUser() {
    user.screen = "showuser"
    displayPrompt()
}

// Empty input cancels; digits look up by id, anything else by name.
func showUserInput(input: string) {
    var id: int = parseIntStr(input)
    var rec: text
    if input == "" {
        gotoScreen("sysopusers")
        return
    }
    if id < 1 { id = findUserId(input) }
    if id >= 1 { rec = dbFind(usersDb, id) }
    if rec.length != userRecordSize {
        sendLine("No such user.")
        displayPrompt()
        return
    }
    drawUserDetails(id, rec)
    user.screen = "sysopusers"
    displayPrompt()
}

func drawUserDetails(id: int, rec: text) {
    var w: list of int
    detailWidths(w)
    sendTableTitle("User Details", w)
    sendDetailRow("ID",       intStr(id), w)
    sendDetailRow("Username", dbExtractString(rec, uOffName), w)
    sendDetailRow("Access",   accessName(rec[uOffAccess]), w)
    sendDetailRow("Email",    dbExtractString(rec, uOffEmail), w)
    sendDetailRow("Created",  dateTimeStr(rec.intAt(uOffCreated)), w)
    if rec.intAt(uOffLastSeen) != 0 {
        sendDetailRow("Last On", dateTimeStr(rec.intAt(uOffLastSeen)), w)
    } else {
        sendDetailRow("Last On", "Never", w)
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func startShowBoard() {
    user.screen = "showboard"
    displayPrompt()
}

// Empty input cancels; otherwise a board id.
func showBoardInput(input: string) {
    if input == "" {
        gotoScreen("sysopboards")
        return
    }
    if not loadBoard(parseIntStr(input)) {
        sendLine("No such board.")
        displayPrompt()
        return
    }
    drawBoardDetails()
    user.screen = "sysopboards"
    displayPrompt()
}

// Renders the globally loaded `board` (see loadBoard in boardsdb.cla).
func drawBoardDetails() {
    var w: list of int
    detailWidths(w)
    sendTableTitle("Board Details", w)
    sendDetailRow("ID",          intStr(board.id), w)
    sendDetailRow("Name",        board.name, w)
    sendDetailRow("Description", board.description, w)
    sendDetailRow("Network",     networkLabel(board.networkId), w)
    sendDetailRow("Echo tag",    board.tag, w)
    sendDetailRow("Exported",    intStr(board.lastExported), w)
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

// --- Edit screens ------------------------------------------------------
// Same lookup as the detail cards, then a card with a letter on each
// editable field: pick a letter, type the new value (Enter keeps the
// current one), S)ave writes everything at once, Q)uit discards.

// Wider label column than detailWidths: fits "D) Description".
func editWidths(w: list of int) {
    w.clear()
    w.add(14)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(18)
        return
    }
    w.add(58)
}

func startEditUser() {
    user.screen = "edituserid"
    displayPrompt()
}

func editUserIdInput(input: string) {
    var id: int = parseIntStr(input)
    var rec: text
    if input == "" {
        gotoScreen("sysopusers")
        return
    }
    if id < 1 { id = findUserId(input) }
    if id >= 1 { rec = dbFind(usersDb, id) }
    if rec.length != userRecordSize {
        sendLine("No such user.")
        displayPrompt()
        return
    }
    editId = id
    editName = dbExtractString(rec, uOffName)
    editHash = rec.intAt(uOffHash)
    editEmail = dbExtractString(rec, uOffEmail)
    editAccess = rec[uOffAccess]
    editCreated = rec.intAt(uOffCreated)
    editLastSeen = rec.intAt(uOffLastSeen)
    user.screen = "edituser"
    drawEditUserCard()
    displayPrompt()
}

func drawEditUserCard() {
    var w: list of int
    editWidths(w)
    sendTableTitle("Edit User", w)
    sendDetailRow("ID",          intStr(editId), w)
    sendDetailRow("N) Username", editName, w)
    sendDetailRow("E) Email",    editEmail, w)
    if editId == user.id {
        // No demoting yourself -- the system must keep a sysop.
        sendDetailRow("Access", accessName(editAccess), w)
    } else {
        sendDetailRow("A) Access", accessName(editAccess), w)
    }
    sendDetailRow("P) Password", "(hidden)", w)
    sendDetailRow("Created",     dateTimeStr(editCreated), w)
    if editLastSeen != 0 {
        sendDetailRow("Last On", dateTimeStr(editLastSeen), w)
    } else {
        sendDetailRow("Last On", "Never", w)
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func editUserChoice(input: string) {
    switch upperStr(input) {
    case "N", "E", "A", "P" {
        if upperStr(input) == "A" and editId == user.id {
            sendLine("You cannot change your own access level.")
            displayPrompt()
            return
        }
        editField = upperStr(input)[0]
        user.screen = "edituserval"
        displayPrompt()
    }
    case "S" {
        if updateUserFields(editId, editName, editHash, editEmail, editAccess, editCreated, editLastSeen) {
            if editId == user.id { loadUser(editId) }
            sendLine("Saved.")
        } else {
            sendLine("Save failed: " + lastError.message)
        }
        gotoScreen("sysopusers")
    }
    case "Q" { gotoScreen("sysopusers") }
    case "?" {
        drawEditUserCard()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

func editUserValuePrompt() {
    switch editField {
    case 'N' { sendData("Username [" + editName + "]: ") }
    case 'E' { sendData("Email [" + editEmail + "]: ") }
    case 'A' { sendData("Access (U/S) [" + editAccess + "]: ") }
    case 'P' { sendData("New password (Enter keeps): ") }
    }
}

func editUserValue(input: string) {
    var ok: bool = true
    if input != "" {
        switch editField {
        case 'N' {
            if input.length > 31 {
                sendLine("Names are limited to 31 characters.")
                ok = false
            } else if upperStr(input) == "NEW" {
                sendLine("That name is reserved.")
                ok = false
            } else if findUserId(input) >= 1 and findUserId(input) != editId {
                sendLine("That name is taken.")
                ok = false
            } else {
                editName = input
            }
        }
        case 'E' {
            if input.length > 63 {
                sendLine("Emails are limited to 63 characters.")
                ok = false
            } else {
                editEmail = input
            }
        }
        case 'A' {
            switch upperStr(input) {
            case "U" { editAccess = accessUser }
            case "S" { editAccess = accessSysop }
            else {
                sendLine("U or S.")
                ok = false
            }
            }
        }
        case 'P' { editHash = hashPassword(input) }
        }
    }
    if not ok {
        displayPrompt()
        return
    }
    user.screen = "edituser"
    drawEditUserCard()
    displayPrompt()
}

func startEditBoard() {
    user.screen = "editboardid"
    displayPrompt()
}

// Edits buffer in the global `board`; Q discards (the next loadBoard
// overwrites it), S writes it back.
func editBoardIdInput(input: string) {
    if input == "" {
        gotoScreen("sysopboards")
        return
    }
    if not loadBoard(parseIntStr(input)) {
        sendLine("No such board.")
        displayPrompt()
        return
    }
    user.screen = "editboard"
    drawEditBoardCard()
    displayPrompt()
}

func drawEditBoardCard() {
    var w: list of int
    editWidths(w)
    sendTableTitle("Edit Board", w)
    sendDetailRow("ID",             intStr(board.id), w)
    sendDetailRow("N) Name",        board.name, w)
    sendDetailRow("D) Description", board.description, w)
    sendDetailRow("W) Network",     networkLabel(board.networkId), w)
    sendDetailRow("T) Echo tag",    board.tag, w)
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func editBoardChoice(input: string) {
    switch upperStr(input) {
    case "N", "D", "W", "T" {
        editField = upperStr(input)[0]
        user.screen = "editboardval"
        displayPrompt()
    }
    case "S" {
        if saveBoard() {
            sendLine("Saved.")
        } else {
            sendLine("Save failed: " + lastError.message)
        }
        gotoScreen("sysopboards")
    }
    case "Q" { gotoScreen("sysopboards") }
    case "?" {
        drawEditBoardCard()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

func editBoardValuePrompt() {
    switch editField {
    case 'N' { sendData("Name [" + board.name + "]: ") }
    case 'D' { sendData("Description [" + board.description + "]: ") }
    case 'W' { sendData("Network (ID or name, - = local) [" + networkLabel(board.networkId) + "]: ") }
    case 'T' { sendData("Echo tag (- = none) [" + board.tag + "]: ") }
    }
}

func editBoardValue(input: string) {
    var ok: bool = true
    var id: int = 0
    if input != "" {
        switch editField {
        case 'N' {
            if input.length > 63 {
                sendLine("Names are limited to 63 characters.")
                ok = false
            } else {
                board.name = input
            }
        }
        case 'D' {
            if input.length > 63 {
                sendLine("Descriptions are limited to 63 characters.")
                ok = false
            } else {
                board.description = input
            }
        }
        case 'W' {
            id = resolveNetwork(input)
            if id < 0 {
                sendLine("No such network.")
                ok = false
            } else {
                board.networkId = id
            }
        }
        case 'T' {
            if input.length > 63 {
                sendLine("Echo tags are limited to 63 characters.")
                ok = false
            } else if input == "-" {
                board.tag = ""
            } else {
                board.tag = upperStr(input)
            }
        }
        }
    }
    if not ok {
        displayPrompt()
        return
    }
    user.screen = "editboard"
    drawEditBoardCard()
    displayPrompt()
}

// --- Delete screens ----------------------------------------------------
// Same lookup as the detail cards, then the details themselves (the
// same drawing routines) and a Y/N confirmation. Only Y deletes.

func startDeleteUser() {
    user.screen = "deluserid"
    displayPrompt()
}

func delUserIdInput(input: string) {
    var id: int = parseIntStr(input)
    var rec: text
    if input == "" {
        gotoScreen("sysopusers")
        return
    }
    if id < 1 { id = findUserId(input) }
    if id >= 1 { rec = dbFind(usersDb, id) }
    if rec.length != userRecordSize {
        sendLine("No such user.")
        displayPrompt()
        return
    }
    if id == user.id {
        sendLine("You cannot delete your own account.")
        displayPrompt()
        return
    }
    editId = id
    drawUserDetails(id, rec)
    user.screen = "deluserconfirm"
    displayPrompt()
}

func delUserConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(usersDb, editId) {
            sendLine("User deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
    } else {
        sendLine("Cancelled.")
    }
    gotoScreen("sysopusers")
}

func startDeleteBoard() {
    user.screen = "delboardid"
    displayPrompt()
}

// ponytail: deleting a board leaves its BRD<nn> post files behind;
// clean them up when post management arrives.
func delBoardIdInput(input: string) {
    if input == "" {
        gotoScreen("sysopboards")
        return
    }
    if not loadBoard(parseIntStr(input)) {
        sendLine("No such board.")
        displayPrompt()
        return
    }
    drawBoardDetails()
    user.screen = "delboardconfirm"
    displayPrompt()
}

func delBoardConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(boardsDb, board.id) {
            sendLine("Board deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
    } else {
        sendLine("Cancelled.")
    }
    gotoScreen("sysopboards")
}

// --- New board ---------------------------------------------------------
// Name -> description -> network (default local), then create and show
// the new board's details. Empty name cancels.

func startNewBoard() {
    board.name = ""
    board.description = ""
    board.tag = ""
    board.networkId = 0
    user.screen = "newboardname"
    displayPrompt()
}

func newBoardName(input: string) {
    if input == "" {
        sendLine("Cancelled.")
        gotoScreen("sysopboards")
        return
    }
    if input.length > 63 {
        sendLine("Names are limited to 63 characters.")
        displayPrompt()
        return
    }
    board.name = input
    user.screen = "newboarddesc"
    displayPrompt()
}

func newBoardDesc(input: string) {
    if input.length > 63 {
        sendLine("Descriptions are limited to 63 characters.")
        displayPrompt()
        return
    }
    board.description = input
    user.screen = "newboardnet"
    displayPrompt()
}

func newBoardNet(input: string) {
    var id: int = resolveNetwork(input)
    if id < 0 {
        sendLine("No such network.")
        displayPrompt()
        return
    }
    board.networkId = id
    if id == 0 {
        finishNewBoard()
        return
    }
    user.screen = "newboardtag"
    displayPrompt()
}

func newBoardTag(input: string) {
    if input == "" or input.length > 63 {
        sendLine("Echo tags are 1-63 characters.")
        displayPrompt()
        return
    }
    board.tag = upperStr(input)
    finishNewBoard()
}

func finishNewBoard() {
    var id: int = createBoard(board.name, board.description, board.tag, board.networkId)
    if id < 1 {
        sendLine("Create failed: " + lastError.message)
        gotoScreen("sysopboards")
        return
    }
    sendLine("Board " + intStr(id) + " created.")
    loadBoard(id)
    drawBoardDetails()
    user.screen = "sysopboards"
    displayPrompt()
}

// --- File areas --------------------------------------------------------
// The board screens again, over the Areas database (areasdb.cla): a
// paged list, a detail card, a lettered edit card buffered in the
// global `area`, Y/N delete, and a New Area wizard. Files inside an
// area are not managed here yet.

func drawSysopAreasMenu() {
    sendLine("")
    sendLine("Sysop - File Areas:")
    sendLine("L) List Areas")
    sendLine("S) Show Area Details")
    sendLine("E) Edit Area")
    sendLine("N) New Area")
    sendLine("D) Delete Area")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

func sysopAreasChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { startAreaList() }
    case "S" { startShowArea() }
    case "E" { startEditArea() }
    case "N" { startNewArea() }
    case "D" { startDeleteArea() }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

// The area access byte as shown to the sysop: 0 = All, 'S' = Sysop.
func areaAccessName(a: char): string {
    if a == accessSysop { return "Sysop" }
    return "All"
}

// Content widths: narrow is ID/Name (total 39), wide is
// ID/Name/Description/Access (total 79).
func areaListWidths(w: list of int) {
    w.clear()
    w.add(4)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(28)
        return
    }
    w.add(20)
    w.add(35)
    w.add(7)
}

func startAreaList() {
    user.screen = "arealist"
    listFromId = 1
    drawAreaListPage()
}

func areaListInput(input: string) {
    if upperStr(input) == "Q" {
        gotoScreen("sysopareas")
    } else {
        drawAreaListPage()
    }
}

func drawAreaListPage() {
    var w: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(areasDb)
    var pageRows: int = terminal.rows - 8
    var shown: int = 0
    var id: int = 0
    var rec: text

    areaListWidths(w)
    cells.add("ID")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Description")
        cells.add("Access")
    }
    sendTableHeader("File Areas", cells, w)

    id = listFromId
    while id < nextId and shown < pageRows {
        rec = dbFind(areasDb, id)
        if rec.length == areaRecordSize {
            cells.clear()
            cells.add(intStr(id))
            cells.add(dbExtractString(rec, aOffName))
            if terminal.columns >= minimumWideTerminalWidth {
                cells.add(dbExtractString(rec, aOffDescription))
                cells.add(areaAccessName(rec[aOffAccess]))
            }
            sendLine(rowLine(cells, w))
            shown = shown + 1
        }
        id = id + 1
    }
    listFromId = id
    finishListPage(areasDb, nextId, areaRecordSize, "sysopareas", w)
}

func startShowArea() {
    user.screen = "showarea"
    displayPrompt()
}

// Empty input cancels; otherwise an area id.
func showAreaInput(input: string) {
    if input == "" {
        gotoScreen("sysopareas")
        return
    }
    if not loadArea(parseIntStr(input)) {
        sendLine("No such area.")
        displayPrompt()
        return
    }
    drawAreaDetails()
    user.screen = "sysopareas"
    displayPrompt()
}

func folderName(folder: string): string {
    if folder == "" { return "(app directory)" }
    return folder
}

// Renders the globally loaded `area` (see loadArea in areasdb.cla).
func drawAreaDetails() {
    var w: list of int
    detailWidths(w)
    sendTableTitle("Area Details", w)
    sendDetailRow("ID",          intStr(area.id), w)
    sendDetailRow("Name",        area.name, w)
    sendDetailRow("Description", area.description, w)
    sendDetailRow("Folder",      folderName(area.folder), w)
    sendDetailRow("Access",      areaAccessName(area.access), w)
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func startEditArea() {
    user.screen = "editareaid"
    displayPrompt()
}

// Edits buffer in the global `area`; Q discards (the next loadArea
// overwrites it), S writes it back.
func editAreaIdInput(input: string) {
    if input == "" {
        gotoScreen("sysopareas")
        return
    }
    if not loadArea(parseIntStr(input)) {
        sendLine("No such area.")
        displayPrompt()
        return
    }
    user.screen = "editarea"
    drawEditAreaCard()
    displayPrompt()
}

func drawEditAreaCard() {
    var w: list of int
    editWidths(w)
    sendTableTitle("Edit Area", w)
    sendDetailRow("ID",             intStr(area.id), w)
    sendDetailRow("N) Name",        area.name, w)
    sendDetailRow("D) Description", area.description, w)
    sendDetailRow("F) Folder",      folderName(area.folder), w)
    sendDetailRow("A) Access",      areaAccessName(area.access), w)
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

// What a folder value means to the File Manager -- printed before both
// folder prompts (fileFolderPath joins "<folder>:<name>", so a bare
// name would be read as a volume; docs/files.md).
func sendFolderHelp() {
    sendLine("Folder examples:")
    sendLine("  (empty)              the BBS application's own directory")
    sendLine("  :Downloads           a folder inside the application's directory")
    sendLine("  Shareware CD         the root of a volume by that name")
    sendLine("  BBS HD:Files:Games   a full path to a folder")
    sendLine("")
}

func editAreaChoice(input: string) {
    switch upperStr(input) {
    case "N", "D", "F", "A" {
        editField = upperStr(input)[0]
        user.screen = "editareaval"
        if editField == 'F' { sendFolderHelp() }
        displayPrompt()
    }
    case "S" {
        if saveArea() {
            sendLine("Saved.")
        } else {
            sendLine("Save failed: " + lastError.message)
        }
        gotoScreen("sysopareas")
    }
    case "Q" { gotoScreen("sysopareas") }
    case "?" {
        drawEditAreaCard()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

func editAreaValuePrompt() {
    switch editField {
    case 'N' { sendData("Name [" + area.name + "]: ") }
    case 'D' { sendData("Description [" + area.description + "]: ") }
    case 'F' { sendData("Folder (- = app directory) [" + folderName(area.folder) + "]: ") }
    case 'A' { sendData("Access (A=all, S=sysop) [" + areaAccessName(area.access) + "]: ") }
    }
}

// Enter keeps the current value; a folder of "-" clears it (the app
// directory), since an empty entry means keep like every other field.
func editAreaValue(input: string) {
    var ok: bool = true
    if input != "" {
        switch editField {
        case 'N' {
            if input.length > 63 {
                sendLine("Names are limited to 63 characters.")
                ok = false
            } else {
                area.name = input
            }
        }
        case 'D' {
            if input.length > 63 {
                sendLine("Descriptions are limited to 63 characters.")
                ok = false
            } else {
                area.description = input
            }
        }
        case 'F' {
            if input == "-" {
                area.folder = ""
            } else if input.length > 63 {
                sendLine("Folders are limited to 63 characters.")
                ok = false
            } else {
                area.folder = input
            }
        }
        case 'A' {
            switch upperStr(input) {
            case "A" { area.access = accessAll }
            case "S" { area.access = accessSysop }
            else {
                sendLine("A or S.")
                ok = false
            }
            }
        }
        }
    }
    if not ok {
        displayPrompt()
        return
    }
    user.screen = "editarea"
    drawEditAreaCard()
    displayPrompt()
}

func startDeleteArea() {
    user.screen = "delareaid"
    displayPrompt()
}

// ponytail: deleting an area leaves its ARE<nn> files and folder
// behind (Clarus has no file delete); clean up when it does.
func delAreaIdInput(input: string) {
    if input == "" {
        gotoScreen("sysopareas")
        return
    }
    if not loadArea(parseIntStr(input)) {
        sendLine("No such area.")
        displayPrompt()
        return
    }
    drawAreaDetails()
    user.screen = "delareaconfirm"
    displayPrompt()
}

func delAreaConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(areasDb, area.id) {
            sendLine("Area deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
    } else {
        sendLine("Cancelled.")
    }
    gotoScreen("sysopareas")
}

// New area: name -> description -> folder (default app directory) ->
// access (default all), then create and show the details. Empty name
// cancels.

func startNewArea() {
    area.name = ""
    area.description = ""
    area.folder = ""
    area.access = accessAll
    user.screen = "newareaname"
    displayPrompt()
}

func newAreaName(input: string) {
    if input == "" {
        sendLine("Cancelled.")
        gotoScreen("sysopareas")
        return
    }
    if input.length > 63 {
        sendLine("Names are limited to 63 characters.")
        displayPrompt()
        return
    }
    area.name = input
    user.screen = "newareadesc"
    displayPrompt()
}

func newAreaDesc(input: string) {
    if input.length > 63 {
        sendLine("Descriptions are limited to 63 characters.")
        displayPrompt()
        return
    }
    area.description = input
    user.screen = "newareafolder"
    sendFolderHelp()
    displayPrompt()
}

func newAreaFolder(input: string) {
    if input.length > 63 {
        sendLine("Folders are limited to 63 characters.")
        displayPrompt()
        return
    }
    area.folder = input
    user.screen = "newareaaccess"
    displayPrompt()
}

func newAreaAccess(input: string) {
    var id: int = 0
    switch upperStr(input) {
    case "", "A" { area.access = accessAll }
    case "S"     { area.access = accessSysop }
    else {
        sendLine("A or S.")
        displayPrompt()
        return
    }
    }
    id = createArea(area.name, area.description, area.folder, area.access)
    if id < 1 {
        sendLine("Create failed: " + lastError.message)
        gotoScreen("sysopareas")
        return
    }
    area.id = id
    sendLine("Area " + intStr(id) + " created.")
    drawAreaDetails()
    user.screen = "sysopareas"
    displayPrompt()
}

// --- Networks ------------------------------------------------------------
// The board screens over the Networks database (networksdb.cla). New
// asks for a name only and drops into the edit card; the detail card
// offers P)oll (queued for after logoff -- the sysop is on the line)
// and A)reaFix (a netmail to the robot).

func drawSysopNetsMenu() {
    sendLine("")
    sendLine("Sysop - Networks:")
    sendLine("L) List Networks")
    sendLine("S) Show Network Details")
    sendLine("E) Edit Network")
    sendLine("N) New Network")
    sendLine("D) Delete Network")
    sendLine("Q) Return to Sysop Menu")
    sendLine("")
}

func sysopNetsChoice(input: string) {
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" { startNetList() }
    case "S" { startShowNet() }
    case "E" { startEditNet() }
    case "N" {
        user.screen = "newnetname"
        displayPrompt()
    }
    case "D" { startDeleteNet() }
    case "Q" { gotoScreen("sysop") }
    else     { displayPrompt() }
    }
}

// Content widths: narrow is ID/Name (total 39), wide adds Address,
// Uplink and Last poll (total 79).
func netListWidths(w: list of int) {
    w.clear()
    w.add(4)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(28)
        return
    }
    w.add(15)
    w.add(12)
    w.add(12)
    w.add(20)
}

func startNetList() {
    user.screen = "netlist"
    listFromId = 1
    drawNetListPage()
}

func netListInput(input: string) {
    if upperStr(input) == "Q" {
        gotoScreen("sysopnets")
    } else {
        drawNetListPage()
    }
}

func drawNetListPage() {
    var w: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(networksDb)
    var pageRows: int = terminal.rows - 8
    var shown: int = 0
    var id: int = 0
    var rec: text

    netListWidths(w)
    cells.add("ID")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Address")
        cells.add("Uplink")
        cells.add("Last poll")
    }
    sendTableHeader("Networks", cells, w)
    id = listFromId
    while id < nextId and shown < pageRows {
        rec = dbFind(networksDb, id)
        if rec.length == networkRecordSize {
            cells.clear()
            cells.add(intStr(id))
            cells.add(dbExtractString(rec, nOffName))
            if terminal.columns >= minimumWideTerminalWidth {
                cells.add(addressStr(addressAt(rec, nOffAddr)))
                cells.add(addressStr(addressAt(rec, nOffUplink)))
                cells.add(pollResultName(int(rec[nOffLastResult])))
            }
            sendLine(rowLine(cells, w))
            shown = shown + 1
        }
        id = id + 1
    }
    listFromId = id
    finishListPage(networksDb, nextId, networkRecordSize, "sysopnets", w)
}

// ID or name; loads the network. Empty input -> 0 (cancel), unknown -> -1.
func netFromInput(input: string): int {
    var id: int
    if input == "" { return 0 }
    id = parseIntStr(input)
    if id > 0 and loadNetwork(id) { return id }
    if id == 0 {
        id = findNetworkByName(input)
        if id > 0 { return id }
    }
    return -1
}

func startShowNet() {
    user.screen = "shownet"
    displayPrompt()
}

func showNetInput(input: string) {
    var id: int = netFromInput(input)
    if id == 0 {
        gotoScreen("sysopnets")
        return
    }
    if id < 0 {
        sendLine("No such network.")
        displayPrompt()
        return
    }
    drawNetDetails()
    user.screen = "shownetkeys"
    displayPrompt()
}

func onOff(b: bool): string {
    if b { return "yes" }
    return "no"
}

func lastPollStr(): string {
    if network.lastPoll == 0 { return "never" }
    return dateTimeStr(network.lastPoll) + " (" + pollResultName(network.lastResult) + ")"
}

// Renders the globally loaded `network`.
func drawNetDetails() {
    var w: list of int
    var nid: int = network.id
    var pending: string
    pending = intStr(ftnPendingMail(nid)) + " netmail, " + intStr(ftnPendingPosts(nid)) + " posts"
    loadNetwork(nid)          // the pending counts reload boards/mail/networks
    detailWidths(w)
    sendTableTitle("Network Details", w)
    sendDetailRow("ID",          intStr(network.id), w)
    sendDetailRow("Name",        network.name, w)
    sendDetailRow("Domain",      network.domain, w)
    sendDetailRow("Address",     addressStr(network.addr), w)
    sendDetailRow("Uplink",      addressStr(network.uplink), w)
    sendDetailRow("Dial",        network.dial, w)
    sendDetailRow("UTC offset",  intStr(network.utcOffset) + " min", w)
    sendDetailRow("Poll every",  intStr(network.pollInterval) + " min", w)
    sendDetailRow("Enabled",     onOff(networkEnabled()), w)
    sendDetailRow("Last poll",   lastPollStr(), w)
    sendDetailRow("Pending",     pending, w)
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
}

func showNetKeys(input: string) {
    switch upperStr(input) {
    case "P" {
        ftnQueuePoll(network.id)
        sendLine("Poll queued -- it runs after you log off.")
        gotoScreen("sysopnets")
    }
    case "A" {
        user.screen = "areafixreq"
        displayPrompt()
    }
    case "Q", "" { gotoScreen("sysopnets") }
    else { displayPrompt() }
    }
}

// One AreaFix request line as a netmail to the robot; the subject is
// the AreaFix password (FSC-0057).
func areafixReqInput(input: string) {
    var body: text
    var msgid: string = newMsgId(network.addr)
    if input == "" {
        gotoScreen("sysopnets")
        return
    }
    body.append(ftnKludge)
    body.append("MSGID: " + msgid)
    body.append(ftnCR)
    body.append(input)
    body.append(ftnCR)
    if sendMailFtn(user.name, user.id, network.addr, network.areafixName, 0, network.uplink, network.areafixPw, body, msgIdCrc(msgid), 0) >= 1 {
        sendLine("Request queued for the next poll.")
    } else {
        sendLine("Queue failed: " + lastError.message)
    }
    gotoScreen("sysopnets")
}

func startEditNet() {
    user.screen = "editnetid"
    displayPrompt()
}

// Edits buffer in the global `network`; Q discards, S writes it back.
func editNetIdInput(input: string) {
    var id: int = netFromInput(input)
    if id == 0 {
        gotoScreen("sysopnets")
        return
    }
    if id < 0 {
        sendLine("No such network.")
        displayPrompt()
        return
    }
    user.screen = "editnet"
    drawEditNetCard()
    displayPrompt()
}

func drawEditNetCard() {
    var w: list of int
    editWidths(w)
    sendTableTitle("Edit Network", w)
    sendDetailRow("ID",                 intStr(network.id), w)
    sendDetailRow("N) Name",            network.name, w)
    sendDetailRow("D) Domain",          network.domain, w)
    sendDetailRow("A) Our address",     addressStr(network.addr), w)
    sendDetailRow("U) Uplink address",  addressStr(network.uplink), w)
    sendDetailRow("W) Session passwd",  network.sessionPw, w)
    sendDetailRow("P) Packet passwd",   network.packetPw, w)
    sendDetailRow("X) AreaFix passwd",  network.areafixPw, w)
