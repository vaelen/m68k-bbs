// Bulletin board reader: the caller-facing board picker and post
// list. Included by bbs.cla, which owns the screen dispatch;
// sysop.cla owns the admin screens for the same data.

// The numbered post list: number N at the prompt = postIds[N-1].
// Post IDs stay hidden from callers. Numbering restarts at 1 on every
// page; postPage/postPages track where we are (page 1 = newest).
var postIds: list of int
var postPage: int = 1
var postPages: int = 1

// Row cells for one board record, for sysop.cla's board list (the
// caller picker below lays out its own).
func boardRowCells(id: int, rec: text, cells: list of string) {
    cells.clear()
    cells.add(intStr(id))
    cells.add(dbExtractString(rec, bOffName))
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add(dbExtractString(rec, bOffDescription))
        if dbExtractString(rec, bOffTag) == "" {
            cells.add("local")
        } else {
            cells.add(dbExtractString(rec, bOffTag))
        }
    }
}

// Content widths for the caller picker: narrow is ID/Name (total 39),
// wide adds Description, Last (post date) and Network (total 79).
func boardPickerWidths(w: list of int) {
    w.clear()
    if terminal.columns < minimumWideTerminalWidth {
        w.add(4)
        w.add(28)
        return
    }
    w.add(3)
    w.add(11)
    w.add(31)
    w.add(8)
    w.add(10)
}

// Fill in lastPost for boards that predate the field (0): the newest
// surviving post's date. Run once at launch; a board that really has
// no posts is rescanned each launch, cheaply. Board IDs are collected
// first -- boardTouch writes the Boards database, and a scan must not
// see writes.
func boardsBackfillLastPost() {
    var cur: text
    var rec: text
    var todo: list of int
    var i: int = 0
    var id: int
    if dbScanStart(boardsDb, cur, 1, false) {
        id = dbScanNext(boardsDb, cur, rec)
        while id != 0 {
            if rec.intAt(bOffLastPost) == 0 { todo.add(id) }
            id = dbScanNext(boardsDb, cur, rec)
        }
    }
    while i < todo.count {
        if postsOpen(todo[i]) and dbScanStart(postsDb, cur, postsNextId() - 1, true) {
            id = dbScanNext(postsDb, cur, rec)
            if id != 0 { boardTouch(todo[i], rec.intAt(pOffCreated)) }
        }
        i = i + 1
    }
    postsClose()
}

// Network names looked up once per draw: the picker shows the same
// network on most rows.
var netMemoIds: list of int
var netMemoNames: list of string

func networkNameFor(netId: int): string {
    var i: int = 0
    var name: string
    while i < netMemoIds.count {
        if netMemoIds[i] == netId { return netMemoNames[i] }
        i = i + 1
    }
    name = intStr(netId)
    if loadNetwork(netId) { name = network.name }
    netMemoIds.add(netId)
    netMemoNames.add(name)
    return name
}

// The caller's cells: the network's name (not the echo tag) in the
// last column, "local" for a board with no network.
func boardPickerCells(id: int, rec: text, cells: list of string) {
    var netId: int
    var when: int
    cells.clear()
    cells.add(intStr(id))
    cells.add(dbExtractString(rec, bOffName))
    if terminal.columns < minimumWideTerminalWidth { return }
    cells.add(dbExtractString(rec, bOffDescription))
    when = rec.intAt(bOffLastPost)
    if when == 0 {
        cells.add("")
    } else {
        cells.add(dateTimeStr(when)[0, 8])
    }
    netId = rec.intAt(bOffNetwork)
    if netId == 0 {
        cells.add("local")
    } else {
        cells.add(networkNameFor(netId))
    }
}

// ponytail: the picker shows every board unpaged; page it if a system
// ever has more boards than screen rows.
func drawBoardPicker() {
    var w: list of int
    var cells: list of string
    var cur: text
    var id: int
    var rec: text

    boardPickerWidths(w)
    cells.add("ID")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Description")
        cells.add("Last")
        cells.add("Network")
    }
    netMemoIds.clear()
    netMemoNames.clear()
    sendTableHeader("Bulletin Boards", cells, w)
    if dbScanStart(boardsDb, cur, 1, false) {
        id = dbScanNext(boardsDb, cur, rec)
        while id != 0 {
            boardPickerCells(id, rec, cells)
            sendLine(rowLine(cells, w))
            id = dbScanNext(boardsDb, cur, rec)
        }
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
    if terminal.columns < minimumWideTerminalWidth {
        sendLine("V) Select Board (or enter ID)")
        sendLine("Q) Return to Main Menu")
    } else {
        sendLine("V) Select Board (or enter ID)   Q) Return to Main Menu")
    }
}

// Enter or Q returns to the main menu; V (or a digit, via inputChar)
// asks for a board ID.
func boardPickerInput(input: string) {
    switch upperStr(input) {
    case "", "Q" { gotoScreen("main") }
    case "V"     { promptNumber("boardnum", "") }
    case "?"     { gotoScreen("boards") }
    else         { displayPrompt() }
    }
}

// Empty input returns to the picker; a board ID enters the board.
func boardNumInput(input: string) {
    user.screen = "boards"
    if input == "" {
        displayPrompt()
        return
    }
    if not loadBoard(parseIntStr(input)) {
        sendLine("No such board.")
        displayPrompt()
        return
    }
    enterBoard()
}

func enterBoard() {
    if not postsOpen(board.id) {
        sendLine("Board unavailable: " + lastError.message)
        displayPrompt()
        return
    }
    user.screen = "posts"
    postPage = 1
    drawPostList()
    displayPrompt()
}

// Content widths: narrow is #/Subject (total 39), wide
// adds From and Date (total 79).
func postListWidths(w: list of int) {
    w.clear()
    w.add(3)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(29)
        return
    }
    w.add(30)
    w.add(16)
    w.add(17)
}

// One page of posts, newest (highest post ID) first, numbered from 1
// on every page. Frame is 9 lines from the top rule down (top, title,
// joint, header, joint, joint, footer, bottom, prompt) -- everything
// above the table is expected to scroll off.
func drawPostList() {
    var w: list of int
    var cells: list of string
    var cur: text
    var id: int
    var pageRows: int = terminal.rows - 9
    var skip: int = 0
    var rec: text

    postPages = (postCount() + pageRows - 1) / pageRows
    if postPages < 1 { postPages = 1 }
    if postPage > postPages { postPage = postPages }
    if postPage < 1 { postPage = 1 }
    skip = (postPage - 1) * pageRows

    postIds.clear()
    postListWidths(w)
    cells.add("#")
    cells.add("Subject")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("From")
        cells.add("Date")
    }
    sendTableHeader(board.name, cells, w)
    if dbScanStart(postsDb, cur, postsNextId() - 1, true) {
        dbScanSkip(postsDb, cur, skip)
        id = dbScanNext(postsDb, cur, rec)
        while id != 0 and postIds.count < pageRows {
            postIds.add(id)
            cells.clear()
            cells.add(intStr(postIds.count))
            cells.add(dbExtractString(rec, pOffSubject))
            if terminal.columns >= minimumWideTerminalWidth {
                cells.add(dbExtractString(rec, pOffSender))
                cells.add(dateTimeStr(rec.intAt(pOffCreated)))
            }
            sendLine(rowLine(cells, w))
            if postIds.count < pageRows {
                id = dbScanNext(postsDb, cur, rec)
            } else {
                id = 0
            }
        }
    }
    sendTableFooter("Page " + intStr(postPage) + " of " + intStr(postPages), w)
    if postIds.count == 0 {
        sendLine("No posts yet.")
    }
}

func drawPostsMenu() {
    sendLine("")
    sendLine("V) View Post (or enter number)")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine("L) List Posts")
    if hasPermission(PostBoards) { sendLine("N) New Post") }
    if hasPermission(Sysop) {
        sendLine("D) Delete Post")
    }
    sendLine("Q) Return to Board List")
    sendLine("")
}

func postsPrompt() {
    sendData(board.name + "> ")
}

// Enter and + page forward, - pages back; at either end they just
// re-prompt.
func postsChoice(input: string) {
    if input == "" or input == "+" {
        if postPage < postPages {
            postPage = postPage + 1
            drawPostList()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if postPage > 1 {
            postPage = postPage - 1
            drawPostList()
        }
        displayPrompt()
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawPostList()
        displayPrompt()
    }
    case "V" { promptNumber("postnum", "") }
    case "N" {
        if hasPermission(PostBoards) { startNewPost() } else { displayPrompt() }
    }
    case "D" {
        if hasPermission(Sysop) {
            delFromView = false
            user.screen = "delpostnum"
        }
        displayPrompt()
    }
    case "Q" {
        postsClose()
        gotoScreen("boards")
    }
    else { displayPrompt() }
    }
}

// Empty input returns to the list; a number on the current page opens
// that post.
func postNumInput(input: string) {
    var n: int = parseIntStr(input)
    user.screen = "posts"
    if n >= 1 and n <= postIds.count {
        showPost(n)
        return
    }
    if input != "" { sendLine("No such post.") }
    displayPrompt()
}

// --- Post view ---------------------------------------------------------
// Option-B frame: subject title bar, From/Date meta rows, body wrapped
// inside the border and paged, "Post N - Page X of Y" footer.

var postNum: int = 0            // display number in the current list page
var bodyLines: list of string
var bodyPage: int = 1
var bodyPages: int = 1

// Single-span content width for the post frame.
func postViewWidths(w: list of int) {
    w.clear()
    if terminal.columns < minimumWideTerminalWidth {
        w.add(35)
        return
    }
    w.add(75)
}

func showPost(n: int) {
    if not loadPostView(n) { return }
    user.screen = "postview"
    displayPrompt()
}

// Load and draw post number n (shared by viewing and the sysop
// delete-from-list flow, which confirms over the drawn post).
func loadPostView(n: int): bool {
    var w: list of int
    postViewWidths(w)
    if not loadPost(postIds[n - 1]) {
        sendLine("Post unavailable.")
        displayPrompt()
        return false
    }
    postNum = n
    wrapText(stripKludges(postBody(post.id)), w[0], bodyLines)
    bodyPage = 1
    drawPostView()
    return true
}

func drawPostView() {
    var w: list of int
    var cells: list of string
    var pageRows: int = 0
    var i: int = 0
    var last: int = 0
    var d: string = dateTimeStr(post.created)

    postViewWidths(w)
    // Frame from the top rule down: 8 lines plus one per meta row
    // (top, title, joint, meta, joint, joint, footer, bottom, prompt).
    if terminal.columns < minimumWideTerminalWidth {
        pageRows = terminal.rows - 10
    } else {
        pageRows = terminal.rows - 9
    }
    bodyPages = (bodyLines.count + pageRows - 1) / pageRows
    if bodyPages < 1 { bodyPages = 1 }
    if bodyPage > bodyPages { bodyPage = bodyPages }
    if bodyPage < 1 { bodyPage = 1 }

    sendTableTitle(post.subject, w)
    cells.clear()
    if terminal.columns < minimumWideTerminalWidth {
        cells.add("From: " + post.sender)
        sendLine(rowLine(cells, w))
        cells.clear()
        cells.add("Date: " + d)
        sendLine(rowLine(cells, w))
    } else {
        cells.add(pad("From: " + post.sender, w[0] - 23) + "Date: " + d)
        sendLine(rowLine(cells, w))
    }
    sendRule(CenterLeft, Center, CenterRight, w)
    i = (bodyPage - 1) * pageRows
    last = i + pageRows
    while i < bodyLines.count and i < last {
        cells.clear()
        cells.add(bodyLines[i])
        sendLine(rowLine(cells, w))
        i = i + 1
    }
    sendTableFooter("Post " + intStr(postNum) + " - Page " + intStr(bodyPage) + " of " + intStr(bodyPages), w)
}

func drawPostViewMenu() {
    sendLine("")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine(">) Next Post (or .)")
    sendLine("<) Previous Post (or ,)")
    sendLine("L) Redraw This Page")
    if hasPermission(PostBoards) { sendLine("R) Reply") }
    if hasPermission(Sysop) {
        sendLine("D) Delete Post")
    }
    sendLine("Q) Return to Post List")
    sendLine("")
}

// +/Enter/- page within the post; >/. and </, move between posts in
// list order; all quietly re-prompt at their ends.
func postViewChoice(input: string) {
    if input == "" or input == "+" {
        if bodyPage < bodyPages {
            bodyPage = bodyPage + 1
            drawPostView()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if bodyPage > 1 {
            bodyPage = bodyPage - 1
            drawPostView()
        }
        displayPrompt()
        return
    }
    if input == ">" or input == "." {
        if postNum < postIds.count {
            showPost(postNum + 1)
        } else {
            displayPrompt()
        }
        return
    }
    if input == "<" or input == "," {
        if postNum > 1 {
            showPost(postNum - 1)
        } else {
            displayPrompt()
        }
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawPostView()
        displayPrompt()
    }
    case "R" {
        if hasPermission(PostBoards) { startReply() } else { displayPrompt() }
    }
    case "D" {
        if hasPermission(Sysop) {
            delFromView = true
            user.screen = "delpostconfirm"
        }
        displayPrompt()
    }
    case "Q" {
        user.screen = "posts"
        drawPostList()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

// --- Post deletion (sysop only) ----------------------------------------
// From the list: D, then a post number -- the post is drawn and
// confirmed over. From the view: D confirms the post on screen.
// Deleted bodies stay orphaned in the .MSG heap (postsdb design).

var delFromView: bool = false

func delPostNumInput(input: string) {
    var n: int = parseIntStr(input)
    if input == "" {
        user.screen = "posts"
        displayPrompt()
        return
    }
    if n < 1 or n > postIds.count {
        sendLine("No such post.")
        displayPrompt()
        return
    }
    if not loadPostView(n) { return }
    user.screen = "delpostconfirm"
    displayPrompt()
}

func delPostConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(postsDb, post.id) {
            sendLine("Post deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
        user.screen = "posts"
        drawPostList()
        displayPrompt()
        return
    }
    sendLine("Cancelled.")
    if delFromView {
        user.screen = "postview"
    } else {
        user.screen = "posts"
        drawPostList()
    }
    displayPrompt()
}
