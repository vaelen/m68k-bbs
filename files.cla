// File-area reader: the caller-facing area picker, file list, and file
// view. Included by bbs.cla, which owns the screen dispatch; sysop.cla
// owns the admin screens for the same data (areasdb.cla/filesdb.cla).
//
// Read-only for now: there is no download yet (transfers are a later
// step), so a caller browses metadata and long descriptions. Sysops
// get D)elete, like the board reader.

// The numbered file list: number N at the prompt = fileNumIds[N-1].
// File IDs stay hidden from callers. Numbering restarts at 1 on every
// page; filePage/filePages track where we are (page 1 = newest).
var fileNumIds: list of int
var filePage: int = 1
var filePages: int = 1

// A file record is visible to the current caller unless it is pending
// approval and the caller is not a sysop.
func fileVisible(rec: text): bool {
    if user.access == accessSysop { return true }
    return (rec.intAt(fOffFlags) & fileFlagPending) == 0
}

// An area is visible to the current caller unless it is sysop-only and
// the caller is not a sysop.
func areaVisible(rec: text): bool {
    if user.access == accessSysop { return true }
    return rec[aOffAccess] != accessSysop
}

// A byte count as a short string: bytes under 1K, else whole K.
func sizeStr(n: int): string {
    if n < 1024 { return intStr(n) }
    return intStr(n / 1024) + "K"
}

// --- Area picker -------------------------------------------------------

// Content widths: narrow is ID/Name (total 39), wide is
// ID/Name/Description (total 79).
func areaPickerWidths(w: list of int) {
    w.clear()
    w.add(4)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(28)
        return
    }
    w.add(30)
    w.add(35)
}

// ponytail: the picker shows every visible area unpaged; page it if a
// system ever has more areas than screen rows.
func drawAreaPicker() {
    var w: list of int
    var cells: list of string
    var nextId: int = dbNextRecordId(areasDb)
    var id: int = 1
    var rec: text

    areaPickerWidths(w)
    cells.add("ID")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Description")
    }
    sendTableHeader("File Areas", cells, w)
    while id < nextId {
        rec = dbFind(areasDb, id)
        if rec.length == areaRecordSize and areaVisible(rec) {
            cells.clear()
            cells.add(intStr(id))
            cells.add(dbExtractString(rec, aOffName))
            if terminal.columns >= minimumWideTerminalWidth {
                cells.add(dbExtractString(rec, aOffDescription))
            }
            sendLine(rowLine(cells, w))
        }
        id = id + 1
    }
    sendRule(BottomLeft, BottomCenter, BottomRight, w)
    if terminal.columns < minimumWideTerminalWidth {
        sendLine("V) Select Area (or enter ID)")
        sendLine("Q) Return to Main Menu")
    } else {
        sendLine("V) Select Area (or enter ID)   Q) Return to Main Menu")
    }
}

// Enter or Q returns to the main menu; V (or a digit, via inputChar)
// asks for an area ID.
func areaPickerInput(input: string) {
    switch upperStr(input) {
    case "", "Q" { gotoScreen("main") }
    case "V"     { promptNumber("areanum", "") }
    case "?"     { gotoScreen("areas") }
    else         { displayPrompt() }
    }
}

// Empty input returns to the picker; an area ID enters the area.
func areaNumInput(input: string) {
    var rec: text
    var id: int
    user.screen = "areas"
    if input == "" {
        displayPrompt()
        return
    }
    id = parseIntStr(input)
    if id >= 1 { rec = dbFind(areasDb, id) }
    if rec.length != areaRecordSize or not areaVisible(rec) {
        sendLine("No such area.")
        displayPrompt()
        return
    }
    if not loadArea(id) {
        sendLine("No such area.")
        displayPrompt()
        return
    }
    enterArea()
}

func enterArea() {
    if not filesOpen(area.id) {
        sendLine("Area unavailable: " + lastError.message)
        displayPrompt()
        return
    }
    user.screen = "files"
    filePage = 1
    drawFileList()
    displayPrompt()
}

// --- File list ---------------------------------------------------------

// Files visible to the current caller (pending hidden from non-sysops).
func visibleFileCount(): int {
    var n: int = 0
    var id: int = 1
    var nextId: int = filesNextId()
    var rec: text
    while id < nextId {
        rec = dbFind(filesDb, id)
        if rec.length == fileRecordSize and fileVisible(rec) {
            n = n + 1
        }
        id = id + 1
    }
    return n
}

// Content widths: narrow is #/Name (total 39), wide adds
// Size and Description (total 79).
func fileListWidths(w: list of int) {
    w.clear()
    w.add(3)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(29)
        return
    }
    w.add(28)
    w.add(8)
    w.add(27)
}

// One page of files, newest (highest file ID) first, numbered from 1
// on every page. Frame is 8 lines from the top rule down (top, title,
// joint, header, joint, footer, bottom, prompt).
func drawFileList() {
    var w: list of int
    var cells: list of string
    var id: int = filesNextId() - 1
    var pageRows: int = terminal.rows - 8
    var skip: int = 0
    var rec: text

    filePages = (visibleFileCount() + pageRows - 1) / pageRows
    if filePages < 1 { filePages = 1 }
    if filePage > filePages { filePage = filePages }
    if filePage < 1 { filePage = 1 }
    skip = (filePage - 1) * pageRows

    fileNumIds.clear()
    fileListWidths(w)
    cells.add("#")
    cells.add("Name")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("Size")
        cells.add("Description")
    }
    sendTableHeader(area.name, cells, w)
    while id >= 1 and fileNumIds.count < pageRows {
        rec = dbFind(filesDb, id)
        if rec.length == fileRecordSize and fileVisible(rec) {
            if skip > 0 {
                skip = skip - 1
            } else {
                fileNumIds.add(id)
                cells.clear()
                cells.add(intStr(fileNumIds.count))
                cells.add(dbExtractString(rec, fOffName))
                if terminal.columns >= minimumWideTerminalWidth {
                    cells.add(sizeStr(rec.intAt(fOffSize)))
                    cells.add(dbExtractString(rec, fOffDescription))
                }
                sendLine(rowLine(cells, w))
            }
        }
        id = id - 1
    }
    sendTableFooter("Page " + intStr(filePage) + " of " + intStr(filePages), w)
    if fileNumIds.count == 0 {
        sendLine("No files yet.")
    }
}

func drawFilesMenu() {
    sendLine("")
    sendLine("V) View File (or enter number)")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine("L) List Files")
    sendLine("U) Upload File")
    if user.access == accessSysop {
        sendLine("D) Delete File")
    }
    sendLine("Q) Return to Area List")
    sendLine("")
}

func filesPrompt() {
    sendData(area.name + "> ")
}

// Enter and + page forward, - pages back; at either end they just
// re-prompt.
func filesChoice(input: string) {
    if input == "" or input == "+" {
        if filePage < filePages {
            filePage = filePage + 1
            drawFileList()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if filePage > 1 {
            filePage = filePage - 1
            drawFileList()
        }
        displayPrompt()
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawFileList()
        displayPrompt()
    }
    case "V" { promptNumber("filenum", "") }
    case "U" { gotoScreen("upproto") }
    case "D" {
        if user.access == accessSysop {
            delFileFromView = false
            user.screen = "delfilenum"
        }
        displayPrompt()
    }
    case "Q" {
        filesClose()
        gotoScreen("areas")
    }
    else { displayPrompt() }
    }
}

// Empty input returns to the list; a number on the current page opens
// that file.
func fileNumInput(input: string) {
    var n: int = parseIntStr(input)
    user.screen = "files"
    if n >= 1 and n <= fileNumIds.count {
        showFile(n)
        return
    }
    if input != "" { sendLine("No such file.") }
    displayPrompt()
}

// --- File view ---------------------------------------------------------
// A metadata card (Name/From/Date/Size/Downloads) followed by the long
// description wrapped inside the border and paged, "File N - Page X of
// Y" footer. No download yet.

var fileNum: int = 0            // display number in the current list page
var descLines: list of string
var descPage: int = 1
var descPages: int = 1

// Single-span content width for the file frame.
func fileViewWidths(w: list of int) {
    w.clear()
    if terminal.columns < minimumWideTerminalWidth {
        w.add(35)
        return
    }
    w.add(75)
}

func showFile(n: int) {
    if not loadFileView(n) { return }
    user.screen = "fileview"
    displayPrompt()
}

// Load and draw file number n (shared by viewing and the sysop
// delete-from-list flow, which confirms over the drawn file).
func loadFileView(n: int): bool {
    var w: list of int
    fileViewWidths(w)
    if not loadFile(fileNumIds[n - 1]) {
        sendLine("File unavailable.")
        displayPrompt()
        return false
    }
    fileNum = n
    wrapText(fileLongDesc(fileRec.id), w[0], descLines)
    descPage = 1
    drawFileView()
    return true
}

func drawFileView() {
    var w: list of int
    var cells: list of string
    var pageRows: int = 0
    var i: int = 0
    var last: int = 0
    var d: string = dateTimeStr(fileRec.created)
    var meta: string = "Size: " + sizeStr(fileRec.size) + "  Downloads: " + intStr(fileRec.downloads)
    var descHdr: list of string
    var dt: text
    var metaRows: int = 0

    fileViewWidths(w)
    // The short description is word-wrapped to the frame width and shown
    // as the last header line(s) -- matters most in 40-column mode.
    if fileRec.description.length > 0 {
        dt.append(fileRec.description)
        wrapText(dt, w[0], descHdr)
    }
    // Frame from the top rule down is 9 fixed lines (blank, top rule,
    // title, joint, mid rule, footer joint, footer, bottom, prompt)
    // plus one per meta row: From, Date (or the two combined when wide),
    // Size/Downloads, and each wrapped description line.
    if terminal.columns < minimumWideTerminalWidth {
        metaRows = 3
    } else {
        metaRows = 2
    }
    metaRows = metaRows + descHdr.count
    pageRows = terminal.rows - 9 - metaRows
    descPages = (descLines.count + pageRows - 1) / pageRows
    if descPages < 1 { descPages = 1 }
    if descPage > descPages { descPage = descPages }
    if descPage < 1 { descPage = 1 }

    sendTableTitle(fileRec.name, w)
    cells.clear()
    if terminal.columns < minimumWideTerminalWidth {
        cells.add("From: " + fileRec.uploader)
        sendLine(rowLine(cells, w))
        cells.clear()
        cells.add("Date: " + d)
        sendLine(rowLine(cells, w))
        cells.clear()
        cells.add(meta)
        sendLine(rowLine(cells, w))
    } else {
        cells.add(pad("From: " + fileRec.uploader, w[0] - 23) + "Date: " + d)
        sendLine(rowLine(cells, w))
        cells.clear()
        cells.add(meta)
        sendLine(rowLine(cells, w))
    }
    i = 0
    while i < descHdr.count {
        cells.clear()
        cells.add(descHdr[i])
        sendLine(rowLine(cells, w))
        i = i + 1
    }
    sendRule(CenterLeft, Center, CenterRight, w)
    i = (descPage - 1) * pageRows
    last = i + pageRows
    while i < descLines.count and i < last {
        cells.clear()
        cells.add(descLines[i])
        sendLine(rowLine(cells, w))
        i = i + 1
    }
    sendTableFooter("File " + intStr(fileNum) + " - Page " + intStr(descPage) + " of " + intStr(descPages), w)
}

func drawFileViewMenu() {
    sendLine("")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine(">) Next File (or .)")
    sendLine("<) Previous File (or ,)")
    sendLine("L) Redraw This Page")
    sendLine("D) Download File")
    if user.access == accessSysop {
        if (fileRec.flags & fileFlagPending) != 0 { sendLine("A) Approve File") }
        sendLine("X) Delete File")
    }
    sendLine("Q) Return to File List")
    sendLine("")
}

// +/Enter/- page within the description; >/. and </, move between
// files in list order; all quietly re-prompt at their ends.
func fileViewChoice(input: string) {
    if input == "" or input == "+" {
        if descPage < descPages {
            descPage = descPage + 1
            drawFileView()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if descPage > 1 {
            descPage = descPage - 1
            drawFileView()
        }
        displayPrompt()
        return
    }
    if input == ">" or input == "." {
        if fileNum < fileNumIds.count {
            showFile(fileNum + 1)
        } else {
            displayPrompt()
        }
        return
    }
    if input == "<" or input == "," {
        if fileNum > 1 {
            showFile(fileNum - 1)
        } else {
            displayPrompt()
        }
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawFileView()
        displayPrompt()
    }
    case "D" {
        if (fileRec.flags & fileFlagOffline) != 0 {
            sendLine("That file is offline.")
            displayPrompt()
        } else {
            gotoScreen("xferproto")
        }
    }
    case "A" {
        if user.access == accessSysop and (fileRec.flags & fileFlagPending) != 0 {
            fileRec.flags = fileRec.flags & ~fileFlagPending
            if saveFile() {
                sendLine("Approved.")
            } else {
                sendLine("Save failed: " + lastError.message)
            }
            drawFileView()
        }
        displayPrompt()
    }
    case "X" {
        if user.access == accessSysop {
            delFileFromView = true
            user.screen = "delfileconfirm"
        }
        displayPrompt()
    }
    case "Q" {
        user.screen = "files"
        drawFileList()
        displayPrompt()
    }
    else { displayPrompt() }
    }
}

// --- File deletion (sysop only) ----------------------------------------
// From the list: D, then a file number -- the file is drawn and
// confirmed over. From the view: D confirms the file on screen. The
// physical file and its heap bytes stay behind (filesdb design).

var delFileFromView: bool = false

func delFileNumInput(input: string) {
    var n: int = parseIntStr(input)
    if input == "" {
        user.screen = "files"
        displayPrompt()
        return
    }
    if n < 1 or n > fileNumIds.count {
        sendLine("No such file.")
        displayPrompt()
        return
    }
    if not loadFileView(n) { return }
    user.screen = "delfileconfirm"
    displayPrompt()
}

func delFileConfirm(input: string) {
    if upperStr(input) == "Y" {
        if dbDelete(filesDb, fileRec.id) {
            sendLine("File deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
        user.screen = "files"
        drawFileList()
        displayPrompt()
        return
    }
    sendLine("Cancelled.")
    if delFileFromView {
        user.screen = "fileview"
    } else {
        user.screen = "files"
        drawFileList()
    }
    displayPrompt()
}

// --- Download ----------------------------------------------------------
// D in the file view -> protocol menu -> the "xfer" screen (bbs.cla
// routes bytes to the engine). xferDone brings the caller back to the
// file view. ponytail: one protocol on the menu; add letters with
// engines.

func drawXferProtoMenu() {
    sendLine("")
    sendLine("Download " + fileRec.name + " (" + intStr(fileRec.size) + " bytes)")
    sendLine("")
    sendLine("X) XMODEM")
    sendLine("1) XMODEM-1K")
    sendLine("Y) YMODEM")
    sendLine("Q) Cancel")
    sendLine("")
}

func xferProtoChoice(input: string) {
    switch upperStr(input) {
    case "X" { startDownload('X') }
    case "1" { startDownload('1') }
    case "Y" { startDownload('Y') }
    case "", "Q" {
        user.screen = "fileview"
        displayPrompt()
    }
    case "?" { gotoScreen("xferproto") }
    else { displayPrompt() }
    }
}

var xferDir: char = 'D'          // 'D' download, 'U' upload
var upProto: char = 'X'
var upName: string(31)
var upDesc: string(63)

func protoLabel(proto: char): string {
    switch proto {
    case '1' { return "XMODEM-1K" }
    case 'Y' { return "YMODEM" }
    }
    return "XMODEM"
}

func startDownload(proto: char) {
    xferDir = 'D'
    sendLine("Start your " + protoLabel(proto) + " receive now (Ctrl-X twice to cancel)...")
    log(protoLabel(proto) + " send: " + filePath(fileRec.id))
    xferStart(proto, filePath(fileRec.id), fileRec.name)
}

// --- Upload ------------------------------------------------------------
// U on the file list -> protocol -> (XMODEM: filename) -> description ->
// the "xfer" screen. Each received file becomes a pending entry
// (sysops' own uploads go live at once); xferDone returns to the list.

func drawUpProtoMenu() {
    sendLine("")
    sendLine("Upload to " + area.name)
    sendLine("")
    sendLine("X) XMODEM")
    sendLine("1) XMODEM-1K")
    sendLine("Y) YMODEM")
    sendLine("Q) Cancel")
    sendLine("")
}

func upProtoChoice(input: string) {
    var choice: string = upperStr(input)
    switch choice {
    case "X", "1", "Y" {
        upProto = choice[0]
        upName = ""
        if upProto == 'Y' {
            user.screen = "updesc"       // the name comes with the file
        } else {
            user.screen = "upname"
        }
        displayPrompt()
    }
    case "", "Q" {
        user.screen = "files"
        displayPrompt()
    }
    case "?" { gotoScreen("upproto") }
    else { displayPrompt() }
    }
}

// The Mac File Manager's rules plus "not already here". Shared with the
// engine, which vets YMODEM names through it.
func xferAcceptName(name: string): bool {
    var i: int = 0
    if name.length == 0 or name.length > 31 { return false }
    while i < name.length {
        if name[i] == ':' { return false }
        i = i + 1
    }
    return findFile(name) < 0
}

func upNameInput(input: string) {
    if input == "" {
        user.screen = "files"
        sendLine("Cancelled.")
        displayPrompt()
        return
    }
    if not xferAcceptName(input) {
        if findFile(input) >= 0 {
            sendLine("That name is already in use.")
        } else {
            sendLine("Names are 1-31 characters with no colon.")
        }
        displayPrompt()
        return
    }
    upName = input
    user.screen = "updesc"
    displayPrompt()
}

func upDescInput(input: string) {
    if input.length > 63 {
        sendLine("Descriptions are limited to 63 characters.")
        displayPrompt()
        return
    }
    upDesc = input
    xferDir = 'U'
    sendLine("Start your " + protoLabel(upProto) + " send now (Ctrl-X twice to cancel)...")
    log(protoLabel(upProto) + " receive into " + area.name)
    xferStartReceive(upProto, area.folder, upName)
}

// Engine callback: one file landed on disk.
func xferReceived(name: string, bytes: int) {
    var none: text
    var flags: int = fileFlagPending
    if user.access == accessSysop { flags = 0 }
    if addFile(name, user.name, upDesc, bytes, flags, none) < 1 {
        log("Upload: addFile failed for " + name + ": " + lastError.message)
        return
    }
    log("Upload: " + name + " (" + intStr(bytes) + " bytes) from " + user.name)
    sendLine("Received " + name + " (" + intStr(bytes) + " bytes).")
}

// Engine callback: the transfer is over and the engine is idle.
func xferDone(ok: bool) {
    sendLine("")
    if xferDir == 'U' {
        if ok {
            sendLine("Upload complete.")
            if user.access != accessSysop {
                sendLine("It will be listed once the sysop approves it.")
            }
        } else {
            sendLine("Upload failed.")
        }
        user.screen = "files"
        drawFileList()
        displayPrompt()
        return
    }
    if ok {
        fileRec.downloads = fileRec.downloads + 1
        if not saveFile() { log("Download count save failed: " + lastError.message) }
        sendLine("Transfer complete.")
    } else {
        sendLine("Transfer failed.")
    }
    user.screen = "fileview"
    drawFileView()
    displayPrompt()
}
