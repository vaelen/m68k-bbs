// Terminal details for the connected caller -- drives how we emit
// colors and line-drawing characters per client later on.

enum TerminalType { ASCII, ANSI, VT100 }

record Terminal {
    columns: int = 80
    rows:    int = 24
    color:   bool                     // defaults false
    type:    TerminalType             // defaults to ASCII
    eol:     string(2) = "\x0D\x0A"   // line terminator sent to the caller
    echo:    bool = true              // BBS echoes received chars back
    ansi:    bool                     // terminal honors ANSI escape codes
    telnet:  bool                     // caller is a telnet client
    reportedTerminalType: string(40)  // client's TERMINAL-TYPE reply
    reportedSpeed:        string(31)  // client's TERMINAL-SPEED reply
}

var terminal: Terminal

// The 16 primary terminal colors, in ANSI order (value mod 8 = the
// ANSI color code offset; 8 and up are the bright variants).
enum Color {
    Black, Red, Green, Yellow, Blue, Magenta, Cyan, White
    BrightBlack, BrightRed, BrightGreen, BrightYellow
    BrightBlue, BrightMagenta, BrightCyan, BrightWhite
}

// ANSI sequence for a foreground color. Bright variants use bold+color
// ("\x1B[1;3Xm") rather than 90-97m, which VT100-era clients lack;
// normal variants turn bold off with 22 (not 0, which would also wipe
// the background).
func colorSeq(color: Color): string {
    switch color {
    case Black         { return "\x1B[22;30m" }
    case Red           { return "\x1B[22;31m" }
    case Green         { return "\x1B[22;32m" }
    case Yellow        { return "\x1B[22;33m" }
    case Blue          { return "\x1B[22;34m" }
    case Magenta       { return "\x1B[22;35m" }
    case Cyan          { return "\x1B[22;36m" }
    case White         { return "\x1B[22;37m" }
    case BrightBlack   { return "\x1B[1;30m" }
    case BrightRed     { return "\x1B[1;31m" }
    case BrightGreen   { return "\x1B[1;32m" }
    case BrightYellow  { return "\x1B[1;33m" }
    case BrightBlue    { return "\x1B[1;34m" }
    case BrightMagenta { return "\x1B[1;35m" }
    case BrightCyan    { return "\x1B[1;36m" }
    case BrightWhite   { return "\x1B[1;37m" }
    }
    return ""
}

// ANSI sequence for a background color.
// ponytail: bright backgrounds render as their basic color -- there is
// no portable bright-background SGR (100-107 is aixterm-only, 5;4Xm
// blinks on non-iCE clients); switch to 100-107 if we ever require
// modern clients.
func backgroundSeq(color: Color): string {
    switch color {
    case Black,   BrightBlack   { return "\x1B[40m" }
    case Red,     BrightRed     { return "\x1B[41m" }
    case Green,   BrightGreen   { return "\x1B[42m" }
    case Yellow,  BrightYellow  { return "\x1B[43m" }
    case Blue,    BrightBlue    { return "\x1B[44m" }
    case Magenta, BrightMagenta { return "\x1B[45m" }
    case Cyan,    BrightCyan    { return "\x1B[46m" }
    case White,   BrightWhite   { return "\x1B[47m" }
    }
    return ""
}

// Default foreground (with bold off, since bright colors set bold) and
// default background.
const clearColorSeq:      string = "\x1B[22;39m"
const clearBackgroundSeq: string = "\x1B[49m"

// --- Box drawing -------------------------------------------------------

enum BoxPiece {
    TopLeft, TopCenter, TopRight
    CenterLeft, Center, CenterRight
    BottomLeft, BottomCenter, BottomRight
    Horizontal, Vertical
}

// Designate G1 = DEC Special Graphics. Sent once when a caller picks
// VT100; startDrawing/stopDrawing then shift in and out of it.
const vt100SetupSeq: string = "\x1B)0"

// The box-drawing character for the caller's terminal: ASCII uses
// + - |, ANSI the cp437 line-drawing set, VT100 the DEC Special
// Graphics letters (which render as lines only between
// startDrawing/stopDrawing).
func boxChar(p: BoxPiece): char {
    switch terminal.type {
    case ANSI {
        switch p {
        case TopLeft      { return '\xDA' }
        case TopCenter    { return '\xC2' }
        case TopRight     { return '\xBF' }
        case CenterLeft   { return '\xC3' }
        case Center       { return '\xC5' }
        case CenterRight  { return '\xB4' }
        case BottomLeft   { return '\xC0' }
        case BottomCenter { return '\xC1' }
        case BottomRight  { return '\xD9' }
        case Horizontal   { return '\xC4' }
        case Vertical     { return '\xB3' }
        }
    }
    case VT100 {
        switch p {
        case TopLeft      { return 'l' }
        case TopCenter    { return 'w' }
        case TopRight     { return 'k' }
        case CenterLeft   { return 't' }
        case Center       { return 'n' }
        case CenterRight  { return 'u' }
        case BottomLeft   { return 'm' }
        case BottomCenter { return 'v' }
        case BottomRight  { return 'j' }
        case Horizontal   { return 'q' }
        case Vertical     { return 'x' }
        }
    }
    case ASCII {
        switch p {
        case Horizontal { return '-' }
        case Vertical   { return '|' }
        else            { return '+' }
        }
    }
    }
    return '+'
}

// Shift to / from the VT100 drawing set (SO/SI); empty for the other
// types. Wrap a whole run of drawing characters in one pair.
func startDrawing(): string {
    if terminal.type == VT100 { return "\x0E" }
    return ""
}

func stopDrawing(): string {
    if terminal.type == VT100 { return "\x0F" }
    return ""
}

// A horizontal rule segment, bare -- meant for inside a
// startDrawing/stopDrawing pair (see termio.cla's sendDrawing).
func hbar(width: int): string {
    var out: string = ""
    var h: char = boxChar(Horizontal)
    var i: int = 0
    while i < width {
        out = out + h
        i = i + 1
    }
    return out
}

// A self-contained vertical bar for data rows, where normal text sits
// between bars: on VT100 it carries its own SO/SI.
func vbar(): string {
    return startDrawing() + boxChar(Vertical) + stopDrawing()
}

// A full horizontal rule for a table: `l`, joints of `m` between
// columns, `r`. Widths are content widths; each column adds the two
// padding spaces rowLine uses. Bare drawing chars -- send with
// sendDrawing.
func ruleLine(l: BoxPiece, m: BoxPiece, r: BoxPiece, widths: list of int): string {
    var out: string = ""
    var i: int = 0
    out = out + boxChar(l)
    while i < widths.count {
        if i > 0 { out = out + boxChar(m) }
        out = out + hbar(widths[i] + 2)
        i = i + 1
    }
    return out + boxChar(r)
}

// The one-column content width that spans the same total width as the
// given columns (for title bars): sum + 3*(n-1).
func spanWidth(widths: list of int): int {
    var total: int = 0
    var i: int = 0
    while i < widths.count {
        total = total + widths[i]
        i = i + 1
    }
    return total + 3 * (widths.count - 1)
}

// A table data row: cells padded to their content widths, one space of
// padding each side, vbar-separated. Self-contained (vbar carries its
// own SO/SI) -- send as-is.
func rowLine(cells: list of string, widths: list of int): string {
    var out: string = ""
    var i: int = 0
    while i < widths.count {
        out = out + vbar() + " " + pad(cells[i], widths[i]) + " "
        i = i + 1
    }
    return out + vbar()
}

// Left-align s in a field of `width` spaces, truncating if longer.
func pad(s: string, width: int): string {
    var out: string = s
    if width <= 0 { return "" }
    if s.length >= width { return s[0, width] }
    while out.length < width {
        out = out + " "
    }
    return out
}

// Word-wrap `body` into lines no wider than `width`: breaks on
// spaces, hard-breaks words longer than a line, keeps CR line breaks
// (blank lines included), drops LFs (CRLF input works).
func wrapText(body: text, width: int, lines: list of string) {
    var line: string = ""
    var word: string = ""
    var i: int = 0
    var c: char
    var joined: string
    lines.clear()
    if width < 1 { return }
    while i < body.length {
        c = body[i]
        i = i + 1
        if c == '\x0A' { continue }
        if c == '\x0D' or c == ' ' {
            // flush the pending word onto the line
            if word != "" {
                if line == "" {
                    joined = word
                } else {
                    joined = line + " " + word
                }
                if joined.length <= width {
                    line = joined
                } else {
                    lines.add(line)
                    line = word
                }
                word = ""
            }
            if c == '\x0D' {
                lines.add(line)
                line = ""
            }
        } else {
            word = word + c
            if word.length == width {
                // a full-width word gets a line of its own
                if line != "" {
                    lines.add(line)
                    line = ""
                }
                lines.add(word)
                word = ""
            }
        }
    }
    if word != "" {
        if line == "" {
            joined = word
        } else {
            joined = line + " " + word
        }
        if joined.length <= width {
            line = joined
        } else {
            lines.add(line)
            line = word
        }
    }
    if line != "" { lines.add(line) }
}

// Right-align s in a field of `width` spaces, truncating if longer.
func padLeft(s: string, width: int): string {
    var out: string = s
    if width <= 0 { return "" }
    if s.length >= width { return s[0, width] }
    while out.length < width {
        out = " " + out
    }
    return out
}

// Center s in a field of `width` spaces (odd leftover space goes
// right), truncating if longer.
func center(s: string, width: int): string {
    var out: string = ""
    var left: int = (width - s.length) / 2
    var i: int = 0
    if width <= 0 { return "" }
    if s.length >= width { return s[0, width] }
    while i < left {
        out = out + " "
        i = i + 1
    }
    return pad(out + s, width)
}
