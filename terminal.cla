// Terminal details for the connected caller -- drives how we emit
// colors and line-drawing characters per client later on.

enum TerminalType { ASCII, ANSI, VT100, PETSCII }

// Columns are stored as one LESS than the physical width, and layouts
// are chosen against minimumWideTerminalWidth (79 for an 80-column
// screen). SyncTERM and DOS ANSI.SYS wrap by themselves when the last
// column is written, so a newline after a full 80-column line becomes
// a blank line there; Unix terminals (and anything wider than 80) need
// the newline. Never writing the last column sidesteps both: every
// line ends before it and carries its own newline. Set the width only
// through setColumns so the -1 lives in one place.
const minimumWideTerminalWidth: int = 79

record Terminal {
    columns: int = 79                 // physical width - 1; see above
    rows:    int = 24
    color:   bool                     // defaults false
    type:    TerminalType             // defaults to ASCII
    eol:     string(2) = "\x0D\x0A"   // line terminator sent to the caller
    echo:    bool = true              // BBS echoes received chars back
    linemode: bool                    // buffer input until Enter (text
                                      // prompts); off = each key acts
    ansi:    bool                     // terminal honors ANSI escape codes
    telnet:  bool                     // caller is a telnet client
    reportedTerminalType: string(40)  // client's TERMINAL-TYPE reply
    reportedSpeed:        string(31)  // client's TERMINAL-SPEED reply
    asciiKeys: bool                   // PETSCII client sends ASCII-cased
                                      // letters (SyncTERM); see petsciiIn
}

var terminal: Terminal

// The physical screen size, as the caller or NAWS reports it.
func setColumns(actual: int) {
    terminal.columns = actual - 1
}

func setRows(actual: int) {
    terminal.rows = actual
}

// The 16 primary terminal colors, in ANSI order (value mod 8 = the
// ANSI color code offset; 8 and up are the bright variants).
enum Color {
    Black, Red, Green, Yellow, Blue, Magenta, Cyan, White
    BrightBlack, BrightRed, BrightGreen, BrightYellow
    BrightBlue, BrightMagenta, BrightCyan, BrightWhite
}

// ANSI sequence for a foreground color. Bright variants use bold+color
// ("\x1B[1;3Xm") rather than 90-97m, which VT100-era clients lack;
// normal variants turn bold off with 22 (not 0, which would also wipe
// the background).
func colorSeq(color: Color): string {
    switch color {
    case Black         { return "\x1B[22;30m" }
    case Red           { return "\x1B[22;31m" }
    case Green         { return "\x1B[22;32m" }
    case Yellow        { return "\x1B[22;33m" }
    case Blue          { return "\x1B[22;34m" }
    case Magenta       { return "\x1B[22;35m" }
    case Cyan          { return "\x1B[22;36m" }
    case White         { return "\x1B[22;37m" }
    case BrightBlack   { return "\x1B[1;30m" }
    case BrightRed     { return "\x1B[1;31m" }
    case BrightGreen   { return "\x1B[1;32m" }
    case BrightYellow  { return "\x1B[1;33m" }
    case BrightBlue    { return "\x1B[1;34m" }
    case BrightMagenta { return "\x1B[1;35m" }
    case BrightCyan    { return "\x1B[1;36m" }
    case BrightWhite   { return "\x1B[1;37m" }
    }
    return ""
}

// ANSI sequence for a background color.
// ponytail: bright backgrounds render as their basic color -- there is
// no portable bright-background SGR (100-107 is aixterm-only, 5;4Xm
// blinks on non-iCE clients); switch to 100-107 if we ever require
// modern clients.
func backgroundSeq(color: Color): string {
    switch color {
    case Black,   BrightBlack   { return "\x1B[40m" }
    case Red,     BrightRed     { return "\x1B[41m" }
    case Green,   BrightGreen   { return "\x1B[42m" }
    case Yellow,  BrightYellow  { return "\x1B[43m" }
    case Blue,    BrightBlue    { return "\x1B[44m" }
    case Magenta, BrightMagenta { return "\x1B[45m" }
    case Cyan,    BrightCyan    { return "\x1B[46m" }
    case White,   BrightWhite   { return "\x1B[47m" }
    }
    return ""
}

// Default foreground (with bold off, since bright colors set bold) and
// default background.
const clearColorSeq:      string = "\x1B[22;39m"
const clearBackgroundSeq: string = "\x1B[49m"

// --- PETSCII -----------------------------------------------------------
// Commodore terminals: no ESC, colors and cursor motion are single
// control bytes, and the shifted (lowercase) character set puts
// lowercase at $41-$5A and uppercase at $C1-$DA. Caller-facing text is
// translated on the wire by translateOut (sendData); control bytes the
// builders below emit ride behind an ESC, which translateOut strips
// while copying the next byte verbatim (docs/petscii.md).

const petsciiLowercaseSeq: string = "\x0E"   // sent once at selection

func petsciiCtrl(b: char): string {
    return "\x1B" + b
}

// The 16 ANSI colors on the C64 palette (no backgrounds).
func petsciiColor(color: Color): char {
    switch color {
    case Black         { return '\x90' }
    case Red           { return '\x1C' }
    case Green         { return '\x1E' }
    case Yellow        { return '\x95' }   // brown
    case Blue          { return '\x1F' }
    case Magenta       { return '\x9C' }   // purple
    case Cyan          { return '\x9F' }
    case White         { return '\x9B' }   // grey 3
    case BrightBlack   { return '\x97' }   // grey 1
    case BrightRed     { return '\x96' }
    case BrightGreen   { return '\x99' }
    case BrightYellow  { return '\x9E' }
    case BrightBlue    { return '\x9A' }
    case BrightMagenta { return '\x9C' }
    case BrightCyan    { return '\x9F' }
    case BrightWhite   { return '\x05' }
    }
    return '\x05'
}

const petsciiDefaultColor: char = '\x9A'   // light blue, the C64's own

// CP437 byte -> PETSCII byte for the shifted set: letters swap case,
// single- and double-line box drawing and blocks go to the C= graphics
// that survive a charset switch, the rest of the high half is '?'.
// int(c) sign-extends high bytes on the 68k backend (the host lane
// doesn't), so mask before any magnitude test.
func petsciiChar(c: char): char {
    var n: int = int(c) & 0xFF
    if n >= 65 and n <= 90 { return char(n + 128) }   // A-Z -> $C1-$DA
    if n >= 97 and n <= 122 { return char(n - 32) }   // a-z -> $41-$5A
    if n < 128 {
        switch c {
        case '\x08' { return '\x14' }   // BS -> DELETE
        case '\x5C' { return '?' }      // backslash (PETSCII shows a pound)
        case '\x5F' { return '\xA4' }   // underscore -> bottom line
        case '\x60' { return '\x27' }   // backtick -> apostrophe
        case '\x7B', '\x7D', '\x7E', '\x7F' { return '?' }
        case '\x7C' { return '\xDD' }   // | -> vertical bar
        else { return c }
        }
    }
    switch c {
    case '\xB3', '\xBA'                         { return '\xDD' }   // vertical
    case '\xC4', '\xCD'                         { return '\xC0' }   // horizontal
    case '\xDA', '\xC9', '\xD5', '\xD6'         { return '\xB0' }   // top left
    case '\xBF', '\xB7', '\xB8', '\xBB'         { return '\xAE' }   // top right
    case '\xC0', '\xC8', '\xD3', '\xD4'         { return '\xAD' }   // bottom left
    case '\xD9', '\xBC', '\xBD', '\xBE'         { return '\xBD' }   // bottom right
    case '\xC3', '\xC6', '\xC7', '\xCC'         { return '\xAB' }   // left tee
    case '\xB4', '\xB5', '\xB6', '\xB9'         { return '\xB3' }   // right tee
    case '\xC2', '\xCB', '\xD1', '\xD2'         { return '\xB2' }   // top tee
    case '\xC1', '\xCA', '\xCF', '\xD0'         { return '\xB1' }   // bottom tee
    case '\xC5', '\xCE', '\xD7', '\xD8'         { return '\xDB' }   // cross
    case '\xB0', '\xB1', '\xB2'                 { return '\xA6' }   // shading
    case '\xDB', '\xFE'                         { return '\xA0' }   // full block
    case '\xDC' { return '\xA2' }   // lower half
    case '\xDD' { return '\xA1' }   // left half
    case '\xDE' { return '\xB6' }   // right half
    case '\xDF' { return '\xB8' }   // upper half
    case '\xF9', '\xFA' { return '.' }
    case '\xFF' { return ' ' }
    else { return '?' }
    }
}

// PETSCII keyboard byte -> the ASCII the rest of the BBS expects. A
// C64's KERNAL sends unshifted letters as $41-$5A and shifted as
// $C1-$DA, never $61-$7A; SyncTERM's PETSCII mode sends plain ASCII
// ($61-$7A unshifted, $41-$5A shifted). The first $61-$7A byte marks
// the session ASCII-cased and $41-$5A is uppercase from then on.
// ponytail: a SyncTERM caller whose first letters are all shifted gets
// them lowercased until an unshifted one arrives.
func petsciiIn(c: char): char {
    var n: int = int(c) & 0xFF
    if n >= 97 and n <= 122 {                          // $61-$7A: ASCII client
        terminal.asciiKeys = true
        return c
    }
    if n >= 65 and n <= 90 {                           // $41-$5A
        if terminal.asciiKeys { return c }
        return char(n + 32)
    }
    if n >= 193 and n <= 218 { return char(n - 128) } // $C1-$DA -> A-Z
    if c == '\x14' { return '\x08' }                  // DELETE -> BS
    return c
}

// Caller-facing text as the terminal's character set: ASCII gets '?'
// for every high byte, PETSCII the mapping above (an ESC passes the
// byte after it through untouched -- the builders' control bytes),
// ANSI and VT100 are sent as-is. Applied by sendData, never to file
// transfers.
func translateOut(s: string): string {
    var out: string = ""
    var i: int = 0
    var c: char
    if terminal.type == ANSI or terminal.type == VT100 { return s }
    while i < s.length {
        c = s[i]
        i = i + 1
        if terminal.type == PETSCII {
            if c == '\x1B' {
                if i < s.length {
                    out = out + s[i]
                    i = i + 1
                }
            } else {
                out = out + petsciiChar(c)
            }
        } else if (int(c) & 0xFF) >= 128 {
            out = out + '?'
        } else {
            out = out + c
        }
    }
    return out
}

// --- Terminal-aware builders -------------------------------------------
// Each returns the sequence when the session's terminal supports it and
// "" otherwise, so menus and screens can concatenate them freely and
// degrade to plain text by themselves. Colors need terminal.color; the
// rest need terminal.ansi (escape codes honored) or a PETSCII terminal,
// which has its own control bytes.

func fg(color: Color): string {
    if not terminal.color { return "" }
    if terminal.type == PETSCII { return petsciiCtrl(petsciiColor(color)) }
    return colorSeq(color)
}

func bg(color: Color): string {
    if not terminal.color or terminal.type == PETSCII { return "" }
    return backgroundSeq(color)
}

func fgOff(): string {
    if not terminal.color { return "" }
    if terminal.type == PETSCII { return petsciiCtrl(petsciiDefaultColor) }
    return clearColorSeq
}

func bgOff(): string {
    if not terminal.color or terminal.type == PETSCII { return "" }
    return clearBackgroundSeq
}

// Clear the screen and home the cursor.
func clearScreen(): string {
    if terminal.type == PETSCII { return petsciiCtrl('\x93') }
    if not terminal.ansi { return "" }
    return "\x1B[2J\x1B[H"
}

// SGR attribute toggles. Bold off (22) also un-brightens a bright
// foreground, since bright colors are bold+color -- re-send fg after.
func bold(enabled: bool): string {
    if not terminal.ansi { return "" }
    if enabled { return "\x1B[1m" }
    return "\x1B[22m"
}

func underline(enabled: bool): string {
    if not terminal.ansi { return "" }
    if enabled { return "\x1B[4m" }
    return "\x1B[24m"
}

func blink(enabled: bool): string {
    if not terminal.ansi { return "" }
    if enabled { return "\x1B[5m" }
    return "\x1B[25m"
}

func reverseVideo(enabled: bool): string {
    if terminal.type == PETSCII {
        if enabled { return petsciiCtrl('\x12') }
        return petsciiCtrl('\x92')
    }
    if not terminal.ansi { return "" }
    if enabled { return "\x1B[7m" }
    return "\x1B[27m"
}

// All attributes and colors off.
func attrsOff(): string {
    if terminal.type == PETSCII {
        if terminal.color { return reverseVideo(false) + fgOff() }
        return reverseVideo(false)
    }
    if not terminal.ansi { return "" }
    return "\x1B[0m"
}

// Move the cursor to a 1-based row and column.
// ponytail: trackOutput ignores cursor motion, so termCol is stale
// after this until the next CR; fine for full-screen layouts that
// don't take echoed line input mid-screen.
func moveTo(row: int, col: int): string {
    var out: string = ""
    var i: int = 1
    if terminal.type == PETSCII {
        // HOME, then step down and right
        out = petsciiCtrl('\x13')
        while i < row {
            out = out + petsciiCtrl('\x11')
            i = i + 1
        }
        i = 1
        while i < col {
            out = out + petsciiCtrl('\x1D')
            i = i + 1
        }
        return out
    }
    if not terminal.ansi { return "" }
    return "\x1B[" + string(row) + ";" + string(col) + "H"
}

// --- Output column tracking -------------------------------------------
// The caller's cursor column, kept up to date by feeding every
// caller-facing send through trackOutput (bbs.cla's sendData does).
// The input echo relies on it: a rubout can't cross a display row.
// Escape sequences and other control bytes don't move the cursor;
// CR returns to column 0. Rows are not tracked, so the count is only
// trustworthy from the last CR on -- which is all the echo needs.

var termCol: int = 0
var termEsc: int = 0   // 0 = text, 1 = after ESC, 2 = inside CSI

func trackOutput(s: string) {
    var i: int = 0
    var c: char
    while i < s.length {
        c = s[i]
        i = i + 1
        if termEsc == 1 {
            if c == '[' {
                termEsc = 2
            } else if c < ' ' or c > '/' {   // 0x20-0x2F are intermediates
                termEsc = 0                  // this byte ends the sequence
            }
        } else if termEsc == 2 {
            if c >= '@' { termEsc = 0 }      // CSI final byte
        } else if c == '\x1B' {
            termEsc = 1
        } else if c == '\x0D' {
            termCol = 0
        } else if c == '\x08' {
            if termCol > 0 { termCol = termCol - 1 }
        } else if c >= ' ' and c != '\x7F' {
            termCol = termCol + 1
        }
    }
}

// --- Box drawing -------------------------------------------------------

enum BoxPiece {
    TopLeft, TopCenter, TopRight
    CenterLeft, Center, CenterRight
    BottomLeft, BottomCenter, BottomRight
    Horizontal, Vertical
}

// Designate G1 = DEC Special Graphics. Sent once when a caller picks
// VT100; startDrawing/stopDrawing then shift in and out of it.
const vt100SetupSeq: string = "\x1B)0"

// The box-drawing character for the caller's terminal: ASCII uses
// + - |, ANSI the cp437 line-drawing set (PETSCII too -- translateOut
// turns it into the C= graphics on the wire), VT100 the DEC Special
// Graphics letters (which render as lines only between
// startDrawing/stopDrawing).
func boxChar(p: BoxPiece): char {
    switch terminal.type {
    case ANSI, PETSCII {
        switch p {
        case TopLeft      { return '\xDA' }
        case TopCenter    { return '\xC2' }
        case TopRight     { return '\xBF' }
        case CenterLeft   { return '\xC3' }
        case Center       { return '\xC5' }
        case CenterRight  { return '\xB4' }
        case BottomLeft   { return '\xC0' }
        case BottomCenter { return '\xC1' }
        case BottomRight  { return '\xD9' }
        case Horizontal   { return '\xC4' }
        case Vertical     { return '\xB3' }
        }
    }
    case VT100 {
        switch p {
        case TopLeft      { return 'l' }
        case TopCenter    { return 'w' }
        case TopRight     { return 'k' }
        case CenterLeft   { return 't' }
        case Center       { return 'n' }
        case CenterRight  { return 'u' }
        case BottomLeft   { return 'm' }
        case BottomCenter { return 'v' }
        case BottomRight  { return 'j' }
        case Horizontal   { return 'q' }
        case Vertical     { return 'x' }
        }
    }
    case ASCII {
        switch p {
        case Horizontal { return '-' }
        case Vertical   { return '|' }
        else            { return '+' }
        }
    }
    }
    return '+'
}

// Shift to / from the VT100 drawing set (SO/SI); empty for the other
// types. Wrap a whole run of drawing characters in one pair.
func startDrawing(): string {
    if terminal.type == VT100 { return "\x0E" }
    return ""
}

func stopDrawing(): string {
    if terminal.type == VT100 { return "\x0F" }
    return ""
}

// A horizontal rule segment, bare -- meant for inside a
// startDrawing/stopDrawing pair (see termio.cla's sendDrawing).
func hbar(width: int): string {
    var out: string = ""
    var h: char = boxChar(Horizontal)
    var i: int = 0
    while i < width {
        out = out + h
        i = i + 1
    }
    return out
}

// A self-contained vertical bar for data rows, where normal text sits
// between bars: on VT100 it carries its own SO/SI.
func vbar(): string {
    return startDrawing() + boxChar(Vertical) + stopDrawing()
}

// A full horizontal rule for a table: `l`, joints of `m` between
// columns, `r`. Widths are content widths; each column adds the two
// padding spaces rowLine uses. Bare drawing chars -- send with
// sendDrawing.
func ruleLine(l: BoxPiece, m: BoxPiece, r: BoxPiece, widths: list of int): string {
    var out: string = ""
    var i: int = 0
    out = out + boxChar(l)
    while i < widths.count {
        if i > 0 { out = out + boxChar(m) }
        out = out + hbar(widths[i] + 2)
        i = i + 1
    }
    return out + boxChar(r)
}

// The one-column content width that spans the same total width as the
// given columns (for title bars): sum + 3*(n-1).
func spanWidth(widths: list of int): int {
    var total: int = 0
    var i: int = 0
    while i < widths.count {
        total = total + widths[i]
        i = i + 1
    }
    return total + 3 * (widths.count - 1)
}

// A table data row: cells padded to their content widths, one space of
// padding each side, vbar-separated. Self-contained (vbar carries its
// own SO/SI) -- send as-is.
func rowLine(cells: list of string, widths: list of int): string {
    var out: string = ""
    var i: int = 0
    while i < widths.count {
        out = out + vbar() + " " + pad(clip(cells[i], widths[i]), widths[i]) + " "
        i = i + 1
    }
    return out + vbar()
}

// Shorten s to `width` for display: an over-long value ends in
// "..." so a caller can tell it was cut (three ASCII dots -- the
// MacRoman ellipsis has no ASCII/CP437/PETSCII form). Under four
// columns there is no room for the dots, so it is a hard cut. Display
// only: record fields (loginlog) use pad, which cuts silently.
func clip(s: string, width: int): string {
    if width <= 0 { return "" }
    if s.length <= width { return s }
    if width < 4 { return s[0, width] }
    return s[0, width - 3] + "..."
}

// Left-align s in a field of `width` spaces, truncating if longer.
func pad(s: string, width: int): string {
    var out: string = s
    if width <= 0 { return "" }
    if s.length >= width { return s[0, width] }
    while out.length < width {
        out = out + " "
    }
    return out
}

// Word-wrap `body` into lines no wider than `width`: breaks on
// spaces, hard-breaks words longer than a line, keeps CR line breaks
// (blank lines included), drops LFs (CRLF input works).
func wrapText(body: text, width: int, lines: list of string) {
    var line: string = ""
    var word: string = ""
    var i: int = 0
    var c: char
    var joined: string
    lines.clear()
    if width < 1 { return }
    while i < body.length {
        c = body[i]
        i = i + 1
        if c == '\x0A' { continue }
        if c == '\x0D' or c == ' ' {
            // flush the pending word onto the line
            if word != "" {
                if line == "" {
                    joined = word
                } else {
                    joined = line + " " + word
                }
                if joined.length <= width {
                    line = joined
                } else {
                    lines.add(line)
                    line = word
                }
                word = ""
            }
            if c == '\x0D' {
                lines.add(line)
                line = ""
            }
        } else {
            word = word + c
            if word.length == width {
                // a full-width word gets a line of its own
                if line != "" {
                    lines.add(line)
                    line = ""
                }
                lines.add(word)
                word = ""
            }
        }
    }
    if word != "" {
        if line == "" {
            joined = word
        } else {
            joined = line + " " + word
        }
        if joined.length <= width {
            line = joined
        } else {
            lines.add(line)
            line = word
        }
    }
    if line != "" { lines.add(line) }
}

// Right-align s in a field of `width` spaces, truncating if longer.
func padLeft(s: string, width: int): string {
    var out: string = s
    if width <= 0 { return "" }
    if s.length >= width { return s[0, width] }
    while out.length < width {
        out = " " + out
    }
    return out
}

// Center s in a field of `width` spaces (odd leftover space goes
// right), truncating if longer.
func center(s: string, width: int): string {
    var out: string = ""
    var left: int = (width - s.length) / 2
    var i: int = 0
    if width <= 0 { return "" }
    if s.length >= width { return clip(s, width) }
    while i < left {
        out = out + " "
        i = i + 1
    }
    return pad(out + s, width)
}
