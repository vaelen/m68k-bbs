// File-based B-tree, vDB v2 on-disk format (docs/vdb-clarus.md).
// Keys and values are int (i32, big-endian on disk). Standalone and
// reusable: includes nothing, knows nothing about vDB.
//
// The handle is the filehandle itself; there is no in-memory tree
// state. Every operation reads the header and the pages on its
// descent path and writes changes back immediately, so the file is
// always current. Close with f.close().
//
// A full multi-level tree: leaves split when their 505-byte entry
// budget overflows (separator promoted to the parent), internal nodes
// split at 63 keys (median promoted), and the root grows upward, so
// every leaf stays at the same depth. Deletion is lazy: entries are
// removed but nodes are never merged, and empty leaves stay in place
// -- rebuild the tree (vDB does this on compaction/recovery) to
// reclaim the space. Leaves form a sorted next_leaf chain for range
// scans. Overflow pages (type 4) are still reserved, so one key's
// value list must fit its leaf (~123 values).

const btPageSize: int = 512
const btLeafHeaderSize: int = 7    // page_type(1) + key_count(2) + next_leaf(4)
const btLeafBudget: int = 505     // btPageSize - btLeafHeaderSize
const btMaxInternalKeys: int = 63 // 3 + (8*63 + 4) <= 512
const btMaxDepth: int = 32        // corruption guard on descent

const btPtInternal: int = 2
const btPtLeaf: int = 3
const btPtOverflow: int = 4

// --- Page construction helpers ---------------------------------------

func btZeroFill(t: text) {
    while t.length < btPageSize {
        t.append(char(0))
    }
}

func btAppendInt(t: text, v: int) {
    var p: int = t.length
    t.append("\x00\x00\x00\x00")
    t.setIntAt(p, v)
}

func btAppendWord(t: text, v: int) {
    var p: int = t.length
    t.append("\x00\x00")
    t.setWordAt(p, v)
}

// A brand-new leaf entry: key, one value, no overflow page.
func btAppendNewEntry(t: text, key: int, value: int) {
    btAppendInt(t, key)
    btAppendWord(t, 1)
    btAppendInt(t, value)
    btAppendInt(t, 0)
}

func btMakeLeaf(entries: text, keyCount: int, nextLeaf: int): text {
    var p: text
    p.append(char(btPtLeaf))
    btAppendWord(p, keyCount)
    btAppendInt(p, nextLeaf)
    p.append(entries)
    btZeroFill(p)
    return p
}

// An internal page: child i at offset 3 + 8i, key i at 7 + 8i.
// `region` is that child0 [key child]... run (8n + 4 bytes for n keys).
func btWriteInternal(f: filehandle, pageNum: int, region: text, keyCount: int): bool {
    var pg: text
    pg.append(char(btPtInternal))
    btAppendWord(pg, keyCount)
    pg.append(region)
    btZeroFill(pg)
    return f.writeAt(pageNum * btPageSize, pg)
}

// --- Header -----------------------------------------------------------

// Reads and validates the header page; returns the root page number,
// or -1 if the file is not a v2 B-tree (or cannot be read).
func btRootPage(f: filehandle): int {
    var hdr: text
    if not f.readAt(0, btPageSize, hdr) { return -1 }
    if hdr.length < 20 { return -1 }
    if hdr[0] != 'B' or hdr[1] != 'T' or hdr[2] != 'R' or hdr[3] != 'E' { return -1 }
    if hdr.wordAt(4) != 2 { return -1 }
    return hdr.intAt(8)
}

func btSetRoot(f: filehandle, pageNum: int): bool {
    var hdr: text
    if not f.readAt(0, btPageSize, hdr) { return false }
    if hdr.length != btPageSize { return false }
    hdr.setIntAt(8, pageNum)
    return f.writeAt(0, hdr)
}

// Allocate the next page number (from the header's page_count).
// Returns -1 on I/O error.
func btAllocPage(f: filehandle): int {
    var hdr: text
    var n: int
    if not f.readAt(0, btPageSize, hdr) { return -1 }
    if hdr.length != btPageSize { return -1 }
    n = hdr.intAt(16)
    hdr.setIntAt(16, n + 1)
    if not f.writeAt(0, hdr) { return -1 }
    return n
}

// --- Open / create ----------------------------------------------------

// Create-or-truncate a B-tree file: header page + empty root leaf.
// Returns the open handle, or nil (see lastError).
func btCreate(path: string, ftype: string, fcreator: string): filehandle {
    var f: filehandle
    var hdr: text
    var leaf: text
    f = file.create(path, ftype, fcreator)
    if f == nil { return nil }
    f.setSize(0)              // a re-create of an existing file keeps its bytes on the Macintosh
    hdr.append("BTRE")
    btAppendWord(hdr, 2)      // version
    btAppendWord(hdr, 61)     // order (informational)
    btAppendInt(hdr, 1)       // root_page
    btAppendInt(hdr, 0)       // next_free_page
    btAppendInt(hdr, 2)       // page_count
    btZeroFill(hdr)
    leaf.append(char(btPtLeaf))
    btZeroFill(leaf)
    if not f.writeAt(0, hdr) {
        f.close()
        return nil
    }
    if not f.writeAt(btPageSize, leaf) {
        f.close()
        return nil
    }
    if not f.flush() {
        f.close()
        return nil
    }
    return f
}

// Open an existing B-tree file, validating magic and version.
// Returns nil if the file is missing or not a v2 B-tree.
func btOpen(path: string): filehandle {
    var f: filehandle = file.open(path)
    if f == nil { return nil }
    if btRootPage(f) < 0 {
        f.close()
        return nil
    }
    return f
}

// --- Descent ----------------------------------------------------------

// The child an internal page routes `key` to: child i holds keys
// below key i, the last child everything else.
func btChildFor(page: text, key: int): int {
    var n: int = page.wordAt(1)
    var i: int = 0
    while i < n {
        if key < page.intAt(7 + 8 * i) { return page.intAt(3 + 8 * i) }
        i = i + 1
    }
    return page.intAt(3 + 8 * n)
}

// Walk from the root to the leaf that owns `key`. Fills `path` with
// the page numbers visited (root first, leaf last) and leaves the
// leaf's content in `page`.
func btDescend(f: filehandle, key: int, path: list of int, page: text): bool {
    var p: int = btRootPage(f)
    path.clear()
    if p < 0 { return false }
    while path.count < btMaxDepth {
        if not f.readAt(p * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize { return false }
        path.add(p)
        if int(page[0]) == btPtLeaf { return true }
        if int(page[0]) != btPtInternal { return false }
        p = btChildFor(page, key)
        if p < 1 { return false }
    }
    return false
}

// Reassemble a leaf from its old header (page_type + next_leaf kept)
// and a rebuilt entries region.
func btWriteLeaf(f: filehandle, pageNum: int, oldPage: text, entries: text, keyCount: int): bool {
    var page: text
    if entries.length > btLeafBudget { return false }
    page.append(oldPage.textAt(0, btLeafHeaderSize))
    page.append(entries)
    btZeroFill(page)
    page.setWordAt(1, keyCount)
    return f.writeAt(pageNum * btPageSize, page)
}

// --- Split propagation ------------------------------------------------

// After the page at the end of `path` split, hang (sep, newPage) off
// its parent, splitting internal nodes upward as needed; a root split
// grows a new root and repoints the header.
func btInsertUp(f: filehandle, path: list of int, sep: int, newPage: int): bool {
    var page: text
    var region: text
    var leftR: text
    var rightR: text
    var rootR: text
    var level: int
    var childPage: int
    var k: int = sep
    var nc: int = newPage
    var p: int
    var n: int
    var s: int
    var i: int
    var h: int
    var k2: int
    var np: int
    childPage = path[path.count - 1]
    level = path.count - 2
    while level >= 0 {
        p = path[level]
        if not f.readAt(p * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize or int(page[0]) != btPtInternal { return false }
        n = page.wordAt(1)
        // find childPage's slot, then splice (k, nc) in after it
        s = -1
        i = 0
        while i <= n {
            if page.intAt(3 + 8 * i) == childPage {
                s = i
                break
            }
            i = i + 1
        }
        if s < 0 { return false }
        region = page.textAt(3, 8 * s + 4)
        btAppendInt(region, k)
        btAppendInt(region, nc)
        region.append(page.textAt(3 + 8 * s + 4, 8 * n + 4 - (8 * s + 4)))
        n = n + 1
        if n <= btMaxInternalKeys {
            return btWriteInternal(f, p, region, n)
        }
        // split this internal node: median key h promotes upward
        h = n / 2
        k2 = region.intAt(8 * h + 4)
        leftR = region.textAt(0, 8 * h + 4)
        rightR = region.textAt(8 * h + 8, 8 * n + 4 - (8 * h + 8))
        np = btAllocPage(f)
        if np < 0 { return false }
        if not btWriteInternal(f, np, rightR, n - h - 1) { return false }
        if not btWriteInternal(f, p, leftR, h) { return false }
        k = k2
        nc = np
        childPage = p
        level = level - 1
    }
    // the root itself split: grow a new root above it
    np = btAllocPage(f)
    if np < 0 { return false }
    btAppendInt(rootR, childPage)
    btAppendInt(rootR, k)
    btAppendInt(rootR, nc)
    if not btWriteInternal(f, np, rootR, 1) { return false }
    return btSetRoot(f, np)
}

// --- Operations -------------------------------------------------------

// Insert a key/value pair. Duplicate keys collect multiple values on
// one entry; duplicate values under a key are allowed. Fails only on
// I/O error, an invalid file, or a single entry outgrowing a page.
func btInsert(f: filehandle, key: int, value: int): bool {
    var page: text
    var out: text
    var leftE: text
    var rightE: text
    var path: list of int
    var leaf: int
    var n: int
    var off: int
    var i: int = 0
    var k: int
    var vc: int
    var esz: int
    var epos: int
    var half: int
    var cut: int
    var leftCnt: int
    var newPage: int
    var added: bool = false
    var merged: bool = false
    if not btDescend(f, key, path, page) { return false }
    leaf = path[path.count - 1]
    n = page.wordAt(1)
    off = btLeafHeaderSize
    while i < n {
        k = page.intAt(off)
        vc = page.wordAt(off + 4)
        esz = 10 + vc * 4
        if not added and not merged and key < k {
            btAppendNewEntry(out, key, value)
            added = true
        }
        if k == key {
            // copy the entry with the new value appended
            epos = out.length
            out.append(page.textAt(off, 6 + vc * 4))
            out.setWordAt(epos + 4, vc + 1)
            btAppendInt(out, value)
            out.append(page.textAt(off + 6 + vc * 4, 4))
            merged = true
        } else {
            out.append(page.textAt(off, esz))
        }
        off = off + esz
        i = i + 1
    }
    if not added and not merged {
        btAppendNewEntry(out, key, value)
        added = true
    }
    if added { n = n + 1 }
    if out.length <= btLeafBudget {
        return btWriteLeaf(f, leaf, page, out, n)
    }
    // split the leaf near the byte midpoint (entries vary in size),
    // keeping at least one entry on each side
    if n < 2 { return false }    // one entry over a page: needs overflow pages
    half = out.length / 2
    cut = 0
    leftCnt = 0
    while leftCnt < n - 1 and (leftCnt == 0 or cut < half) {
        vc = out.wordAt(cut + 4)
        cut = cut + 10 + vc * 4
        leftCnt = leftCnt + 1
    }
    leftE = out.textAt(0, cut)
    rightE = out.textAt(cut, out.length - cut)
    if leftE.length > btLeafBudget or rightE.length > btLeafBudget { return false }
    newPage = btAllocPage(f)
    if newPage < 0 { return false }
    if not f.writeAt(newPage * btPageSize, btMakeLeaf(rightE, n - leftCnt, page.intAt(3))) {
        return false
    }
    if not f.writeAt(leaf * btPageSize, btMakeLeaf(leftE, leftCnt, newPage)) {
        return false
    }
    return btInsertUp(f, path, rightE.intAt(0), newPage)
}

// Find all values for a key; fills `values` (cleared first).
// Returns true if the key exists.
func btFind(f: filehandle, key: int, values: list of int): bool {
    var page: text
    var path: list of int
    var n: int
    var off: int
    var i: int = 0
    var k: int
    var vc: int
    var j: int
    values.clear()
    if not btDescend(f, key, path, page) { return false }
    n = page.wordAt(1)
    off = btLeafHeaderSize
    while i < n {
        k = page.intAt(off)
        vc = page.wordAt(off + 4)
        if k == key {
            j = 0
            while j < vc {
                values.add(page.intAt(off + 6 + j * 4))
                j = j + 1
            }
            return true
        }
        if k > key { return false }    // entries are sorted
        off = off + 10 + vc * 4
        i = i + 1
    }
    return false
}

// Shared removal walk (lazy: no merging, an emptied leaf stays).
// valueOnly: remove the first occurrence of `value` under `key`
// (dropping the entry if it was the last value); otherwise remove the
// whole entry. Returns false if nothing matched.
func btRemove(f: filehandle, key: int, value: int, valueOnly: bool): bool {
    var page: text
    var out: text
    var path: list of int
    var leaf: int
    var n: int
    var off: int
    var i: int = 0
    var k: int
    var vc: int
    var esz: int
    var j: int
    var hit: int
    var drops: int = 0
    var found: bool = false
    if not btDescend(f, key, path, page) { return false }
    leaf = path[path.count - 1]
    n = page.wordAt(1)
    off = btLeafHeaderSize
    while i < n {
        k = page.intAt(off)
        vc = page.wordAt(off + 4)
        esz = 10 + vc * 4
        if k != key {
            out.append(page.textAt(off, esz))
        } else {
            if not valueOnly {
                found = true
                drops = drops + 1
            } else {
                hit = -1
                j = 0
                while j < vc {
                    if hit < 0 and page.intAt(off + 6 + j * 4) == value { hit = j }
                    j = j + 1
                }
                if hit < 0 {
                    out.append(page.textAt(off, esz))
                } else {
                    found = true
                    if vc == 1 {
                        drops = drops + 1
                    } else {
                        btAppendInt(out, k)
                        btAppendWord(out, vc - 1)
                        j = 0
                        while j < vc {
                            if j != hit { btAppendInt(out, page.intAt(off + 6 + j * 4)) }
                            j = j + 1
                        }
                        out.append(page.textAt(off + 6 + vc * 4, 4))
                    }
                }
            }
        }
        off = off + esz
        i = i + 1
    }
    if not found { return false }
    return btWriteLeaf(f, leaf, page, out, n - drops)
}

// Delete a key and all its values.
func btDelete(f: filehandle, key: int): bool {
    return btRemove(f, key, 0, false)
}

// Delete one key/value pair (the first occurrence of value).
func btDeleteValue(f: filehandle, key: int, value: int): bool {
    return btRemove(f, key, value, true)
}

// --- Keys -------------------------------------------------------------

// Case-insensitive string key: CRC-16/KERMIT of the lowercased bytes
// (ASCII A-Z only; high MacRoman bytes pass through unchanged).
// Collisions are possible -- callers verify the field after lookup.
func stringKey(s: string): int {
    var t: text
    var i: int = 0
    var c: char
    while i < s.length {
        c = s[i]
        if c >= 'A' and c <= 'Z' { c = char(int(c) + 32) }
        t.append(c)
        i = i + 1
    }
    return t.crc16(0, 0, t.length)
}
