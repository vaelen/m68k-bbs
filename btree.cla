// File-based B-tree, vDB v2 on-disk format (docs/vdb-clarus.md).
// Keys and values are int (i32, big-endian on disk). Standalone and
// reusable: includes nothing, knows nothing about vDB.
//
// The handle is the filehandle itself; there is no in-memory tree
// state. Every operation reads the header and the pages on its
// descent path and writes changes back immediately, so the file is
// always current. Close with f.close().
//
// A full multi-level tree: leaves split when their 505-byte entry
// budget overflows (separator promoted to the parent), internal nodes
// split at 63 keys (median promoted), and the root grows upward, so
// every leaf stays at the same depth. Deletion is lazy: entries are
// removed but nodes are never merged, and empty leaves stay in place
// -- rebuild the tree (vDB does this on compaction/recovery) to
// reclaim the space. Leaves form a sorted next_leaf chain for range
// scans. A key's first btMaxInline values live inline in its leaf
// entry; the rest chain through type-4 overflow pages, so a key holds
// unboundedly many values. Whole-key deletion leaks the chain until
// the tree is rebuilt (the same lazy model as emptied leaves).

const btPageSize: int = 512
const btLeafHeaderSize: int = 7    // page_type(1) + key_count(2) + next_leaf(4)
const btLeafBudget: int = 505     // btPageSize - btLeafHeaderSize
const btMaxInternalKeys: int = 63 // 3 + (8*63 + 4) <= 512
const btMaxDepth: int = 32        // corruption guard on descent

const btPtInternal: int = 2
const btPtLeaf: int = 3
const btPtOverflow: int = 4

// A leaf entry keeps at most this many values inline; further values
// spill into the overflow chain. Small enough that an entry stays well
// under the leaf budget so leaves hold several keys; legacy entries
// written before overflow existed may hold more inline and are read
// fine -- only new values ever spill.
const btMaxInline: int = 32
const btOverflowCap: int = 126     // (btPageSize - 7) / 4 values per overflow page
const btOverflowHeader: int = 7    // page_type(1) + value_count(2) + next(4)

// --- Page construction helpers ---------------------------------------

// Zero padding in slices of one prebuilt block: on the 68k a one-byte
// append costs ~0.3 ms, so padding a page byte by byte cost up to
// ~150 ms per page write (bench app, 2026-09-28).
var btZeroBlock: text

func btPadTo(t: text, size: int) {
    var n: int
    if btZeroBlock.length == 0 {
        while btZeroBlock.length < btPageSize { btZeroBlock.append(char(0)) }
    }
    while t.length < size {
        n = size - t.length
        if n > btZeroBlock.length { n = btZeroBlock.length }
        t.append(btZeroBlock.textAt(0, n))
    }
}

func btZeroFill(t: text) {
    btPadTo(t, btPageSize)
}

func btAppendInt(t: text, v: int) {
    var p: int = t.length
    t.append("\x00\x00\x00\x00")
    t.setIntAt(p, v)
}

func btAppendWord(t: text, v: int) {
    var p: int = t.length
    t.append("\x00\x00")
    t.setWordAt(p, v)
}

// A brand-new leaf entry: key, one value, no overflow page.
func btAppendNewEntry(t: text, key: int, value: int) {
    btAppendInt(t, key)
    btAppendWord(t, 1)
    btAppendInt(t, value)
    btAppendInt(t, 0)
}

func btMakeLeaf(entries: text, keyCount: int, nextLeaf: int): text {
    var p: text
    p.append(char(btPtLeaf))
    btAppendWord(p, keyCount)
    btAppendInt(p, nextLeaf)
    p.append(entries)
    btZeroFill(p)
    return p
}

// An internal page: child i at offset 3 + 8i, key i at 7 + 8i.
// `region` is that child0 [key child]... run (8n + 4 bytes for n keys).
func btWriteInternal(f: filehandle, pageNum: int, region: text, keyCount: int): bool {
    var pg: text
    pg.append(char(btPtInternal))
    btAppendWord(pg, keyCount)
    pg.append(region)
    btZeroFill(pg)
    return f.writeAt(pageNum * btPageSize, pg)
}

// --- Header -----------------------------------------------------------

// Reads and validates the header page; returns the root page number,
// or -1 if the file is not a v2 B-tree (or cannot be read).
func btRootPage(f: filehandle): int {
    var hdr: text
    if not f.readAt(0, btPageSize, hdr) { return -1 }
    if hdr.length < 20 { return -1 }
    if hdr[0] != 'B' or hdr[1] != 'T' or hdr[2] != 'R' or hdr[3] != 'E' { return -1 }
    if hdr.wordAt(4) != 2 { return -1 }
    return hdr.intAt(8)
}

func btSetRoot(f: filehandle, pageNum: int): bool {
    var hdr: text
    if not f.readAt(0, btPageSize, hdr) { return false }
    if hdr.length != btPageSize { return false }
    hdr.setIntAt(8, pageNum)
    return f.writeAt(0, hdr)
}

// Allocate the next page number (from the header's page_count).
// Returns -1 on I/O error.
func btAllocPage(f: filehandle): int {
    var hdr: text
    var n: int
    if not f.readAt(0, btPageSize, hdr) { return -1 }
    if hdr.length != btPageSize { return -1 }
    n = hdr.intAt(16)
    hdr.setIntAt(16, n + 1)
    if not f.writeAt(0, hdr) { return -1 }
    return n
}

// --- Open / create ----------------------------------------------------

// Create-or-truncate a B-tree file: header page + empty root leaf.
// Returns the open handle, or nil (see lastError).
func btCreate(path: string, ftype: string, fcreator: string): filehandle {
    var f: filehandle
    var hdr: text
    var leaf: text
    f = file.create(path, ftype, fcreator)
    if f == nil { return nil }
    f.setSize(0)              // a re-create of an existing file keeps its bytes on the Macintosh
    hdr.append("BTRE")
    btAppendWord(hdr, 2)      // version
    btAppendWord(hdr, 61)     // order (informational)
    btAppendInt(hdr, 1)       // root_page
    btAppendInt(hdr, 0)       // next_free_page
    btAppendInt(hdr, 2)       // page_count
    btZeroFill(hdr)
    leaf.append(char(btPtLeaf))
    btZeroFill(leaf)
    if not f.writeAt(0, hdr) {
        f.close()
        return nil
    }
    if not f.writeAt(btPageSize, leaf) {
        f.close()
        return nil
    }
    if not f.flush() {
        f.close()
        return nil
    }
    return f
}

// Open an existing B-tree file, validating magic and version.
// Returns nil if the file is missing or not a v2 B-tree.
func btOpen(path: string): filehandle {
    var f: filehandle = file.open(path)
    if f == nil { return nil }
    if btRootPage(f) < 0 {
        f.close()
        return nil
    }
    return f
}

// --- Descent ----------------------------------------------------------

// The child an internal page routes `key` to: child i holds keys
// below key i, the last child everything else.
func btChildFor(page: text, key: int): int {
    var n: int = page.wordAt(1)
    var i: int = 0
    while i < n {
        if key < page.intAt(7 + 8 * i) { return page.intAt(3 + 8 * i) }
        i = i + 1
    }
    return page.intAt(3 + 8 * n)
}

// Walk from the root to the leaf that owns `key`. Fills `path` with
// the page numbers visited (root first, leaf last) and leaves the
// leaf's content in `page`.
func btDescend(f: filehandle, key: int, path: list of int, page: text): bool {
    return btDescendFrom(f, btRootPage(f), key, path, page)
}

// btDescend from a root page the caller already knows -- a batch of
// deletes reads it once (deletes never move the root: no merges).
func btDescendFrom(f: filehandle, root: int, key: int, path: list of int, page: text): bool {
    var p: int = root
    path.clear()
    if p < 0 { return false }
    while path.count < btMaxDepth {
        if not f.readAt(p * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize { return false }
        path.add(p)
        if int(page[0]) == btPtLeaf { return true }
        if int(page[0]) != btPtInternal { return false }
        p = btChildFor(page, key)
        if p < 1 { return false }
    }
    return false
}

// Reassemble a leaf from its old header (page_type + next_leaf kept)
// and a rebuilt entries region.
func btWriteLeaf(f: filehandle, pageNum: int, oldPage: text, entries: text, keyCount: int): bool {
    var page: text
    if entries.length > btLeafBudget { return false }
    page.append(oldPage.textAt(0, btLeafHeaderSize))
    page.append(entries)
    btZeroFill(page)
    page.setWordAt(1, keyCount)
    return f.writeAt(pageNum * btPageSize, page)
}

// --- Split propagation ------------------------------------------------

// After the page at the end of `path` split, hang (sep, newPage) off
// its parent, splitting internal nodes upward as needed; a root split
// grows a new root and repoints the header.
func btInsertUp(f: filehandle, path: list of int, sep: int, newPage: int): bool {
    var page: text
    var region: text
    var leftR: text
    var rightR: text
    var rootR: text
    var level: int
    var childPage: int
    var k: int = sep
    var nc: int = newPage
    var p: int
    var n: int
    var s: int
    var i: int
    var h: int
    var k2: int
    var np: int
    childPage = path[path.count - 1]
    level = path.count - 2
    while level >= 0 {
        p = path[level]
        if not f.readAt(p * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize or int(page[0]) != btPtInternal { return false }
        n = page.wordAt(1)
        // find childPage's slot, then splice (k, nc) in after it
        s = -1
        i = 0
        while i <= n {
            if page.intAt(3 + 8 * i) == childPage {
                s = i
                break
            }
            i = i + 1
        }
        if s < 0 { return false }
        region = page.textAt(3, 8 * s + 4)
        btAppendInt(region, k)
        btAppendInt(region, nc)
        region.append(page.textAt(3 + 8 * s + 4, 8 * n + 4 - (8 * s + 4)))
        n = n + 1
        if n <= btMaxInternalKeys {
            return btWriteInternal(f, p, region, n)
        }
        // split this internal node: median key h promotes upward
        h = n / 2
        k2 = region.intAt(8 * h + 4)
        leftR = region.textAt(0, 8 * h + 4)
        rightR = region.textAt(8 * h + 8, 8 * n + 4 - (8 * h + 8))
        np = btAllocPage(f)
        if np < 0 { return false }
        if not btWriteInternal(f, np, rightR, n - h - 1) { return false }
        if not btWriteInternal(f, p, leftR, h) { return false }
        k = k2
        nc = np
        childPage = p
        level = level - 1
    }
    // the root itself split: grow a new root above it
    np = btAllocPage(f)
    if np < 0 { return false }
    btAppendInt(rootR, childPage)
    btAppendInt(rootR, k)
    btAppendInt(rootR, nc)
    if not btWriteInternal(f, np, rootR, 1) { return false }
    return btSetRoot(f, np)
}

// --- Overflow chain --------------------------------------------------
// A type-4 page: page_type(1) + value_count(2, u16) + next(4, i32) +
// packed i32 values. A key's spilled values live in a singly linked
// chain of these, hung off the leaf entry's trailing overflow pointer.

// Append `value` to the chain whose head is `head` (0 = none). Returns
// the head to store in the entry -- a new page number only when `head`
// was 0, otherwise `head` unchanged -- or -1 on error. ponytail: walks
// to the tail each call, O(chain) per append; realistic chains are a
// few pages, rebuild if a key ever holds tens of thousands of values.
func btOverflowAppend(f: filehandle, head: int, value: int): int {
    var page: text
    var fresh: text
    var pnum: int
    var next: int
    var vc: int
    var newp: int
    var guard: int = 0
    if head == 0 {
        newp = btAllocPage(f)
        if newp < 0 { return 0 - 1 }
        fresh.append(char(btPtOverflow))
        btAppendWord(fresh, 1)
        btAppendInt(fresh, 0)
        btAppendInt(fresh, value)
        btZeroFill(fresh)
        if not f.writeAt(newp * btPageSize, fresh) { return 0 - 1 }
        return newp
    }
    pnum = head
    while guard < 1000000 {
        if not f.readAt(pnum * btPageSize, btPageSize, page) { return 0 - 1 }
        if page.length != btPageSize or int(page[0]) != btPtOverflow { return 0 - 1 }
        next = page.intAt(3)
        if next == 0 {
            vc = page.wordAt(1)
            if vc < btOverflowCap {
                page.setWordAt(1, vc + 1)
                page.setIntAt(btOverflowHeader + vc * 4, value)
                if not f.writeAt(pnum * btPageSize, page) { return 0 - 1 }
                return head
            }
            newp = btAllocPage(f)
            if newp < 0 { return 0 - 1 }
            page.setIntAt(3, newp)
            if not f.writeAt(pnum * btPageSize, page) { return 0 - 1 }
            fresh.append(char(btPtOverflow))
            btAppendWord(fresh, 1)
            btAppendInt(fresh, 0)
            btAppendInt(fresh, value)
            btZeroFill(fresh)
            if not f.writeAt(newp * btPageSize, fresh) { return 0 - 1 }
            return head
        }
        pnum = next
        guard = guard + 1
    }
    return 0 - 1
}

// Append every value in the chain at `head` to `values`.
func btOverflowValues(f: filehandle, head: int, values: list of int): bool {
    var page: text
    var pnum: int = head
    var vc: int
    var j: int
    var guard: int = 0
    while pnum != 0 and guard < 1000000 {
        if not f.readAt(pnum * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize or int(page[0]) != btPtOverflow { return false }
        vc = page.wordAt(1)
        j = 0
        while j < vc {
            values.add(page.intAt(btOverflowHeader + j * 4))
            j = j + 1
        }
        pnum = page.intAt(3)
        guard = guard + 1
    }
    return true
}

// Remove the first occurrence of `value` from the chain at `head`;
// true if it was there. Leaves an emptied page linked (lazy).
func btOverflowRemoveFirst(f: filehandle, head: int, value: int): bool {
    var page: text
    var pnum: int = head
    var vc: int
    var j: int
    var hit: int
    var guard: int = 0
    while pnum != 0 and guard < 1000000 {
        if not f.readAt(pnum * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize or int(page[0]) != btPtOverflow { return false }
        vc = page.wordAt(1)
        hit = 0 - 1
        j = 0
        while j < vc {
            if hit < 0 and page.intAt(btOverflowHeader + j * 4) == value { hit = j }
            j = j + 1
        }
        if hit >= 0 {
            j = hit
            while j < vc - 1 {
                page.setIntAt(btOverflowHeader + j * 4, page.intAt(btOverflowHeader + (j + 1) * 4))
                j = j + 1
            }
            page.setWordAt(1, vc - 1)
            return f.writeAt(pnum * btPageSize, page)
        }
        pnum = page.intAt(3)
        guard = guard + 1
    }
    return false
}

// --- Operations -------------------------------------------------------

// Insert a key/value pair. Duplicate keys collect multiple values on
// one entry; duplicate values under a key are allowed. Fails only on
// I/O error, an invalid file, or a single entry outgrowing a page.
func btInsert(f: filehandle, key: int, value: int): bool {
    var page: text
    var out: text
    var leftE: text
    var rightE: text
    var path: list of int
    var leaf: int
    var n: int
    var off: int
    var i: int = 0
    var k: int
    var vc: int
    var esz: int
    var epos: int
    var half: int
    var cut: int
    var leftCnt: int
    var newPage: int
    var ovf: int
    var newOvf: int
    var added: bool = false
    var merged: bool = false
    var at: int
    var endOff: int
    if not btDescend(f, key, path, page) { return false }
    leaf = path[path.count - 1]
    n = page.wordAt(1)
    // Find where `key` goes (its entry, or the first larger key) and
    // where the entries end, reading fields only; then the new entry
    // region is three slices -- before, the changed entry, after --
    // instead of one text copy per entry (~290 ms a leaf on the 68k).
    off = btLeafHeaderSize
    at = 0 - 1
    while i < n {
        k = page.intAt(off)
        vc = page.wordAt(off + 4)
        if at < 0 and k >= key {
            at = off
            merged = k == key
        }
        off = off + 10 + vc * 4
        i = i + 1
    }
    endOff = off
    if at < 0 { at = endOff }
    if at > btLeafHeaderSize { out.append(page.textAt(btLeafHeaderSize, at - btLeafHeaderSize)) }
    if merged {
        vc = page.wordAt(at + 4)
        esz = 10 + vc * 4
        ovf = page.intAt(at + 6 + vc * 4)
        if vc < btMaxInline and ovf == 0 {
            // room inline: copy the entry with the value appended
            epos = out.length
            out.append(page.textAt(at, 6 + vc * 4))
            out.setWordAt(epos + 4, vc + 1)
            btAppendInt(out, value)
            btAppendInt(out, ovf)
        } else {
            // inline full (or a chain already exists): spill to overflow
            newOvf = btOverflowAppend(f, ovf, value)
            if newOvf < 0 { return false }
            if newOvf == ovf { return true }    // chain grew; the leaf is unchanged
            epos = out.length
            out.append(page.textAt(at, esz))
            out.setIntAt(epos + 6 + vc * 4, newOvf)
        }
        at = at + esz
    } else {
        btAppendNewEntry(out, key, value)
        added = true
    }
    if endOff > at { out.append(page.textAt(at, endOff - at)) }
    if added { n = n + 1 }
    if out.length <= btLeafBudget {
        return btWriteLeaf(f, leaf, page, out, n)
    }
    // split the leaf near the byte midpoint (entries vary in size),
    // keeping at least one entry on each side
    if n < 2 { return false }    // one entry over a page: needs overflow pages
    half = out.length / 2
    cut = 0
    leftCnt = 0
    while leftCnt < n - 1 and (leftCnt == 0 or cut < half) {
        vc = out.wordAt(cut + 4)
        cut = cut + 10 + vc * 4
        leftCnt = leftCnt + 1
    }
    leftE = out.textAt(0, cut)
    rightE = out.textAt(cut, out.length - cut)
    if leftE.length > btLeafBudget or rightE.length > btLeafBudget { return false }
    newPage = btAllocPage(f)
    if newPage < 0 { return false }
    if not f.writeAt(newPage * btPageSize, btMakeLeaf(rightE, n - leftCnt, page.intAt(3))) {
        return false
    }
    if not f.writeAt(leaf * btPageSize, btMakeLeaf(leftE, leftCnt, newPage)) {
        return false
    }
    return btInsertUp(f, path, rightE.intAt(0), newPage)
}

// Find all values for a key; fills `values` (cleared first).
// Returns true if the key exists.
func btFind(f: filehandle, key: int, values: list of int): bool {
    return btFindFrom(f, btRootPage(f), key, values)
}

func btFindFrom(f: filehandle, root: int, key: int, values: list of int): bool {
    var page: text
    var path: list of int
    var n: int
    var off: int
    var i: int = 0
    var k: int
    var vc: int
    var j: int
    values.clear()
    if not btDescendFrom(f, root, key, path, page) { return false }
    n = page.wordAt(1)
    off = btLeafHeaderSize
    while i < n {
        k = page.intAt(off)
        vc = page.wordAt(off + 4)
        if k == key {
            j = 0
            while j < vc {
                values.add(page.intAt(off + 6 + j * 4))
                j = j + 1
            }
            if page.intAt(off + 6 + vc * 4) != 0 {
                if not btOverflowValues(f, page.intAt(off + 6 + vc * 4), values) { return false }
            }
            return true
        }
        if k > key { return false }    // entries are sorted
        off = off + 10 + vc * 4
        i = i + 1
    }
    return false
}

// --- Scan cursors -----------------------------------------------------
// A transient, caller-owned cursor over the tree in key order, either
// direction. The blob layout is private: state(1) dir(1) entry_index(2)
// leaf_page(4) key(4) value(4) depth(2) path page numbers
// (btMaxDepth * 4), then a snapshot of the current leaf page.
// Descending walks re-read path pages to find the previous leaf (the
// leaf chain is forward-only), so the tree MUST NOT be written while a
// scan is live -- create, drain and drop the cursor inside one event
// handler; mutators collect keys first, then act.

const btScanHdrSize: int = 146     // 18 + btMaxDepth * 4
const btScanFresh: int = 0
const btScanRun: int = 1
const btScanDone: int = 2

// Empty a text in place (a text parameter cannot be rebound).
// ponytail: thin wrapper kept for its call sites; new code can call
// t.clear() directly.
func btTextReset(t: text) {
    t.clear()
}

func btScanKey(cur: text): int {
    return cur.intAt(8)
}

func btScanValue(cur: text): int {
    return cur.intAt(12)
}

// All values of the current entry, read from the cursor's leaf
// snapshot -- no descent from the root (what a btFind per key costs);
// only an entry past btMaxInline values reads its overflow chain.
func btScanValues(f: filehandle, cur: text, values: list of int): bool {
    var off: int = btScanEntryOff(cur, cur.wordAt(2))
    var vc: int = cur.wordAt(off + 4)
    var j: int = 0
    values.clear()
    while j < vc {
        values.add(cur.intAt(off + 6 + j * 4))
        j = j + 1
    }
    if cur.intAt(off + 6 + vc * 4) != 0 {
        return btOverflowValues(f, cur.intAt(off + 6 + vc * 4), values)
    }
    return true
}

// Byte offset (within the blob) of leaf entry `idx`.
func btScanEntryOff(cur: text, idx: int): int {
    var off: int = btScanHdrSize + btLeafHeaderSize
    var i: int = 0
    while i < idx {
        off = off + 10 + cur.wordAt(off + 4) * 4
        i = i + 1
    }
    return off
}

// Make entry `idx` of the snapshot current.
func btScanLoad(cur: text, idx: int) {
    var off: int = btScanEntryOff(cur, idx)
    cur.setWordAt(2, idx)
    cur.setIntAt(8, cur.intAt(off))
    cur.setIntAt(12, cur.intAt(off + 6))
}

// Replace the leaf snapshot (page `pageNum`, content `page`).
func btScanSetLeaf(cur: text, pageNum: int, page: text) {
    var head: text
    head.append(cur.textAt(0, btScanHdrSize))
    btTextReset(cur)
    cur.append(head)
    cur.append(page)
    cur.setIntAt(4, pageNum)
}

// Ascending: follow the next_leaf chain to the next non-empty leaf.
// (The path is not maintained -- ascending never reads it.)
func btScanNextLeaf(f: filehandle, cur: text): bool {
    var page: text
    var next: int = cur.intAt(btScanHdrSize + 3)
    while next != 0 {
        if not f.readAt(next * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize { return false }
        btScanSetLeaf(cur, next, page)
        if cur.wordAt(btScanHdrSize + 1) > 0 { return true }
        next = cur.intAt(btScanHdrSize + 3)
    }
    return false
}

// Descending: the previous leaf in tree order, via the path -- find
// this child in its parent, take the one before it (recursing up at a
// first child), then ride the rightmost spine back down to a leaf.
// May land on an empty leaf; the caller loops.
func btScanPrevLeaf(f: filehandle, cur: text): bool {
    var page: text
    var level: int = cur.wordAt(16) - 2
    var child: int
    var idx: int
    var n: int
    var i: int
    while level >= 0 {
        if not f.readAt(cur.intAt(18 + level * 4) * btPageSize, btPageSize, page) { return false }
        if page.length != btPageSize { return false }
        child = cur.intAt(18 + (level + 1) * 4)
        n = page.wordAt(1)
        idx = 0 - 1
        i = 0
        while i <= n {
            if page.intAt(3 + 8 * i) == child {
                idx = i
                i = n + 1
            }
            i = i + 1
        }
        if idx > 0 {
            child = page.intAt(3 + 8 * (idx - 1))
            level = level + 1
            while level < btMaxDepth {
                if not f.readAt(child * btPageSize, btPageSize, page) { return false }
                if page.length != btPageSize { return false }
                cur.setIntAt(18 + level * 4, child)
                if int(page[0]) == btPtLeaf {
                    cur.setWordAt(16, level + 1)
                    btScanSetLeaf(cur, child, page)
                    return true
                }
                if int(page[0]) != btPtInternal { return false }
                child = page.intAt(3 + 8 * page.wordAt(1))
                level = level + 1
            }
            return false
        }
        level = level - 1
    }
    return false
}

// Move to the adjacent leaf in scan direction and make its first
// (asc) or last (desc) entry current. Marks the cursor done at the
// end; otherwise the state byte is left for the caller to set.
func btScanStep(f: filehandle, cur: text): bool {
    var ok: bool
    if int(cur[1]) == 1 {
        ok = btScanPrevLeaf(f, cur)
        while ok and cur.wordAt(btScanHdrSize + 1) == 0 {
            ok = btScanPrevLeaf(f, cur)
        }
        if ok { btScanLoad(cur, cur.wordAt(btScanHdrSize + 1) - 1) }
    } else {
        ok = btScanNextLeaf(f, cur)
        if ok { btScanLoad(cur, 0) }
    }
    if not ok { cur[0] = char(btScanDone) }
    return ok
}

// Seed a scan at fromKey: the smallest key >= fromKey (ascending) or
// the largest <= fromKey (descending). True when an entry is current.
func btScanStart(f: filehandle, cur: text, fromKey: int, descending: bool): bool {
    var path: list of int
    var page: text
    var n: int
    var i: int
    var off: int
    var k: int
    var found: int = 0 - 1
    btTextReset(cur)
    btPadTo(cur, btScanHdrSize)
    cur[0] = char(btScanDone)
    if not btDescend(f, fromKey, path, page) { return false }
    if descending { cur[1] = char(1) }
    cur.setWordAt(16, path.count)
    i = 0
    while i < path.count {
        cur.setIntAt(18 + i * 4, path[i])
        i = i + 1
    }
    cur.append(page)
    cur.setIntAt(4, path[path.count - 1])
    n = cur.wordAt(btScanHdrSize + 1)
    off = btScanHdrSize + btLeafHeaderSize
    i = 0
    while i < n {
        k = cur.intAt(off)
        if descending {
            if k <= fromKey { found = i }
        } else {
            if found < 0 and k >= fromKey { found = i }
        }
        off = off + 10 + cur.wordAt(off + 4) * 4
        i = i + 1
    }
    if found >= 0 {
        btScanLoad(cur, found)
        cur[0] = char(btScanFresh)
        return true
    }
    if not btScanStep(f, cur) { return false }
    cur[0] = char(btScanFresh)
    return true
}

// Advance one entry; the first call after btScanStart returns the
// seeded entry itself. False (sticky) when the scan is exhausted.
func btScanNext(f: filehandle, cur: text): bool {
    var idx: int
    if cur.length < btScanHdrSize or int(cur[0]) == btScanDone { return false }
    if int(cur[0]) == btScanFresh {
        cur[0] = char(btScanRun)
        return true
    }
    idx = cur.wordAt(2)
    if int(cur[1]) == 1 {
        if idx > 0 {
            btScanLoad(cur, idx - 1)
            return true
        }
    } else {
        if idx + 1 < cur.wordAt(btScanHdrSize + 1) {
            btScanLoad(cur, idx + 1)
            return true
        }
    }
    return btScanStep(f, cur)
}

// Shared removal walk (lazy: no merging, an emptied leaf stays).
// valueOnly: remove the first occurrence of `value` under `key`
// (dropping the entry if it was the last value); otherwise remove the
// whole entry. Returns false if nothing matched.
func btRemove(f: filehandle, key: int, value: int, valueOnly: bool): bool {
    return btRemoveFrom(f, btRootPage(f), key, value, valueOnly)
}

func btRemoveFrom(f: filehandle, root: int, key: int, value: int, valueOnly: bool): bool {
    var page: text
    var ent: text
    var path: list of int
    var n: int
    var r: int
    if not btDescendFrom(f, root, key, path, page) { return false }
    n = page.wordAt(1)
    btLeafEntries(page, ent)
    r = btEntryRemove(f, ent, n, key, value, valueOnly)
    if r < 0 { return false }
    if r == 0 { return true }               // removed from the overflow chain; leaf unchanged
    if r == 2 { n = n - 1 }
    return btWriteLeaf(f, path[path.count - 1], page, ent, n)
}

// A leaf's packed entries region (everything after its header), into
// `ent`; returns the last entry's key (0 for an empty leaf).
func btLeafEntries(page: text, ent: text): int {
    var n: int = page.wordAt(1)
    var off: int = btLeafHeaderSize
    var i: int = 0
    var last: int = 0
    while i < n {
        last = page.intAt(off)
        off = off + 10 + page.wordAt(off + 4) * 4
        i = i + 1
    }
    ent.clear()
    if off > btLeafHeaderSize { ent.append(page.textAt(btLeafHeaderSize, off - btLeafHeaderSize)) }
    return last
}

// Remove `key` (valueOnly: just `value` under it) from a leaf's entries
// region `ent` (n entries), in place. The entry is found by reading
// fields only and the region rebuilt from three slices (before, the
// entry minus the value or nothing, after) -- one text copy per entry
// cost ~290 ms a leaf on the 68k. Every other entry is copied through
// untouched. Returns -1 not found, 0 removed from the key's overflow
// chain (region unchanged), 1 value removed (entry kept), 2 entry
// dropped.
func btEntryRemove(f: filehandle, ent: text, n: int, key: int, value: int, valueOnly: bool): int {
    var out: text
    var off: int = 0
    var i: int = 0
    var at: int = 0 - 1
    var vc: int
    var esz: int
    var ovf: int
    var hit: int = 0 - 1
    var j: int
    while i < n and at < 0 {
        if ent.intAt(off) == key { at = off }
        off = off + 10 + ent.wordAt(off + 4) * 4
        i = i + 1
    }
    if at < 0 { return 0 - 1 }
    vc = ent.wordAt(at + 4)
    esz = 10 + vc * 4
    ovf = ent.intAt(at + 6 + vc * 4)
    if valueOnly {
        j = 0
        while j < vc and hit < 0 {
            if ent.intAt(at + 6 + j * 4) == value { hit = j }
            j = j + 1
        }
        if hit < 0 {
            // not inline: the overflow chain; the region is unchanged
            if ovf != 0 and btOverflowRemoveFirst(f, ovf, value) { return 0 }
            return 0 - 1
        }
    }
    if at > 0 { out.append(ent.textAt(0, at)) }
    if valueOnly and not (vc == 1 and ovf == 0) {
        // the entry minus value `hit`: key, count, values before it,
        // then the values after it and the overflow pointer
        j = out.length
        out.append(ent.textAt(at, 6 + hit * 4))
        out.setWordAt(j + 4, vc - 1)
        out.append(ent.textAt(at + 10 + hit * 4, (vc - hit - 1) * 4 + 4))
    }
    if ent.length > at + esz { out.append(ent.textAt(at + esz, ent.length - at - esz)) }
    ent.clear()
    ent.append(out)
    if valueOnly and not (vc == 1 and ovf == 0) { return 1 }
    return 2
}

// Remove every (keys[i], values[i]) pair, grouped by leaf: pairs are
// taken in key order, each leaf is read once, all of its pairs are
// removed in memory (btEntryRemove -- only those exact pairs; every
// other entry on the page is kept), and the leaf is written once. A
// batch of consecutive keys (expiry: oldest IDs, dates, threads) costs
// about one leaf write instead of one per pair -- writes are ~73 ms on
// the SE. The root must be current (deletes never move it). Returns
// the number removed, or -1 on an I/O error.
func btRemoveMany(f: filehandle, root: int, keys: list of int, values: list of int): int {
    var order: list of int
    var page: text
    var ent: text
    var path: list of int
    var i: int
    var j: int
    var t: int
    var p: int = 0
    var n: int
    var last: int
    var r: int
    var changed: bool
    var removed: int = 0
    // insertion sort of indices by key (batches are small)
    i = 0
    while i < keys.count {
        order.add(i)
        j = order.count - 1
        while j > 0 and keys[order[j - 1]] > keys[order[j]] {
            t = order[j - 1]
            order[j - 1] = order[j]
            order[j] = t
            j = j - 1
        }
        i = i + 1
    }
    while p < order.count {
        if not btDescendFrom(f, root, keys[order[p]], path, page) { return 0 - 1 }
        n = page.wordAt(1)
        last = btLeafEntries(page, ent)
        changed = false
        // this pair, then every following pair whose key this leaf holds
        j = p
        while j < order.count and (j == p or (n > 0 and keys[order[j]] <= last)) {
            r = btEntryRemove(f, ent, n, keys[order[j]], values[order[j]], true)
            if r >= 0 { removed = removed + 1 }
            if r >= 1 { changed = true }
            if r == 2 { n = n - 1 }
            j = j + 1
        }
        if changed {
            if not btWriteLeaf(f, path[path.count - 1], page, ent, n) { return 0 - 1 }
        }
        p = j
    }
    return removed
}

// Delete a key and all its values.
func btDelete(f: filehandle, key: int): bool {
    return btRemove(f, key, 0, false)
}

// Delete one key/value pair (the first occurrence of value).
func btDeleteValue(f: filehandle, key: int, value: int): bool {
    return btRemove(f, key, value, true)
}

// --- Keys -------------------------------------------------------------

// Case-insensitive string key: CRC-16/KERMIT of the lowercased bytes
// (ASCII A-Z only; high MacRoman bytes pass through unchanged).
// Collisions are possible -- callers verify the field after lookup.
func stringKey(s: string): int {
    var t: text
    var i: int = 0
    var c: char
    while i < s.length {
        c = s[i]
        if c >= 'A' and c <= 'Z' { c = char(int(c) + 32) }
        t.append(c)
        i = i + 1
    }
    return t.crc16(0, 0, t.length)
}
