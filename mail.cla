// Private mail UI: the caller's inbox (paged, newest first), the
// framed message view, delete, and compose/reply (via editor.cla).
// Included by bbs.cla after boards.cla (reuses its view widths and
// body paging globals) and before editor.cla.

// Inbox paging: number N at the prompt = mailIds[N-1]; numbering
// restarts at 1 per page. `inbox` holds every message ID for the
// caller, newest first.
var inbox: list of int
var mailIds: list of int
var mailPage: int = 1
var mailPages: int = 1

// Reload the caller's inbox, newest (highest ID) first.
func loadInbox() {
    var oldest: list of int
    var i: int
    inboxIds(user.id, oldest)
    inbox.clear()
    i = oldest.count - 1
    while i >= 0 {
        inbox.add(oldest[i])
        i = i - 1
    }
}

// Content widths: narrow is #/new/Subject (total 29, 39 cols
// with borders and padding), wide adds From and Date (total 63 = 79).
func inboxWidths(w: list of int) {
    w.clear()
    w.add(3)
    w.add(1)
    if terminal.columns < minimumWideTerminalWidth {
        w.add(25)
        return
    }
    w.add(26)
    w.add(16)
    w.add(17)
}

// One page of the inbox; frame is 9 lines like the post list.
func drawInbox() {
    var w: list of int
    var cells: list of string
    var pageRows: int = terminal.rows - 9
    var i: int = 0
    var last: int = 0
    var rec: text

    loadInbox()
    mailPages = (inbox.count + pageRows - 1) / pageRows
    if mailPages < 1 { mailPages = 1 }
    if mailPage > mailPages { mailPage = mailPages }
    if mailPage < 1 { mailPage = 1 }

    mailIds.clear()
    inboxWidths(w)
    cells.add("#")
    cells.add("")
    cells.add("Subject")
    if terminal.columns >= minimumWideTerminalWidth {
        cells.add("From")
        cells.add("Date")
    }
    sendTableHeader("Mail for " + user.name, cells, w)
    i = (mailPage - 1) * pageRows
    last = i + pageRows
    while i < inbox.count and i < last {
        rec = dbFind(mailDb, inbox[i])
        if rec.length == mailRecordSize {
            mailIds.add(inbox[i])
            cells.clear()
            cells.add(intStr(mailIds.count))
            if (rec.wordAt(mOffFlags) & mailFlagRead) == 0 {
                cells.add("*")
            } else {
                cells.add(" ")
            }
            cells.add(dbExtractString(rec, mOffSubject))
            if terminal.columns >= minimumWideTerminalWidth {
                if rec.intAt(mOffFromId) == 0 and rec.wordAt(mOffFromAddr) != 0 {
                    cells.add(dbExtractString(rec, mOffFrom) + " (" + addressStr(addressAt(rec, mOffFromAddr)) + ")")
                } else {
                    cells.add(dbExtractString(rec, mOffFrom))
                }
                cells.add(dateTimeStr(rec.intAt(mOffCreated)))
            }
            sendLine(rowLine(cells, w))
        }
        i = i + 1
    }
    sendTableFooter("Page " + intStr(mailPage) + " of " + intStr(mailPages), w)
    if mailIds.count == 0 {
        sendLine("No mail.")
    }
}

func drawMailMenu() {
    sendLine("")
    sendLine("V) Read Message (or enter number)")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine("L) List Messages")
    sendLine("N) New Message")
    sendLine("Q) Return to Main Menu")
    sendLine("")
}

func mailPrompt() {
    sendData("Mail> ")
}

func backToInbox() {
    user.screen = "mail"
    drawInbox()
    displayPrompt()
}

func mailChoice(input: string) {
    if input == "" or input == "+" {
        if mailPage < mailPages {
            mailPage = mailPage + 1
            drawInbox()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if mailPage > 1 {
            mailPage = mailPage - 1
            drawInbox()
        }
        displayPrompt()
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawInbox()
        displayPrompt()
    }
    case "V" { promptNumber("mailnum", "") }
    case "N" { startNewMail() }
    case "Q" { gotoScreen("main") }
    else { displayPrompt() }
    }
}

// Empty input returns to the inbox; a number on the current page opens
// that message.
func mailNumInput(input: string) {
    var n: int = parseIntStr(input)
    user.screen = "mail"
    if n >= 1 and n <= mailIds.count {
        showMessage(n)
        return
    }
    if input != "" { sendLine("No such message.") }
    displayPrompt()
}

// --- Message view ------------------------------------------------------
// Same frame as the post view: subject title bar, From/Date meta,
// wrapped body paged inside the border, "Message N - Page X of Y".
// Viewing marks the message read.

var mailNum: int = 0

func showMessage(n: int) {
    if not loadMessageView(n) { return }
    user.screen = "mailview"
    displayPrompt()
}

func loadMessageView(n: int): bool {
    var w: list of int
    postViewWidths(w)
    if not loadMessage(mailIds[n - 1]) {
        sendLine("Message unavailable.")
        displayPrompt()
        return false
    }
    mailNum = n
    markRead(message.id)
    wrapText(stripKludges(messageBody(message.id)), w[0], bodyLines)
    bodyPage = 1
    drawMessageView()
    return true
}

func drawMessageView() {
    var w: list of int
    var cells: list of string
    var pageRows: int = 0
    var i: int = 0
    var last: int = 0
    var d: string = dateTimeStr(message.created)
    var from: string = message.fromName
    var netmail: bool = not addressIsZero(message.fromAddr) or not addressIsZero(message.toAddr)

    if not addressIsZero(message.fromAddr) { from = from + " (" + addressStr(message.fromAddr) + ")" }
    postViewWidths(w)
    if terminal.columns < minimumWideTerminalWidth {
        pageRows = terminal.rows - 10
    } else {
        pageRows = terminal.rows - 9
    }
    if netmail { pageRows = pageRows - 1 }     // the To: row below
    bodyPages = (bodyLines.count + pageRows - 1) / pageRows
    if bodyPages < 1 { bodyPages = 1 }
    if bodyPage > bodyPages { bodyPage = bodyPages }
    if bodyPage < 1 { bodyPage = 1 }

    sendTableTitle(message.subject, w)
    cells.clear()
    if terminal.columns < minimumWideTerminalWidth {
        cells.add("From: " + from)
        sendLine(rowLine(cells, w))
        cells.clear()
        cells.add("Date: " + d)
        sendLine(rowLine(cells, w))
    } else {
        cells.add(pad("From: " + from, w[0] - 23) + "Date: " + d)
        sendLine(rowLine(cells, w))
    }
    if netmail {
        // netmail shows who it was addressed to (the original name when
        // it landed with the sysop as unknown-recipient mail)
        cells.clear()
        cells.add("To: " + message.toName)
        sendLine(rowLine(cells, w))
    }
    sendRule(CenterLeft, Center, CenterRight, w)
    i = (bodyPage - 1) * pageRows
    last = i + pageRows
    while i < bodyLines.count and i < last {
        cells.clear()
        cells.add(bodyLines[i])
        sendLine(rowLine(cells, w))
        i = i + 1
    }
    sendTableFooter("Message " + intStr(mailNum) + " - Page " + intStr(bodyPage) + " of " + intStr(bodyPages), w)
}

func drawMailViewMenu() {
    sendLine("")
    sendLine("+) Next Page (or Enter)")
    sendLine("-) Previous Page")
    sendLine(">) Next Message (or .)")
    sendLine("<) Previous Message (or ,)")
    sendLine("L) Redraw This Page")
    sendLine("R) Reply")
    sendLine("D) Delete Message")
    sendLine("Q) Return to Inbox")
    sendLine("")
}

func mailViewChoice(input: string) {
    if input == "" or input == "+" {
        if bodyPage < bodyPages {
            bodyPage = bodyPage + 1
            drawMessageView()
        }
        displayPrompt()
        return
    }
    if input == "-" {
        if bodyPage > 1 {
            bodyPage = bodyPage - 1
            drawMessageView()
        }
        displayPrompt()
        return
    }
    if input == ">" or input == "." {
        if mailNum < mailIds.count {
            showMessage(mailNum + 1)
        } else {
            displayPrompt()
        }
        return
    }
    if input == "<" or input == "," {
        if mailNum > 1 {
            showMessage(mailNum - 1)
        } else {
            displayPrompt()
        }
        return
    }
    switch upperStr(input) {
    case "?" {
        displayMenu()
        displayPrompt()
    }
    case "L" {
        drawMessageView()
        displayPrompt()
    }
    case "R" { startMailReply() }
    case "D" {
        user.screen = "delmailconfirm"
        displayPrompt()
    }
    case "Q" { backToInbox() }
    else { displayPrompt() }
    }
}

// --- Delete ------------------------------------------------------------
// The recipient deletes from the view (confirming over the drawn
// message); body bytes stay orphaned in Mail.MSG (maildb design).
// ponytail: no delete-by-number from the list; add if callers ask.

func delMailConfirm(input: string) {
    if upperStr(input) == "Y" {
        if deleteMessage(message.id) {
            sendLine("Message deleted.")
        } else {
            sendLine("Delete failed: " + lastError.message)
        }
        backToInbox()
        return
    }
    sendLine("Cancelled.")
    user.screen = "mailview"
    displayPrompt()
}

// --- Compose / reply ---------------------------------------------------
// The To: prompt resolves a local username (case-insensitive) and
// rejects anything else; the subject/body prompts are editor.cla's,
// retargeted with editTarget = 'M'.

var mailToId: int = 0
var mailToName: string(63)
var mailToAddr: FtnAddress      // outbound netmail destination (zero = local)
var mailFromAddr: FtnAddress    // our address on that network
var mailToPending: string(63)   // the name typed at To:, awaiting an address

func startNewMail() {
    editTarget = 'M'
    editThread = 0
    editSubject = ""
    editLines.clear()
    editPending = ' '
    mailToId = 0
    mailToName = ""
    mailToAddr = new FtnAddress
    mailFromAddr = new FtnAddress
    editReplyMsgId = ""
    sendEditorBanner("New Message")
    user.screen = "mailto"
    displayPrompt()
}

// Empty To: cancels; an unknown name re-prompts.
func mailToInput(input: string) {
    var id: int
    var rec: text
    if input == "" or upperStr(input) == "/A" {
        abortEditor()
        return
    }
    id = findUserId(trimStr(input))
    if id < 1 {
        mailToPending = trimStr(input)
        if mailToPending.length > 63 { mailToPending = mailToPending[0, 63] }
        sendLine("Not a local user. Enter a FidoNet address to send netmail, or nothing to cancel.")
        user.screen = "mailaddr"
        displayPrompt()
        return
    }
    rec = dbFind(usersDb, id)
    mailToAddr = new FtnAddress
    mailToId = id
    mailToName = dbExtractString(rec, uOffName)
    sendLine("To: " + mailToName)
    user.screen = "editsubject"
    displayPrompt()
}

// Netmail: the address for a To: name that isn't local. Empty cancels;
// the zone picks the network we send from.
func mailAddrInput(input: string) {
    var a: FtnAddress = parseAddress(trimStr(input))
    if input == "" {
        abortEditor()
        return
    }
    if addressIsZero(a) {
        sendLine("Enter an address like 21:1/100.")
        displayPrompt()
        return
    }
    if findNetworkByZone(a.zone) == 0 {
        sendLine("No network for zone " + intStr(a.zone) + ".")
        displayPrompt()
        return
    }
    mailToAddr = a
    mailFromAddr = network.addr
    mailToId = 0
    mailToName = mailToPending
    sendLine("To: " + mailToName + " (" + addressStr(a) + ")")
    user.screen = "editsubject"
    displayPrompt()
}

// "Re: <orig>" unless it already is one.
func replySubject(orig: string): string {
    var sub: string = orig
    if sub.length < 4 or sub[0, 4] != "Re: " {
        if sub.length > 59 { sub = sub[0, 59] }
        sub = "Re: " + sub
    }
    return sub
}

// Reply to the message on screen: To = its sender, subject Re: <orig>.
// Inbound netmail replies to the sender's address, no prompt.
func startMailReply() {
    var rec: text = dbFind(usersDb, message.fromUserId)
    if message.fromUserId < 1 and not addressIsZero(message.fromAddr) {
        if findNetworkByZone(message.fromAddr.zone) == 0 {
            sendLine("No network for zone " + intStr(message.fromAddr.zone) + ".")
            displayPrompt()
            return
        }
        editTarget = 'M'
        editThread = 0
        mailToId = 0
        mailToName = message.fromName
        mailToAddr = message.fromAddr
        mailFromAddr = network.addr
        editReplyMsgId = findKludge(messageBody(message.id), "MSGID:")
        editSubject = replySubject(message.subject)
        editLines.clear()
        editPending = ' '
        sendEditorBanner("Reply to " + mailToName + " (" + addressStr(mailToAddr) + ")")
        user.screen = "editsubject"
        displayPrompt()
        return
    }
    if message.fromUserId < 1 or rec.length != userRecordSize {
        sendLine("The sender is no longer a user here.")
        displayPrompt()
        return
    }
    editTarget = 'M'
    editThread = 0
    mailToId = message.fromUserId
    mailToName = dbExtractString(rec, uOffName)
    mailToAddr = new FtnAddress
    editReplyMsgId = ""
    editSubject = replySubject(message.subject)
    editLines.clear()
    editPending = ' '
    sendEditorBanner("Reply to " + mailToName)
    user.screen = "editsubject"
    displayPrompt()
}
